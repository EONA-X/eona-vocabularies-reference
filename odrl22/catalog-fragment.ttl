# Catalog fragment for the W3C ODRL 2.2 vocabulary.
#
# This does NOT redefine the whole catalog — the mobility pipeline's catalog.ttl
# already declares eona:catalog (dcat:Catalog) with its title/description. This
# fragment only MERGES additional triples into that single shared catalog via the
# default-graph union (rebuild_default_graph unions ALL named graphs):
#   - dcterms:hasPart edges to the ODRL ConceptScheme + entities/attributes ones, and
#   - each scheme's title/label/description so Prez renders it as a collection.
# The odrl: vann prefix binding for Prez curie routing now lives in metadata.ttl
# (same target named graph, so the union sees it exactly as before).
# Loaded (local=True) into its own named graph:
#   https://vocab.eona-x.eu/catalog/odrl
#
# Why a separate eona: scheme IRI: the ODRL ontology IRI
# <http://www.w3.org/ns/odrl/2/> equals the odrl: namespace, so its only curie is
# the empty-localname "odrl:", which Prez cannot route as a collection. The
# browsable scheme therefore lives at a clean eona: IRI (eona:odrl); the loader
# links the ODRL skos:Concepts to it via skos:inScheme so Prez lists them as items.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix eona: <https://vocab.eona-x.eu/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

# Merge the ODRL schemes into the shared catalog as additional members: the full
# vocabulary plus two focused sub-schemes for browsing entities and attributes.
eona:catalog dcterms:hasPart eona:odrl , eona:odrl-entities , eona:odrl-attributes .

# Browsable ConceptScheme for the full ODRL vocabulary. The ODRL skos:Concepts
# are linked in via skos:inScheme by the loader, so Prez lists them as items.
eona:odrl a skos:ConceptScheme ;
    dcterms:identifier "odrl" ;
    dcterms:title "ODRL Version 2.2" ;
    rdfs:label "ODRL Version 2.2" ;
    dcterms:description "The Open Digital Rights Language (ODRL): W3C Recommendation vocabulary for expressing permissions, prohibitions, and obligations (policies) over digital assets." ;
    rdfs:seeAlso <http://www.w3.org/ns/odrl/2/> .

# ODRL entities (owl:Class) and attributes (rdf:Property), split into their own
# browsable sub-schemes. The loader links each ODRL term into the matching scheme
# (and tags it dcterms:type "Entity"/"Attribute") based purely on its rdf:type.
eona:odrl-entities a skos:ConceptScheme ;
    dcterms:identifier "odrl-entities" ;
    dcterms:title "ODRL — Entities (classes)" ;
    rdfs:label "ODRL — Entities (classes)" ;
    dcterms:description "The classes of the ODRL model (owl:Class): Policy, Permission, Prohibition, Duty, Asset, Party, Action, Constraint, etc." ;
    rdfs:seeAlso <http://www.w3.org/ns/odrl/2/> .

eona:odrl-attributes a skos:ConceptScheme ;
    dcterms:identifier "odrl-attributes" ;
    dcterms:title "ODRL — Attributes (properties)" ;
    rdfs:label "ODRL — Attributes (properties)" ;
    dcterms:description "The properties/relations of the ODRL model (rdf:Property): action, target, assignee, assigner, constraint, etc." ;
    rdfs:seeAlso <http://www.w3.org/ns/odrl/2/> .
