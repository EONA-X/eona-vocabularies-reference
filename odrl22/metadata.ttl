<> a dcat:Dataset, adms:Asset ;
    dcterms:title "W3C ODRL 2.2 Vocabulary"@en ;
    dcterms:description "The Open Digital Rights Language (ODRL) 2.2 — the W3C Recommendation vocabulary for permissions, prohibitions and obligations. Bundled upstream copy."@en ;
    dcat:type assettype:c_89b4bdb7 ;
    adms:status status:CURRENT .

<> dcterms:creator [ a foaf:Agent ; foaf:name "W3C" ] .

<> schema:logo "w3c-hero.png" .

[] vann:preferredNamespacePrefix "odrl" ;
    vann:preferredNamespaceUri "http://www.w3.org/ns/odrl/2/" .
