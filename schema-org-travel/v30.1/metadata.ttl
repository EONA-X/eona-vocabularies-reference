@prefix assettype: <http://publications.europa.eu/resource/authority/asset-classification/> .
@prefix status: <http://publications.europa.eu/resource/authority/concept-status/> .

<> a dcat:Dataset, adms:Asset ;
    dcat:version "30.1" ;
    dcterms:title "Schema.org travel subset (v30.1)"@en ;
    dcterms:description "Subset of schema.org v30.1 in the https://schema.org/ namespace: Reservation and its subclasses, Trip and its subclasses, ProgramMembership, their superclasses up to Thing, and every property whose schema:domainIncludes one of them. Generated by tools/generators from the pinned upstream release."@en ;
    dcat:type assettype:c_89b4bdb7 ;
    adms:status status:CURRENT .

<> dcterms:creator [ a foaf:Agent ; foaf:name "Schema.org" ] .
