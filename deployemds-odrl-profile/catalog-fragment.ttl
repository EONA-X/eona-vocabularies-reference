# Catalog fragment for the deployEMDS ODRL Profile.
#
# This does NOT redefine the whole catalog — the mobility pipeline's catalog.ttl
# already declares eona:catalog (dcat:Catalog) with its title/description. This
# fragment only MERGES additional triples into that single shared catalog via the
# default-graph union (rebuild_default_graph unions ALL named graphs):
#   - dcterms:hasPart edges from eona:catalog to the profile's 5 enumeration
#     ConceptSchemes (the only emds: terms typed skos:Concept — see
#     deployemds-odrl-profile.ttl's Actions/LeftOperands, which are not),
#   - dcterms:title/description on each scheme so Prez renders it as a collection
#     (the profile itself only carries rdfs:label).
# The emds: vann prefix binding for Prez curie routing now lives in metadata.ttl
# (same target named graph, so the union sees it exactly as before).
# Loaded (local=True) into its own named graph:
#   https://vocab.eona-x.eu/catalog/deployemds-odrl-profile
#
# Why only the 5 schemes, not the whole profile: unlike the W3C ODRL vocabulary,
# this profile's odrl:Action subclasses and odrl:LeftOperand terms are NOT typed
# skos:Concept (Prez's OGC-Records items query selects ?c a skos:Concept), so only
# the 5 closed-classification value schemes (Confidentiality Level, Personal Data
# Category, IP Rights Status, Purpose, Payment Model — see the profile's "Sheets
# that are closed classifications" term-typing rule) are browsable collections.
# The profile ontology IRI itself is intentionally NOT a direct catalog member
# (mirrors the ODRL loader's own empty-curie-avoidance pattern).

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix eona: <https://vocab.eona-x.eu/> .
@prefix emds: <https://w3id.org/deployemds/odrl-profile#> .

# Merge the profile's 5 enumeration schemes into the shared catalog as additional
# members.
eona:catalog dcterms:hasPart
    emds:confidentialityLevelScheme ,
    emds:personalDataCategoryScheme ,
    emds:ipRightsStatusScheme ,
    emds:purposeScheme ,
    emds:paymentModelScheme .

emds:confidentialityLevelScheme
    dcterms:title "Confidentiality Level values"@en ;
    dcterms:description "Candidate rightOperand values for the deployEMDS emds:confidentialityLevel LeftOperand (Confidential info sheet)."@en ;
    rdfs:seeAlso emds: .

emds:personalDataCategoryScheme
    dcterms:title "Personal Data Category values"@en ;
    dcterms:description "Candidate rightOperand values for the deployEMDS emds:personalDataCategory LeftOperand (Data protection sheet)."@en ;
    rdfs:seeAlso emds: .

emds:ipRightsStatusScheme
    dcterms:title "IP Rights Status values"@en ;
    dcterms:description "Candidate rightOperand values for the deployEMDS emds:ipRightsStatus LeftOperand (IPR sheet)."@en ;
    rdfs:seeAlso emds: .

emds:purposeScheme
    dcterms:title "Purpose values"@en ;
    dcterms:description "Candidate rightOperand values for the deployEMDS emds:purpose LeftOperand (Purpose sheet)."@en ;
    rdfs:seeAlso emds: .

emds:paymentModelScheme
    dcterms:title "Payment Model values"@en ;
    dcterms:description "Candidate rightOperand values for the deployEMDS emds:paymentModel LeftOperand (Fees and monetisation sheet)."@en ;
    rdfs:seeAlso emds: .
