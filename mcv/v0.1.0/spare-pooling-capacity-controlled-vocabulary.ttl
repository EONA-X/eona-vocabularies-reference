@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix mcv: <https://eona-x.eu/vocabulary/mcv/v0.1.0#> .

mcv: a skos:ConceptScheme ;
    dcterms:title "MCV - Spare Pooling Capacity"@en ;
    dcterms:description "Spare pooling capacity use case controlled vocabulary"@en ;
    skos:prefLabel "Spare Pooling Capacity Controlled Vocabulary"@en, "Vocabulaire contrôlé du cas d'usage MCV"@fr ;
    skos:altLabel "MCV"@en, "SPC"@en, "Mutualisation des capacités vacantes"@fr ;
    skos:definition "This controlled vocabulary defines and disambiguates business concepts involved in the spare pooling capacity use case. Technical concepts are excluded."@en ;
    dcterms:creator [ a foaf:Person ; foaf:name "Maxime Blanchard" ] ;
    dcterms:publisher [ a foaf:Organization ; foaf:name "EONA-X" ] ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-10-08"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    vann:preferredNamespacePrefix "mcv" ;
    vann:preferredNamespaceUri "https://eona-x.eu/vocabulary/mcv/v0.1.0#" ;
    dcterms:language "en" ;
    skos:hasTopConcept mcv:Constraint, mcv:Offerer, mcv:Requester, mcv:SpareCapacityOffer, mcv:SpareCapacityDemand, mcv:SpareCapacityVolume, mcv:TransportationActor, mcv:SpareCapacityPublication, mcv:AccountEligibility, mcv:OriginDestination, mcv:TransportationVehicle, mcv:Goods, mcv:PublicationStatus, mcv:PivotModel, mcv:Pseudonymisation, mcv:OfferRequestAssociation, mcv:AssociationScore, mcv:AssociationApproval, mcv:AssociationStatus, mcv:LogisticsUnit .

mcv:Offerer a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Offerer"@en, "Offreur"@fr ;
    skos:definition "MCV platform user role that publishes spare capacity offers associated with business and technical conditions."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:Requester a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Requester"@en, "Demandeur"@fr ;
    skos:definition "MCV platform user role that publishes spare capacity demand associated with business and technical conditions."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:SpareCapacityOffer a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Spare Capacity Offer"@en, "Offre de capacité vacante"@fr ;
    skos:altLabel "Plan de transport"@fr ;
    skos:definition "A spare capacity offer is a proposal to rent some free volume in a vehicle with specific conditions (temperature, pickup, departure date, location, ...) from a logistics company to another."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-10-01"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:SpareCapacityDemand a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Spare Capacity Demand"@en, "Demande de capacité vacante"@fr ;
    skos:altLabel "Spare Capacity Request"@en, "Besoin de transport"@fr ;
    skos:definition "A spare capacity demand entity represents the public, not necessarily binding, not necessarily exclusive, announcement by an organization or person to seek a certain type of spare volume in a logistics vehicle."@en ;
    rdfs:comment "The definition is partially drawn from http://schema.org/Demand"@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-10-01"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:SpareCapacityVolume a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Spare Capacity Volume"@en, "Volume de capacité vacante"@fr ;
    skos:altLabel "Spare Capacity"@en, "Capacité vacante"@fr ;
    skos:definition "Attribute describing the spare capacity in liters."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:TransportationActor a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Logistics Actor"@en, "Opérateur de logistique"@fr ;
    skos:definition "A company offering services of picking up and delivering goods."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:SpareCapacityPublication a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Spare Capacity Publication"@en, "Publication de capacité vacante"@fr ;
    skos:definition "Can be either an Offer or a Demand validated and published on MCV platform."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:AccountEligibility a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Account Eligibility"@en, "Éligibilité du compte"@fr ;
    skos:definition "The eligibility of an MCV platform account is subject to conditions that are evaluated against validation tests such as existing SIREN/SIRET number."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:OriginDestination a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Origin/Destination"@en, "Origine/destination"@fr ;
    skos:altLabel "O/D"@en, "O-D"@en, "Itinerary"@en, "Itinéraire"@fr ;
    skos:definition "A one-way itinerary between a departure and an arrival."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:Constraint a skos:Concept ;
    skos:inScheme mcv: ;
    skos:topConceptOf mcv: ;
    skos:prefLabel "Constraint"@en, "Contrainte"@fr ;
    skos:definition "Condition attached to a spare capacity offer or demand that an association between them must satisfy."@en ;
    skos:narrower mcv:VolumeConstraint, mcv:WeightConstraint, mcv:TemperatureConstraint, mcv:GoodsConstraint, mcv:DeliveryConstraint, mcv:PickupConstraint .

mcv:VolumeConstraint a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Volume Constraint"@en, "Contrainte de volume"@fr ;
    skos:definition "Volume needed specified in the demand or maximal available volume."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:broader mcv:Constraint .

mcv:WeightConstraint a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Weight Constraint"@en, "Contrainte de poids"@fr ;
    skos:definition "Maximal vehicle's goods total weight."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:broader mcv:Constraint .

mcv:TransportationVehicle a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Transportation Vehicle"@en, "Véhicule de transport"@fr ;
    skos:definition "A vehicle is a device that is designed or used to transport people or cargo over land, water, air, or through space."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:Goods a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Goods"@en, "Marchandise"@fr ;
    skos:definition "Any product that is transported in a vehicle."@en ;
    skos:example "A pair of shoes."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:TemperatureConstraint a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Temperature Constraint"@en, "Contrainte de température"@fr ;
    skos:definition "Maximal temperature that must be met."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:broader mcv:Constraint .

mcv:GoodsConstraint a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Goods Constraint"@en, "Contrainte de marchandise"@fr ;
    skos:definition "Condition that must be met due to the goods' nature."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:broader mcv:Constraint .

mcv:DeliveryConstraint a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Delivery Constraint"@en, "Contrainte de livraison"@fr ;
    skos:definition "Condition defined by a Demand that must be met, or defined by an Offer that is imposed."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:broader mcv:Constraint .

mcv:PickupConstraint a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Pickup Constraint"@en, "Contrainte de chargement"@fr ;
    skos:definition "Condition that must be met due to the pickup nature."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:broader mcv:Constraint .

mcv:PublicationStatus a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Publication Status"@en, "Statut de la publication"@fr ;
    skos:definition "Limited set of terms describing the state of a publication (offer or demand)."@en ;
    skos:example "READY"@en, "PUBLISHED"@en, "ARCHIVED"@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:PivotModel a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Pivot Model"@en, "Modèle pivot"@fr ;
    skos:altLabel "Standard"@en, "Schema"@en, "Vocabulary"@en, "Data Schema"@en ;
    skos:definition "Offers and Demands are aligned to the pivot model."@en ;
    skos:example "IATA One Record"@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:Pseudonymisation a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Pseudonymisation"@en, "Pseudonymisation"@fr ;
    skos:altLabel "Pseudonymization"@en ;
    skos:definition "La pseudonymisation consiste à remplacer les identifiants directs par des alias ou codes, permettant une réidentification à l’aide d’informations supplémentaires conservées séparément."@fr, "Pseudonymization involves replacing direct identifiers with aliases or codes, allowing for re-identification using additional information stored separately."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:OfferRequestAssociation a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Offer-Request Association"@en, "Association offre-demande"@fr ;
    skos:definition "A match between an offer and a demand."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:AssociationScore a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Association Score"@en, "Score d'association"@fr ;
    skos:definition "Measures how much an offer matches a demand."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:AssociationApproval a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Association Approval"@en, "Approbation d'association"@fr ;
    skos:definition "The action made by an Offerer or a Requester to accept or refuse an association returned by the association algorithm."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:AssociationStatus a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Association Status"@en, "Statut de l'association"@fr ;
    skos:definition "Describes whether an Association waits to be approved, is approved by one, is approved by both parties, or is stale because one of the parties refused it"@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:topConceptOf mcv: .

mcv:LogisticsUnit a skos:Concept ;
    skos:inScheme mcv: ;
    skos:prefLabel "Logistics Unit"@en, "Unité logistique"@fr ;
    skos:altLabel "UL"@fr ;
    skos:definition "L'unité logistique est un regroupement standardisé de marchandises (unités consommateurs) créé pour faciliter le transport, le stockage et la manutention au sein de la chaîne d'approvisionnement."@fr, "A logistics unit is a standardized grouping of goods (consumer units) created to facilitate transportation, storage, and handling within the supply chain."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-10-01"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-10-01"^^xsd:date ;
    skos:topConceptOf mcv: .
