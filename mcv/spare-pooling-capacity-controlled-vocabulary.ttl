<http://vocabulary.eona-x.eu/vocabulary/mcv> a skos:ConceptScheme ;
    dcterms:title "MCV - Spare Pooling Capacity"@en ;
    dcterms:description "Spare pooling capacity use case controlled vocabulary"@en ;
    dcterms:creator "Maxime Blanchard"@en ;
    dcterms:publisher "EONA-X"@en ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    vann:preferredNamespaceUri "http://vocabulary.eona-x.eu/vocabulary/mcv/" ;
    dcterms:language "en" ;
    skos:hasTopConcept :SparePoolingCapacityControlledVocabulary .

:SparePoolingCapacityControlledVocabulary a skos:Concept ;
    skos:inScheme <http://vocabulary.eona-x.eu/vocabulary/mcv> ;
    skos:topConceptOf <http://vocabulary.eona-x.eu/vocabulary/mcv> ;
    skos:prefLabel "Spare Pooling Capacity Controlled Vocabulary"@en, "Vocabulaire contrôlé du cas d'usage MCV"@fr ;
    skos:altLabel "MCV"@en, "Mutualisation des capacités vacantes"@fr, "SPC"@en ;
    skos:definition "This controlled vocabulary defines and disambiguates business concepts involved in the spare pooling capacity use case. Technical concepts are excluded."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:changeNote "2026-09-29 — Term created"@en, "2026-09-29 — Renamed from “NewConcept” to “SparePoolingCapacityUseCase”; Preferred label “Spare Pooling Capacity Use Case” added; Alternative label “MCV” added; Alternative label “Mutualisation des capacités vacantes (fr)” added; Alternative label “SPC” added"@en, "2026-09-29 — Renamed from “SparePoolingCapacityUseCase” to “SparePoolingCapacityUseCaseControlledVoc”; Preferred label “Spare Pooling Capacity Use Case Controlled Vocabulary” added; Preferred label “Vocabulaire contrôlé du cas d'usage MCV” added; Preferred label “Spare Pooling Capacity Use Case” removed (by Maxime Blanchard)"@en, "2026-09-29 — Renamed from “SparePoolingCapacityUseCaseControlledVoc” to “SparePoolingCapacityControlledVocabulary”; Preferred label changed from “Spare Pooling Capacity Use Case Controlled Vocabulary” to “Spare Pooling Capacity Controlled Vocabulary” (by Maxime Blanchard)"@en, "2026-09-30 — Preferred label changed from “Vocabulaire contrôlé du cas d'usage MCV” to “Vocabulaire contrôlé du cas d'usage MCV (fr)” (by Maxime Blanchard)"@en, "2026-09-30 — Definition added (by Maxime Blanchard)"@en ;
    skos:narrower :Offerer, :Requester, :SpareCapacityOffer, :SpareCapacityDemand, :SpareCapacityVolume, :TransportationActor, :SpareCapacityPublication, :AccountEligility, :OriginDestination, :Constraints, :WeightConstraint, :TransportationVehicle, :Goods, :TemperatureConstraint, :GoodsConstraint, :DeliveryConstraint, :PickupConstraint, :PublicationStatus, :PivotModel, :Pseudonymisation, :OfferRequestAssociation, :AssociationScore, :AssociationApprovement, :AssociationStatus .

:Offerer a skos:Concept ;
    skos:inScheme <http://vocabulary.eona-x.eu/vocabulary/mcv> ;
    skos:prefLabel "Offerer"@en, "Offreur"@fr ;
    skos:definition "MCV platform user role that publishes spare capacity offers associated with business and technical conditions."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:broader :SparePoolingCapacityControlledVocabulary ;
    skos:changeNote "2026-09-29 — Term created under “Logistics Actor”"@en, "2026-09-29 — Renamed from “NewConcept” to “SpareCapacityOfferer”; Preferred label “Spare Capacity Offerer” added"@en, "2026-09-29 — Renamed from “SpareCapacityOfferer” to “Offerer”; Preferred label changed from “Spare Capacity Offerer” to “Offerer”"@en, "2026-09-29 — Parent “Spare Pooling Capacity Use Case” added"@en, "2026-09-30 — Preferred label “Offreur (fr)” added; Definition added (by Maxime Blanchard)"@en, "2026-09-30 — Definition updated (by Maxime Blanchard)"@en .

:Requester a skos:Concept ;
    skos:inScheme <http://vocabulary.eona-x.eu/vocabulary/mcv> ;
    skos:prefLabel "Requester"@en ;
    skos:definition "MCV platform user role that publishes spare capacity demand associated with business and technical conditions."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:broader :SparePoolingCapacityControlledVocabulary ;
    skos:changeNote "2026-09-29 — Term created under “Logistics Actor”"@en, "2026-09-29 — Renamed from “NewConcept” to “Requester”; Preferred label “Requester” added"@en, "2026-09-29 — Parent “Spare Pooling Capacity Use Case” added"@en, "2026-09-30 — Definition added (by Maxime Blanchard)"@en .

:SpareCapacityOffer a skos:Concept ;
    skos:inScheme <http://vocabulary.eona-x.eu/vocabulary/mcv> ;
    skos:prefLabel "Spare Capacity Offer"@en, "Offre de capacité vacante"@fr ;
    skos:definition "A spare capacity offer is a proposal to rent some free volume in a vehicle with specific conditions (temperature, pickup, departure date, location, ...) from a logistics company to another."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:broader :SparePoolingCapacityControlledVocabulary ;
    skos:changeNote "2026-09-29 — Term created under “Publication”"@en, "2026-09-29 — Renamed from “NewConcept” to “Offer”; Preferred label “Offer” added"@en, "2026-09-29 — Parent “Spare Pooling Capacity Use Case” added"@en, "2026-09-30 — Renamed from “Offer” to “Spare-Capacity-Offer”; Preferred label “Spare Capacity Offer” added; Preferred label “Offre de capacité vacante” added; Preferred label “Offer” removed; Definition added (by Maxime Blanchard)"@en, "2026-09-30 — Renamed from “Spare-Capacity-Offer” to “SpareCapacityOffer” (by Maxime Blanchard)"@en, "2026-09-30 — Preferred label changed from “Offre de capacité vacante” to “Offre de capacité vacante (fr)” (by Maxime Blanchard)"@en .

:SpareCapacityDemand a skos:Concept ;
    skos:inScheme <http://vocabulary.eona-x.eu/vocabulary/mcv> ;
    skos:prefLabel "Spare Capacity Demand"@en, "Demande de capacité vacante"@fr ;
    skos:altLabel "Spare Capacity Request"@en ;
    skos:definition "A spare capacity demand entity represents the public, not necessarily binding, not necessarily exclusive, announcement by an organization or person to seek a certain type of spare volume in a logistics vehicle."@en ;
    rdfs:comment "The definition is partially drawn from http://schema.org/Demand"@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:broader :SparePoolingCapacityControlledVocabulary ;
    skos:changeNote "2026-09-29 — Term created under “Publication”"@en, "2026-09-29 — Renamed from “NewConcept” to “Request”; Preferred label “Request” added"@en, "2026-09-29 — Parent “Spare Pooling Capacity Use Case” added"@en, "2026-09-30 — Renamed from “Request” to “SpareCapacityDemand”; Preferred label “Spare Capacity Demand” added; Preferred label “Demande de capacité vacante (fr)” added; Preferred label “Request” removed; Alternative label “Spare Capacity Request” added; Definition added (by Maxime Blanchard)"@en .

:SpareCapacityVolume a skos:Concept ;
    skos:inScheme <http://vocabulary.eona-x.eu/vocabulary/mcv> ;
    skos:prefLabel "Spare Capacity Volume"@en, "Volume de capacité vacante"@fr ;
    skos:altLabel "Spare Capacity"@en, "Capacité vacante"@fr ;
    skos:definition "Attribute describing the spare capacity in liters."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:broader :SparePoolingCapacityControlledVocabulary ;
    skos:changeNote "2026-09-29 — Term created under “Spare Pooling Capacity Use Case”"@en, "2026-09-29 — Renamed from “NewConcept” to “SpareCapacity”; Preferred label “Spare Capacity” added; Preferred label “Capacité vacante (fr)” added"@en, "2026-09-29 — Preferred label “Spare Capacity Volume” added; Preferred label “Volume de capacité vacante (fr)” added; Preferred label “Spare Capacity” removed; Preferred label “Capacité vacante (fr)” removed; Alternative label “Spare Capacity” added; Alternative label “Capacité vacante (fr)” added"@en, "2026-09-30 — Renamed from “SpareCapacity” to “SpareCapacityVolume”; Definition added (by Maxime Blanchard)"@en .

:TransportationActor a skos:Concept ;
    skos:inScheme <http://vocabulary.eona-x.eu/vocabulary/mcv> ;
    skos:prefLabel "Logistics Actor"@en, "Opérateur de logistique"@fr ;
    skos:definition "A company offering services of picking up and delivering goods."@en ;
    dcterms:creator "Maxime Blanchard" ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-09-29"^^xsd:date ;
