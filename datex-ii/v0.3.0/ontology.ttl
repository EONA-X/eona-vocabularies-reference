    rdfs:domain datex:ElectricChargingEquipment ;
    skos:scopeNote "Value type: object reference (DATEX II ElectricChargingPoint) — see the ElectricVehicleChargingPoint entity. Required in DATEX II." ;
    rdfs:range datex:ElectricVehicleChargingPoint ;
    dcterms:source "DATEX II ElectricChargingEquipment.electricChargingPoint; hub-curated SKOS rendering." .

