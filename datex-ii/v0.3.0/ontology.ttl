    skos:prefLabel "Not available"@en ;
    skos:definition "Whether energy-mix information is not available for this charging point." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricEnergyMix ;
    skos:scopeNote "Value type: xsd:boolean. DATEX II native type: Boolean." ;
    rdfs:range xsd:boolean ;
    dcterms:source "DATEX II ElectricEnergyMix.notAvailable; hub-curated SKOS rendering." .

# Naming note: DATEX II's native element name is "energyProvider", already
# used by the pre-existing datex:energyProvider (domain
# EnergyInfrastructureStation); disambiguated here as "energyMixProvider"
# since this is a second, distinct usage of the same native name on a
# different class (ElectricEnergyMix).
#
# OWL enrichment note: object reference in DATEX II (DATEX II Organisation);
# modeled as owl:ObjectProperty with no invented rdfs:range (out of scope,
# see TERMS.md).
datex:energyMixProvider a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricEnergyMix ;
    skos:prefLabel "Energy mix provider"@en ;
    skos:definition "The organisation providing this specific energy mix." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricEnergyMix ;
    skos:scopeNote "Value type: object reference (DATEX II Organisation; external, out of scope — same pattern as the pre-existing datex:energyProvider)." ;
    dcterms:source "DATEX II ElectricEnergyMix.energyProvider; hub-curated SKOS rendering." .

# Naming note: DATEX II's native element name is "rates"; qualified here as
# "energyMixRates" for readability alongside this file's other attribute
# names (no collision with an existing IRI).
#
# OWL enrichment note: object reference in DATEX II (DATEX II Facilities
# Rates, an abstract class); modeled as owl:ObjectProperty with no invented
# rdfs:range (out of scope, see TERMS.md).
datex:energyMixRates a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricEnergyMix ;
    skos:prefLabel "Energy mix rates"@en ;
    skos:definition "The pricing/rates applicable to this energy mix." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricEnergyMix ;
    skos:scopeNote "Value type: object reference (DATEX II Facilities Rates; external, out of scope)." ;
    dcterms:source "DATEX II ElectricEnergyMix.rates; hub-curated SKOS rendering." .

datex:energyMixIndex a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricEnergyMix ;
    skos:prefLabel "Energy mix index"@en ;
    skos:definition "The index (ordinal) of this energy mix entry among the charging point's possible energy mixes." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricEnergyMix ;
    skos:scopeNote "Value type: xsd:integer. DATEX II native type: Integer (XML attribute). Required in DATEX II." ;
    rdfs:range xsd:integer ;
    dcterms:source "DATEX II ElectricEnergyMix/@energyMixIndex; hub-curated SKOS rendering." .

# OWL enrichment note: the pre-existing datex:energySourceType /
# datex:energySourceRatio attributes already render a flattened view of this
# same information directly on ElectricEnergyMix (a deliberate earlier
# simplification, left untouched). This attribute adds the fully faithful,
# properly-nested rendering (source + ratio + free-text "other" source
# paired per entry) alongside it, without altering the flattened original.
datex:electricEnergySourceRatio a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricEnergyMix ;
    skos:prefLabel "Electric energy source ratio (containment)"@en ;
    skos:definition "A source/ratio pair making up this energy mix (e.g. 40% solar). The containment edge from ElectricEnergyMix down to ElectricEnergySourceRatio." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricEnergyMix ;
    skos:scopeNote "Value type: object reference (DATEX II ElectricEnergySourceRatio) — see the ElectricEnergySourceRatio entity. Multi-valued." ;
    rdfs:range datex:ElectricEnergySourceRatio ;
    dcterms:source "DATEX II ElectricEnergyMix.electricEnergySourceRatio; hub-curated SKOS rendering." .


# ===========================================================================
# Missing code values on two ORIGINAL enumeration attributes (full native scope)
# ===========================================================================

# The native AuthenticationAndIdentificationEnum (XSD) has 19 literals; the
# original hub-curated subset modelled 10. Adding the missing 9 as new
# skos:Concept code values, narrower of the pre-existing
# datex:authenticationAndIdentificationMethods (a separate statement --
# its original skos:narrower block above is untouched).
datex:authenticationAndIdentificationMethods skos:narrower datex:authMethod-activeRFIDChip ,
    datex:authMethod-calypso , datex:authMethod-mifareClassic , datex:authMethod-mifareDesfire ,
    datex:authMethod-overTheAir , datex:authMethod-phoneDialog , datex:authMethod-phoneSMS ,
    datex:authMethod-pinpad , datex:authMethod-plc .

