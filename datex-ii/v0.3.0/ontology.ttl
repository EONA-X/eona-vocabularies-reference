# ===========================================================================
# Additional skos:hasTopConcept for the 15 new Entity classes
# ===========================================================================

# (separate statement -- the original skos:hasTopConcept block above is
# untouched; each new entity below also states skos:topConceptOf itself,
# matching the original entities' own pattern)
datex:energy-infrastructure skos:hasTopConcept datex:RefillPoint , datex:DieselRefillPoint ,
    datex:PetrolRefillPoint , datex:OrganicGasRefillPoint , datex:HydrogenRefillPoint ,
    datex:RefillPointStatus , datex:ElectricChargingPointStatus , datex:EnergyInfrastructureSiteStatus ,
    datex:EnergyInfrastructureStationStatus , datex:ServiceType , datex:ElectricChargingEquipment ,
    datex:VehicleSpace , datex:EnergyPricingPolicy , datex:AssociatedParking ,
    datex:ElectricEnergySourceRatio .

# ===========================================================================
# ENTITY: RefillPoint (abstract)
# ===========================================================================

datex:RefillPoint a skos:Concept, owl:Class ;
    skos:inScheme datex:energy-infrastructure ;
    skos:topConceptOf datex:energy-infrastructure ;
    skos:prefLabel "Refill point (abstract)"@en ;
    skos:definition "Technical infrastructure at a specific location that facilitates refilling one vehicle at a time with any form of energy (electricity, diesel, petrol, organic gas, hydrogen). Abstract superclass of ElectricVehicleChargingPoint (already modelled above) and of DieselRefillPoint, PetrolRefillPoint, OrganicGasRefillPoint and HydrogenRefillPoint (modelled below)." ;
    dcterms:type "Entity" ;
    dcterms:source "DATEX II EnergyInfrastructure: RefillPoint (abstract, extends Facility); hub-curated SKOS rendering." ;
    skos:narrower datex:deliveryUnit ;
    skos:narrower datex:maximumDeliveryAmount ;
    skos:narrower datex:minimumDeliveryAmount ;
    skos:narrower datex:modelType ;
    skos:narrower datex:reservation ;
    skos:narrower datex:serviceType .

datex:deliveryUnit a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:RefillPoint ;
    skos:prefLabel "Delivery unit"@en ;
    skos:definition "The unit in which energy/fuel is delivered at the refill point (e.g. litre, kWh, kg)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:RefillPoint ;
    skos:scopeNote "Value type: enumeration (DeliveryUnitEnum) — see narrower code values." ;
    rdfs:range datex:deliveryUnit ;
    dcterms:source "DATEX II RefillPoint.deliveryUnit (DeliveryUnitEnum); hub-curated SKOS rendering." ;
    skos:narrower datex:deliveryUnit-litre ;
    skos:narrower datex:deliveryUnit-kWh ;
    skos:narrower datex:deliveryUnit-kg ;
    skos:narrower datex:deliveryUnit-m3 ;
    skos:narrower datex:deliveryUnit-imperialGallon ;
    skos:narrower datex:deliveryUnit-usGallon ;
    skos:narrower datex:deliveryUnit-gasGallonEquivalent .

datex:deliveryUnit-litre a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:deliveryUnit ;
    skos:prefLabel "Litre"@en ;
    skos:definition "Delivery measured in litres." ;
    dcterms:type "Code value" ;
    skos:notation "litre" .

datex:deliveryUnit-kWh a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:deliveryUnit ;
    skos:prefLabel "Kilowatt-hour"@en ;
    skos:definition "Delivery measured in kilowatt-hours." ;
    dcterms:type "Code value" ;
    skos:notation "kWh" .

datex:deliveryUnit-kg a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:deliveryUnit ;
    skos:prefLabel "Kilogram"@en ;
    skos:definition "Delivery measured in kilograms." ;
    dcterms:type "Code value" ;
    skos:notation "kg" .

datex:deliveryUnit-m3 a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:deliveryUnit ;
    skos:prefLabel "Cubic metre"@en ;
    skos:definition "Delivery measured in cubic metres." ;
    dcterms:type "Code value" ;
    skos:notation "m3" .

datex:deliveryUnit-imperialGallon a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:deliveryUnit ;
    skos:prefLabel "Imperial gallon"@en ;
    skos:definition "Delivery measured in imperial gallons." ;
    dcterms:type "Code value" ;
    skos:notation "imperialGallon" .

datex:deliveryUnit-usGallon a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:deliveryUnit ;
    skos:prefLabel "US gallon"@en ;
    skos:definition "Delivery measured in US gallons." ;
    dcterms:type "Code value" ;
    skos:notation "usGallon" .

datex:deliveryUnit-gasGallonEquivalent a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:deliveryUnit ;
    skos:prefLabel "Gas gallon equivalent"@en ;
    skos:definition "Delivery measured in gas gallon equivalent (GGE)." ;
    dcterms:type "Code value" ;
    skos:notation "gasGallonEquivalent" .

datex:maximumDeliveryAmount a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:RefillPoint ;
    skos:prefLabel "Maximum delivery amount"@en ;
    skos:definition "The maximum amount of energy/fuel that can be delivered in a single session, in the unit given by datex:deliveryUnit." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:RefillPoint ;
    skos:scopeNote "Value type: xsd:decimal. DATEX II native type: Units (float)." ;
    rdfs:range xsd:decimal ;
    dcterms:source "DATEX II RefillPoint.maximumDeliveryAmount; hub-curated SKOS rendering." .

datex:minimumDeliveryAmount a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:RefillPoint ;
    skos:prefLabel "Minimum delivery amount"@en ;
    skos:definition "The minimum amount of energy/fuel that can be delivered in a single session, in the unit given by datex:deliveryUnit." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:RefillPoint ;
    skos:scopeNote "Value type: xsd:decimal. DATEX II native type: Units (float)." ;
    rdfs:range xsd:decimal ;
    dcterms:source "DATEX II RefillPoint.minimumDeliveryAmount; hub-curated SKOS rendering." .

datex:modelType a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:RefillPoint ;
    skos:prefLabel "Model type"@en ;
    skos:definition "The manufacturer's model designation of the refill point." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:RefillPoint ;
    skos:scopeNote "Value type: xsd:string. DATEX II native type: MultilingualString." ;
    rdfs:range xsd:string ;
    dcterms:source "DATEX II RefillPoint.modelType; hub-curated SKOS rendering." .

datex:reservation a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:RefillPoint ;
    skos:prefLabel "Reservation"@en ;
    skos:definition "Whether the refill point can be reserved in advance. External enumeration (DATEX II Facilities ReservationTypeEnum: optional, mandatory, notAvailable, partly, unknown, unspecified) — code values are not modelled in this hub-curated subset (out of scope, Facilities namespace)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:RefillPoint ;
    skos:scopeNote "Value type: enumeration (DATEX II Facilities ReservationTypeEnum; external, out of scope — code values not modelled)." ;
    dcterms:source "DATEX II RefillPoint.reservation (fac:_ReservationTypeEnum, DATEX II Facilities namespace); hub-curated SKOS rendering." .

# Naming note: DATEX II's native element name is "serviceType", reused
# across RefillPoint, EnergyInfrastructureStation and ServiceType's own
# scalar field; this is the primary/bare-name usage (RefillPoint is the
# class this attribute is native to; the EnergyInfrastructureStation usage
# is disambiguated as datex:stationServiceType, and ServiceType's own
# enumeration field as datex:serviceTypeCode).
datex:serviceType a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:RefillPoint ;
    skos:prefLabel "Service type"@en ;
    skos:definition "The way the refill point is serviced (full service, self-service, or unattended)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:RefillPoint ;
    skos:scopeNote "Value type: object reference (DATEX II ServiceType) — see the ServiceType entity." ;
    rdfs:range datex:ServiceType ;
    dcterms:source "DATEX II RefillPoint.serviceType; hub-curated SKOS rendering." .

# ===========================================================================
# ENTITY: DieselRefillPoint
# ===========================================================================

datex:DieselRefillPoint a skos:Concept, owl:Class ;
    skos:inScheme datex:energy-infrastructure ;
    skos:topConceptOf datex:energy-infrastructure ;
    rdfs:subClassOf datex:RefillPoint ;
    skos:prefLabel "Diesel refill point"@en ;
    skos:definition "A refill point specialised for dispensing diesel fuel." ;
    dcterms:type "Entity" ;
    dcterms:source "DATEX II EnergyInfrastructure: DieselRefillPoint (extends RefillPoint); hub-curated SKOS rendering." ;
    skos:narrower datex:dieselType ;
    skos:narrower datex:cetane .

datex:dieselType a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:DieselRefillPoint ;
    skos:prefLabel "Diesel type"@en ;
    skos:definition "The type(s) of diesel fuel dispensed (e.g. car diesel, truck diesel, biodiesel)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:DieselRefillPoint ;
    skos:scopeNote "Value type: enumeration (DieselTypeEnum) — see narrower code values. Multi-valued." ;
    rdfs:range datex:dieselType ;
    dcterms:source "DATEX II DieselRefillPoint.dieselType (DieselTypeEnum); hub-curated SKOS rendering." ;
    skos:narrower datex:dieselType-carDiesel ;
    skos:narrower datex:dieselType-truckDiesel ;
    skos:narrower datex:dieselType-bioDiesel ;
    skos:narrower datex:dieselType-unknown .

datex:dieselType-carDiesel a skos:Concept ;
