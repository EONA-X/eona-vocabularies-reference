datex:authMethod-overTheAir a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:authenticationAndIdentificationMethods ;
    skos:prefLabel "Over the air"@en ;
    skos:definition "Identification/authentication performed over the air (remote activation)." ;
    dcterms:type "Code value" ;
