# ===========================================================================
# ENTITY: ElectricEnergySourceRatio
# ===========================================================================

datex:ElectricEnergySourceRatio a skos:Concept, owl:Class ;
    skos:inScheme datex:energy-infrastructure ;
    skos:topConceptOf datex:energy-infrastructure ;
    skos:prefLabel "Electric energy source ratio"@en ;
    skos:definition "A single energy-source/ratio pairing within an electric energy mix (e.g. '40% solar'). Referenced by the pre-existing ElectricEnergyMix entity via the new datex:electricEnergySourceRatio containment attribute; provides a fully faithful, properly-nested alternative to that entity's pre-existing flattened datex:energySourceType/datex:energySourceRatio attributes." ;
    dcterms:type "Entity" ;
    dcterms:source "DATEX II EnergyInfrastructure: ElectricEnergySourceRatio; hub-curated SKOS rendering." ;
    skos:narrower datex:energySource ;
    skos:narrower datex:otherEnergySource ;
    skos:narrower datex:sourceRatioValue .

# OWL enrichment note: kept as owl:DatatypeProperty (not owl:ObjectProperty),
# consistent with this file's existing rule for enumeration-valued
# attributes (see TERMS.md "OWL enrichment"): its rdfs:range is the
# pre-existing datex:energySourceType enumeration ROOT concept -- itself a
# skos:Concept/owl:DatatypeProperty, not an owl:Class -- reused rather than
# duplicated under a new IRI, so this attribute has no code values of its
# own (see datex:energySourceType's narrower list instead).
datex:energySource a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricEnergySourceRatio ;
    skos:prefLabel "Energy source"@en ;
    skos:definition "The type of energy source for this source/ratio pairing. Reuses the pre-existing datex:energySourceType enumeration root (ElectricEnergySourceTypeEnum) as its range rather than duplicating its 10 code values under a new IRI." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricEnergySourceRatio ;
    skos:scopeNote "Value type: enumeration (DATEX II ElectricEnergySourceTypeEnum) — reuses the pre-existing datex:energySourceType enumeration (see its narrower code values). Required in DATEX II." ;
    rdfs:range datex:energySourceType ;
    dcterms:source "DATEX II ElectricEnergySourceRatio.energySource (ElectricEnergySourceTypeEnum); hub-curated SKOS rendering." .

datex:otherEnergySource a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricEnergySourceRatio ;
    skos:prefLabel "Other energy source (free text)"@en ;
    skos:definition "Free-text description of the energy source when datex:energySource is 'other'." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricEnergySourceRatio ;
    skos:scopeNote "Value type: xsd:string. DATEX II native type: String." ;
    rdfs:range xsd:string ;
    dcterms:source "DATEX II ElectricEnergySourceRatio.otherEnergySource; hub-curated SKOS rendering." .

# Naming note: DATEX II's native element name is "sourceRatioValue"; kept
# distinct from the pre-existing datex:energySourceRatio (domain
# ElectricEnergyMix, the flattened rendering of the same idea) since the two
# have different domains under this file's one-domain-per-attribute
# convention.
datex:sourceRatioValue a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricEnergySourceRatio ;
    skos:prefLabel "Source ratio value"@en ;
    skos:definition "The percentage share of this energy source within the electric energy mix." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricEnergySourceRatio ;
    skos:scopeNote "Value type: xsd:decimal (percentage). DATEX II native type: PercentageValue. Required in DATEX II." ;
    rdfs:range xsd:decimal ;
    dcterms:source "DATEX II ElectricEnergySourceRatio.sourceRatioValue; hub-curated SKOS rendering." .


