# ===========================================================================
# ENTITY: RefillPointStatus
# ===========================================================================

datex:RefillPointStatus a skos:Concept, owl:Class ;
    skos:inScheme datex:energy-infrastructure ;
    skos:topConceptOf datex:energy-infrastructure ;
    skos:prefLabel "Refill point status"@en ;
    skos:definition "The dynamic operational status of a refill point (availability, stock level, waiting time). The status counterpart of RefillPoint." ;
    dcterms:type "Entity" ;
    dcterms:source "DATEX II EnergyInfrastructure: RefillPointStatus (extends Facilities FacilityStatus); hub-curated SKOS rendering." ;
    skos:narrower datex:refillPointStatusCode ;
    skos:narrower datex:unitsInStock ;
    skos:narrower datex:waitingTime .

# Naming note: DATEX II's native element name is "status", already used by
# the pre-existing datex:status (domain ElectricVehicleChargingPoint, a
# hub-curated OCPI-style simplification, left untouched); disambiguated here
# as "refillPointStatusCode" since this is the faithful native
# RefillPointStatusEnum (13 values) on a different class.
datex:refillPointStatusCode a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:RefillPointStatus ;
    skos:prefLabel "Refill point status code"@en ;
    skos:definition "The native DATEX II operational status of the refill point (e.g. available, occupied, faulted, out of order)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:RefillPointStatus ;
    skos:scopeNote "Value type: enumeration (RefillPointStatusEnum) — see narrower code values. Required in DATEX II." ;
    rdfs:range datex:refillPointStatusCode ;
    dcterms:source "DATEX II RefillPointStatus.status (RefillPointStatusEnum); hub-curated SKOS rendering." ;
    skos:narrower datex:refillPointStatusCode-available ;
    skos:narrower datex:refillPointStatusCode-blocked ;
    skos:narrower datex:refillPointStatusCode-charging ;
    skos:narrower datex:refillPointStatusCode-faulted ;
    skos:narrower datex:refillPointStatusCode-inoperative ;
    skos:narrower datex:refillPointStatusCode-occupied ;
    skos:narrower datex:refillPointStatusCode-outOfOrder ;
    skos:narrower datex:refillPointStatusCode-outOfStock ;
    skos:narrower datex:refillPointStatusCode-planned ;
    skos:narrower datex:refillPointStatusCode-removed ;
    skos:narrower datex:refillPointStatusCode-reserved ;
    skos:narrower datex:refillPointStatusCode-unavailable ;
    skos:narrower datex:refillPointStatusCode-unknown .

datex:refillPointStatusCode-available a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:refillPointStatusCode ;
    skos:prefLabel "Available"@en ;
    skos:definition "The refill point is operational and free to use." ;
