# =========================================================================
# FULL NATIVE SCOPE EXPANSION (added 2026-08-18)
# =========================================================================
# Everything from here to the end of the file is ADDITIVE: new concepts, and
# new triples on the five ORIGINAL entities above (new skos:narrower /
# rdfs:subClassOf edges, expressed as separate statements so as not to touch
# a single character of the original blocks). No existing triple is removed
# or altered.
#
# Source: primary XSD, fetched live and read directly (no secondary
# description needed -- the primary schema was reachable):
#   https://docs.datex2.eu/_static/data/v3.7/DATEXII_3_EnergyInfrastructure.xsd
# (same DATEX II v3.7 EnergyInfrastructure namespace already cited by this
# file's ontology header). Cross-checked against the DATEX II Documentation
# Portal's "Mastering > Energy" narrative pages (docs.datex2.eu/levels/
# mastering/energy/) for definitions/context, and against the imported
# DATEXII_3_Facilities.xsd / DATEXII_3_Common.xsd schemas (also fetched) to
# resolve inherited/external type names cited in scope notes below.
#
# Scope rule applied: every class and attribute defined DIRECTLY in
# DATEXII_3_EnergyInfrastructure.xsd is modelled (all 15 non-enum,
# non-envelope complexTypes not already covered by the original 5 entities;
# see the per-entity dcterms:source below for the exact XSD complexType).
# Deliberately EXCLUDED, as genuinely out of the domain model:
#   - the four XML/message *envelope* complexTypes:
#     EnergyInfrastructureTable, EnergyInfrastructureTablePublication,
#     EnergyInfrastructureStatusPublication, and the
#     _EnergyInfrastructureTableVersionedReference helper -- these are
#     exchange-message wrappers (com:PayloadPublication descendants,
#     id/version envelopes), not domain concepts, matching this file's
#     pre-existing choice not to model com:PayloadPublication/
#     HeaderInformation either;
#   - the "_XyzEnum" extensibility wrapper complexTypes (one per enum) --
#     an XSD open-enumeration mechanism (an "_extendedValue" escape hatch),
#     not real classes;
#   - the "_extended" enumeration literal present on every native enum --
#     matches this file's pre-existing choice to omit it from the original
#     6 enumerations;
#   - the AFIR-branded sibling namespace/extension (AfirEnergyInfrastructure,
#     DATEXII_3_AfirEnergyInfrastructure.xsd) -- a SEPARATE DATEX II
#     extension/namespace (confirmed via docs.datex2.eu/downloads/modelv37/),
#     not "the EnergyInfrastructure model" this file already scopes to;
#   - attributes/types that live in the imported Facilities/Common/
#     LocationReferencing namespaces (fac:/com:/loc:) and are not modelled
#     in this file -- kept out of scope exactly like the original file's
#     entrance/operatingHours/energyProvider/location precedent: rendered as
#     owl:ObjectProperty or owl:DatatypeProperty with NO invented
#     rdfs:range/code values, and a "(external, out of scope)" scopeNote.
#
# Attribute-naming collisions: DATEX II XSD element names are locally scoped
# per complexType, so several native names recur across more than one class
# in this same extension (e.g. "energyProvider" on both
# EnergyInfrastructureStation and ElectricEnergyMix; "serviceType" on
# EnergyInfrastructureStation, RefillPoint AND as ServiceType's own scalar
# field; "status" on the pre-existing hub-curated ElectricVehicleChargingPoint
# attribute AND natively again on the new RefillPointStatus class). Since
# this file's convention is one bare-name IRI per attribute with a single
# rdfs:domain, a second/third use of the same native name is disambiguated
# with a short, readable suffix (documented per-attribute below with a
# "# Naming note:" comment); the first/pre-existing or most-central usage
# always keeps the bare native name.

# ===========================================================================
# New attributes on the five ORIGINAL entities (full native scope)
# ===========================================================================

# --- EnergyInfrastructureSite: additional native attributes ---
# (separate statement -- the original skos:narrower block above is untouched)
datex:EnergyInfrastructureSite skos:narrower datex:typeOfSite , datex:exclusiveUsers ,
    datex:preferredUsers , datex:exit , datex:energyInfrastructureStation .

datex:typeOfSite a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureSite ;
    skos:prefLabel "Type of site"@en ;
    skos:definition "The physical type of the energy infrastructure site (e.g. roofed station, in a building, open space, on-street, on a company site)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureSite ;
    skos:scopeNote "Value type: enumeration (EnergyInfrastructureSiteTypeEnum) — see narrower code values." ;
    rdfs:range datex:typeOfSite ;
    dcterms:source "DATEX II EnergyInfrastructureSite.typeOfSite (EnergyInfrastructureSiteTypeEnum); hub-curated SKOS rendering." ;
    skos:narrower datex:typeOfSite-roofedStation ;
    skos:narrower datex:typeOfSite-inBuilding ;
    skos:narrower datex:typeOfSite-openSpace ;
    skos:narrower datex:typeOfSite-onstreet ;
    skos:narrower datex:typeOfSite-onCompanySite ;
    skos:narrower datex:typeOfSite-other .

datex:typeOfSite-roofedStation a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:typeOfSite ;
    skos:prefLabel "Roofed station"@en ;
    skos:definition "The site is a roofed station." ;
    dcterms:type "Code value" ;
    skos:notation "roofedStation" .

datex:typeOfSite-inBuilding a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:typeOfSite ;
    skos:prefLabel "In building"@en ;
    skos:definition "The site is located inside a building." ;
    dcterms:type "Code value" ;
    skos:notation "inBuilding" .

datex:typeOfSite-openSpace a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:typeOfSite ;
    skos:prefLabel "Open space"@en ;
    skos:definition "The site is an open, unroofed space." ;
    dcterms:type "Code value" ;
    skos:notation "openSpace" .

datex:typeOfSite-onstreet a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:typeOfSite ;
    skos:prefLabel "On-street"@en ;
    skos:definition "The site is located on-street." ;
    dcterms:type "Code value" ;
    skos:notation "onstreet" .

datex:typeOfSite-onCompanySite a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:typeOfSite ;
    skos:prefLabel "On company site"@en ;
    skos:definition "The site is located on a company's premises." ;
    dcterms:type "Code value" ;
    skos:notation "onCompanySite" .

datex:typeOfSite-other a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:typeOfSite ;
    skos:prefLabel "Other site type"@en ;
    skos:definition "A site type not covered by the enumerated values." ;
    dcterms:type "Code value" ;
    skos:notation "other" .

datex:exclusiveUsers a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureSite ;
    skos:prefLabel "Exclusive users"@en ;
    skos:definition "The user group(s) exclusively allowed to use this site (e.g. employees, hotel guests). External enumeration (DATEX II Facilities UserTypeEnum) — code values are not modelled in this hub-curated subset (out of scope, Facilities namespace)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureSite ;
    skos:scopeNote "Value type: enumeration (DATEX II Facilities UserTypeEnum; external, out of scope — code values not modelled). Multi-valued." ;
    dcterms:source "DATEX II EnergyInfrastructureSite.exclusiveUsers (fac:_UserTypeEnum, DATEX II Facilities namespace); hub-curated SKOS rendering." .

datex:preferredUsers a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureSite ;
    skos:prefLabel "Preferred users"@en ;
    skos:definition "The user group(s) for whom this site is preferentially intended (non-exclusive). External enumeration (DATEX II Facilities UserTypeEnum) — code values are not modelled in this hub-curated subset (out of scope, Facilities namespace)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureSite ;
    skos:scopeNote "Value type: enumeration (DATEX II Facilities UserTypeEnum; external, out of scope — code values not modelled). Multi-valued." ;
    dcterms:source "DATEX II EnergyInfrastructureSite.preferredUsers (fac:_UserTypeEnum, DATEX II Facilities namespace); hub-curated SKOS rendering." .

# OWL enrichment note: object reference in DATEX II (DATEX II Location), same
# pattern as the pre-existing datex:entrance; modeled as owl:ObjectProperty
# with no invented rdfs:range (out of scope, see TERMS.md).
datex:exit a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureSite ;
    skos:prefLabel "Exit"@en ;
    skos:definition "The geographic location of an exit from the site." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureSite ;
    skos:scopeNote "Value type: object reference (DATEX II Location; external, out of scope — see the pre-existing datex:entrance for the same pattern). Multi-valued." ;
    dcterms:source "DATEX II EnergyInfrastructureSite.exit; hub-curated SKOS rendering." .

datex:energyInfrastructureStation a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureSite ;
    skos:prefLabel "Energy infrastructure station (containment)"@en ;
    skos:definition "The energy infrastructure station(s) located on this site. The containment edge from Site down to Station." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureSite ;
    skos:scopeNote "Value type: object reference (DATEX II EnergyInfrastructureStation) — see the EnergyInfrastructureStation entity. Multi-valued." ;
    rdfs:range datex:EnergyInfrastructureStation ;
    dcterms:source "DATEX II EnergyInfrastructureSite.energyInfrastructureStation; hub-curated SKOS rendering." .

# --- EnergyInfrastructureStation: additional native attributes ---
# (separate statement -- the original skos:narrower block above is untouched)
datex:EnergyInfrastructureStation skos:narrower datex:numberOfRefillPoints , datex:refillPointByReference ,
    datex:userInterfaceLanguage , datex:energyDistributor , datex:stationServiceType , datex:refillPoint .

datex:numberOfRefillPoints a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureStation ;
    skos:prefLabel "Number of refill points"@en ;
    skos:definition "The number of refill points (e.g. charging points) available at the station." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureStation ;
    skos:scopeNote "Value type: xsd:nonNegativeInteger. DATEX II native type: NonNegativeInteger." ;
    rdfs:range xsd:nonNegativeInteger ;
    dcterms:source "DATEX II EnergyInfrastructureStation.numberOfRefillPoints; hub-curated SKOS rendering." .

datex:refillPointByReference a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureStation ;
    skos:prefLabel "Refill point (by reference)"@en ;
    skos:definition "A refill point of this station, referenced by identifier rather than embedded inline (e.g. one already published separately)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureStation ;
    skos:scopeNote "Value type: object reference (DATEX II VersionedReference targeting a RefillPoint) — see the RefillPoint entity. Multi-valued." ;
    rdfs:range datex:RefillPoint ;
    dcterms:source "DATEX II EnergyInfrastructureStation.refillPointByReference; hub-curated SKOS rendering." .

datex:userInterfaceLanguage a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureStation ;
    skos:prefLabel "User interface language"@en ;
    skos:definition "A language supported by the station's user interface / payment terminal." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureStation ;
    skos:scopeNote "Value type: xsd:language. DATEX II native type: Language (ISO 639-1 code). Multi-valued." ;
    rdfs:range xsd:language ;
    dcterms:source "DATEX II EnergyInfrastructureStation.userInterfaceLanguage; hub-curated SKOS rendering." .

# OWL enrichment note: object reference in DATEX II (DATEX II Organisation),
# same pattern as the pre-existing datex:energyProvider; modeled as
# owl:ObjectProperty with no invented rdfs:range (out of scope, see TERMS.md).
datex:energyDistributor a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureStation ;
    skos:prefLabel "Energy distributor"@en ;
    skos:definition "The organisation distributing the energy at the station (as distinct from the energy provider/producer)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureStation ;
    skos:scopeNote "Value type: object reference (DATEX II Organisation; external, out of scope — same pattern as the pre-existing datex:energyProvider)." ;
    dcterms:source "DATEX II EnergyInfrastructureStation.energyDistributor; hub-curated SKOS rendering." .

# Naming note: DATEX II's native element name is "serviceType", reused
# across EnergyInfrastructureStation, RefillPoint and ServiceType's own
# scalar field; disambiguated here as "stationServiceType" (this attribute)
# vs. datex:serviceType (RefillPoint's own attribute of the same native
# name) vs. datex:serviceTypeCode (ServiceType's own enumeration field).
datex:stationServiceType a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureStation ;
    skos:prefLabel "Station service type"@en ;
    skos:definition "The way the station's refill points are serviced (full service, self-service, or unattended)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureStation ;
    skos:scopeNote "Value type: object reference (DATEX II ServiceType) — see the ServiceType entity." ;
    rdfs:range datex:ServiceType ;
    dcterms:source "DATEX II EnergyInfrastructureStation.serviceType; hub-curated SKOS rendering." .

datex:refillPoint a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureStation ;
    skos:prefLabel "Refill point (containment)"@en ;
    skos:definition "A refill point of this station, embedded inline. The containment edge from Station down to RefillPoint (and its specialisations, e.g. ElectricVehicleChargingPoint)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureStation ;
    skos:scopeNote "Value type: object reference (DATEX II RefillPoint) — see the RefillPoint entity and its specialisations. Multi-valued." ;
    rdfs:range datex:RefillPoint ;
    dcterms:source "DATEX II EnergyInfrastructureStation.refillPoint; hub-curated SKOS rendering." .

