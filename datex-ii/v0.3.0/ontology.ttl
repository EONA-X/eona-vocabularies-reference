# Hub-curated SKOS rendering of the DATEX II EnergyInfrastructure model.
#
# DATEX II is published natively as XML Schema (XSD) — there is no clean,
# canonical RDF/SKOS serialisation of its data model to mirror. The EONA-X
# vocabulary hub therefore curates a SKOS ConceptScheme covering the
# EnergyInfrastructure EV-charging (IRVE) terms the EMDS demo needs, modelled
# so it is both browsable in Prez and alignable by the later crosswalk (#446).
#
# Faithfulness: classes, attributes, attribute value types and enumeration code
# values below are taken from the DATEX II v3.7 EnergyInfrastructure namespace
# (DATEXII_3_EnergyInfrastructure.xsd). The exact native DATEX II enumeration
# literal for each "Code value" concept is preserved in skos:notation.
#
# UI/type encoding (Prez renders these annotations as fields):
#   * dcterms:type  "Entity" | "Attribute" | "Code value"  (plain string)
#   * skos:scopeNote "Value type: ..."                      (human-readable)
#   * rdfs:range     <xsd type>            for fixed-datatype attributes
#   * rdfs:range     <enum/entity concept> for enumeration- or reference-valued
#                    attributes (the attribute concept doubles as its own
#                    enumeration root; its code values are skos:narrower).
#
# Hierarchy: entity classes are skos:topConcept of the scheme; attributes are
# skos:broader their entity; enumeration code values are skos:broader their
# attribute. skos:narrower inverses are stated explicitly (no inference).
#
# Loaded (local=True) into its own named graph:
#   https://eona-x.eu/ontology/datex-ii/v0.3.0#
# The scheme IRI doubles as the OGC Records collection so Prez lists the
# concepts below as `items` under it.

@prefix datex: <https://eona-x.eu/ontology/datex-ii/v0.3.0#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# --- Ontology header: version + provenance -------------------------------
<https://eona-x.eu/ontology/datex-ii/v0.3.0#> a owl:Ontology ;
    dcterms:title "DATEX II EnergyInfrastructure — EV-charging subset (EONA-X hub-curated)" ;
    dcterms:description "Hub-curated SKOS rendering of the DATEX II EnergyInfrastructure model, scoped to EV charging (IRVE) for the EMDS demo: entities, attributes, attribute value types and enumeration code values." ;
    dcterms:source "DATEX II v3.7 EnergyInfrastructure namespace (DATEXII_3_EnergyInfrastructure.xsd, https://docs.datex2.eu/v3.7/energy/) — natively XSD; this is a curated SKOS rendering. Enumeration literals preserved in skos:notation." ;
    dcterms:creator "EONA-X Vocabulary Hub" ;
    dcterms:created "2026-06-22"^^xsd:date ;
    dcterms:modified "2026-08-18"^^xsd:date ;
    owl:versionInfo "0.3.0" ;
    rdfs:label "DATEX II EnergyInfrastructure — EV-charging subset" .

# --- ConceptScheme --------------------------------------------------------
datex:energy-infrastructure a skos:ConceptScheme ;
    dcterms:title "DATEX II — EnergyInfrastructure (EV-charging subset)" ;
    rdfs:label "DATEX II — EnergyInfrastructure (EV-charging subset)" ;
    dcterms:description "EV-charging (IRVE) terms curated from the DATEX II EnergyInfrastructure model for the EMDS demo. Entities, their attributes, attribute value types and enumeration code values." ;
    dcterms:source "Hub-curated SKOS rendering of the natively-XSD DATEX II v3.7 EnergyInfrastructure model." ;
    skos:hasTopConcept datex:EnergyInfrastructureSite ;
    skos:hasTopConcept datex:EnergyInfrastructureStation ;
    skos:hasTopConcept datex:ElectricVehicleChargingPoint ;
    skos:hasTopConcept datex:Connector ;
    skos:hasTopConcept datex:ElectricEnergyMix .

# =========================================================================
# ENTITY: EnergyInfrastructureSite
# =========================================================================
datex:EnergyInfrastructureSite a skos:Concept, owl:Class ;
    skos:inScheme datex:energy-infrastructure ;
    skos:topConceptOf datex:energy-infrastructure ;
    skos:prefLabel "Energy infrastructure site"@en ;
    skos:definition "A site where vehicles can be supplied with energy, including all buildings, stations, parking spaces and associated services. Contains one or more energy infrastructure stations." ;
    dcterms:type "Entity" ;
    dcterms:source "DATEX II EnergyInfrastructure: EnergyInfrastructureSite (extends Facility); hub-curated SKOS rendering." ;
    skos:narrower datex:brand ;
    skos:narrower datex:entrance ;
    skos:narrower datex:operatingHours .

datex:brand a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureSite ;
    skos:prefLabel "Brand"@en ;
    skos:definition "The commercial brand of the energy infrastructure site." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureSite ;
    skos:scopeNote "Value type: xsd:string. DATEX II native type: MultilingualString." ;
    rdfs:range xsd:string ;
    dcterms:source "DATEX II EnergyInfrastructureSite.brand; hub-curated SKOS rendering." .

# OWL enrichment note: object reference in DATEX II (DATEX II Location); modeled
# as owl:ObjectProperty even though the referenced type is out of scope
# for this hub-curated subset and has no rdfs:range here (see TERMS.md).
datex:entrance a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureSite ;
    skos:prefLabel "Entrance"@en ;
    skos:definition "The geographic location of an entrance to the site." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureSite ;
    skos:scopeNote "Value type: object reference (DATEX II Location)." ;
    dcterms:source "DATEX II EnergyInfrastructureSite.entrance; hub-curated SKOS rendering." .

# OWL enrichment note: object reference in DATEX II (DATEX II OperatingHours / OverallPeriod); modeled
# as owl:ObjectProperty even though the referenced type is out of scope
# for this hub-curated subset and has no rdfs:range here (see TERMS.md).
datex:operatingHours a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureSite ;
    skos:prefLabel "Operating hours"@en ;
    skos:definition "The opening / operating hours during which the site is accessible." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureSite ;
    skos:scopeNote "Value type: object reference (DATEX II OperatingHours / OverallPeriod), inherited from Facility." ;
    dcterms:source "DATEX II Facility.operatingHours (inherited by EnergyInfrastructureSite); hub-curated SKOS rendering." .

# =========================================================================
# ENTITY: EnergyInfrastructureStation
# =========================================================================
datex:EnergyInfrastructureStation a skos:Concept, owl:Class ;
    skos:inScheme datex:energy-infrastructure ;
    skos:topConceptOf datex:energy-infrastructure ;
    skos:prefLabel "Energy infrastructure station"@en ;
    skos:definition "A collection of associated refill points on a site (for EV charging, a charging station grouping one or more charging points). Often the vehicle space is shared between its refill points." ;
    dcterms:type "Entity" ;
    dcterms:source "DATEX II EnergyInfrastructure: EnergyInfrastructureStation (extends Facility); hub-curated SKOS rendering." ;
    skos:narrower datex:authenticationAndIdentificationMethods ;
    skos:narrower datex:energyProvider .

# OWL enrichment note: enumeration-valued attribute whose rdfs:range is its
# own IRI (self-referential enumeration root, per this file's existing
# convention). Modeled as owl:DatatypeProperty rather than owl:ObjectProperty
# because "Code value" concepts are kept as plain skos:Concept leaves, not
# owl:NamedIndividuals (see TERMS.md "OWL enrichment" section).
datex:authenticationAndIdentificationMethods a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureStation ;
    skos:prefLabel "Authentication and identification methods"@en ;
    skos:definition "The methods of identification and/or authentication accepted to start a charging session at the station." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureStation ;
    skos:scopeNote "Value type: enumeration (AuthenticationAndIdentificationEnum) — see narrower code values." ;
    rdfs:range datex:authenticationAndIdentificationMethods ;
    dcterms:source "DATEX II EnergyInfrastructureStation.authenticationAndIdentificationMethods; hub-curated SKOS rendering." ;
    skos:narrower datex:authMethod-rfid ;
    skos:narrower datex:authMethod-nfc ;
    skos:narrower datex:authMethod-creditCard ;
    skos:narrower datex:authMethod-debitCard ;
    skos:narrower datex:authMethod-cashPayment ;
    skos:narrower datex:authMethod-apps ;
    skos:narrower datex:authMethod-website ;
    skos:narrower datex:authMethod-prepaidCard ;
    skos:narrower datex:authMethod-unlimitedAccess ;
    skos:narrower datex:authMethod-noAccess .

datex:authMethod-rfid a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:authenticationAndIdentificationMethods ;
    skos:prefLabel "RFID"@en ;
    skos:definition "Identification by RFID token / charge card." ;
    dcterms:type "Code value" ;
    skos:notation "rfid" .

datex:authMethod-nfc a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:authenticationAndIdentificationMethods ;
    skos:prefLabel "NFC"@en ;
    skos:definition "Identification by Near Field Communication." ;
    dcterms:type "Code value" ;
    skos:notation "nfc" .

datex:authMethod-creditCard a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:authenticationAndIdentificationMethods ;
    skos:prefLabel "Credit card"@en ;
    skos:definition "Authentication / payment by credit card." ;
    dcterms:type "Code value" ;
    skos:notation "creditCard" .

datex:authMethod-debitCard a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:authenticationAndIdentificationMethods ;
    skos:prefLabel "Debit card"@en ;
    skos:definition "Authentication / payment by debit card." ;
    dcterms:type "Code value" ;
    skos:notation "debitCard" .

datex:authMethod-cashPayment a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:authenticationAndIdentificationMethods ;
    skos:prefLabel "Cash payment"@en ;
    skos:definition "Payment in cash." ;
    dcterms:type "Code value" ;
    skos:notation "cashPayment" .

datex:authMethod-apps a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:authenticationAndIdentificationMethods ;
    skos:prefLabel "Apps"@en ;
    skos:definition "Authentication via a mobile application." ;
    dcterms:type "Code value" ;
    skos:notation "apps" .

datex:authMethod-website a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:authenticationAndIdentificationMethods ;
    skos:prefLabel "Website"@en ;
    skos:definition "Authentication via a website." ;
    dcterms:type "Code value" ;
    skos:notation "website" .

datex:authMethod-prepaidCard a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:authenticationAndIdentificationMethods ;
    skos:prefLabel "Prepaid card"@en ;
    skos:definition "Authentication / payment by prepaid card." ;
    dcterms:type "Code value" ;
    skos:notation "prepaidCard" .

datex:authMethod-unlimitedAccess a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:authenticationAndIdentificationMethods ;
    skos:prefLabel "Unlimited access"@en ;
    skos:definition "Freely accessible; no authentication required." ;
    dcterms:type "Code value" ;
    skos:notation "unlimitedAccess" .

datex:authMethod-noAccess a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:authenticationAndIdentificationMethods ;
    skos:prefLabel "No access"@en ;
    skos:definition "Not accessible / no public access." ;
    dcterms:type "Code value" ;
    skos:notation "noAccess" .

# OWL enrichment note: object reference in DATEX II (DATEX II Organisation); modeled
# as owl:ObjectProperty even though the referenced type is out of scope
# for this hub-curated subset and has no rdfs:range here (see TERMS.md).
datex:energyProvider a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:EnergyInfrastructureStation ;
    skos:prefLabel "Energy provider"@en ;
    skos:definition "The organisation providing the energy delivered at the station." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:EnergyInfrastructureStation ;
    skos:scopeNote "Value type: object reference (DATEX II Organisation)." ;
    dcterms:source "DATEX II EnergyInfrastructureStation.energyProvider; hub-curated SKOS rendering." .

# =========================================================================
# ENTITY: ElectricVehicleChargingPoint  (DATEX II ElectricChargingPoint)
# =========================================================================
datex:ElectricVehicleChargingPoint a skos:Concept, owl:Class ;
    skos:inScheme datex:energy-infrastructure ;
    skos:topConceptOf datex:energy-infrastructure ;
    skos:prefLabel "Electric Vehicle Charging Point"@en ;
    skos:definition "Technical infrastructure at a specific location that facilitates electric charging of one vehicle at a time. A specialisation of the abstract RefillPoint." ;
    dcterms:type "Entity" ;
    dcterms:source "DATEX II EnergyInfrastructure: ElectricChargingPoint (a RefillPoint specialisation, extends Facility); hub-curated SKOS rendering." ;
    skos:narrower datex:status ;
    skos:narrower datex:power ;
    skos:narrower datex:availableChargingPower ;
    skos:narrower datex:availableVoltage ;
    skos:narrower datex:connector ;
    skos:narrower datex:electricEnergyMix ;
    skos:narrower datex:location .

# OWL enrichment note: enumeration-valued attribute whose rdfs:range is its
# own IRI (self-referential enumeration root, per this file's existing
# convention). Modeled as owl:DatatypeProperty rather than owl:ObjectProperty
# because "Code value" concepts are kept as plain skos:Concept leaves, not
# owl:NamedIndividuals (see TERMS.md "OWL enrichment" section).
datex:status a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricVehicleChargingPoint ;
    skos:prefLabel "Charging point status"@en ;
    skos:definition "Operational / availability status of an electric vehicle charging point (e.g. available, occupied, out of service)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricVehicleChargingPoint ;
    skos:scopeNote "Value type: enumeration — see narrower code values. Rendered from the DATEX II Facilities availability / OperatingStatus model; the code set is hub-curated to an OCPI-style status list." ;
    rdfs:range datex:status ;
    dcterms:source "DATEX II Facility availability / status (Facilities model); hub-curated SKOS rendering." ;
    skos:narrower datex:status-available ;
    skos:narrower datex:status-occupied ;
    skos:narrower datex:status-reserved ;
    skos:narrower datex:status-outOfService ;
    skos:narrower datex:status-unknown .

datex:status-available a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:status ;
    skos:prefLabel "Available"@en ;
    skos:definition "The charging point is operational and free to use." ;
    dcterms:type "Code value" ;
    skos:notation "available" .

datex:status-occupied a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:status ;
    skos:prefLabel "Occupied"@en ;
    skos:definition "The charging point is currently in use by a vehicle." ;
    dcterms:type "Code value" ;
    skos:notation "occupied" .

datex:status-reserved a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:status ;
    skos:prefLabel "Reserved"@en ;
    skos:definition "The charging point is reserved and not available for general use." ;
    dcterms:type "Code value" ;
    skos:notation "reserved" .

datex:status-outOfService a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:status ;
    skos:prefLabel "Out of service"@en ;
    skos:definition "The charging point is not operational (technical defect or maintenance)." ;
    dcterms:type "Code value" ;
    skos:notation "outOfService" .

datex:status-unknown a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:status ;
    skos:prefLabel "Unknown"@en ;
    skos:definition "The operational status of the charging point is unknown." ;
    dcterms:type "Code value" ;
    skos:notation "unknown" .

datex:power a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricVehicleChargingPoint ;
    skos:prefLabel "Rated power (kW)"@en ;
    skos:definition "The rated electrical power of the charging point, expressed in kilowatts." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricVehicleChargingPoint ;
    skos:scopeNote "Value type: xsd:decimal (kW). DATEX II native type: Watt (float), e.g. ElectricChargingPoint.availableChargingPower / Connector.maxPowerAtSocket." ;
    rdfs:range xsd:decimal ;
    dcterms:source "DATEX II ElectricChargingPoint power (availableChargingPower / Connector.maxPowerAtSocket); hub-curated SKOS rendering." .

datex:availableChargingPower a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricVehicleChargingPoint ;
    skos:prefLabel "Available charging power (kW)"@en ;
    skos:definition "A possible degree of charging power offered by the charging point. May be multi-valued (a charging point can support several power levels)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricVehicleChargingPoint ;
    skos:scopeNote "Value type: xsd:decimal (kW). DATEX II native type: Watt (float), multi-valued." ;
    rdfs:range xsd:decimal ;
    dcterms:source "DATEX II ElectricChargingPoint.availableChargingPower; hub-curated SKOS rendering." .

datex:availableVoltage a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricVehicleChargingPoint ;
    skos:prefLabel "Available voltage (V)"@en ;
    skos:definition "A possible degree of voltage offered by the charging point. May be multi-valued." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricVehicleChargingPoint ;
    skos:scopeNote "Value type: xsd:decimal (V). DATEX II native type: Volt (float), multi-valued." ;
    rdfs:range xsd:decimal ;
    dcterms:source "DATEX II ElectricChargingPoint.availableVoltage; hub-curated SKOS rendering." .

datex:connector a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricVehicleChargingPoint ;
    skos:prefLabel "Connector (charging interface)"@en ;
    skos:definition "A physical charging interface available at the charging point. A charging point may expose several connectors." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricVehicleChargingPoint ;
    skos:scopeNote "Value type: object reference (DATEX II Connector) — see the Connector entity. Multi-valued." ;
    rdfs:range datex:Connector ;
    dcterms:source "DATEX II ElectricChargingPoint.connector; hub-curated SKOS rendering." .

datex:electricEnergyMix a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricVehicleChargingPoint ;
    skos:prefLabel "Electric energy mix"@en ;
    skos:definition "The mix of energy sources of the electricity delivered at the charging point." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricVehicleChargingPoint ;
    skos:scopeNote "Value type: object reference (DATEX II ElectricEnergyMix) — see the Electric energy mix entity." ;
    rdfs:range datex:ElectricEnergyMix ;
    dcterms:source "DATEX II ElectricChargingPoint.electricEnergyMix; hub-curated SKOS rendering." .

# OWL enrichment note: object reference in DATEX II (DATEX II Location); modeled
# as owl:ObjectProperty even though the referenced type is out of scope
# for this hub-curated subset and has no rdfs:range here (see TERMS.md).
datex:location a skos:Concept, owl:ObjectProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:ElectricVehicleChargingPoint ;
    skos:prefLabel "Location (latitude/longitude)"@en ;
    skos:definition "The geographic location of the charging point, expressed as latitude and longitude coordinates." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:ElectricVehicleChargingPoint ;
    skos:scopeNote "Value type: object reference (DATEX II Location); coordinates expressed as xsd:decimal degrees (latitude/longitude). Inherited from Facility." ;
    dcterms:source "DATEX II Facility.location (inherited by RefillPoint/ElectricChargingPoint); hub-curated SKOS rendering." .

# =========================================================================
# ENTITY: Connector
# =========================================================================
datex:Connector a skos:Concept, owl:Class ;
    skos:inScheme datex:energy-infrastructure ;
    skos:topConceptOf datex:energy-infrastructure ;
    skos:prefLabel "Connector"@en ;
    skos:definition "Parameters and description of an interface available at an electric charging point to connect vehicles (the charging interface type and cable information)." ;
    dcterms:type "Entity" ;
    dcterms:source "DATEX II EnergyInfrastructure: Connector; hub-curated SKOS rendering." ;
    skos:narrower datex:connectorType ;
    skos:narrower datex:chargingMode ;
    skos:narrower datex:connectorFormat ;
    skos:narrower datex:maxPowerAtSocket ;
    skos:narrower datex:voltage ;
    skos:narrower datex:maximumCurrent .

# OWL enrichment note: enumeration-valued attribute whose rdfs:range is its
# own IRI (self-referential enumeration root, per this file's existing
# convention). Modeled as owl:DatatypeProperty rather than owl:ObjectProperty
# because "Code value" concepts are kept as plain skos:Concept leaves, not
# owl:NamedIndividuals (see TERMS.md "OWL enrichment" section).
datex:connectorType a skos:Concept, owl:DatatypeProperty ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:Connector ;
    skos:prefLabel "Connector type"@en ;
    skos:definition "The type of physical connector / charging interface offered (e.g. Type 2, CCS Combo 2, CHAdeMO)." ;
    dcterms:type "Attribute" ;
    rdfs:domain datex:Connector ;
    skos:scopeNote "Value type: enumeration (ConnectorTypeEnum) — see narrower code values. Required in DATEX II." ;
    rdfs:range datex:connectorType ;
    dcterms:source "DATEX II Connector.connectorType (ConnectorTypeEnum, per IEC 62196 / IEC 60309); hub-curated SKOS rendering." ;
    skos:narrower datex:connectorType-iec62196T2 ;
    skos:narrower datex:connectorType-iec62196T2COMBO ;
    skos:narrower datex:connectorType-iec62196T1 ;
    skos:narrower datex:connectorType-iec62196T1COMBO ;
    skos:narrower datex:connectorType-iec62196T3A ;
    skos:narrower datex:connectorType-iec62196T3C ;
    skos:narrower datex:connectorType-chademo ;
    skos:narrower datex:connectorType-yazaki ;
    skos:narrower datex:connectorType-domestic ;
    skos:narrower datex:connectorType-cee3 ;
    skos:narrower datex:connectorType-cee5 ;
    skos:narrower datex:connectorType-iec60309x2single16 ;
    skos:narrower datex:connectorType-iec60309x2three16 ;
    skos:narrower datex:connectorType-iec60309x2three32 ;
    skos:narrower datex:connectorType-iec60309x2three64 ;
    skos:narrower datex:connectorType-pantographBottomUp ;
    skos:narrower datex:connectorType-pantographTopDown ;
    skos:narrower datex:connectorType-teslaConnectorEurope ;
    skos:narrower datex:connectorType-teslaConnectorAmerica ;
    skos:narrower datex:connectorType-teslaR ;
    skos:narrower datex:connectorType-teslaS ;
    skos:narrower datex:connectorType-other .

datex:connectorType-iec62196T2 a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:connectorType ;
    skos:prefLabel "Type 2 / Mennekes (IEC 62196-2, AC)"@en ;
    skos:definition "IEC 62196 Type 2 AC connector (Mennekes), the European AC charging standard." ;
    dcterms:type "Code value" ;
    skos:notation "iec62196T2" .

datex:connectorType-iec62196T2COMBO a skos:Concept ;
    skos:inScheme datex:energy-infrastructure ;
    skos:broader datex:connectorType ;
    skos:prefLabel "CCS Combo 2 (IEC 62196-3, DC)"@en ;
    skos:definition "Combined Charging System Combo 2: Type 2 supplemented with two DC pins for DC fast charging." ;
    dcterms:type "Code value" ;
    skos:notation "iec62196T2COMBO" .

datex:connectorType-iec62196T1 a skos:Concept ;
