# Catalog fragment for the DATEX II EnergyInfrastructure subset.
#
# This does NOT redefine the whole catalog — the mobility pipeline's catalog.ttl
# already declares eona:catalog (dcat:Catalog) with its title/description. This
# fragment only MERGES additional triples into that single shared catalog via the
# default-graph union (rebuild_default_graph unions ALL named graphs):
#   - one extra dcterms:hasPart edge pointing at the DATEX II scheme, and
#   - the scheme's title/label so Prez renders it as a collection.
# The datex: vann prefix binding for Prez curie routing now lives in metadata.ttl
# (same target named graph, so the union sees it exactly as before).
# Loaded (local=True) into its own named graph:
#   https://vocab.eona-x.eu/catalog/datex-ii

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix eona: <https://vocab.eona-x.eu/> .
@prefix datex: <https://vocab.eona-x.eu/datex-ii/> .

# Merge the DATEX II scheme into the shared catalog as an additional member.
eona:catalog dcterms:hasPart datex:energy-infrastructure .

# Display title/label so Prez surfaces the scheme as a collection.
datex:energy-infrastructure a skos:ConceptScheme ;
    dcterms:title "DATEX II — EnergyInfrastructure (EV-charging subset)" ;
    rdfs:label "DATEX II — EnergyInfrastructure (EV-charging subset)" .
