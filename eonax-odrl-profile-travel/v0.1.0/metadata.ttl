<> a dcat:Dataset, adms:Asset ;
    dcat:version "0.1.0" ;
    dcterms:title "Eona-X ODRL Profile for Travel Data"@en ;
    dcterms:description "Extension of the Eona-X ODRL Profile v0.0.8 for personal travel data: purpose (DPV 2.3), personal-data category (DPV 2.3 and its pd extension), consent status and per-field scope. Authoring terms awaiting connector support: none is enforced."@en ;
