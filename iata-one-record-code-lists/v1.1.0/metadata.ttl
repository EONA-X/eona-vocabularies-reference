<> a dcat:Dataset, adms:Asset ;
    dcat:version "1.1.0" ;
    dcterms:title "ONE Record Code Lists Ontology"@en ;
    dcterms:description "ONE Record code lists, described using W3C RDF Schema and the Web Ontology Language. Imported by the ONE Record ontology."@en ;
    dcat:type assettype:c_89b4bdb7 ;
    adms:status status:CURRENT .

<> dcat:distribution [ a dcat:Distribution ; dcat:downloadURL <IATA-1R-CL-Ontology.ttl> ; dcat:mediaType "text/turtle" ] .

