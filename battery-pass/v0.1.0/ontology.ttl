# The Battery Passport Data Model
#
# OWL representation of the BatteryPass-Ready consortium's per-category JSON
# Schemas (EV, LMT, Industrial_Without_BMS, Other_Industrial_Above_2kWh,
# Stationary_Industrial_Above_2kWh) — the concrete, implementation-side data
# shape for a Battery Regulation (EU) 2023/1542 Digital Product Passport.
# Source: git.gefeg.com/bp/BatteryPassDataModel, BatteryPass-Ready/JSONSchemaFiles/*.json
# (public repository, no stated license — confirm reuse terms with GEFEG/the
# BatteryPass consortium before external/downstream publication).
#
# The 5 category schemas share one structure almost verbatim (same 7 content
# clusters, ~200 fields); this ontology merges them into a single TBox and
# records, per field, which of the 5 categories carry it via bp:applicableTo —
# mirroring pipelines/load-dpp/dpp.ttl's dpp:applicableTo pattern for its own,
# coarser 4-category split (that spreadsheet does not break out
# 'industrial battery without BMS' as its own column).
#
# Companion resource: pipelines/load-dpp/dpp.ttl models the same domain from
# the *regulation* side (the BatteryPass-Ready Data Attribute Longlist) — the
# two ontologies share the same 7 content-cluster names (see rdfs:seeAlso on
# each bp: section class below) but were generated independently and are not
# formally aligned (no owl:equivalentClass/Property claims).
#
# JSON Schema union types (object) become owl:Class; scalar fields become
# owl:DatatypeProperty; fields $ref-ing an enum or another object become
# owl:ObjectProperty. The recurring {value, unit} wrapper pattern (e.g.
# percent_decimal, kilowatthour_integer) collapses into one reusable
# bp:QuantityValue class instead of ~15 near-duplicate wrapper classes; the
# field's expected unit(s) are then recorded as a bp:unit annotation on that
# field. Each JSON Schema x-AccessRights extension becomes bp:readAccess /
# bp:writeAccess object properties onto a shared access-role codelist.

@base <https://vocabulary.eona-x.eu/ontology/battery-pass/v0.1.0#> .
@prefix bp: <https://vocabulary.eona-x.eu/ontology/battery-pass/v0.1.0#> .
@prefix dpp: <https://vocabulary.eona-x.eu/ontology/dpp/v0.1.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#  Ontology
#################################################################

bp:
    a owl:Ontology ;
    rdfs:label "Battery Passport Data Model"@en ;
    dct:title "Battery Passport Data Model"@en ;
    owl:versionInfo "0.1.0" ;
    dct:description "OWL transcription of the BatteryPass-Ready consortium's per-category JSON Schemas for a Battery Regulation (EU) 2023/1542 Digital Product Passport: the concrete data shape (classes, properties, units, access rights) implementing the requirements listed in the companion dpp: (Data Attribute Longlist) ontology."@en ;
    dct:source <https://git.gefeg.com/bp/BatteryPassDataModel/-/tree/main/BatteryPass-Ready/JSONSchemaFiles> ;
    rdfs:seeAlso <https://thebatterypass.eu/battery-pass-ready/resources/> .

#################################################################
#  Access-role codelist (from each field's x-AccessRights extension)
#################################################################

bp:AccessRoleCodes a skos:ConceptScheme ;
    skos:prefLabel "Access role"@en ;
    skos:hasTopConcept bp:PublicRole , bp:AuthoritiesRole , bp:CommissionRole , bp:NotifiedBodiesRole , bp:LegitimateInterestRole , bp:EconomicOperatorRole , bp:ThirdPartiesAuthorizedByEconomicOperatorRole .

bp:PublicRole a skos:Concept ;
    skos:inScheme bp:AccessRoleCodes ; skos:topConceptOf bp:AccessRoleCodes ;
    skos:prefLabel "Public"@en .

bp:AuthoritiesRole a skos:Concept ;
    skos:inScheme bp:AccessRoleCodes ; skos:topConceptOf bp:AccessRoleCodes ;
    skos:prefLabel "Market surveillance authorities"@en .

bp:CommissionRole a skos:Concept ;
    skos:inScheme bp:AccessRoleCodes ; skos:topConceptOf bp:AccessRoleCodes ;
    skos:prefLabel "European Commission"@en .

bp:NotifiedBodiesRole a skos:Concept ;
    skos:inScheme bp:AccessRoleCodes ; skos:topConceptOf bp:AccessRoleCodes ;
    skos:prefLabel "Notified bodies"@en .

bp:LegitimateInterestRole a skos:Concept ;
    skos:inScheme bp:AccessRoleCodes ; skos:topConceptOf bp:AccessRoleCodes ;
    skos:prefLabel "Persons with a legitimate interest"@en .

bp:EconomicOperatorRole a skos:Concept ;
    skos:inScheme bp:AccessRoleCodes ; skos:topConceptOf bp:AccessRoleCodes ;
    skos:prefLabel "Economic operator"@en .

bp:ThirdPartiesAuthorizedByEconomicOperatorRole a skos:Concept ;
    skos:inScheme bp:AccessRoleCodes ; skos:topConceptOf bp:AccessRoleCodes ;
    skos:prefLabel "Third parties authorised by the economic operator"@en .

bp:readAccess a owl:ObjectProperty ;
    rdfs:label "read access"@en ; rdfs:range bp:AccessRoleCodes ;
    rdfs:comment "Roles allowed to read this field (x-AccessRights.read in the source JSON Schema)."@en .

bp:writeAccess a owl:ObjectProperty ;
    rdfs:label "write access"@en ; rdfs:range bp:AccessRoleCodes ;
    rdfs:comment "Roles allowed to write this field (x-AccessRights.write in the source JSON Schema)."@en .

#################################################################
#  Battery category codelist
#################################################################

bp:BatteryCategoryCodes a skos:ConceptScheme ;
    skos:prefLabel "Battery category"@en ;
    skos:definition "The 5 BatteryPass-Ready battery categories, one per source JSON Schema file."@en ;
    skos:hasTopConcept bp:EV , bp:LMT , bp:IndustrialWithoutBMS , bp:OtherIndustrialAbove2kWh , bp:StationaryIndustrialAbove2kWh .

bp:EV a skos:Concept ;
    skos:inScheme bp:BatteryCategoryCodes ; skos:topConceptOf bp:BatteryCategoryCodes ;
    skos:prefLabel "electric vehicle battery"@en .

bp:LMT a skos:Concept ;
    skos:inScheme bp:BatteryCategoryCodes ; skos:topConceptOf bp:BatteryCategoryCodes ;
    skos:prefLabel "LMT battery"@en .

bp:IndustrialWithoutBMS a skos:Concept ;
    skos:inScheme bp:BatteryCategoryCodes ; skos:topConceptOf bp:BatteryCategoryCodes ;
    skos:prefLabel "industrial battery without BMS"@en .

bp:OtherIndustrialAbove2kWh a skos:Concept ;
    skos:inScheme bp:BatteryCategoryCodes ; skos:topConceptOf bp:BatteryCategoryCodes ;
    skos:prefLabel "industrial/non-stationary battery"@en .

bp:StationaryIndustrialAbove2kWh a skos:Concept ;
    skos:inScheme bp:BatteryCategoryCodes ; skos:topConceptOf bp:BatteryCategoryCodes ;
    skos:prefLabel "industrial/stationary battery"@en .

bp:applicableTo a owl:ObjectProperty ;
    rdfs:label "applicable to"@en ; rdfs:range bp:BatteryCategoryCodes ;
    rdfs:comment "Battery categories whose JSON Schema defines this field (fields absent from a category's schema are omitted here, e.g. most self-discharge-rate fields only exist for LMT/StationaryIndustrialAbove2kWh, and most BMS-derived monitoring fields are absent from IndustrialWithoutBMS)."@en .

#################################################################
#  Unit of measure codelist (folds ~15 {value,unit} wrapper defs into one)
#################################################################

bp:UnitOfMeasureCodes a skos:ConceptScheme ;
    skos:prefLabel "Unit of measure"@en ;
    skos:hasTopConcept bp:UnitPercent , bp:UnitPercentPerMonth , bp:UnitAmperePerAmpereHour , bp:UnitAmpereHour , bp:UnitOhm , bp:UnitVolt , bp:UnitWatt , bp:UnitWattPerWattHour , bp:UnitGram , bp:UnitKilowattHour , bp:UnitKilogram , bp:UnitKgCO2Equivalent , bp:UnitKgCO2EquivalentPerKilowattHour , bp:UnitMilliampereHour , bp:UnitDegreeCelsius .

bp:UnitPercent a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "%"@en .

bp:UnitPercentPerMonth a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "%/month"@en .

bp:UnitAmperePerAmpereHour a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "A/Ah"@en .

bp:UnitAmpereHour a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "Ah"@en .

bp:UnitOhm a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "Ohm"@en .

bp:UnitVolt a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "V"@en .

bp:UnitWatt a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "W"@en .

bp:UnitWattPerWattHour a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "W/Wh"@en .

bp:UnitGram a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "g"@en .

bp:UnitKilowattHour a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "kWh"@en .

bp:UnitKilogram a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "kg"@en .

bp:UnitKgCO2Equivalent a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "kgCO2-eq"@en .

bp:UnitKgCO2EquivalentPerKilowattHour a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "kgCO2-eq/kWh"@en .

bp:UnitMilliampereHour a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "mAh"@en .

bp:UnitDegreeCelsius a skos:Concept ;
    skos:inScheme bp:UnitOfMeasureCodes ; skos:topConceptOf bp:UnitOfMeasureCodes ;
    skos:prefLabel "°C"@en .

bp:QuantityValue a owl:Class ;
    rdfs:label "Quantity value"@en ;
    rdfs:comment "Generic {numeric value, unit} pair, reused for every physical-quantity field. Collapses the source schemas' ~15 near-duplicate wrapper types (percent_decimal, kilowatthour_integer, ohm_integer, ...) into one class; the specific unit(s) a given field is expressed in are recorded as a bp:unit annotation on that field, not here."@en .

bp:numericValue a owl:DatatypeProperty ;
    rdfs:domain bp:QuantityValue ; rdfs:range xsd:decimal ;
    rdfs:label "numeric value"@en .

bp:unitOfMeasure a owl:ObjectProperty ;
    rdfs:domain bp:QuantityValue ; rdfs:range bp:UnitOfMeasureCodes ;
    rdfs:label "unit of measure"@en .

bp:unit a owl:AnnotationProperty ;
    rdfs:label "unit"@en ;
    rdfs:comment "The unit(s) a bp:QuantityValue-ranged field is expressed in, per its source wrapper type's unit-sign enum, e.g. \"kWh\" or \"Ah or mAh\"."@en .

#################################################################
#  Custom chemical codes (varies by category — IndustrialWithoutBMS is Pb-only)
#################################################################

bp:CustomChemicalCodes a skos:ConceptScheme ;
    skos:prefLabel "Custom chemical code"@en ;
    skos:hasTopConcept bp:ChemistryLiIonLCO , bp:ChemistryLiIonLFP , bp:ChemistryLiIonLMO , bp:ChemistryLiIonNCA , bp:ChemistryLiIonNMC , bp:ChemistryLiMetal , bp:ChemistryNaIon , bp:ChemistryNiCd , bp:ChemistryNiMH , bp:ChemistryPb .

bp:ChemistryLiIonLCO a skos:Concept ;
    skos:inScheme bp:CustomChemicalCodes ; skos:topConceptOf bp:CustomChemicalCodes ;
    skos:prefLabel "Li-ion LCO"@en ;
    bp:applicableTo bp:EV, bp:LMT, bp:OtherIndustrialAbove2kWh, bp:StationaryIndustrialAbove2kWh .

bp:ChemistryLiIonLFP a skos:Concept ;
    skos:inScheme bp:CustomChemicalCodes ; skos:topConceptOf bp:CustomChemicalCodes ;
    skos:prefLabel "Li-ion LFP"@en ;
    bp:applicableTo bp:EV, bp:LMT, bp:OtherIndustrialAbove2kWh, bp:StationaryIndustrialAbove2kWh .

bp:ChemistryLiIonLMO a skos:Concept ;
    skos:inScheme bp:CustomChemicalCodes ; skos:topConceptOf bp:CustomChemicalCodes ;
    skos:prefLabel "Li-ion LMO"@en ;
    bp:applicableTo bp:EV, bp:LMT, bp:OtherIndustrialAbove2kWh, bp:StationaryIndustrialAbove2kWh .

bp:ChemistryLiIonNCA a skos:Concept ;
    skos:inScheme bp:CustomChemicalCodes ; skos:topConceptOf bp:CustomChemicalCodes ;
    skos:prefLabel "Li-ion NCA"@en ;
    bp:applicableTo bp:EV, bp:LMT, bp:OtherIndustrialAbove2kWh, bp:StationaryIndustrialAbove2kWh .

bp:ChemistryLiIonNMC a skos:Concept ;
    skos:inScheme bp:CustomChemicalCodes ; skos:topConceptOf bp:CustomChemicalCodes ;
    skos:prefLabel "Li-ion NMC"@en ;
    bp:applicableTo bp:EV, bp:LMT, bp:OtherIndustrialAbove2kWh, bp:StationaryIndustrialAbove2kWh .

bp:ChemistryLiMetal a skos:Concept ;
    skos:inScheme bp:CustomChemicalCodes ; skos:topConceptOf bp:CustomChemicalCodes ;
    skos:prefLabel "Li-metal"@en ;
    bp:applicableTo bp:EV, bp:LMT, bp:OtherIndustrialAbove2kWh, bp:StationaryIndustrialAbove2kWh .

bp:ChemistryNaIon a skos:Concept ;
    skos:inScheme bp:CustomChemicalCodes ; skos:topConceptOf bp:CustomChemicalCodes ;
    skos:prefLabel "Na-ion"@en ;
    bp:applicableTo bp:EV, bp:LMT, bp:OtherIndustrialAbove2kWh, bp:StationaryIndustrialAbove2kWh .

bp:ChemistryNiCd a skos:Concept ;
    skos:inScheme bp:CustomChemicalCodes ; skos:topConceptOf bp:CustomChemicalCodes ;
    skos:prefLabel "Ni-Cd"@en ;
    bp:applicableTo bp:EV, bp:LMT, bp:OtherIndustrialAbove2kWh, bp:StationaryIndustrialAbove2kWh .

bp:ChemistryNiMH a skos:Concept ;
    skos:inScheme bp:CustomChemicalCodes ; skos:topConceptOf bp:CustomChemicalCodes ;
    skos:prefLabel "Ni-MH"@en ;
    bp:applicableTo bp:EV, bp:LMT, bp:OtherIndustrialAbove2kWh, bp:StationaryIndustrialAbove2kWh .

bp:ChemistryPb a skos:Concept ;
    skos:inScheme bp:CustomChemicalCodes ; skos:topConceptOf bp:CustomChemicalCodes ;
    skos:prefLabel "Pb"@en ;
    bp:applicableTo bp:EV, bp:LMT, bp:IndustrialWithoutBMS, bp:OtherIndustrialAbove2kWh, bp:StationaryIndustrialAbove2kWh .

#################################################################
#  Battery status codelist
#################################################################

bp:BatteryStatusCodes a skos:ConceptScheme ;
    skos:prefLabel "Battery status"@en ;
    skos:hasTopConcept bp:BatteryStatusCodes_Original , bp:BatteryStatusCodes_ReUsed , bp:BatteryStatusCodes_Remanufactured , bp:BatteryStatusCodes_Repurposed , bp:BatteryStatusCodes_Waste .

bp:BatteryStatusCodes_Original a skos:Concept ;
    skos:inScheme bp:BatteryStatusCodes ; skos:topConceptOf bp:BatteryStatusCodes ;
    skos:prefLabel "original"@en .

bp:BatteryStatusCodes_ReUsed a skos:Concept ;
    skos:inScheme bp:BatteryStatusCodes ; skos:topConceptOf bp:BatteryStatusCodes ;
    skos:prefLabel "re-used"@en .

bp:BatteryStatusCodes_Remanufactured a skos:Concept ;
    skos:inScheme bp:BatteryStatusCodes ; skos:topConceptOf bp:BatteryStatusCodes ;
    skos:prefLabel "remanufactured"@en .

bp:BatteryStatusCodes_Repurposed a skos:Concept ;
    skos:inScheme bp:BatteryStatusCodes ; skos:topConceptOf bp:BatteryStatusCodes ;
    skos:prefLabel "repurposed"@en .

bp:BatteryStatusCodes_Waste a skos:Concept ;
    skos:inScheme bp:BatteryStatusCodes ; skos:topConceptOf bp:BatteryStatusCodes ;
    skos:prefLabel "waste"@en .

#################################################################
#  DPP status codelist
#################################################################

bp:DppStatusCodes a skos:ConceptScheme ;
    skos:prefLabel "DPP status"@en ;
    skos:hasTopConcept bp:DppStatusCodes_Active , bp:DppStatusCodes_Archived , bp:DppStatusCodes_Inactive , bp:DppStatusCodes_MarkedForDeletion .

bp:DppStatusCodes_Active a skos:Concept ;
    skos:inScheme bp:DppStatusCodes ; skos:topConceptOf bp:DppStatusCodes ;
    skos:prefLabel "Active"@en .

bp:DppStatusCodes_Archived a skos:Concept ;
    skos:inScheme bp:DppStatusCodes ; skos:topConceptOf bp:DppStatusCodes ;
    skos:prefLabel "Archived"@en .

bp:DppStatusCodes_Inactive a skos:Concept ;
    skos:inScheme bp:DppStatusCodes ; skos:topConceptOf bp:DppStatusCodes ;
    skos:prefLabel "Inactive"@en .

bp:DppStatusCodes_MarkedForDeletion a skos:Concept ;
    skos:inScheme bp:DppStatusCodes ; skos:topConceptOf bp:DppStatusCodes ;
    skos:prefLabel "Marked-for-deletion"@en .

#################################################################
#  Root class + the 7 content-cluster classes
#################################################################

bp:BatteryPassport a owl:Class ;
    rdfs:label "Battery Passport"@en ;
    rdfs:comment "Root object of a battery Digital Product Passport instance, composed of the 7 BatteryPass-Ready content clusters below."@en .

bp:hasSymbolsLabelsAndDocumentationOfConformity a owl:ObjectProperty ;
    rdfs:domain bp:BatteryPassport ; rdfs:range bp:SymbolsLabelsAndDocumentationOfConformity ;
    rdfs:label "Symbols Labels And Documentation Of Conformity"@en .

bp:hasSupplyChainDueDiligence a owl:ObjectProperty ;
    rdfs:domain bp:BatteryPassport ; rdfs:range bp:SupplyChainDueDiligence ;
    rdfs:label "Supply Chain Due Diligence"@en .

bp:hasPerformanceAndDurability a owl:ObjectProperty ;
    rdfs:domain bp:BatteryPassport ; rdfs:range bp:PerformanceAndDurability ;
    rdfs:label "Performance And Durability"@en .

bp:hasIdentifiersAndProductData a owl:ObjectProperty ;
    rdfs:domain bp:BatteryPassport ; rdfs:range bp:IdentifiersAndProductData ;
    rdfs:label "Identifiers And Product Data"@en .

bp:hasCircularityAndResourceEfficiency a owl:ObjectProperty ;
    rdfs:domain bp:BatteryPassport ; rdfs:range bp:CircularityAndResourceEfficiency ;
    rdfs:label "Circularity And Resource Efficiency"@en .

bp:hasBatteryMaterialsAndComposition a owl:ObjectProperty ;
    rdfs:domain bp:BatteryPassport ; rdfs:range bp:BatteryMaterialsAndComposition ;
    rdfs:label "Battery Materials And Composition"@en .

bp:hasBatteryCarbonFootprint a owl:ObjectProperty ;
    rdfs:domain bp:BatteryPassport ; rdfs:range bp:BatteryCarbonFootprint ;
    rdfs:label "Battery Carbon Footprint"@en .

bp:SymbolsLabelsAndDocumentationOfConformity a owl:Class ;
    rdfs:label "Symbols Labels And Documentation Of Conformity"@en ;
    rdfs:seeAlso dpp:SymbolsLabelsAndDocumentationOfConformity .

bp:separateCollectionSymbol
    a owl:DatatypeProperty
    ; rdfs:domain bp:SymbolsLabelsAndDocumentationOfConformity
    ; rdfs:range xsd:anyURI
    ; rdfs:label "SeparateCollectionSymbol"@en
    ; bp:readAccess bp:PublicRole
    ; bp:writeAccess bp:EconomicOperatorRole .

bp:symbolsForCadmiumAndLead
    a owl:DatatypeProperty
    ; rdfs:domain bp:SymbolsLabelsAndDocumentationOfConformity
    ; rdfs:range xsd:anyURI
    ; rdfs:label "SymbolsForCadmiumAndLead"@en
    ; bp:readAccess bp:PublicRole
    ; bp:writeAccess bp:EconomicOperatorRole .

bp:carbonFootprintLabel
    a owl:DatatypeProperty
    ; rdfs:domain bp:SymbolsLabelsAndDocumentationOfConformity
    ; rdfs:range xsd:anyURI
    ; rdfs:label "CarbonFootprintLabel"@en
    ; bp:readAccess bp:PublicRole
    ; bp:writeAccess bp:EconomicOperatorRole .

bp:SymbolsLabelsAndDocumentationOfConformity_extinguishingAgent
    a owl:ObjectProperty
    ; rdfs:domain bp:SymbolsLabelsAndDocumentationOfConformity
    ; rdfs:range bp:ExtinguishingAgent
    ; rdfs:label "ExtinguishingAgent"@en
    ; bp:readAccess bp:PublicRole
    ; bp:writeAccess bp:EconomicOperatorRole .

bp:meaningOfLabelsAndSymbols
    a owl:DatatypeProperty
    ; rdfs:domain bp:SymbolsLabelsAndDocumentationOfConformity
    ; rdfs:range xsd:string
    ; rdfs:label "MeaningOfLabelsAndSymbols"@en
    ; bp:readAccess bp:PublicRole
    ; bp:writeAccess bp:EconomicOperatorRole .

bp:euDeclarationOfConformity
    a owl:DatatypeProperty
    ; rdfs:domain bp:SymbolsLabelsAndDocumentationOfConformity
    ; rdfs:range xsd:anyURI
    ; rdfs:label "EUDeclarationOfConformity"@en
    ; bp:readAccess bp:PublicRole
    ; bp:writeAccess bp:EconomicOperatorRole .

bp:resultsOfTestReportsProvingCompliance
    a owl:DatatypeProperty
    ; rdfs:domain bp:SymbolsLabelsAndDocumentationOfConformity
    ; rdfs:range xsd:anyURI
    ; rdfs:label "ResultsOfTestReportsProvingCompliance"@en
    ; bp:readAccess bp:NotifiedBodiesRole, bp:AuthoritiesRole, bp:CommissionRole
    ; bp:writeAccess bp:EconomicOperatorRole .

bp:SupplyChainDueDiligence a owl:Class ;
    rdfs:label "Supply Chain Due Diligence"@en ;
    rdfs:seeAlso dpp:SupplyChainDueDiligence .

bp:informationOfDueDiligenceReport
    a owl:DatatypeProperty
    ; rdfs:domain bp:SupplyChainDueDiligence
    ; rdfs:range xsd:anyURI
    ; rdfs:label "InformationOfDueDiligenceReport"@en
    ; bp:readAccess bp:PublicRole
    ; bp:writeAccess bp:EconomicOperatorRole .

bp:thirdPartyAssurancesOfRecognisedSchemes
    a owl:DatatypeProperty
    ; rdfs:domain bp:SupplyChainDueDiligence
    ; rdfs:range xsd:string
    ; rdfs:label "ThirdPartyAssurancesOfRecognisedSchemes"@en
    ; bp:readAccess bp:PublicRole
    ; bp:writeAccess bp:EconomicOperatorRole .

bp:supplyChainIndices
    a owl:DatatypeProperty
    ; rdfs:domain bp:SupplyChainDueDiligence
    ; rdfs:range xsd:string
    ; rdfs:label "SupplyChainIndices"@en
    ; bp:readAccess bp:PublicRole
    ; bp:writeAccess bp:EconomicOperatorRole .

bp:PerformanceAndDurability a owl:Class ;
    rdfs:label "Performance And Durability"@en ;
    rdfs:seeAlso dpp:PerformanceAndDurability .

bp:ratedCapacity
    a owl:ObjectProperty
    ; rdfs:domain bp:PerformanceAndDurability
    ; rdfs:range bp:QuantityValue
    ; bp:unit "Ah or mAh"
    ; rdfs:label "RatedCapacity"@en
    ; bp:readAccess bp:PublicRole
    ; bp:writeAccess bp:EconomicOperatorRole .

bp:remainingCapacity
    a owl:ObjectProperty
    ; rdfs:domain bp:PerformanceAndDurability
    ; rdfs:range bp:QuantityValue
    ; bp:unit "Ah or mAh"
    ; rdfs:label "RemainingCapacity"@en
    ; bp:applicableTo bp:EV, bp:LMT, bp:OtherIndustrialAbove2kWh, bp:StationaryIndustrialAbove2kWh
    ; bp:readAccess bp:LegitimateInterestRole
    ; bp:writeAccess bp:EconomicOperatorRole, bp:ThirdPartiesAuthorizedByEconomicOperatorRole .

bp:capacityFade
    a owl:ObjectProperty
    ; rdfs:domain bp:PerformanceAndDurability
    ; rdfs:range bp:QuantityValue
    ; bp:unit "%"
    ; rdfs:label "CapacityFade"@en
    ; bp:readAccess bp:LegitimateInterestRole
    ; bp:writeAccess bp:EconomicOperatorRole, bp:ThirdPartiesAuthorizedByEconomicOperatorRole .

bp:certifiedUsableBatteryEnergy
    a owl:ObjectProperty
    ; rdfs:domain bp:PerformanceAndDurability
    ; rdfs:range bp:QuantityValue
    ; bp:unit "kWh"
    ; rdfs:label "CertifiedUsableBatteryEnergy"@en
    ; bp:applicableTo bp:EV
    ; bp:readAccess bp:PublicRole
    ; bp:writeAccess bp:EconomicOperatorRole .

bp:remainingUsableBatteryEnergy
    a owl:ObjectProperty
    ; rdfs:domain bp:PerformanceAndDurability
    ; rdfs:range bp:QuantityValue
    ; bp:unit "kWh"
    ; rdfs:label "RemainingUsableBatteryEnergy"@en
    ; bp:applicableTo bp:EV
    ; bp:readAccess bp:LegitimateInterestRole
    ; bp:writeAccess bp:EconomicOperatorRole, bp:ThirdPartiesAuthorizedByEconomicOperatorRole .

bp:stateOfCertifiedEnergySOCE
    a owl:ObjectProperty
    ; rdfs:domain bp:PerformanceAndDurability
    ; rdfs:range bp:QuantityValue
    ; bp:unit "%"
    ; rdfs:label "StateOfCertifiedEnergySOCE"@en
    ; bp:applicableTo bp:EV
