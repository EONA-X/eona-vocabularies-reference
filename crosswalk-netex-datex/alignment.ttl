# Hub-curated NeTEx <-> DATEX II crosswalk (alignment graph) for the EV-charging
# (IRVE) domain — the EMDS demo "passerelle" (demo point C, issue #446).
#
# This graph holds ONLY alignment statements between the existing DATEX II
# (#433) and NeTEx (#445) EV-charging concepts. It does NOT redefine those
# concepts — they live in the datex/netex named graphs loaded by the sibling
# pipelines; here we only reference their IRIs.
#
# Loaded (local=True) into its own named graph:
#   https://eona-x.eu/crosswalk/netex-datex/v0.1.0#
#
# For each concept pair we assert a SKOS match triple in BOTH directions (SKOS
# match properties are symmetric; the reverse is asserted explicitly for
# robustness so plain — non-inferencing — SPARQL resolves either way). Each
# mapping carries per-mapping provenance + a closeness rationale via RDF
# reification (rdf:Statement). A graph-level alignment resource node carries
# dataset-level provenance and links back to the two schemes.
#
# Coverage tracks the enriched DATEX II / NeTEx subsets: the original 5 EV-charging
# pairs plus 4 added for the enriched terms (station, max power at socket, voltage,
# charging mode), 9 concept pairs in total, plus granular connector code-value
# (plug) alignments between the two connector enumerations.

@prefix align: <https://eona-x.eu/crosswalk/netex-datex/v0.1.0#> .
@prefix datex: <https://eona-x.eu/ontology/datex-ii/v0.3.0#> .
@prefix netex: <https://eona-x.eu/ontology/netex/v0.2.0#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# === Graph-level provenance: the alignment resource ========================
# Typed skos:ConceptScheme so Prez resolves it as a browsable vocabulary object
# (its concepts being the 5 mapping nodes below). It is ALSO void:Linkset (a set
# of links between two datasets) and dcat:Resource (so it surfaces as a member of
# eona:catalog).
#
# NB: do NOT type this node skos:Collection. Prez routes a skos:Collection at a
# different hierarchy level (concept collection WITHIN a vocab), so a catalog
# member also typed skos:Collection makes Prez's object endpoint return an empty
# body and the UI throws "Unable to find item". Verified against Prez 4.23.6.
<https://eona-x.eu/crosswalk/netex-datex/v0.1.0#>
    a skos:ConceptScheme , void:Linkset , dcat:Resource ;
    owl:versionInfo "0.1.0" ;
    dcterms:identifier "netex-datex-ii" ;
    dcterms:title "NeTEx ↔ DATEX II crosswalk (EV-charging)" ;
    rdfs:label "NeTEx ↔ DATEX II crosswalk (EV-charging)" ;
    dcterms:description "Hub-curated EV-charging (IRVE) crosswalk for the EMDS demo: SKOS alignment between the DATEX II EnergyInfrastructure subset (#433) and the NeTEx/Transmodel-style subset (#445), so a term in one vocabulary resolves to its counterpart in the other." ;
    dcterms:created "2026-06-22"^^xsd:date ;
    dcterms:modified "2026-06-26"^^xsd:date ;
    dcterms:creator "EONA-X Vocabulary Hub" ;
    dcterms:source "Hub-curated EV-charging crosswalk for the EMDS demo (demo point C); not derived from an upstream NeTEx/DATEX II distribution — DATEX II and NeTEx are published natively as XSD and carry no canonical cross-standard SKOS mapping." ;
    void:linkPredicate skos:exactMatch , skos:closeMatch , skos:relatedMatch ;
    rdfs:seeAlso <https://eona-x.eu/ontology/datex-ii/v0.3.0#energy-infrastructure> ,
                 <https://eona-x.eu/ontology/netex/v0.2.0#ev-charging> .

# === The 5 alignment mappings (both directions) ============================
# Pair 1: charging point/equipment — point vs equipment, hence closeMatch.
datex:ElectricVehicleChargingPoint skos:closeMatch netex:ElectricVehicleChargingEquipment .
netex:ElectricVehicleChargingEquipment skos:closeMatch datex:ElectricVehicleChargingPoint .

# Pair 2: status — both name operational availability, hence closeMatch.
datex:status skos:closeMatch netex:availabilityStatus .
netex:availabilityStatus skos:closeMatch datex:status .

# Pair 3: rated power (kW) — same quantity/units, hence exactMatch.
datex:power skos:exactMatch netex:powerRating .
netex:powerRating skos:exactMatch datex:power .

# Pair 4: connector — "type" vs "standard" framing, hence closeMatch.
datex:connectorType skos:closeMatch netex:connectorStandard .
netex:connectorStandard skos:closeMatch datex:connectorType .

# Pair 5: location — same geographic concept, hence exactMatch.
datex:location skos:exactMatch netex:location .
netex:location skos:exactMatch datex:location .

# Pair 6: station — DATEX II EnergyInfrastructureStation vs NeTEx RechargingStation,
# both the place grouping charging points/equipment, hence closeMatch.
datex:EnergyInfrastructureStation skos:closeMatch netex:RechargingStation .
netex:RechargingStation skos:closeMatch datex:EnergyInfrastructureStation .

# Pair 7: maximum power at socket — same quantity (max deliverable power) but DATEX
# II expresses kW and NeTEx W, so closeMatch rather than exactMatch.
datex:maxPowerAtSocket skos:closeMatch netex:maximumChargingPower .
netex:maximumChargingPower skos:closeMatch datex:maxPowerAtSocket .

# Pair 8: voltage — DATEX II "voltage" vs NeTEx "nominal voltage" of the equipment,
# closeMatch (near-equivalent, framing differs).
datex:voltage skos:closeMatch netex:nominalVoltage .
netex:nominalVoltage skos:closeMatch datex:voltage .

# Pair 9: charging mode vs current type — associative, not equivalence: DATEX II
# chargingMode (IEC 61851 modes 1-4) and NeTEx currentType (AC/DC) both characterise
# how charging is delivered but at different granularity, hence relatedMatch.
datex:chargingMode skos:relatedMatch netex:currentType .
netex:currentType skos:relatedMatch datex:chargingMode .

# === Connector code-value alignments (enum <-> enum) =======================
# Granular alignment between the DATEX II connectorType and NeTEx connectorStandard
# code values, so a specific plug in one vocabulary resolves to its counterpart in
# the other. exactMatch where the standard is identical (Type 1/2, CCS Combo 1/2,
# CHAdeMO); closeMatch where NeTEx collapses variants (Type 3A/3C -> type3) or the
# naming differs (Yazaki is a Type 1 / SAE J1772 implementation). Asserted both
# directions. Tesla and generic domestic plugs are intentionally left unmapped:
# NeTEx carries a single generic Tesla plug and region-specific domestic types
# (E/F/G/J) with no 1:1 DATEX II counterpart (see the note on align:map-connector).

datex:connectorType-iec62196T1 skos:exactMatch netex:connectorStandard-type1 .
netex:connectorStandard-type1 skos:exactMatch datex:connectorType-iec62196T1 .

datex:connectorType-iec62196T2 skos:exactMatch netex:connectorStandard-type2 .
netex:connectorStandard-type2 skos:exactMatch datex:connectorType-iec62196T2 .

datex:connectorType-iec62196T1COMBO skos:exactMatch netex:connectorStandard-ccsCombo1Plug .
netex:connectorStandard-ccsCombo1Plug skos:exactMatch datex:connectorType-iec62196T1COMBO .

datex:connectorType-iec62196T2COMBO skos:exactMatch netex:connectorStandard-ccsCombo2Plug .
netex:connectorStandard-ccsCombo2Plug skos:exactMatch datex:connectorType-iec62196T2COMBO .

datex:connectorType-chademo skos:exactMatch netex:connectorStandard-CHAdeMO .
netex:connectorStandard-CHAdeMO skos:exactMatch datex:connectorType-chademo .

datex:connectorType-iec62196T3C skos:closeMatch netex:connectorStandard-type3 .
netex:connectorStandard-type3 skos:closeMatch datex:connectorType-iec62196T3C .

datex:connectorType-iec62196T3A skos:closeMatch netex:connectorStandard-type3 .
netex:connectorStandard-type3 skos:closeMatch datex:connectorType-iec62196T3A .

datex:connectorType-yazaki skos:closeMatch netex:connectorStandard-type1 .
netex:connectorStandard-type1 skos:closeMatch datex:connectorType-yazaki .

# === Per-mapping provenance + closeness rationale (RDF reification) =========
# One rdf:Statement per pair (reifying the DATEX II -> NeTEx direction), with
# skos:note (closeness rationale), dcterms:source and dcterms:created. Reification
# is the most Oxigraph/Prez-compatible way to annotate a triple.
#
# Each mapping node is ALSO a skos:Concept skos:inScheme the alignment scheme, so
# Prez lists the correspondences as browsable `items` under the crosswalk and
# each opens a detail page (rationale via skos:note, the two aligned terms via
# rdf:subject / rdf:object).

align:map-charging-point a rdf:Statement , skos:Concept ;
    skos:inScheme <https://eona-x.eu/crosswalk/netex-datex/v0.1.0#> ;
    skos:prefLabel "Charging point ↔ charging equipment"@en ;
    rdf:subject datex:ElectricVehicleChargingPoint ;
    rdf:predicate skos:closeMatch ;
    rdf:object netex:ElectricVehicleChargingEquipment ;
    skos:note "closeMatch, not exactMatch: DATEX II models the single charging *point* whereas NeTEx models the charging *equipment* (the physical unit, which may expose several points); the concepts overlap closely but are not strictly equivalent." ;
    dcterms:source "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)" ;
    dcterms:created "2026-06-22"^^xsd:date .

align:map-status a rdf:Statement , skos:Concept ;
    skos:inScheme <https://eona-x.eu/crosswalk/netex-datex/v0.1.0#> ;
    skos:prefLabel "Status ↔ availability status"@en ;
    rdf:subject datex:status ;
    rdf:predicate skos:closeMatch ;
    rdf:object netex:availabilityStatus ;
    skos:note "closeMatch: both denote the operational availability status of the charging facility; DATEX II's status enumeration and NeTEx's availabilityStatus are not guaranteed value-for-value identical, so close rather than exact." ;
    dcterms:source "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)" ;
    dcterms:created "2026-06-22"^^xsd:date .

align:map-power a rdf:Statement , skos:Concept ;
    skos:inScheme <https://eona-x.eu/crosswalk/netex-datex/v0.1.0#> ;
    skos:prefLabel "Rated power ↔ power rating"@en ;
    rdf:subject datex:power ;
    rdf:predicate skos:exactMatch ;
    rdf:object netex:powerRating ;
    skos:note "exactMatch: both denote the rated electrical power of the charging facility in kilowatts (kW); same quantity and units, interchangeable." ;
    dcterms:source "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)" ;
    dcterms:created "2026-06-22"^^xsd:date .

align:map-connector a rdf:Statement , skos:Concept ;
    skos:inScheme <https://eona-x.eu/crosswalk/netex-datex/v0.1.0#> ;
    skos:prefLabel "Connector type ↔ connector standard"@en ;
    rdf:subject datex:connectorType ;
    rdf:predicate skos:closeMatch ;
    rdf:object netex:connectorStandard ;
    skos:note "closeMatch: DATEX II frames the connector as a 'type' and NeTEx as a 'standard'; the underlying enumerations (Type 2, CCS, CHAdeMO, ...) overlap heavily but the framings/value sets are not asserted identical, so close rather than exact. The individual code values are aligned one-by-one in the connector code-value block (exact/closeMatch); Tesla and generic domestic plugs have no 1:1 NeTEx counterpart and are left unmapped." ;
    dcterms:source "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)" ;
    dcterms:created "2026-06-22"^^xsd:date .

align:map-location a rdf:Statement , skos:Concept ;
    skos:inScheme <https://eona-x.eu/crosswalk/netex-datex/v0.1.0#> ;
    skos:prefLabel "Location ↔ location"@en ;
    rdf:subject datex:location ;
    rdf:predicate skos:exactMatch ;
    rdf:object netex:location ;
    skos:note "exactMatch: both denote the geographic location of the charging facility (latitude/longitude resp. Transmodel Point/Location); the same real-world concept, interchangeable." ;
    dcterms:source "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)" ;
    dcterms:created "2026-06-22"^^xsd:date .

align:map-station a rdf:Statement , skos:Concept ;
    skos:inScheme <https://eona-x.eu/crosswalk/netex-datex/v0.1.0#> ;
    skos:prefLabel "Station ↔ recharging station"@en ;
    rdf:subject datex:EnergyInfrastructureStation ;
    rdf:predicate skos:closeMatch ;
    rdf:object netex:RechargingStation ;
    skos:note "closeMatch: DATEX II EnergyInfrastructureStation and NeTEx RechargingStation both denote the place that groups the charging points/equipment of a site; near-equivalent groupings, not asserted strictly identical." ;
    dcterms:source "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)" ;
    dcterms:created "2026-06-26"^^xsd:date .

align:map-max-power a rdf:Statement , skos:Concept ;
    skos:inScheme <https://eona-x.eu/crosswalk/netex-datex/v0.1.0#> ;
    skos:prefLabel "Maximum power at socket ↔ maximum charging power"@en ;
    rdf:subject datex:maxPowerAtSocket ;
    rdf:predicate skos:closeMatch ;
    rdf:object netex:maximumChargingPower ;
    skos:note "closeMatch: both denote the maximum power the equipment can deliver, but DATEX II expresses it in kilowatts (kW) and NeTEx in watts (W); same quantity, different unit framing, so close rather than exact." ;
    dcterms:source "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)" ;
    dcterms:created "2026-06-26"^^xsd:date .

align:map-voltage a rdf:Statement , skos:Concept ;
    skos:inScheme <https://eona-x.eu/crosswalk/netex-datex/v0.1.0#> ;
    skos:prefLabel "Voltage ↔ nominal voltage"@en ;
    rdf:subject datex:voltage ;
    rdf:predicate skos:closeMatch ;
    rdf:object netex:nominalVoltage ;
    skos:note "closeMatch: DATEX II 'voltage' and NeTEx 'nominal voltage' both denote the operating voltage of the charging equipment in volts (V); near-equivalent, framing differs slightly." ;
    dcterms:source "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)" ;
    dcterms:created "2026-06-26"^^xsd:date .

align:map-charging-mode a rdf:Statement , skos:Concept ;
    skos:inScheme <https://eona-x.eu/crosswalk/netex-datex/v0.1.0#> ;
    skos:prefLabel "Charging mode ↔ current type"@en ;
    rdf:subject datex:chargingMode ;
    rdf:predicate skos:relatedMatch ;
    rdf:object netex:currentType ;
    skos:note "relatedMatch (associative, not equivalence): DATEX II chargingMode (IEC 61851 modes 1-4, encoding AC/DC plus control) and NeTEx currentType (AC/DC) both characterise how charging is delivered, but at different granularity, so related rather than close or exact." ;
    dcterms:source "EONA-X Vocabulary Hub — EV-charging crosswalk (EMDS demo, #446)" ;
    dcterms:created "2026-06-26"^^xsd:date .
