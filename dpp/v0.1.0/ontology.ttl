    skos:definition "Safety measures to be taken during battery handling, including the dismantling"@en ;
    skos:scopeNote "A battery passport must include safety measures."@en ;
    skos:note "The safety measures should be provided via the instruction manuals as URL linking to PDF."@en ;
    dpp:regulationReference "Annex XIII (2d); Art. 74(2)" ;
    dct:relation "DIN DKE Spec 99100 6.6.1.5" ;
    dpp:dataFormat "URI/URL" ;
    dpp:dataBehaviour dpp:Static ;
