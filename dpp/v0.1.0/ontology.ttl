    rdfs:label "Number of overcharge events"@en ;
    skos:prefLabel "Number of overcharge events"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "99" ;
    skos:definition "The number of occasions, in which voltage has increased above the upper operational limit as provided in the battery passport"@en ;
    skos:note """As a non-mandatory data attribute the battery passport should include information on the number of overcharge events.

The information on number of overcharge events should relate to the battery item in analogy to deep discharge events.

The update interval for the number of overcharge events should be analogous to that of the number of deep discharge events."""@en ;
    dct:relation "DIN DKE Spec 99100 6.7.8.3" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement """depending on individual definition of \"up-to-date\" based on this data attribute and its use case. (Currently no clarification through official guidance or delegated act expected)""" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: o; LMT: o; Other Industrial >2kWh: o; Stationary >2kWh: o" .

dpp:informationOnAccidents
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_NegativeEvents ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Information on accidents"@en ;
    skos:prefLabel "Information on accidents"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "100" ;
    skos:definition "Information on accidents affecting the battery, including when incorporated in equipment it is powering."@en ;
    skos:scopeNote "The battery passport must contain information and data resulting from its use such as accidents."@en ;
    skos:note """Identification of accidents can be based on measuring abrupt positive or negative acceleration above a corresponding absolute threshold value. An identified accident should be followed by an assessment of battery safety.

Reporting of information on accidents should consider requirements of personal data protection legislation, e.g. by an appropriate level of anonymization."""@en ;
    dpp:regulationReference "Annex XIII (4d)" ;
    dct:relation "DIN DKE Spec 99100 6.7.8.4" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement """depending on individual definition of \"up-to-date\" based on this data attribute and its use case. (Currently no clarification through official guidance or delegated act expected)""" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

