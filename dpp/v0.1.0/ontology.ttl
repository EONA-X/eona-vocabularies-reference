    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:postConsumerRecycledCobaltShare
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:CircularityAndResourceEfficiency_RecycledAndRenewableContent ;
    rdfs:range xsd:decimal ;
    rdfs:label "Post-consumer recycled cobalt share"@en ;
    skos:prefLabel "Post-consumer recycled cobalt share"@en ;
    skos:inScheme dpp:CircularityAndResourceEfficiency ;
    dct:identifier "52" ;
    skos:definition "The share of cobalt recycled from post-consumer waste in the active materials of the battery"@en ;
    skos:scopeNote """A battery passport must include recycled content information.

The content information must include the percentage share of cobalt that is present in active materials and that has been recovered from post-consumer waste, for each battery model per year and per manufacturing plant."""@en ;
    skos:note """The recycled content shares from pre-consumer waste and post-consumer waste of cobalt, lithium, nickel in active materials and lead present in the battery should be calculated and declared separately.

Post-consumer material is defined in DIN EN ISO 14021 as the “material generated by households or by commercial, industrial, and institutional facilities in their role as end-users of the product, which can no longer be used for its intended purpose. This includes returns of material from the distribution chain.”"""@en ;
    dpp:regulationReference "Annex XIII (1e); Art. 8(1)" ;
    dct:relation "DIN DKE Spec 99100 6.6.2.8" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:postConsumerRecycledLithiumShare
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:CircularityAndResourceEfficiency_RecycledAndRenewableContent ;
    rdfs:range xsd:decimal ;
    rdfs:label "Post-consumer recycled lithium share"@en ;
    skos:prefLabel "Post-consumer recycled lithium share"@en ;
    skos:inScheme dpp:CircularityAndResourceEfficiency ;
    dct:identifier "53" ;
    skos:definition "The share of lithium recycled from post-consumer waste in the active materials of the battery"@en ;
    skos:scopeNote """A battery passport must include recycled content information.

The content information must include the percentage share of lithium that is present in active materials and that has been recovered from post-consumer waste, for each battery model per year and per manufacturing plant."""@en ;
    skos:note """The recycled content shares from pre-consumer waste and post-consumer waste of cobalt, lithium, nickel in active materials and lead present in the battery should be calculated and declared separately.

Post-consumer material is defined in DIN EN ISO 14021 as the “material generated by households or by commercial, industrial, and institutional facilities in their role as end-users of the product, which can no longer be used for its intended purpose. This includes returns of material from the distribution chain.”"""@en ;
    dpp:regulationReference "Annex XIII (1e); Art. 8(1)" ;
    dct:relation "DIN DKE Spec 99100 6.6.2.9" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:recycledLeadShare
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:CircularityAndResourceEfficiency_RecycledAndRenewableContent ;
    rdfs:range xsd:decimal ;
    rdfs:label "Recycled lead share"@en ;
    skos:prefLabel "Recycled lead share"@en ;
    skos:inScheme dpp:CircularityAndResourceEfficiency ;
    dct:identifier "54" ;
    skos:definition "The share of recycled lead in the active materials of the battery"@en ;
    skos:scopeNote """A battery passport must include recycled content information.

The content information must include the percentage share of lead that is present in the active materials of the battery and that has been recovered from waste, for each battery model per year and per manufacturing plant.

The regulation does not distinguish between pre- and post-consumer waste for the lead share."""@en ;
    skos:note "The recycled content share of lead present in the battery should be calculated and declared."@en ;
    dpp:regulationReference "Annex XIII (1e); Art. 8(1)" ;
    dct:relation """DIN DKE Spec 99100 6.6.2.6,
6.6.2.10""" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:renewableContentShare
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:CircularityAndResourceEfficiency_RecycledAndRenewableContent ;
    rdfs:range xsd:decimal ;
    rdfs:label "Renewable content share"@en ;
    skos:prefLabel "Renewable content share"@en ;
    skos:inScheme dpp:CircularityAndResourceEfficiency ;
    dct:identifier "55" ;
    skos:definition "Share of renewable content in the battery"@en ;
    skos:scopeNote "A battery passport must include information about the share of renewable content."@en ;
    skos:note """If the proportion of renewable content is greater than zero, specifications about which material is involved and its content shall be determined.

The renewable content share should be calculated as the mass of renewable material divided by the overall mass of the battery, using the formula: RM/(RM + NM)

Where RM = Mass of renewable materials
NM = Mass of non-renewable materials

Renewable material is defined as materials that are composed of biomass and that can be continually replenished, in EN 16575:2014."""@en ;
    dpp:regulationReference "Annex XIII (1f)" ;
    dct:relation "DIN DKE Spec 99100 6.6.2.11" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:informationOnTheRoleOfEndUsersInContributingToWastePrevention
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:CircularityAndResourceEfficiency_InformationOnRoleOfEndUsersInWastePreventionAndInformationOnBatteryCollectionPreparationForSecondLifeAndOnTreatmentAtEndOfLife ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Information on the role of end-users in contributing to waste prevention"@en ;
    skos:prefLabel "Information on the role of end-users in contributing to waste prevention"@en ;
    skos:inScheme dpp:CircularityAndResourceEfficiency ;
    dct:identifier "56" ;
    skos:definition "Information on how end-users can contribute to waste prevention"@en ;
    skos:scopeNote """A battery passport must include information on the role of end-users in contributing to waste prevention.

The information must include good practices and recommendations concerning the use of batteries aimed at extending their use phase and the possibilities of re-use, preparation for re-use, preparation for repurposing, repurposing and remanufacturing."""@en ;
    skos:note "General information on the role of the end-users in waste prevention and information on good practices and recommendations concerning the use of batteries aiming at extending their use-phase should be provided as link to PDF."@en ;
    dpp:regulationReference "Art. 74(1a)" ;
    dct:relation "DIN DKE Spec 99100 6.6.3.2" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:informationOnTheRoleOfEndUsersInContributingToTheSeparateCollectionOfWasteBatteries
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:CircularityAndResourceEfficiency_InformationOnRoleOfEndUsersInWastePreventionAndInformationOnBatteryCollectionPreparationForSecondLifeAndOnTreatmentAtEndOfLife ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Information on the role of end-users in contributing to the separate collection of waste batteries"@en ;
    skos:prefLabel "Information on the role of end-users in contributing to the separate collection of waste batteries"@en ;
    skos:inScheme dpp:CircularityAndResourceEfficiency ;
    dct:identifier "57" ;
    skos:definition "Information on how end-users can contribute to the separate collection of waste batteries"@en ;
    skos:scopeNote """A battery passport must include information on the role of end-users in contributing to the separate collection of waste batteries.

End-users are obliged to discard waste batteries separately from other waste streams, including from mixed municipal waste and in designated separate collection points set up by, or in accordance with the specific arrangements concluded with, the producer or a producer responsibility organisation."""@en ;
    skos:note """Information on the practical role of the end-users in contributing to the separate collection of waste batteries should be provided as link to PDF.

The European Commission guidelines on the facilitation of the harmonised application of provisions on the removability and replaceability of LMT batteries state that the information on waste prevention provided to the end-user should include clear advice on the next steps required to ensure that waste batteries are not discarded with other waste. Information should also be provided on the correct handling, packaging, storage and transport of the waste battery to a separate collection point or treatment facility."""@en ;
    dpp:regulationReference "Art. 74(1b); Art. 64(1); Art. 64(2)" ;
    dct:relation "DIN DKE Spec 99100 6.6.3.3" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:informationOnBatteryCollectionPreparationForSecondLifeAndOnTreatmentAtEndOfLife
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:CircularityAndResourceEfficiency_InformationOnRoleOfEndUsersInWastePreventionAndInformationOnBatteryCollectionPreparationForSecondLifeAndOnTreatmentAtEndOfLife ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Information on battery collection, preparation for second life and on treatment at end of life"@en ;
    skos:prefLabel "Information on battery collection, preparation for second life and on treatment at end of life"@en ;
    skos:inScheme dpp:CircularityAndResourceEfficiency ;
    dct:identifier "58" ;
    skos:definition "Information on the collection of waste batteries, their preparation for second life and definitive treatment at end of life"@en ;
    skos:scopeNote "A battery passport must include information on the separate collection, take-back and collection points, preparation for re-use, preparation for repurposing and treatment available for waste batteries."@en ;
    skos:note "The location of collection points, a description of the take-back process, preparation for re-use, preparation for repurposing and treatment available should be provided as link to PDF."@en ;
    dpp:regulationReference "Art. 74(1c)" ;
    dct:relation "DIN DKE Spec 99100 6.6.3.4" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:ratedCapacity
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_CapacityEnergyAndVoltage ;
    rdfs:range xsd:integer ;
    rdfs:label "Rated capacity"@en ;
    skos:prefLabel "Rated capacity"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "59" ;
    skos:definition "The total number of ampere-hours that can be withdrawn from a fully charged battery under reference conditions"@en ;
    skos:scopeNote """The battery passport must include information about the rated capacity.

The rated capacity of LMT batteries shall be determined according to reliable, accurate and reproducible methods which take into account the generally recognised state-of-the-art methods, and the results of which are deemed to be of low uncertainty, including methods set out in standards for which references have been published for those purposes in the Official Journal of the European Union (OJEU).

Note: (For LMT batteries) the rated capacity is included in the required information for the battery label."""@en ;
    skos:note "The test method and reference conditions for measurement should include, among others, the battery charge and discharge rate, the resting period between charge and discharge as well as the operating temperature."@en ;
    dpp:regulationReference "Annex IV Part A (1); Annex XIII (1g); Labelling IA (draft) Annex II Part A (VI) and Part C (C, 1)" ;
    dct:relation "DIN DKE Spec 99100 6.7.2.2" ;
    dpp:unit """Ah
or mAh (for LMT)""" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:remainingCapacity
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_CapacityEnergyAndVoltage ;
    rdfs:range xsd:integer ;
    rdfs:label "Remaining capacity"@en ;
    skos:prefLabel "Remaining capacity"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "60" ;
    skos:definition "The corresponding in-use data attribute to rated capacity"@en ;
    skos:scopeNote """The battery passport must include information about the rated capacity.

The rated capacity of LMT batteries shall be determined according to reliable, accurate and reproducible methods which take into account the generally recognised state-of-the-art methods, and the results of which are deemed to be of low uncertainty, including methods set out in standards for which references have been published for those purposes in the Official Journal of the European Union (OJEU).

Note: (For LMT batteries) the rated capacity is included in the required information for the battery label."""@en ;
    skos:note """The definition of remaining capacity shall consider the definition of \"rated capacity\" (6.7.2.2) to ensure comparability.

The test method and reference conditions for measurement should include, among others, the battery charge and discharge rate in terms of rated capacity (C-rate), the resting period in between charge and discharge as well as the operating temperature."""@en ;
    dpp:regulationReference "Annex VII Part A (1)" ;
    dct:relation "DIN DKE Spec 99100 6.7.2.3" ;
    dpp:unit "Ah" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement """depending on individual definition of \"up-to-date\" based on this data attribute and its use case. (Currently no clarification through official guidance or delegated act expected)""" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x; Module: o" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: o; LMT: x; Other Industrial >2kWh: o; Stationary >2kWh: x" .

dpp:capacityFade
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_CapacityEnergyAndVoltage ;
    rdfs:range xsd:decimal ;
    rdfs:label "Capacity fade"@en ;
    skos:prefLabel "Capacity fade"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "61" ;
    skos:definition "The decrease over time and upon usage in the amount of charge that a battery can deliver at the rated voltage, with respect to the original rated capacity as declared by the manufacturer"@en ;
    skos:scopeNote """The battery passport must include information on the capacity fade.

The capacity fade must be updated upon change of the battery status."""@en ;
    skos:note """Capacity fade should be calculated in accordance with ISO 12405 4:2018, using the formula below:
Cfade(x) = 1- C(x)/CBOL ×100 %
where
x 	is the aging parameter (e.g. storage time, number of cycles, etc.);
C(x) 	is the capacity at aging parameter x;
CBOL 	is the capacity at begin of life."""@en ;
    dpp:regulationReference "Annex IV Part A (1); Annex IV (2)" ;
    dct:relation "DIN DKE Spec 99100 6.7.2.4" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:certifiedUsableBatteryEnergy
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_CapacityEnergyAndVoltage ;
    rdfs:range xsd:integer ;
    rdfs:label "Certified usable battery energy"@en ;
    skos:prefLabel "Certified usable battery energy"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "62" ;
    skos:definition "The usable battery energy according to the procedure in the UN GTR No 22 as determined during the certification of the vehicle"@en ;
    skos:note "The battery passport should include information on the remaining usable battery energy for EV batteries as it is useful in context of SOCE and needed for its calculation."@en ;
    dct:relation "DIN DKE Spec 99100 6.7.2.5" ;
    dpp:unit "kWh" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery ;
    skos:example "Applicability — EV: o" .

dpp:remainingUsableBatteryEnergy
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_CapacityEnergyAndVoltage ;
    rdfs:range xsd:integer ;
    rdfs:label "Remaining usable battery energy"@en ;
    skos:prefLabel "Remaining usable battery energy"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "63" ;
    skos:definition "The usable battery energy at the present point in the lifetime of a battery as determined according to the procedure in the UN GTR No 22"@en ;
    skos:note "The update interval and its definition should be aligned with the update interval of the SOCE."@en ;
    dct:relation "DIN DKE Spec 99100 6.7.2.6" ;
    dpp:unit "kWh" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement """depending on individual definition of \"up-to-date\" based on this data attribute and its use case. (Currently no clarification through official guidance or delegated act expected)""" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery ;
    skos:example "Applicability — EV: o" .

dpp:stateOfCertifiedEnergySOCE
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_CapacityEnergyAndVoltage ;
    rdfs:range xsd:decimal ;
    rdfs:label "State of certified energy (SOCE)"@en ;
    skos:prefLabel "State of certified energy (SOCE)"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "64" ;
    skos:definition "The measured or on-board usable battery energy performance at a specific point in its lifetime, expressed as a percentage of the certified usable battery energy."@en ;
    skos:scopeNote "The battery passport must include information on the SOCE as information on the state of health of the battery pursuant to BattReg Article 14 for individual batteries."@en ;
    skos:note """SOCE shall be expressed as a percentage of the certified usable battery energy.

The SOCE shall be reported based on the conditions laid out in the UN GTR No 22."""@en ;
    dpp:regulationReference "Annex VII Part A (EV)" ;
    dct:relation "DIN DKE Spec 99100 6.7.2.7" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement """depending on individual definition of \"up-to-date\" based on this data attribute and its use case. (Currently no clarification through official guidance or delegated act expected)""" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery ;
    skos:example "Applicability — EV: x" .

dpp:stateOfChargeSoC
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_CapacityEnergyAndVoltage ;
    rdfs:range xsd:decimal ;
    rdfs:label "State of Charge (SoC)"@en ;
    skos:prefLabel "State of Charge (SoC)"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "65" ;
    skos:definition "The available energy or charge in a battery expressed as a percentage of rated capacity as declared by the manufacturer. When the battery’s state of health is no longer equal to its initial condition, SoC refers to the maximum energy or charge that can be stored in the battery at the time of charging."@en ;
    skos:scopeNote "The battery passport shall include the state of charge (SoC) of the battery."@en ;
    skos:note """The following recommendation is made:
The information on the SoC should additionally be reported by use of a histogram that represents the time spent in specific SoC intervals covering the entire range of SoC values. The BMS should aggregate the time spent in each SoC interval from values during operation of the battery"""@en ;
    dpp:regulationReference "Annex XIII (4d); Article 3 1(27); Standardization request M/579" ;
    dct:relation "DIN DKE Spec 99100 6.7.2.8" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement """depending on individual definition of \"up-to-date\" based on this data attribute and its use case. (Currently no clarification through official guidance or delegated act expected)""" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:minimumVoltage
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_CapacityEnergyAndVoltage ;
    rdfs:range xsd:decimal ;
    rdfs:label "Minimum voltage"@en ;
    skos:prefLabel "Minimum voltage"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "66" ;
    skos:definition "The lower voltage limit that the safe operation of the battery is rated for"@en ;
    skos:scopeNote "The battery passport must include information on the minimal voltage, with temperature ranges when relevant."@en ;
    skos:note "The temperature range, in which the provided minimal voltage applies, should be reported in °C."@en ;
    dpp:regulationReference "Annex XIII (1h)" ;
    dct:relation "DIN DKE Spec 99100 6.7.2.9" ;
    dpp:unit "V" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:maximumVoltage
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_CapacityEnergyAndVoltage ;
    rdfs:range xsd:decimal ;
    rdfs:label "Maximum voltage"@en ;
    skos:prefLabel "Maximum voltage"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "67" ;
    skos:definition "The upper voltage limit that the safe operation of the battery is rated for"@en ;
    skos:scopeNote "The battery passport must include information about the maximum voltage, with temperature ranges when relevant."@en ;
    skos:note "The temperature range, in which the provided maximum voltage applies, should be reported in °C."@en ;
    dpp:regulationReference "Annex XIII (1h)" ;
    dct:relation "DIN DKE Spec 99100 6.7.2.10" ;
    dpp:unit "V" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
