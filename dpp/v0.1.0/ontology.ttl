    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:nominalVoltage
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_CapacityEnergyAndVoltage ;
    rdfs:range xsd:decimal ;
    rdfs:label "Nominal voltage"@en ;
    skos:prefLabel "Nominal voltage"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "68" ;
    skos:definition "The suitable approximate value of the voltage used to designate or identify the battery"@en ;
    skos:scopeNote "The battery passport must include information about the nominal voltage, with temperature ranges when relevant."@en ;
    dpp:regulationReference "Annex XIII (1h)" ;
    dct:relation "DIN DKE Spec 99100 6.7.2.11" ;
    dpp:unit "V" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:originalPowerCapability
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_PowerCapability ;
    rdfs:range xsd:integer ;
    rdfs:label "Original power capability"@en ;
    skos:prefLabel "Original power capability"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "69" ;
    skos:definition "The amount of energy that a battery is capable to provide over a given period of time under reference conditions"@en ;
    skos:scopeNote "The battery passport must include information about the original power capability […], with temperature range when relevant."@en ;
    skos:note """Power capability shall be measured at reference conditions, which must include measurements at 80 % and 20 % state of charge for EV and industrial batteries.

The temperature range, in which the provided maximum voltage applies, should be provided in the unit °C.

The test method and reference conditions should, among others, include the charge and discharge rate in terms of rated capacity (C-rate), the duration and the voltage at the point of measurement."""@en ;
    dpp:regulationReference "Annex XIII (1i); Art. 10, Annex IV Part B (4) → measurement at 80 % SoC and 20% SoC required; Annex IV (3)" ;
    dct:relation "DIN DKE Spec 99100 6.7.3.2" ;
    dpp:unit "W" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:remainingPowerCapability
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_PowerCapability ;
    rdfs:range xsd:integer ;
    rdfs:label "Remaining power capability"@en ;
    skos:prefLabel "Remaining power capability"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "70" ;
    skos:definition "The amount of energy that a battery is capable to provide over a given period of time under reference conditions at a distinct point in time during its usage"@en ;
    skos:scopeNote "The battery passport must, where possible, contain information on the remaining power capability as information on the state of health of the battery"@en ;
    skos:note "Power capability shall be measured at reference conditions, which, among others, must include the measurement at 80 % and 20 % SoC."@en ;
    dpp:regulationReference """Art. 10: Annex IV (3) (only definition of power); Annex VII Part A (2) \"where possible, remaining power capability\"; Annex IV Part B (4) --> measurement at 80 % SoC and 20% SoC required""" ;
    dct:relation "DIN DKE Spec 99100 6.7.3.3" ;
    dpp:unit "W" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement """depending on individual definition of \"up-to-date\" based on this data attribute and its use case. (Currently no clarification through official guidance or delegated act expected)""" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: o; LMT: x; Other Industrial >2kWh: o; Stationary >2kWh: x" .

dpp:powerFade
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_PowerCapability ;
    rdfs:range xsd:decimal ;
    rdfs:label "Power fade"@en ;
    skos:prefLabel "Power fade"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "71" ;
    skos:definition "The decrease over time and upon usage in the amount of power that a battery can deliver at the rated voltage"@en ;
    skos:scopeNote """The battery passport must contain information on the power fade.

The update interval must be upon placement on the market and upon change of the battery status."""@en ;
    skos:note """Power fade should be calculated using original and remaining power capability following the formula below:
Pfade(x) = 1-P(x) / PBOL ×100 %
where
x 	is the aging parameter (e.g. storage time, number of cycles, etc.);
P(x) 	is the power capability at aging parameter x;
PBOL 	is the power capability at begin of life."""@en ;
    dpp:regulationReference """Annex IV P(4) (\"power fade\" definition); Annex IV Part A (2) (power fade in %)
Annex IV Part B (4) → measurement at 80 % SoC required;""" ;
    dct:relation "DIN DKE Spec 99100 6.7.3.4" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:maximumPermittedBatteryPower
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_PowerCapability ;
    rdfs:range xsd:integer ;
    rdfs:label "Maximum permitted battery power"@en ;
    skos:prefLabel "Maximum permitted battery power"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "72" ;
    skos:definition "The value of maximum permitted power the battery is rated for and reflects the data relevant for power limits"@en ;
    skos:scopeNote "The battery passport must include information about the original power capability and limits, with temperature range when relevant."@en ;
    skos:note """The maximum permitted battery power should be defined as the upper power limit that the safe operation of the battery is rated for.

The temperature range, in which the provided maximum permitted battery power applies, should be provided in unit °C."""@en ;
    dpp:regulationReference "Annex XIII (1i) (power limits)" ;
    dct:relation "DIN DKE Spec 99100 6.7.3.5" ;
    dpp:unit "W" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:ratioBetweenNominalBatteryPowerAndBatteryEnergy
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_PowerCapability ;
    rdfs:range xsd:integer ;
    rdfs:label "Ratio between nominal battery power and battery energy"@en ;
    skos:prefLabel "Ratio between nominal battery power and battery energy"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "73" ;
    skos:definition "The suitable approximate value of the power capability used to designate or identify the battery, while the battery energy is determined in reference conditions to be defined"@en ;
    skos:note "As a non-mandatory data point the battery passport should include the ratio between nominal battery power in W and battery energy in Wh. It aims to provide an indication of the applicable discharge and charge rate in terms of rated capacity (C-rate) (see BattReg Annex IV Part B(2))."@en ;
    dpp:regulationReference "Annex IV Part B (2)" ;
    dct:relation "DIN DKE Spec 99100 6.7.3.6" ;
    dpp:unit "W/Wh" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: o; LMT: o; Other Industrial >2kWh: o; Stationary >2kWh: o" .

dpp:initialRoundTripEnergyEfficiency
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_RoundTripEnergyEfficiencyAndSelfDischarge ;
    rdfs:range xsd:decimal ;
    rdfs:label "Initial round trip energy efficiency"@en ;
    skos:prefLabel "Initial round trip energy efficiency"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "74" ;
    skos:definition "The ratio of the net energy delivered by a battery during a discharge test to the total energy required to restore the initial state of charge by a standard charge (see BattReg Annex IV (6))"@en ;
    skos:scopeNote "The battery passport must include information about the initial round trip energy efficiency."@en ;
    skos:note """Initial round trip energy efficiency should be measured at reference conditions.

The initial state of charge, referred to in the definition above, should correspond to a fully charged state."""@en ;
    dpp:regulationReference "Annex XIII (1n); Art. 10: Annex IV (6); Annex IV Part A (4)" ;
    dct:relation "DIN DKE Spec 99100 6.7.4.2" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:roundTripEnergyEfficiencyAt50OfCycleLife
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_RoundTripEnergyEfficiencyAndSelfDischarge ;
    rdfs:range xsd:decimal ;
    rdfs:label "Round trip energy efficiency at 50% of cycle life"@en ;
    skos:prefLabel "Round trip energy efficiency at 50% of cycle life"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "75" ;
    skos:definition "The ratio of the net energy delivered by a battery during a discharge test to the total energy required to restore the initial state of charge by a standard charge (see BattReg Annex IV (6))"@en ;
    skos:scopeNote "The battery passport must include information about the round trip energy efficiency at 50 % of cycle-life."@en ;
    skos:note """Initial round trip energy efficiency shall be measured at reference conditions that include the specification of “50 % of cycle-life”.

Test methods and reference conditions should separately consider non-cycle applications and batteries with very long cycle-life."""@en ;
    dpp:regulationReference "Annex XIII 1(n); Annex IV (6)" ;
    dct:relation "DIN DKE Spec 99100 6.7.4.3" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:remainingRoundTripEnergyEfficiency
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_RoundTripEnergyEfficiencyAndSelfDischarge ;
    rdfs:range xsd:decimal ;
    rdfs:label "Remaining round trip energy efficiency"@en ;
    skos:prefLabel "Remaining round trip energy efficiency"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "76" ;
    skos:definition "The in-use analogy to the initial roundtrip energy the ratio of the net energy delivered by a battery during a discharge test to the total energy required to restore the initial state of charge by a standard charge"@en ;
    skos:scopeNote "The battery passport must, where possible, include information about the remaining round-trip energy efficiency as information on the state of health of the battery."@en ;
    skos:note "The update frequency of remaining round trip energy efficiency should be aligned with the update frequency of round trip energy efficiency fade and should be provided upon change of the battery status."@en ;
    dpp:regulationReference "Art. 10: Annex IV Part A (4); Article 14: Annex VII Part A (3); Annex IV (6)" ;
    dct:relation "DIN DKE Spec 99100 6.7.4.4" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement """depending on individual definition of \"up-to-date\" based on this data attribute and its use case. (Currently no clarification through official guidance or delegated act expected)""" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:LightMeansOfTransportBattery, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — LMT: x; Stationary >2kWh: x" .

dpp:energyRoundTripEfficiencyFade
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_RoundTripEnergyEfficiencyAndSelfDischarge ;
    rdfs:range xsd:decimal ;
    rdfs:label "Energy round trip efficiency fade"@en ;
    skos:prefLabel "Energy round trip efficiency fade"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "77" ;
    skos:definition "The decrease of round trip energy efficiency as percentage"@en ;
    skos:scopeNote """The battery passport must, where applicable, contain information on the energy round trip efficiency fade.

The energy round trip efficiency fade must be updated upon placement on the market and change of the battery status."""@en ;
    skos:note """Energy round trip efficiency fade should be calculated using the initial round trip energy efficiency and remaining round trip energy efficiency following the formula below:

RTEfade (x) = 1-RTE(x) / RTEBOL  ×100%
where
x 	is the aging parameter (e.g. storage time, number of cycles, etc.);
RTE(x) 	is the round trip energy efficiency at aging parameter x;
RTEBOL 	is the round trip energy efficiency at begin of life."""@en ;
    dpp:regulationReference "Annex IV Part A (4)" ;
    dct:relation "DIN DKE Spec 99100 6.7.4.5" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:initialSelfDischargeRate
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_RoundTripEnergyEfficiencyAndSelfDischarge ;
    rdfs:range xsd:decimal ;
    rdfs:label "Initial self-discharge rate"@en ;
    skos:prefLabel "Initial self-discharge rate"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "78" ;
    skos:definition "The self-discharge-rate in an idle state of the battery in reference conditions (temperature etc.) at begin of life"@en ;
    skos:note """The battery passport should contain information on the evolution of self-discharge rates for stationary BESS using a BMS and LMT batteries.

The information on initial self-discharge rate should be accessible for persons with a legitimate interest."""@en ;
    dct:relation "DIN DKE Spec 99100 6.7.4.6" ;
    dpp:unit "%/month" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:LightMeansOfTransportBattery, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — LMT: o; Stationary >2kWh: o" .

dpp:currentSelfDischargeRate
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_RoundTripEnergyEfficiencyAndSelfDischarge ;
    rdfs:range xsd:decimal ;
    rdfs:label "Current self-discharge rate"@en ;
    skos:prefLabel "Current self-discharge rate"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "79" ;
    skos:definition "The change of the self-discharge rate in an idle state of the battery in reference conditions (temperature etc.) at aging parameter x, e.g. after a certain amount of storage time or, number of cycles"@en ;
    skos:note "The battery passport should contain information on the evolution of self-discharge rates for stationary BESS using a BMS and LMT batteries."@en ;
    dct:relation "DIN DKE Spec 99100 6.7.4.7" ;
    dpp:unit "%/month" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement """depending on individual definition of \"up-to-date\" based on this data attribute and its use case. (Currently no clarification through official guidance or delegated act expected)""" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:LightMeansOfTransportBattery, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — LMT: o; Stationary >2kWh: o" .

dpp:evolutionOfSelfDischargeRates
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_RoundTripEnergyEfficiencyAndSelfDischarge ;
    rdfs:range xsd:decimal ;
    rdfs:label "Evolution of self-discharge rates"@en ;
    skos:prefLabel "Evolution of self-discharge rates"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "80" ;
    skos:definition "The change of self-discharge over time and usage, as percentage calculated from the initial and current self-discharge rate."@en ;
    skos:scopeNote "The battery passport must contain information on the evolution of self-discharge rates for stationary BESS and LMT batteries."@en ;
    skos:note """The evolution of self-discharging rates should be calculated from the initial and current self discharge rate.

The update interval for evolution of self-discharge rates should be upon placement on market and change of battery status."""@en ;
    dpp:regulationReference "Art. 14: Annex VII Part A (4)" ;
    dct:relation "DIN DKE Spec 99100 6.7.4.8" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement """depending on individual definition of \"up-to-date\" based on this data attribute and its use case. (Currently no clarification through official guidance or delegated act expected)""" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:LightMeansOfTransportBattery, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — LMT: x; Stationary >2kWh: x" .

dpp:initialInternalResistanceOfBatteryCellAndPackModuleRecommended
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_InternalResistance ;
    rdfs:range xsd:integer ;
    rdfs:label "Initial internal resistance of battery cell and pack (module recommended)"@en ;
    skos:prefLabel "Initial internal resistance of battery cell and pack (module recommended)"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "81" ;
    skos:definition """\"Quotient of change of voltage of a battery by the corresponding change in discharge current under specified conditions” (IEV 482 03 36)"""@en ;
    skos:scopeNote """BattReg Annex IV (5) states that ‘Internal resistance’ means the opposition to the flow of current within a cell or a battery under reference conditions, that is, the sum of electronic resistance and ionic resistance to the contribution to total effective resistance including inductive/capacitive properties. This definition differs from the definition according to the IEC Electropedia stated above. The battery passport must include information about the internal resistance.

The battery passport must include information about the internal resistance on both battery cell and pack level."""@en ;
    skos:note "The battery passport can include additional information about the initial internal resistance on battery module level, if available. It should be defined and calculated analogously as the requirements on battery pack level above."@en ;
    dpp:regulationReference "Annex XIII (1o); Art. 10: Annex IV Part A (3) (+definition of internal resistance)" ;
    dct:relation "DIN DKE Spec 99100 6.7.5.2" ;
    dpp:unit "Ohm" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x; Module: o; Cell: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:internalResistanceIncreaseOfPackCellAndModuleRecommended
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_InternalResistance ;
    rdfs:range xsd:decimal ;
    rdfs:label "Internal resistance increase of pack (cell and module recommended)"@en ;
    skos:prefLabel "Internal resistance increase of pack (cell and module recommended)"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "82" ;
    skos:definition "The increase over time and upon usage of internal resistance"@en ;
    skos:scopeNote """The battery passport must include information about the internal resistance increase.

The internal resistance increase must be updated upon change of the battery status, which is associated with a new placement on market and described in 6.1.3.7 \"battery status\"."""@en ;
    skos:note """The internal resistance increase over time and upon usage should be defined based on the ratio of current and initial values as follows:
Rincrease(x) = (R(x)  - RBOL) / RBOL × 100 %
where
x 	is the aging parameter (e.g. storage time, number of cycles, etc.;);
R(x)	is the internal resistance at the aging parameter x; and
RBOL	is the internal resistance at begin of life.

The battery passport can include additional information about the internal resistance increase on battery cell and battery module level, if available. It should be defined and calculated analogously to the requirements on battery pack level above."""@en ;
    dpp:regulationReference "Annex IV, Part A(3)" ;
    dct:relation "DIN DKE Spec 99100 6.7.5.3" ;
    dpp:unit "%" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x; Module: o; Cell: o" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:expectedLifetimeInCalendarYears
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_BatteryLifetime ;
    rdfs:range xsd:decimal ;
    rdfs:label "Expected lifetime in calendar years"@en ;
    skos:prefLabel "Expected lifetime in calendar years"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "83" ;
    skos:definition "Expected life-time under the reference conditions for which they have been designed in terms of cycles, except for non-cycle applications, and calendar years"@en ;
    skos:scopeNote """The battery passport must include information about the expected battery lifetime in calendar years.

The update interval must be upon placement on the market and upon change of the battery status."""@en ;
    dpp:regulationReference "Annex IV, Part A(5); Annex XIII (1); Annex XIII (4a)" ;
    dct:relation "DIN DKE Spec 99100 6.7.6.2" ;
    dpp:unit "years" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:expectedLifetimeNumberOfChargeDischargeCycles
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_BatteryLifetime ;
    rdfs:range xsd:integer ;
    rdfs:label "Expected lifetime: Number of charge-discharge cycles"@en ;
    skos:prefLabel "Expected lifetime: Number of charge-discharge cycles"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "84" ;
    skos:definition "Expected life-time under the reference conditions for which they have been designed in terms of cycles, except for non-cycle applications, and calendar years"@en ;
    skos:scopeNote """The battery passport must include information about the expected battery lifetime expressed in cycles, and reference test used, except for non-cycle applications.

The reference test must consider reference conditions for which the battery has been designed."""@en ;
    skos:note """The exception for non-cycle applications that is not included in the BattReg Annex XIII provision should apply to this data attribute in general.

Test methods and reference conditions are subject to the ongoing standardization process at CEN/CENELEC relating to standardization request M/579;"""@en ;
    dpp:regulationReference "Annex IV, Part A(5); Annex XIII (1); Annex XIII (4a)" ;
    dct:relation "DIN DKE Spec 99100 6.7.6.3" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:numberOfFullChargingAndDischargingCycles
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:PerformanceAndDurability_BatteryLifetime ;
    rdfs:range xsd:integer ;
    rdfs:label "Number of full charging and discharging cycles"@en ;
    skos:prefLabel "Number of full charging and discharging cycles"@en ;
    skos:inScheme dpp:PerformanceAndDurability ;
    dct:identifier "85" ;
    skos:definition "In-use number of (full) charging and discharging cycles"@en ;
    skos:scopeNote "The battery passport must include information on the full number of charging and discharging cycles."@en ;
    skos:note """The number of full charging and discharging cycles should be determined considering reference conditions.

The value for the number of full charging and discharging cycles should result from the aggregation of partial cycles occurring in the use phase.

The exception for non-cycle applications as mentioned in \"Expected lifetime: Number of charge-discharge cycles\" should apply to this data attribute as well."""@en ;
    dpp:regulationReference "Annex XIII (4d); Art. 14: Annex VII Part B (5)" ;
    dct:relation "DIN DKE Spec 99100 6.7.6.4" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement """depending on individual definition of \"up-to-date\" based on this data attribute and its use case. (Currently no clarification through official guidance or delegated act expected)""" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

