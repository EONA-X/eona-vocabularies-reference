dpp:carbonFootprintPerformanceClass
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:BatteryCarbonFootprint ;
    rdfs:range xsd:string ;
    rdfs:label "Carbon footprint performance class"@en ;
    skos:prefLabel "Carbon footprint performance class"@en ;
    skos:inScheme dpp:BatteryCarbonFootprint ;
    dct:identifier "33" ;
    skos:definition "Depending on the distribution of the values in the carbon footprint declarations of batteries placed on the market, a meaningful number of classes of performance shall be identified, with category A being the best class with the lowest carbon footprint life cycle impact, to enable market differentiation"@en ;
    skos:scopeNote """The battery passport must include the carbon footprint performance class in accordance with the entry into force of the delegated and implementing acts on the carbon footprint performance classes per Article 7 of the Battery Regulation.

The carbon footprint performance class shall be indicated on the carbon footprint label."""@en ;
    skos:note """The carbon footprint performance class shall be provided on a conspicuous, clearly legible and indelible label (see 6.2.4 \"Carbon footprint label\")."""@en ;
    dpp:regulationReference "Annex XIII (1c); Art. 7(2); Labelling IA (draft) Annex V" ;
    dct:relation "DIN DKE Spec 99100 6.3.7" ;
    dpp:dataFormat "String" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:webLinkToPublicCarbonFootprintStudy
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:BatteryCarbonFootprint ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Web link to public carbon footprint study"@en ;
    skos:prefLabel "Web link to public carbon footprint study"@en ;
    skos:inScheme dpp:BatteryCarbonFootprint ;
    dct:identifier "34" ;
    skos:definition "The public version of the carbon footprint study"@en ;
    skos:scopeNote """The battery passport must include a web link to the carbon footprint study accompanying the battery carbon footprint declaration. The information and reporting requirements are specified in the corresponding delegated acts as outlined in 6.3.2 \"Battery carbon footprint per Functional Unit\"."""@en ;
    dpp:regulationReference "Annex XIII (1c); Art. 7 1(g); EV CF DA (draft)" ;
    dct:relation "DIN DKE Spec 99100 6.3.8" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:absoluteBatteryCarbonFootprint
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:BatteryCarbonFootprint ;
    rdfs:range xsd:integer ;
    rdfs:label "Absolute battery carbon footprint"@en ;
    skos:prefLabel "Absolute battery carbon footprint"@en ;
    skos:inScheme dpp:BatteryCarbonFootprint ;
    dct:identifier "35" ;
    skos:definition "Battery carbon footprint as absolute number"@en ;
    skos:note """As a non-mandatory data attribute, the battery passport should include the battery carbon footprint in absolute terms.

The absolute battery carbon footprint should be calculated as kilograms of carbon dioxide equivalent, without reference to the functional unit as prescribed by the battery regulation."""@en ;
    dct:relation "DIN DKE Spec 99100 6.3.10" ;
    dpp:unit "kgCO2eq" ;
    dpp:dataFormat "Integer" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: o; LMT: o; Other Industrial >2kWh: o; Stationary >2kWh: o" .

dpp:informationOfDueDiligenceReport
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:SupplyChainDueDiligence ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Information of due diligence report"@en ;
    skos:prefLabel "Information of due diligence report"@en ;
    skos:inScheme dpp:SupplyChainDueDiligence ;
    dct:identifier "36" ;
    skos:definition "The report on the supply chain due diligence policy, risk management plan, and summary of third-party verification."@en ;
    skos:scopeNote """The battery passport must include the “information on responsible sourcing as indicated in the report on its due diligence policy referred to in BattReg Article 52(3)”.

The due diligence report must be accessible free of charge to the public via the battery passport and also on the internet.

The report and hence also the information in the battery passport must provide data and information on four aspects:
- Supply chain due diligence policy: steps taken by the economic operator to comply with the requirements of Article 49.
- Risk management plan: steps taken by the economic operator to comply with the requirements of Article 50, including findings of significant adverse impacts.
- Summary report of the third-party verification carried out (Article 51).
- An elaboration on access to information, public participation in decision-making and access to justice."""@en ;
    skos:note """Only the current annual due diligence report valid for the specific battery at the time of placing it on the market should be linked.

The due diligence reports should be made available as PDFs.

For the battery passport, a link to the PDF uploaded to the company website should be made available."""@en ;
    dpp:regulationReference "Art. 52(3)" ;
    dct:relation "DIN DKE Spec 99100 6.4.2" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:thirdPartyAssurancesOfRecognisedSchemes
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:SupplyChainDueDiligence ;
    rdfs:range xsd:string ;
    rdfs:label "Third party assurances of recognised schemes"@en ;
    skos:prefLabel "Third party assurances of recognised schemes"@en ;
    skos:inScheme dpp:SupplyChainDueDiligence ;
    dct:identifier "37" ;
    skos:definition "Information on supply chain scheme assurances granted by third-party actors"@en ;
    skos:note "As a non-mandatory data attribute the battery passport should contain information on third-party supply chain assurances such as certifications, of recognised supply chain schemes. Based on the provided guidance, explore which and how to best make third-party assurances available via the battery passport"@en ;
    dpp:regulationReference "Art. 49(d)" ;
    dct:relation "DIN DKE Spec 99100 6.4.3" ;
    dpp:dataFormat "String" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: o; LMT: o; Other Industrial >2kWh: o; Stationary >2kWh: o" .

dpp:supplyChainIndices
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:SupplyChainDueDiligence ;
    rdfs:range xsd:string ;
    rdfs:label "Supply chain indices"@en ;
    skos:prefLabel "Supply chain indices"@en ;
