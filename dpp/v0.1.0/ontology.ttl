# The Digital Product Passport (DPP) — Battery Data Attribute Longlist
#
# OWL/SKOS representation of the BatteryPass-Ready consortium's "Battery
# Passport Data Attribute Longlist", version 1.3 (March 2026) — the
# regulation-grounded reference list of data attributes a Battery Regulation
# (EU) 2023/1542 Digital Product Passport must (or may) carry, per JTC-24 /
# DIN DKE Spec 99100. Sourced from an internal EONA-X RFI research folder
# (not a public URL); see dct:source below for provenance.
#
# Companion resource: pipelines/load-battery-pass/battery-pass.ttl models the
# same domain from the *implementation* side (BatteryPass-Ready's per-category
# JSON Schemas) — this ontology is the regulation/definition side: one class
# per content cluster (matching the battery-pass: section classes 1:1) and one
# property per attribute, carrying the longlist's definitions, regulation
# references, units, access rights and battery-category applicability.
#
# Each attribute is typed both as an owl:DatatypeProperty (so tooling can use
# rdfs:domain/range) and skos:Concept (so it definitions/notes render in the
# ontology browser), matching this repo's eox-policy: term convention.

@base <https://eona-x.eu/ontology/dpp/v0.1.0#> .
@prefix dpp: <https://eona-x.eu/ontology/dpp/v0.1.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#  Ontology
#################################################################

dpp:
    a owl:Ontology ;
    rdfs:label "Digital Product Passport — Battery Data Attribute Longlist"@en ;
    dct:title "Digital Product Passport — Battery Data Attribute Longlist"@en ;
    owl:versionInfo "0.1.0" ;
    dct:description "OWL/SKOS transcription of the BatteryPass-Ready consortium's Battery Passport Data Attribute Longlist v1.3 (March 2026): the regulation-grounded reference list of data attributes a battery Digital Product Passport (Battery Regulation (EU) 2023/1542, ESPR, JTC-24 prEN 18219/18222/18223, DIN DKE Spec 99100) must or may carry."@en ;
    rdfs:comment """Source: \"BatteryPass-Ready_DataAttributeLongList_v1.3.xlsx\", sheet 'Data attribute longlist_DR_v1.3', 100 attribute rows across 7 content clusters. Internal EONA-X RFI research document (Nextcloud, restricted access) — not a public IRI, hence no dereferenceable dct:source URI is given, only the literal citation below."""@en ;
    dct:source "BatteryPass-Ready consortium — Battery Passport Data Attribute Longlist, version 1.3, March 2026"@en ;
    rdfs:seeAlso <https://thebatterypass.eu/battery-pass-ready/resources/> .

#################################################################
#  Controlled vocabularies (battery category, access rights, data
#  behaviour, granularity level)
#################################################################

dpp:BatteryCategoryCodes a skos:ConceptScheme ;
    skos:prefLabel "Battery category"@en ;
    skos:definition "The four battery categories the longlist distinguishes mandatory/voluntary applicability for (per Battery Regulation Annex/JTC-24)."@en ;
    skos:hasTopConcept dpp:ElectricVehicleBattery , dpp:LightMeansOfTransportBattery , dpp:OtherIndustrialBatteryAbove2kWh , dpp:StationaryIndustrialBatteryAbove2kWh .

dpp:ElectricVehicleBattery a skos:Concept ;
    skos:inScheme dpp:BatteryCategoryCodes ; skos:topConceptOf dpp:BatteryCategoryCodes ;
    skos:prefLabel "Electric vehicle (EV) battery"@en .

dpp:LightMeansOfTransportBattery a skos:Concept ;
    skos:inScheme dpp:BatteryCategoryCodes ; skos:topConceptOf dpp:BatteryCategoryCodes ;
    skos:prefLabel "Light means of transport (LMT) battery"@en .

dpp:OtherIndustrialBatteryAbove2kWh a skos:Concept ;
    skos:inScheme dpp:BatteryCategoryCodes ; skos:topConceptOf dpp:BatteryCategoryCodes ;
    skos:prefLabel "Other industrial battery >2kWh"@en .

dpp:StationaryIndustrialBatteryAbove2kWh a skos:Concept ;
    skos:inScheme dpp:BatteryCategoryCodes ; skos:topConceptOf dpp:BatteryCategoryCodes ;
    skos:prefLabel "Stationary industrial battery >2kWh"@en .

dpp:AccessRightsCodes a skos:ConceptScheme ;
    skos:prefLabel "Access rights"@en ;
    skos:definition "Who may access an attribute's value, per Battery Regulation Art. 77."@en ;
    skos:hasTopConcept dpp:Public , dpp:NotifiedBodiesMarketSurveillanceAuthoritiesAndCommission , dpp:PersonsWithLegitimateInterest , dpp:PersonsWithLegitimateInterestAndCommission .

dpp:Public a skos:Concept ;
    skos:inScheme dpp:AccessRightsCodes ; skos:topConceptOf dpp:AccessRightsCodes ;
    skos:prefLabel "Public"@en .

dpp:NotifiedBodiesMarketSurveillanceAuthoritiesAndCommission a skos:Concept ;
    skos:inScheme dpp:AccessRightsCodes ; skos:topConceptOf dpp:AccessRightsCodes ;
    skos:prefLabel "Notified bodies, market surveillance authorities and the Commission"@en .

dpp:PersonsWithLegitimateInterest a skos:Concept ;
    skos:inScheme dpp:AccessRightsCodes ; skos:topConceptOf dpp:AccessRightsCodes ;
    skos:prefLabel "persons with a legitimate interest"@en .

dpp:PersonsWithLegitimateInterestAndCommission a skos:Concept ;
    skos:inScheme dpp:AccessRightsCodes ; skos:topConceptOf dpp:AccessRightsCodes ;
    skos:prefLabel "persons with a legitimate interest and the Commission"@en .

dpp:DataBehaviourCodes a skos:ConceptScheme ;
    skos:prefLabel "Data behavioural characteristic"@en ;
    skos:hasTopConcept dpp:Static , dpp:Dynamic .

dpp:Static a skos:Concept ;
    skos:inScheme dpp:DataBehaviourCodes ; skos:topConceptOf dpp:DataBehaviourCodes ;
    skos:prefLabel "Static"@en .

dpp:Dynamic a skos:Concept ;
    skos:inScheme dpp:DataBehaviourCodes ; skos:topConceptOf dpp:DataBehaviourCodes ;
    skos:prefLabel "Dynamic"@en .

dpp:GranularityLevelCodes a skos:ConceptScheme ;
    skos:prefLabel "Granularity level (model vs individual battery)"@en ;
    skos:hasTopConcept dpp:BatteryModel , dpp:BatteryModelPerCalendarYearAndManufacturingSite , dpp:BatteryModelPerManufacturingSite , dpp:IndividualBattery .

dpp:BatteryModel a skos:Concept ;
    skos:inScheme dpp:GranularityLevelCodes ; skos:topConceptOf dpp:GranularityLevelCodes ;
    skos:prefLabel "Battery model"@en .

dpp:BatteryModelPerCalendarYearAndManufacturingSite a skos:Concept ;
    skos:inScheme dpp:GranularityLevelCodes ; skos:topConceptOf dpp:GranularityLevelCodes ;
    skos:prefLabel "Battery model per calendar year and per manufacturing site, i.e. batch level"@en .

dpp:BatteryModelPerManufacturingSite a skos:Concept ;
    skos:inScheme dpp:GranularityLevelCodes ; skos:topConceptOf dpp:GranularityLevelCodes ;
    skos:prefLabel "Battery model per manufacturing site"@en .

dpp:IndividualBattery a skos:Concept ;
    skos:inScheme dpp:GranularityLevelCodes ; skos:topConceptOf dpp:GranularityLevelCodes ;
    skos:prefLabel "Individual battery"@en .

#################################################################
#  Properties used to annotate every attribute below
#################################################################

dpp:regulationReference a owl:AnnotationProperty ;
    rdfs:label "regulation reference"@en ;
    rdfs:comment "Citation of the regulation article(s) / standard clause(s) the attribute is grounded in (longlist column 'Regulation Reference')."@en .

dpp:unit a owl:AnnotationProperty ;
    rdfs:label "unit"@en ;
    rdfs:comment "Unit of measure or sign for the attribute value, where applicable."@en .

dpp:accessRights a owl:ObjectProperty ;
    rdfs:label "access rights"@en ;
    rdfs:range dpp:AccessRightsCodes ;
    rdfs:comment "Who may access the attribute's value, per Battery Regulation Art. 77."@en .

dpp:dataBehaviour a owl:ObjectProperty ;
    rdfs:label "data behaviour"@en ;
    rdfs:range dpp:DataBehaviourCodes ;
    rdfs:comment "Whether the attribute's value is fixed at creation (Static) or expected to change over the battery's life (Dynamic)."@en .

dpp:granularityLevel a owl:ObjectProperty ;
    rdfs:label "granularity level"@en ;
    rdfs:range dpp:GranularityLevelCodes ;
    rdfs:comment "Whether the attribute is defined at battery-model level or per individual battery."@en .

dpp:applicableTo a owl:ObjectProperty ;
    rdfs:label "applicable to"@en ;
    rdfs:range dpp:BatteryCategoryCodes ;
    rdfs:comment "Battery categories the attribute is required or recommended for. The exact requirement tier (mandatory per Battery Regulation 'x', mandatory per ESPR/JTC-24 '(x)', or voluntary 'o') per category is recorded verbatim in each property's skos:note."@en .

#################################################################
#  Content clusters (top-level classes, 1:1 with battery-pass: sections)
#################################################################

dpp:IdentifiersAndProductData a owl:Class ;
    rdfs:label "Identifiers and product data"@en ;
    skos:prefLabel "Identifiers and product data"@en .

dpp:SymbolsLabelsAndDocumentationOfConformity a owl:Class ;
    rdfs:label "Symbols, labels and documentation of conformity"@en ;
    skos:prefLabel "Symbols, labels and documentation of conformity"@en .

dpp:BatteryCarbonFootprint a owl:Class ;
    rdfs:label "Battery carbon footprint"@en ;
    skos:prefLabel "Battery carbon footprint"@en .

dpp:SupplyChainDueDiligence a owl:Class ;
    rdfs:label "Supply chain due diligence"@en ;
    skos:prefLabel "Supply chain due diligence"@en .

dpp:BatteryMaterialsAndComposition a owl:Class ;
    rdfs:label "Battery materials and composition"@en ;
    skos:prefLabel "Battery materials and composition"@en .

dpp:CircularityAndResourceEfficiency a owl:Class ;
    rdfs:label "Circularity and resource efficiency"@en ;
    skos:prefLabel "Circularity and resource efficiency"@en .

dpp:PerformanceAndDurability a owl:Class ;
    rdfs:label "Performance and durability"@en ;
    skos:prefLabel "Performance and durability"@en .

#################################################################
#  Sub-categories
#################################################################

dpp:IdentifiersAndProductData_DPPInformation a owl:Class ;
    rdfs:subClassOf dpp:IdentifiersAndProductData ;
    rdfs:label "DPP Information"@en ;
    skos:prefLabel "DPP Information"@en .

dpp:IdentifiersAndProductData_Identifier a owl:Class ;
    rdfs:subClassOf dpp:IdentifiersAndProductData ;
    rdfs:label "Identifier"@en ;
    skos:prefLabel "Identifier"@en .

dpp:IdentifiersAndProductData_ProductData a owl:Class ;
    rdfs:subClassOf dpp:IdentifiersAndProductData ;
    rdfs:label "Product data"@en ;
    skos:prefLabel "Product data"@en .

dpp:CircularityAndResourceEfficiency_CircularityInformation a owl:Class ;
    rdfs:subClassOf dpp:CircularityAndResourceEfficiency ;
    rdfs:label "Circularity Information"@en ;
    skos:prefLabel "Circularity Information"@en .

dpp:CircularityAndResourceEfficiency_RecycledAndRenewableContent a owl:Class ;
    rdfs:subClassOf dpp:CircularityAndResourceEfficiency ;
    rdfs:label "Recycled and renewable content"@en ;
    skos:prefLabel "Recycled and renewable content"@en .

dpp:CircularityAndResourceEfficiency_InformationOnRoleOfEndUsersInWastePreventionAndInformationOnBatteryCollectionPreparationForSecondLifeAndOnTreatmentAtEndOfLife a owl:Class ;
    rdfs:subClassOf dpp:CircularityAndResourceEfficiency ;
    rdfs:label "Information on role of end-users in waste prevention and information on battery collection, preparation for second life and on treatment at end of life"@en ;
    skos:prefLabel "Information on role of end-users in waste prevention and information on battery collection, preparation for second life and on treatment at end of life"@en .

dpp:PerformanceAndDurability_CapacityEnergyAndVoltage a owl:Class ;
    rdfs:subClassOf dpp:PerformanceAndDurability ;
    rdfs:label "Capacity, energy, and voltage"@en ;
    skos:prefLabel "Capacity, energy, and voltage"@en .

dpp:PerformanceAndDurability_PowerCapability a owl:Class ;
    rdfs:subClassOf dpp:PerformanceAndDurability ;
    rdfs:label "Power capability"@en ;
    skos:prefLabel "Power capability"@en .

dpp:PerformanceAndDurability_RoundTripEnergyEfficiencyAndSelfDischarge a owl:Class ;
    rdfs:subClassOf dpp:PerformanceAndDurability ;
    rdfs:label "Round trip energy efficiency and self-discharge"@en ;
    skos:prefLabel "Round trip energy efficiency and self-discharge"@en .

dpp:PerformanceAndDurability_InternalResistance a owl:Class ;
    rdfs:subClassOf dpp:PerformanceAndDurability ;
    rdfs:label "Internal resistance"@en ;
    skos:prefLabel "Internal resistance"@en .

dpp:PerformanceAndDurability_BatteryLifetime a owl:Class ;
    rdfs:subClassOf dpp:PerformanceAndDurability ;
    rdfs:label "Battery lifetime"@en ;
    skos:prefLabel "Battery lifetime"@en .

dpp:PerformanceAndDurability_TemperatureConditions a owl:Class ;
    rdfs:subClassOf dpp:PerformanceAndDurability ;
    rdfs:label "Temperature conditions"@en ;
    skos:prefLabel "Temperature conditions"@en .

dpp:PerformanceAndDurability_NegativeEvents a owl:Class ;
    rdfs:subClassOf dpp:PerformanceAndDurability ;
    rdfs:label "Negative events"@en ;
    skos:prefLabel "Negative events"@en .

#################################################################
#  Attributes (one owl:DatatypeProperty + skos:Concept per longlist row)
#################################################################

dpp:dPPSchemaVersion
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_DPPInformation ;
    rdfs:range xsd:string ;
    rdfs:label "DPP Schema version"@en ;
    skos:prefLabel "DPP Schema version"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "1" ;
    skos:definition "The reference standard the DPP instance schema refers to"@en ;
    skos:scopeNote "The reference standard the DPP instance schema refers to."@en ;
    skos:note """The DPP schema version should refer to the required standards for DPPs in the EU that apply to the DPP at hand.
The first version should refer to the standards introduced by JTC-24 when first published in the Official Journal of the EU.

Note:
It may also refer to versions of a future reference dictionary of a battery passport, which is not defined at this moment but indicated as a requirement in JTC-24 draft standards."""@en ;
    dpp:regulationReference "JTC-24 prEN_18223 (4.1.3.1 Table 1) (draft)" ;
    dpp:dataFormat "String" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: (x); LMT: (x); Other Industrial >2kWh: (x); Stationary >2kWh: (x)" .

dpp:dPPStatus
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_DPPInformation ;
    rdfs:range xsd:string ;
    rdfs:label "DPP Status"@en ;
    skos:prefLabel "DPP Status"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "2" ;
    skos:definition "The current status of the DPP as a digital resource"@en ;
    skos:scopeNote """The status of the DPP instance as digital resource.
Example: \"Active\", \"Archived\""""@en ;
    skos:note """The options for DPP status should be defined as
- Active: current version of the battery passport
- Archived: past version of the battery passport, archived after an update.
- Inactive: A battery passport linked to a new battery passport, which has a different DPP status than 'Inactive', after reuse, repurposing, remanufacturing.
- Marked-for-deletion: a battery passport that has been marked for deletion after recycling or export of the battery"""@en ;
    dpp:regulationReference "JTC-24 prEN_18223 (4.1.3.1 Table 1) (draft)" ;
    dpp:dataFormat "String" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: (x); LMT: (x); Other Industrial >2kWh: (x); Stationary >2kWh: (x)" .

dpp:dPPGranularity
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_DPPInformation ;
    rdfs:range xsd:string ;
    rdfs:label "DPP Granularity"@en ;
    skos:prefLabel "DPP Granularity"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "3" ;
    skos:definition "The required level of information with regard to product item, batch or model"@en ;
    skos:scopeNote """The level of granularity of the ProductID as per ESPR: model, batch or item
In the Battery passport the value shall be 'Item' as each battery will have an individual battery passport."""@en ;
    dpp:regulationReference "JTC-24 prEN_18223 (4.1.3.1 Table 1) (draft)" ;
    dpp:dataFormat "String" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: (x); LMT: (x); Other Industrial >2kWh: (x); Stationary >2kWh: (x)" .

dpp:dateTimeOfLatestUpdateOfDPP
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_DPPInformation ;
    rdfs:range xsd:dateTime ;
    rdfs:label "Date-time of latest update of DPP"@en ;
    skos:prefLabel "Date-time of latest update of DPP"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "4" ;
    skos:definition "Date and time of the latest update of the battery passport"@en ;
    skos:scopeNote "The date and time of the latest update to the DPP instance."@en ;
    skos:note """This timestamp should reflect updates of mandatory and voluntary data in the battery passport.

This time stamp should reflect the date-time of external DPP availability, i.e. when the last update of the DPP has been first made available to third parties.

Note: A time stamp, which may reflect date-time when an information in the DPP has been generated, should be provided as meta data to each data attribute."""@en ;
    dpp:regulationReference "JTC-24 prEN_18223 (4.1.3.1 Table 1) (draft)" ;
    dpp:dataFormat """Timestamp
UTC-based""" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement "upon any update of the battery passport" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: (x); LMT: (x); Other Industrial >2kWh: (x); Stationary >2kWh: (x)" .

dpp:uniqueBatteryPassportIdentifierUniqueDPPIdentifier
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_Identifier ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Unique battery passport identifier / unique DPP identifier"@en ;
    skos:prefLabel "Unique battery passport identifier / unique DPP identifier"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "5" ;
    skos:definition "The unique identifier of a battery passport, equivalent to the unique DPP identifier in JTC-24 draft standards"@en ;
    skos:scopeNote """The unique battery passport identifier / unique DPP identifier serves distinction and identification of archived versions and should resolve to one specific version of a battery passport.

Note: The JTC-24 standards foresee an archiving function for DPPs after updates (exceptions to dynamic data may apply).

Note: A new battery passport version after an update will obtain a new unique battery passport identifier / unique DPP identifier. The previous unique battery passport identifier / unique DPP identifier will be archived together with its previous battery passport version. The initial unique battery passport identifier / unique DPP identifier, likely to be stored in the EU DPP registry, therefore always resolves to the first version of a battery passport."""@en ;
    dpp:regulationReference """Art. 77(3) and (10); Art. 3(66);
JTC-24 prEN_18222 (4.2) & prEN_18223 (4.1.3.1 Table 1 and 4.2) (draft)""" ;
    dct:relation "DIN DKE Spec 99100 6.1.2.1" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement "upon any update of the battery passport that includes archiving" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:uniqueBatteryIdentifierUniqueProductIdentifier
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_Identifier ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Unique battery identifier / unique product identifier"@en ;
    skos:prefLabel "Unique battery identifier / unique product identifier"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "6" ;
    skos:definition "The unique identifier of the battery item, equivalent to the unique product identifier in JTC-24 draft standards"@en ;
    skos:scopeNote """A battery passport must include information identifying the battery. The battery passport must be accessible through the QR code […] which links to a persistent unique battery identifier. The battery identifier is a unique string of characters for the identification of batteries that also enables a link to the battery passport.

The battery identifier must comply with ISO/IEC 15459 1:2014, ISO/IEC 15459 2:2015, ISO/IEC 15459 3:2014, ISO/IEC 15459 4:2014, ISO/IEC 15459 5:2014, ISO/IEC 15459 6:2014, or their equivalent.

It shall be based on a URI/URL structure.
Note: According to JTC-24 prEN_18219 (4.) describes the unique product identifier (here: unique battery identifier  shall follow the following principles: (4.1) globally uniqueness, (4.2) persistence, (4.3) syntax, (4.4) semantic, (4.5) Interoperability and (4.6) Openness.

The economic operator placing the battery on the market must attribute the battery identifier to it.

Note: The unique battery identifier / unique product identifier must also be provided on the battery label. Where the size or nature of the battery does not allow it, the required information must be provided on the packaging or in a document accompanying the battery."""@en ;
    skos:note """The unique battery identifier / unique product identifier may include the information requirement on the battery model identifier as well as that of the battery batch or serial number, or product number or another element allowing the battery's identification.

Such information shall be clearly distinguishable in the chosen format of the identification scheme."""@en ;
    dpp:regulationReference """Art. 77(3); Art. 3(66);
JTC-24 prEN_18219,
JTC-24 prEN_18222 (4.2) & prEN_18223 (4.1.3.1 Table 1)""" ;
    dct:relation "DIN DKE Spec 99100 6.1.2.2" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:batteryModelIdentifier
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_Identifier ;
    rdfs:range xsd:string ;
    rdfs:label "Battery model identifier"@en ;
    skos:prefLabel "Battery model identifier"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "7" ;
    skos:definition "The unique identifier of the battery model."@en ;
    skos:scopeNote """The battery model identifier is a shared property of batteries that belong to the same battery model, which is a version of a battery all units of which share the same technical characteristics relevant for the requirements of the Battery Regulation on sustainability, safety, labelling,marking and information.


Note: The model identifier is a unique string of characters and required in the Draft for the CF declaration IA."""@en ;
    skos:note """The model identifier should be provided to allow attributing data on model level in the battery passport to the specific battery model.

The model identifier may be part of the unique battery identifier / unique product identifier, if clearly distinguishable in the chosen format of the identification scheme.

The model identifier may include the information requirement on the battery serial number, including identification of the the battery batch, if clearly distinguishable in the chosen format of the identification scheme.

Note: Independently of the battery passport, batteries to be placed on the market must bear a model identification."""@en ;
    dpp:regulationReference "Article 3(19); CF declaration IA (draft)" ;
    dpp:dataFormat "ID (string)" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:batterySerialNumber
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_Identifier ;
    rdfs:range xsd:string ;
    rdfs:label "Battery serial number"@en ;
    skos:prefLabel "Battery serial number"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "8" ;
    skos:definition "Serial number of the battery including information on the battery batch"@en ;
    skos:scopeNote """Note: The following requirements of the battery regulation, not directly addressing the battery passport, should be considered:
Manufacturers shall ensure that batteries which they place on the market bear a model identification and batch or serial number, or product number or another element allowing their identification. Where the size or nature of the battery does not allow it, the required information shall be provided on the packaging or in a document accompanying the battery.
The Declaration of Conformity requires the following information (among other information): \"Battery model (product, category, and batch or serial number):\""""@en ;
    skos:note """The serial number of the battery should be included to enable identification on batch and item level to attribute reporting requirements on that level to the respective batch or item (as column T describes for each data attribute).

The serial number should include identification of the battery batch, clearly distinguishable in the format of the identification scheme.

The serial number including the battery batch identification may also be part of unique battery identifier / unique product identifier or the battery model identifier, if clearly distinguishable in the chosen format."""@en ;
    dpp:regulationReference "Article 38(6); Annex IX, 1" ;
    dpp:dataFormat "ID (string)" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:uniqueEconomicOperatorIdentifier
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_Identifier ;
    rdfs:range xsd:string ;
    rdfs:label "Unique economic operator identifier"@en ;
    skos:prefLabel "Unique economic operator identifier"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "9" ;
    skos:definition "The unique identifier of the economic operator"@en ;
    skos:scopeNote """A battery passport must include an operator identifier. The operator identifier is a unique string of characters for the identification of actors involved in the value chain of products (see ESPR, Article 2(31)). It corresponds to the economic operator responsible for creating or updating the battery passport.

Where a unique operator identifier is not yet available, “the economic operator that creates or updates the digital product passport shall request a unique operator identifier on behalf of the relevant actor.” (see ESPR, Article 12(2)).

The unique operator identifier must, where relevant for the products concerned, comply with ISO/IEC 15459 1:2014, ISO/IEC 15459 2:2015, ISO/IEC 15459 3:2014, ISO/IEC 15459 4:2014, ISO/IEC 15459 5:2014, ISO/IEC 15459 6:2014, or their equivalent until referenced harmonised standards are listed in the Official Journal of European Union (OJEU). (see also ESPR Annex III)"""@en ;
    skos:note "When necessary, [an] economic operator [...] is assigned a globally unique economic operator identifier [...]. (see JTC-24 prEN_18219)"@en ;
    dpp:regulationReference """ESPR Art. 2 (31), 12 (2); Annex XIII (1a) Annex VI Part A; Art. 3(66); Art. 77 (3)
JTC-24 prEN_18219 (4.1.1.1) (draft)""" ;
    dct:relation "DIN DKE Spec 99100 6.1.2.3" ;
    dpp:dataFormat "ID (string)" ;
    dpp:accessRights dpp:NotifiedBodiesMarketSurveillanceAuthoritiesAndCommission ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: (x); LMT: (x); Other Industrial >2kWh: (x); Stationary >2kWh: (x)" .

dpp:uniqueManufacturerIdentifier
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_Identifier ;
    rdfs:range xsd:string ;
    rdfs:label "Unique manufacturer identifier"@en ;
    skos:prefLabel "Unique manufacturer identifier"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "10" ;
    skos:definition "The unique identifier of the manufacturer of the battery."@en ;
    skos:scopeNote "The unique manufacturer identifier must, where relevant for the products concerned, comply with ISO/IEC 15459 1:2014, ISO/IEC 15459 2:2015, ISO/IEC 15459 3:2014, ISO/IEC 15459 4:2014, ISO/IEC 15459 5:2014, ISO/IEC 15459 6:2014, or equivalent European or international standards until referenced harmonised standards are listed in the OJEU (see also ESPR Annex III)."@en ;
    skos:note """Information related to the manufacturer, such as its unique operator identifier and the information referred to in Article 27(7) must or can be specified (see ESPR Annex III (g)).

When necessary, [an] economic operator [...] is assigned a globally unique economic operator identifier [...]. (see JTC-24 prEN_18219)"""@en ;
    dpp:regulationReference "Annex VI Part A (1); Art. 38(7); ESPR Art. 2(32); ESPR Art. 12(1); ESPR Annex III" ;
    dct:relation "DIN DKE Spec 99100 6.1.2.4" ;
    dpp:dataFormat "ID (string)" ;
    dpp:accessRights dpp:NotifiedBodiesMarketSurveillanceAuthoritiesAndCommission ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:uniqueFacilityIdentifier
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_Identifier ;
    rdfs:range xsd:string ;
    rdfs:label "Unique facility identifier"@en ;
    skos:prefLabel "Unique facility identifier"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "11" ;
    skos:definition "The unique identifier of a facility"@en ;
    skos:scopeNote """A unique facility identifier is a unique string of characters for the identification of locations or buildings involved in a product’s value chain or used by actors involved in a product’s value chain. (JTC-24 prEN_18219 (3.20))

The unique facility identifiers shall, where relevant for the products concerned, comply with standards ISO/IEC 15459-1:2014, ISO/IEC 15459-2:2015, ISO/IEC 15459-3:2014, ISO/IEC 15459-4:2014, ISO/IEC 15459-5:2014 and ISO/IEC 15459-6:2014. (ESPR Annex III)"""@en ;
    skos:note """A unique facility identifier can be used for the unique identification of the manufacturing place.

When necessary, facility is assigned a globally unique facility identifier. (JTC-24 prEN_18219 (4.1.1))"""@en ;
    dpp:regulationReference "JTC-24 prEN_18219 (3.20) (draft); JTC-24 prEN_18219 (draft); ESPR Annex III" ;
    dct:relation "DIN DKE Spec 99100 6.1.3.1" ;
    dpp:dataFormat "ID (string)" ;
    dpp:accessRights dpp:NotifiedBodiesMarketSurveillanceAuthoritiesAndCommission ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: (x); LMT: (x); Other Industrial >2kWh: (x); Stationary >2kWh: (x)" .

dpp:economicOperatorInformation
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_ProductData ;
    rdfs:range xsd:string ;
    rdfs:label "Economic operator information"@en ;
    skos:prefLabel "Economic operator information"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "12" ;
    skos:definition "Information related to the economic operator"@en ;
    skos:note """If different from the manufacturer, information on the economic operator should be included:
- name
- registered trade name or registered trademark;
- postal address, indicating a single contact point;
- web address, if available; and
- e-mail address, if available.

The contact details must be indicated in a language or languages which can be easily understood by end-users and market surveillance authorities."""@en ;
    dpp:regulationReference "Art. 3, 1(22)" ;
    dct:relation "DIN DKE Spec 99100 6.1.2.3" ;
    dpp:dataFormat "String" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:manufacturerInformation
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_ProductData ;
    rdfs:range xsd:string ;
    rdfs:label "Manufacturer information"@en ;
    skos:prefLabel "Manufacturer information"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "13" ;
    skos:definition "Information related to the manufacturer of the battery"@en ;
    skos:scopeNote """A battery passport must include information identifying the manufacturer.

The manufacturer information must also be provided on the battery label. Where it is not possible to indicate the required information on the battery, it must be provided on the packaging or in a document accompanying the battery.

The manufacturer information must include:
- name;
- registered trade name or registered trademark;
- postal address, indicating a single contact point;
- web address, if available; and
- e-mail address, if available.

The contact details must be indicated in a language or languages which can be easily understood by end-users and market surveillance authorities."""@en ;
    dpp:regulationReference "Annex VI Part A (1); Art. 3, 1(33); Art. 38(7)" ;
    dct:relation "DIN DKE Spec 99100 6.1.2.4" ;
    dpp:dataFormat "String" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:manufacturingPlace
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_ProductData ;
    rdfs:range xsd:string ;
    rdfs:label "Manufacturing place"@en ;
    skos:prefLabel "Manufacturing place"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "14" ;
    skos:definition "The place of manufacture of the battery"@en ;
    skos:scopeNote """A battery passport must include the manufacturing place (geographical location of a battery manufacturing plant). It must be indicated as town, region and country/jurisdiction.

The manufacturing place must also be provided on the battery label."""@en ;
    skos:note """The manufacturing place should be uniquely identifiable. A unique facility identifier can be used for this purpose.

The address of the manufacturing place (country, city, street, or even building if several facilities operate under one address) should be provided in text form."""@en ;
    dpp:regulationReference "Annex XIII (1a); Annex VI, Part A(3); Labelling IA (draft)" ;
    dct:relation "DIN DKE Spec 99100 6.1.3.1" ;
    dpp:dataFormat "String" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:manufacturingDate
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_ProductData ;
    rdfs:range xsd:gYearMonth ;
    rdfs:label "Manufacturing date"@en ;
    skos:prefLabel "Manufacturing date"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "15" ;
    skos:definition "The date of manufacture of the battery"@en ;
    skos:scopeNote """A battery passport must include the date of manufacture (month and year).

The manufacturing date must also be provided on the battery label.

The manufacturing date must consist of the month and year of the date of manufacture."""@en ;
    skos:note """The manufacturing date should not only relate to the battery model, but to the battery item.

The date code should comply with DIN ISO 8601 1:2020 12 and ISO 8601 2:2019."""@en ;
    dpp:regulationReference "Annex XIII (1a); Annex VI Part A (4); Annex VII Part B (1); Labelling IA (draft)" ;
    dct:relation "DIN DKE Spec 99100 6.1.3.2" ;
    dpp:dataFormat "Date[YYYY-MM]" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:dateOfPuttingTheBatteryIntoService
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_ProductData ;
    rdfs:range xsd:gYearMonth ;
    rdfs:label "Date of putting the battery into service"@en ;
    skos:prefLabel "Date of putting the battery into service"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "16" ;
    skos:definition "The date of first use, for its intended purpose, in the European Union, of a battery, without having been previously placed on the market"@en ;
    skos:scopeNote "Where appropriate, the battery passport must include information on the date of putting the battery into service."@en ;
    dpp:regulationReference "Annex VII Part B (1)" ;
    dct:relation "DIN DKE Spec 99100 6.1.3.3" ;
    dpp:dataFormat "Date[YYYY-MM]" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: o; LMT: x; Other Industrial >2kWh: o; Stationary >2kWh: x" .

dpp:warrantyPeriodOfTheBattery
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_ProductData ;
    rdfs:range xsd:gYearMonth ;
    rdfs:label "Warranty period of the battery"@en ;
    skos:prefLabel "Warranty period of the battery"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "17" ;
    skos:definition "Commercial warranty period for the battery"@en ;
    skos:scopeNote "The battery passport must include information about the period for which the commercial warranty applies."@en ;
    dpp:regulationReference "Annex XIII (1m)" ;
    dct:relation "DIN DKE Spec 99100 6.1.3.4" ;
    dpp:dataFormat "Date[YYYY-MM]" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:batteryCategory
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_ProductData ;
    rdfs:range xsd:string ;
    rdfs:label "Battery category"@en ;
    skos:prefLabel "Battery category"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "18" ;
    skos:definition "Description of the scope of application of a battery in terms of its use according to the battery regulation"@en ;
    skos:scopeNote """A battery passport must include the battery category.

The battery category must be provided on the battery label.

The battery must be categorised by its intended use in:
- LMT battery;
- electric vehicle battery; or
- industrial battery (stationary battery energy storage system/other industrial batteries)."""@en ;
    dpp:regulationReference "Annex XIII (1a); Annex VI Part A (2)" ;
    dct:relation "DIN DKE Spec 99100 6.1.3.5" ;
    dpp:dataFormat "String" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:batteryMass
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_ProductData ;
    rdfs:range xsd:decimal ;
    rdfs:label "Battery mass"@en ;
    skos:prefLabel "Battery mass"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "19" ;
    skos:definition "The mass of the battery"@en ;
    skos:scopeNote """A battery passport must include the battery weight.
Note: In all other instances we use the term mass instead of weight, which is used in the regulation: Regulatory requirements define the unit as kg or g per regulation and the physically correct term is then mass.

The battery mass must also be provided on the battery label."""@en ;
    skos:note "The mass of  modules and/or cells should also be specified."@en ;
    dpp:regulationReference "Annex XIII (1a); Annex VI Part A (5); Labelling IA (draft)" ;
    dct:relation "DIN DKE Spec 99100 6.1.3.6" ;
    dpp:unit "g or kg" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:batteryStatus
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:IdentifiersAndProductData_ProductData ;
    rdfs:range xsd:string ;
    rdfs:label "Battery status"@en ;
    skos:prefLabel "Battery status"@en ;
    skos:inScheme dpp:IdentifiersAndProductData ;
    dct:identifier "20" ;
    skos:definition "Current status of the battery item in its life cycle"@en ;
    skos:scopeNote """A battery passport must include information on the status of the battery.

The status of the battery must be defined as ‘original’, ‘repurposed’, ‘re-used’, ‘remanufactured’ or ‘waste’.

A new battery passport must be issued when a battery was subject to remanufacturing, repurpose or one of the treatment operations preparing for re-use and preparing for repurpose and is placed on the market again."""@en ;
    skos:note """Additionally to the battery status, the battery’s repair history shall be included.

The repair of a battery shall be made transparent and be recorded as “repaired” under the battery status “re-used”."""@en ;
    dpp:regulationReference "Annex XIII 4(c)" ;
    dct:relation "DIN DKE Spec 99100 6.1.3.7" ;
    dpp:dataFormat "String" ;
    dpp:accessRights dpp:PersonsWithLegitimateInterest ;
    dpp:dataBehaviour dpp:Dynamic ;
    dpp:updateRequirement "upon placement on market and battery status change" ;
    dpp:granularityLevel dpp:IndividualBattery ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:separateCollectionSymbol
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:SymbolsLabelsAndDocumentationOfConformity ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Separate collection symbol"@en ;
    skos:prefLabel "Separate collection symbol"@en ;
    skos:inScheme dpp:SymbolsLabelsAndDocumentationOfConformity ;
    dct:identifier "21" ;
    skos:definition "Symbol indicating the necessity of separate collection"@en ;
    skos:scopeNote """The battery passport must include the symbol for separate collection.

All batteries must be marked on the label with the symbol for separate collection from 18 August 2025.

The separate collection symbol must cover at least 3 % of the area of the largest side of the battery with a maximum size of (5 × 5) cm2.

For Cylindrical battery cells: The symbol must cover at least 1,5 % of the surface area of the battery and with a maximum size of (5 × 5) cm2.

Where the symbol would be smaller than (0,47 × 0,47) cm2, the battery does not need to be marked with it. Instead, the symbol measuring at least (1 × 1) cm2 must be printed on the packaging."""@en ;
    skos:note "The symbol should be translated into text to ensure machine readability."@en ;
    dpp:regulationReference "Annex XIII (1s); Art. 13(4);  Annex VI Part B" ;
    dct:relation "DIN DKE Spec 99100 6.2.2" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:symbolsForCadmiumAndLead
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:SymbolsLabelsAndDocumentationOfConformity ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Symbols for cadmium and lead"@en ;
    skos:prefLabel "Symbols for cadmium and lead"@en ;
    skos:inScheme dpp:SymbolsLabelsAndDocumentationOfConformity ;
    dct:identifier "22" ;
    skos:definition "Representation of the chemical symbol “Cd” for cadmium and “Pb” for lead contained in the battery"@en ;
    skos:scopeNote """The battery passport must include information regarding the prevention and management of waste batteries including the meaning of the labels and symbols on batteries or printed on their packaging or in the documents accompanying batteries.

Batteries containing more than 0,002 % cadmium or more than 0,004 % lead, must be marked with the chemical symbol for the metal concerned: Cd or Pb.

The symbols for cadmium and lead must also be provided on the battery label.

The relevant chemical symbol indicating the heavy metal content must be printed beneath the separate collection symbol and must cover an area of at least one-quarter the size of that symbol."""@en ;
    skos:note "The symbol should be translated into text to ensure machine readability of the battery passport."@en ;
    dpp:regulationReference "Annex XIII (1s) Art. 13(5);" ;
    dct:relation "DIN DKE Spec 99100 6.2.3" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:carbonFootprintLabel
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:SymbolsLabelsAndDocumentationOfConformity ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Carbon footprint label"@en ;
    skos:prefLabel "Carbon footprint label"@en ;
    skos:inScheme dpp:SymbolsLabelsAndDocumentationOfConformity ;
    dct:identifier "23" ;
    skos:definition "Label indicating the carbon footprint and carbon footprint performance class"@en ;
    skos:scopeNote """EV batteries, rechargeable industrial batteries > 2 kWh and LMT batteries shall bear a conspicuous, clearly legible and indelible label indicating the carbon footprint and declaring the carbon footprint performance class to which the relevant battery model per manufacturing plant corresponds.

The format of the label is described in the Labelling IA and shall include:

Reference to the relevant delegated act establishing the carbon footprint performance classes according to Article 7(2), fourth subparagraph, point (a) of Regulation (EU) 2023/1542 of the relevant battery category;

Declaration of the carbon footprint performance class based on the relevant delegated act establishing the carbon footprint performance classes;

Declared life-cycle carbon footprint expressed in a resolution of two significant figures in accordance with the methodology set out in the relevant delegated acts;

The functional unit in accordance with the methodology set out in the relevant delegated acts adopted by the Commission."""@en ;
    skos:note """The carbon footprint label should be displayed directly in the battery passport in addition to the data in the documentation.

The label should be translated into text/numbers to ensure machine readability of the battery passport.

For the content and calculation of the carbon footprint, see 6.3.2 \"Battery carbon footprint per Functional Unit\" and 6.3.4 \"Contribution of main product production/manufacturing lifecycle stage\"."""@en ;
    dpp:regulationReference "Article 7(2) via Annex XIII (1c); Labelling IA (draft) Annex V" ;
    dct:relation "DIN DKE Spec 99100 6.2.4" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:extinguishingAgent
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:SymbolsLabelsAndDocumentationOfConformity ;
    rdfs:range xsd:string ;
    rdfs:label "Extinguishing agent"@en ;
    skos:prefLabel "Extinguishing agent"@en ;
    skos:inScheme dpp:SymbolsLabelsAndDocumentationOfConformity ;
    dct:identifier "24" ;
    skos:definition "Specification of the usable extinguishing agent"@en ;
    skos:scopeNote """A battery passport must include the usable extinguishing agent or if relevant, the fire class of that agent determined in accordance with standard EN 2:2005

The usable extinguishing agent must also be provided on the battery label."""@en ;
    skos:note """Where applicable, the extinguishing agent category should be indicated.

The information on the usable extinguishing agent should be related to their possible area of application as regulated in DIN EN 2."""@en ;
    dpp:regulationReference "Annex VI Part A (9); Labelling IA (draft)" ;
    dct:relation "DIN DKE Spec 99100 6.2.5" ;
    dpp:dataFormat "String" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:meaningOfLabelsAndSymbols
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:SymbolsLabelsAndDocumentationOfConformity ;
    rdfs:range xsd:string ;
    rdfs:label "Meaning of labels and symbols"@en ;
    skos:prefLabel "Meaning of labels and symbols"@en ;
    skos:inScheme dpp:SymbolsLabelsAndDocumentationOfConformity ;
    dct:identifier "25" ;
    skos:definition "Brief and easily understandable explanatory sentence conveying the meaning of symbols and labels used"@en ;
    skos:scopeNote """The battery passport must include information regarding the prevention and management of waste batteries including the meaning of the labels and symbols on batteries or printed on their packaging or in the documents accompanying batteries.

The information must be communicated in (a) language(s) easily understood by end-users.

All labels and symbols used in the battery label must be accompanied by a brief and easily understandable explanatory sentence."""@en ;
    skos:note """The meaning of labels and symbols shall be provided on the battery label or shall be included in the documentation accompanying the battery.

The meaning of all symbols and labels on the battery or/and in the battery passport should be explained.

The explanatory texts should be agreed on across industry to ease the implementation and ensure comprehensibility for the public."""@en ;
    dpp:regulationReference "Annex XIII (1s);Art. 74 1(e); Labelling IA (draft)" ;
    dct:relation "DIN DKE Spec 99100 6.2.6" ;
    dpp:dataFormat "String" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:eUDeclarationOfConformity
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:SymbolsLabelsAndDocumentationOfConformity ;
    rdfs:range xsd:anyURI ;
    rdfs:label "EU declaration of conformity"@en ;
    skos:prefLabel "EU declaration of conformity"@en ;
    skos:inScheme dpp:SymbolsLabelsAndDocumentationOfConformity ;
    dct:identifier "26" ;
    skos:definition "The document that declares compliance with requirements for placement on EU market"@en ;
    skos:scopeNote """A battery passport must include the EU declaration of conformity.

The regulation specifies the following requirements regarding the EU declaration of conformity (see BattReg Annex XIII (1r) and BattReg Article 18 (2)):

- The EU declaration of conformity has the model structure set out in Annex IX.
- The EU declaration of conformity must contain the elements specified in the relevant modules set out in Annex VIII.
- The EU declaration of conformity must be kept up to date.
- It is translated into the language or languages required by the Member State in which the battery is placed or made available on the market or put into service.
- It must be drawn up in electronic format and, where requested, it must be provided in paper format."""@en ;
    skos:note """The document that declares compliance with the EU requirements and assumes responsibility should be uploaded into the battery passport.

The ID of the EU declaration of conformity should also be displayed in addition to the document.

The CE marking pictogram should be included in the battery passport."""@en ;
    dpp:regulationReference "Annex XIII (1r); Art. 18; Annex IX" ;
    dct:relation "DIN DKE Spec 99100 6.2.7" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:resultsOfTestReportsProvingCompliance
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:SymbolsLabelsAndDocumentationOfConformity ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Results of test reports proving compliance"@en ;
    skos:prefLabel "Results of test reports proving compliance"@en ;
    skos:inScheme dpp:SymbolsLabelsAndDocumentationOfConformity ;
    dct:identifier "27" ;
    skos:definition "Test report results proving compliance with the requirements stated in the battery regulation"@en ;
    skos:scopeNote "A battery passport must include the test report results that can prove the compliance with the requirements stated in the battery regulation."@en ;
    skos:note "A placeholder for the reference to the test reports should be included as the format or specific contents of the test reports are not further specified yet."@en ;
    dpp:regulationReference "Annex XIII (3); Annex VIII Part A 2(h)" ;
    dct:relation "DIN DKE Spec 99100 6.2.8" ;
    dpp:dataFormat "URI/URL" ;
    dpp:accessRights dpp:NotifiedBodiesMarketSurveillanceAuthoritiesAndCommission ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:batteryCarbonFootprintPerFunctionalUnit
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:BatteryCarbonFootprint ;
    rdfs:range xsd:decimal ;
    rdfs:label "Battery carbon footprint per Functional Unit"@en ;
    skos:prefLabel "Battery carbon footprint per Functional Unit"@en ;
    skos:inScheme dpp:BatteryCarbonFootprint ;
    dct:identifier "28" ;
    skos:definition "The battery carbon footprint must be included as declared in terms of kg of carbon dioxide equivalent per one kWh of the total energy provided by the battery over its expected service life."@en ;
    skos:scopeNote "The battery passport must contain carbon footprint per functional unit of the battery as declared in the battery carbon footprint declaration in accordance with the entry into force of the implementing acts on the format of declaration."@en ;
    skos:note "The carbon footprint of the battery shall also be differentiated as contribution of the lifecycle stages to the battery carbon footprint (see separate data attributes)"@en ;
    dpp:regulationReference "Annex XIII (1c) → Art. 7; EV CF DA (draft); CF declaration IA (draft)" ;
    dct:relation "DIN DKE Spec 99100 6.3.2" ;
    dpp:unit "kgCO2eq/kWh" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:contributionOfRawMaterialAcquisitionAndPreProcessingLifecycleStage
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:BatteryCarbonFootprint ;
    rdfs:range xsd:decimal ;
    rdfs:label "Contribution of raw material acquisition and pre-processing lifecycle stage"@en ;
    skos:prefLabel "Contribution of raw material acquisition and pre-processing lifecycle stage"@en ;
    skos:inScheme dpp:BatteryCarbonFootprint ;
    dct:identifier "29" ;
    skos:definition "Contribution of raw material acquisition and pre-processing lifecycle stage to the battery carbon footprint"@en ;
    skos:scopeNote """A battery passport must include the contribution of the lifecycle stage “Raw material acquisition and pre-processing” in the battery carbon footprint.

The system boundaries and reporting requirements are specified in the delegated acts for the carbon footprint methodology outlined in \"Battery carbon footprint per Functional Unit\"

The same mandatory requirements as for \"Battery carbon footprint per Functional Unit\" are required for this data point."""@en ;
    dpp:regulationReference "Annex XIII (1c) → Art. 7; Annex II (4); EV CF DA (draft); CF declaration IA (draft)" ;
    dct:relation "DIN DKE Spec 99100 6.3.3" ;
    dpp:unit "kgCO2eq/kWh" ;
    dpp:dataFormat "Decimal" ;
    dpp:accessRights dpp:Public ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModelPerCalendarYearAndManufacturingSite ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

