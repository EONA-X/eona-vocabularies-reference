dpp:informationOnSourcesOfSpareParts
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:CircularityAndResourceEfficiency_CircularityInformation ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Information on sources of spare parts"@en ;
    skos:prefLabel "Information on sources of spare parts"@en ;
    skos:inScheme dpp:CircularityAndResourceEfficiency ;
    dct:identifier "46" ;
    skos:definition "Information on how to contact sources of spare parts"@en ;
    skos:scopeNote "A battery passport must include contact details of sources for spare parts (replacement spares)."@en ;
    skos:note """As part of their contact details, economic operators should indicate a postal and, if available, email and website address.

The postal address, e-mail address and web address of the sources for spare parts should be provided together with the part numbers of components.

The information on spare parts should be provided within the two manuals in 6.6.1.2."""@en ;
    dpp:regulationReference "Annex XIII (2b);" ;
    dct:relation "DIN DKE Spec 99100 6.6.1.4" ;
    dpp:dataFormat "URI/URL" ;
    dpp:dataBehaviour dpp:Static ;
    dpp:granularityLevel dpp:BatteryModel ;
    dpp:granularityLevelDetail "Pack: x" ;
    dpp:applicableTo dpp:ElectricVehicleBattery, dpp:LightMeansOfTransportBattery, dpp:OtherIndustrialBatteryAbove2kWh, dpp:StationaryIndustrialBatteryAbove2kWh ;
    skos:example "Applicability — EV: x; LMT: x; Other Industrial >2kWh: x; Stationary >2kWh: x" .

dpp:safetyMeasures
    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:CircularityAndResourceEfficiency_CircularityInformation ;
