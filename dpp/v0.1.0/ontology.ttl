    a owl:DatatypeProperty, skos:Concept ;
    rdfs:isDefinedBy dpp: ;
    rdfs:domain dpp:BatteryCarbonFootprint ;
    rdfs:range xsd:decimal ;
    rdfs:label "Contribution of distribution lifecycle stage"@en ;
    skos:prefLabel "Contribution of distribution lifecycle stage"@en ;
    skos:inScheme dpp:BatteryCarbonFootprint ;
    dct:identifier "31" ;
    skos:definition "Contribution of the distribution lifecycle stage to the battery's carbon footprint"@en ;
    skos:scopeNote """A battery passport must include the contribution of the lifecycle stage “Distribution” in the battery carbon footprint.

The system boundaries and reporting requirements are specified in the delegated acts for the carbon footprint methodology outlined in \"Battery carbon footprint per Functional Unit\"

The same mandatory requirements as for \"Battery carbon footprint per Functional Unit\" are required for this data point."""@en ;
    dpp:regulationReference "Annex XIII 1(c) → Art. 7; Annex II (4); EV CF DA (draft); CF declaration IA (draft)" ;
    dct:relation "DIN DKE Spec 99100 6.3.5" ;
