<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ModificationSetEnumeration/all> a netex:ModificationSetEnumeration, skos:Concept ;
    skos:definition "This includes definitions of one or more new entities."@en ;
    skos:inScheme netex:ModificationSetEnumeration ;
    skos:notation "all" ;
    skos:prefLabel "all" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ModificationSetEnumeration/changesOnly> a netex:ModificationSetEnumeration, skos:Concept ;
    skos:definition "This is just the modifications (addition, revision, deletion); entities which are unchanged are omitted."@en ;
    skos:inScheme netex:ModificationSetEnumeration ;
    skos:notation "changesOnly" ;
    skos:prefLabel "changesOnly" .

