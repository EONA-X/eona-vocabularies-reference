    schema:rangeIncludes netex:BlockPart, netex:TrainBlockPart ;
    rdfs:comment "BLOCK PARTS in BLOCK."@en ;
    rdfs:domain netex:Block ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    skos:notation "blockParts" .

