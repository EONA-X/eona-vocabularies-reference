    rdfs:range netex:PercentageType ;
    skos:notation "OccupancyPercentage" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyValuesGroup.OnboardCount> a owl:DatatypeProperty, owl:FunctionalProperty ;
