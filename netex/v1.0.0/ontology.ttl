<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneProjection_VersionStructure.ProjectedZoneRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "ProjectedZoneRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_genericFramework/netex_zoneProjection_version.xsd> ;
    rdfs:comment "ZONE being projected."@en ;
    rdfs:domain netex:ZoneProjection ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:Zone ;
    skos:notation "ProjectedZoneRef" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneProjection_VersionStructure.points> a owl:ObjectProperty ;
    rdfs:label "points" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_genericFramework/netex_zoneProjection_version.xsd> ;
    rdfs:comment "Sequence of points making up PROJECTION."@en ;
    rdfs:domain netex:ZoneProjection ;
