netex:RailwayElement a owl:Class ;
    rdfs:label "RailwayElement" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_networkDescription/netex_networkInfrastructure_version.xsd> ;
    rdfs:comment "A type of INFRASTRUCTURE LINK used to describe a RAILWAY network."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#RailwayElementGroup.FromPointRef> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#RailwayElementGroup.ToPointRef> ], netex:InfrastructureLink, netex:Link ;
    skos:hiddenLabel "RailwayElement_VersionStructure" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#RailwayElementGroup.FromPointRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "FromPointRef" ;
