    skos:notation "BoardingPosition" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#PassengerStopAssignmentGroup.BoardingPositionRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "BoardingPositionRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_stopAssignment_version.xsd> ;
    rdfs:comment "Reference to a BOARDING POSITION."@en ;
    rdfs:domain netex:PassengerStopAssignment ;
