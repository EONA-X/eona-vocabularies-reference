<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#StopPointDescriptionGroup.CompassBearing> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "CompassBearing" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_servicePattern_version.xsd> ;
    schema:domainIncludes netex:ScheduledStopPoint, netex:ScheduledStopPointView ;
    rdfs:comment "Heading of STOP relative to street. Degrees from North. This should be considered as a derived value that can be used for presentation purposes when information about the physical stop is not available. . The definitive value is the compass bearing found on the QUAY (i.e. physical stop) to which a SCHEDULED STOP POINT is assigned."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:AbsoluteBearingType ;
    skos:notation "CompassBearing" .

