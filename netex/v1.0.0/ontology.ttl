    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:ClassInFrameRef ;
    skos:notation "ClassInFrameRef" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ObjectByValueGroupObjectReferences.VersionOfObjectRef> a owl:ObjectProperty ;
    rdfs:label "VersionOfObjectRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_service/netex_filter_object.xsd> ;
    rdfs:comment "Reference to a NeTEx Object . i.e. concrete instance of an ENTITY may include a version. Implements a one to one relationship by reference."@en ;
    rdfs:domain netex:ObjectByValueGroupObjectReferences ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    skos:notation "VersionOfObjectRef" ;
    skos:scopeNote "Reference type VersionOfObjectRefStructure: no target class is defined in the schema."@en .

netex:ObjectFilterByValue a owl:Class ;
    rdfs:label "ObjectFilterByValue" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_service/netex_filter_object.xsd> ;
    rdfs:comment "Abstract Topic Filter."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:ObjectFilterByValueStructure ;
    skos:scopeNote "Abstract in the XSD."@en .

netex:ObjectFilterByValueStructure a owl:Class ;
    rdfs:label "ObjectFilterByValueStructure" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_service/netex_filter_object.xsd> ;
    rdfs:comment "Specifies values to filter by reference value, rather than frame."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

netex:ObjectIdType a rdfs:Datatype ;
    rdfs:label "ObjectIdType" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_responsibility/netex_entity_support.xsd> ;
