    rdfs:comment "[DEPRECATED: renamed to PointsOnSection - included for backwards comaptibilty - use PointsOnSection instead Ordered collection of POINTS used in the COMMON SECTION."@en ;
    rdfs:domain netex:CommonSection ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:CommonSectionPointMember ;
    skos:notation "members" .

