netex:SetOperatorEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "SetOperatorEnumeration" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_responsibility/netex_validityCondition_support.xsd> ;
    rdfs:comment "Allowed values for set operations.where there are one or more GROUPs OF ENTITTies of a given type - used to distinguish between selection of a whole group or of an item in the group). Used in a product description to indicate the range from which a choice may be made and in a sales transaction to record the nature of a choice that has been made. member Set AND AllMembersAllSets AllMembersAllSets OR OneItem AllMembers Of OnSet XOR OnlyOneItem from AnyGroup AllMembers Of OnlySet - AllOfOneSet NOT None"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#SetOperatorEnumeration/allOfAllSets> a netex:SetOperatorEnumeration, skos:Concept ;
    skos:definition "All items from all referenced GROUPs OF ENTITTies of a given type may be selected/have been selected."@en ;
    skos:inScheme netex:SetOperatorEnumeration ;
    skos:notation "allOfAllSets" ;
    skos:prefLabel "allOfAllSets" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#SetOperatorEnumeration/allOfOneSet> a netex:SetOperatorEnumeration, skos:Concept ;
    skos:definition "All items from one specified referenced GROUP OF ENTITTies of a given type may be selected/have been selected."@en ;
    skos:inScheme netex:SetOperatorEnumeration ;
    skos:notation "allOfOneSet" ;
    skos:prefLabel "allOfOneSet" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#SetOperatorEnumeration/oneOfAnyOneSet> a netex:SetOperatorEnumeration, skos:Concept ;
    skos:definition "Only one item from all referenced GROUPs OF ENTITTies of a given type may be selected/has been selected."@en ;
    skos:inScheme netex:SetOperatorEnumeration ;
    skos:notation "oneOfAnyOneSet" ;
    skos:prefLabel "oneOfAnyOneSet" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#SetOperatorEnumeration/oneOfEachSet> a netex:SetOperatorEnumeration, skos:Concept ;
    skos:definition "One item from each specified referenced GROUP OF ENTITTies of a given type must be selected/has been selected.."@en ;
    skos:inScheme netex:SetOperatorEnumeration ;
    skos:notation "oneOfEachSet" ;
    skos:prefLabel "oneOfEachSet" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#SetOperatorEnumeration/someOfAnySet> a netex:SetOperatorEnumeration, skos:Concept ;
    skos:definition "Multiple items from any referenced GROUP OF ENTITTies of a given type may be selected/have been selected."@en ;
    skos:inScheme netex:SetOperatorEnumeration ;
    skos:notation "someOfAnySet" ;
    skos:prefLabel "someOfAnySet" .

netex:SharedUsageEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "SharedUsageEnumeration" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_fares/netex_usageParameterAfterSales_support.xsd> ;
    rdfs:comment "Allowed values for Shared Usage."@en ;
