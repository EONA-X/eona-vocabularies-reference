    schema:domainIncludes netex:ObservedPassingTime, netex:ObservedPassingTime_ViewStructure ;
    rdfs:comment "Actual Arrival time."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:time ;
    skos:notation "ActualArrivalTime" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ObservedTimesAtStopGroup.ActualDepartureTime> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "ActualDepartureTime" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_monitoring/netex_monitoredPassingTimes_version.xsd> ;
    schema:domainIncludes netex:ObservedPassingTime, netex:ObservedPassingTime_ViewStructure ;
    rdfs:comment "Actual departure time."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:time ;
    skos:notation "ActualDepartureTime" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ObservedTimesAtStopGroup.ActualWaitingTime> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "ActualWaitingTime" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_monitoring/netex_monitoredPassingTimes_version.xsd> ;
    schema:domainIncludes netex:ObservedPassingTime, netex:ObservedPassingTime_ViewStructure ;
    rdfs:comment "Actual waiting interval."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:duration ;
    skos:notation "ActualWaitingTime" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ObservedTimesAtStopGroup.ArrivalDayOffset> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "ArrivalDayOffset" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_monitoring/netex_monitoredPassingTimes_version.xsd> ;
    schema:domainIncludes netex:ObservedPassingTime, netex:ObservedPassingTime_ViewStructure ;
    rdfs:comment "Arrival Day Offset from start of JOURNEY. +v1.1"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:DayOffsetType ;
    skos:notation "ArrivalDayOffset" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ObservedTimesAtStopGroup.DepartureDayOffset> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "DepartureDayOffset" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_monitoring/netex_monitoredPassingTimes_version.xsd> ;
    schema:domainIncludes netex:ObservedPassingTime, netex:ObservedPassingTime_ViewStructure ;
    rdfs:comment "Departure Day Offset from start of JOURNEY. +v1.1"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
