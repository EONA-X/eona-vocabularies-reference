    rdfs:comment "Reference to a TIMING POINT IN JOURNEY PATTERN. If given by context does not need to be stated."@en ;
    rdfs:domain netex:VehicleJourneyHeadway ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:TimingPointInJourneyPattern ;
    skos:notation "TimingPointInJourneyPatternRef" .

