    rdfs:comment "Identifier of LOGICAL DISPLAY."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:normalizedString ] .

netex:LogicalOperationEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "LogicalOperationEnumeration" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_responsibility/netex_validityCondition_support.xsd> ;
    rdfs:comment "Allowed values for logical operations. See https://en.wikipedia.org/wiki/Logic_gate"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#LogicalOperationEnumeration/AND> a netex:LogicalOperationEnumeration, skos:Concept ;
    skos:definition "Successive elements are logically ANDed together; comparison must satisfy all specified values."@en ;
    skos:inScheme netex:LogicalOperationEnumeration ;
    skos:notation "AND" ;
    skos:prefLabel "AND" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#LogicalOperationEnumeration/NAND> a netex:LogicalOperationEnumeration, skos:Concept ;
    skos:definition "Successive elements are logically ANDed together; comparison must satisfy all specified values. The result is then negated. +v1.2.2"@en ;
    skos:inScheme netex:LogicalOperationEnumeration ;
    skos:notation "NAND" ;
    skos:prefLabel "NAND" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#LogicalOperationEnumeration/NOR> a netex:LogicalOperationEnumeration, skos:Concept ;
    skos:definition "Successive elements are logically ORed together; comparison must satisfy at least one specified value. The result is then negated. +v1.2.2"@en ;
    skos:inScheme netex:LogicalOperationEnumeration ;
    skos:notation "NOR" ;
    skos:prefLabel "NOR" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#LogicalOperationEnumeration/NOT> a netex:LogicalOperationEnumeration, skos:Concept ;
    skos:definition "Specified elements must be different from the given value. If the number of specified elements is equal to 1, the function negates it. If the number of specified elements > 1, this operator is equal to the NOR operator"@en ;
    skos:inScheme netex:LogicalOperationEnumeration ;
    skos:notation "NOT" ;
    skos:prefLabel "NOT" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#LogicalOperationEnumeration/OR> a netex:LogicalOperationEnumeration, skos:Concept ;
    skos:definition "Successive elements are logically ORed together; comparison must satisfy at least one specified value."@en ;
    skos:inScheme netex:LogicalOperationEnumeration ;
    skos:notation "OR" ;
    skos:prefLabel "OR" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#LogicalOperationEnumeration/XNOR> a netex:LogicalOperationEnumeration, skos:Concept ;
    skos:definition "Successive elements are logically ORed together; comparison must satisfy only one specified value. The result is then negated. +v1.2.2"@en ;
    skos:inScheme netex:LogicalOperationEnumeration ;
    skos:notation "XNOR" ;
    skos:prefLabel "XNOR" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#LogicalOperationEnumeration/XOR> a netex:LogicalOperationEnumeration, skos:Concept ;
    skos:definition "Successive elements are logically ORed together; comparison must satisfy only one specified value."@en ;
    skos:inScheme netex:LogicalOperationEnumeration ;
    skos:notation "XOR" ;
    skos:prefLabel "XOR" .

