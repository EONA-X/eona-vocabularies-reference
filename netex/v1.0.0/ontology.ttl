netex:InstalledEquipmentIdType a rdfs:Datatype ;
    rdfs:label "InstalledEquipmentIdType" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_reusableComponents/netex_equipment_support.xsd> ;
    rdfs:comment "Type for identifier of an INSTALLED EQUIPMENT."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:normalizedString ] .

netex:Interchange a owl:Class ;
    rdfs:label "Interchange" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_interchange_version.xsd> ;
    rdfs:comment "The scheduled possibility for transfer of passengers between two SERVICE JOURNEYs at the same or different STOP POINTs."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:DataManagedObject, netex:DataManagedObjectStructure ;
    skos:hiddenLabel "Interchange_VersionStructure" ;
    skos:scopeNote "Abstract in the XSD."@en .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#InterchangeEndpointGroup.FromPointRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "FromPointRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_interchange_version.xsd> ;
    schema:domainIncludes netex:ServiceJourneyInterchange, netex:ServiceJourneyPatternInterchange ;
    rdfs:comment "SCHEDULED STOP POINT feeding INTERCHANGE."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:ScheduledStopPoint ;
    skos:notation "FromPointRef" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#InterchangeEndpointGroup.FromVisitNumber> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "FromVisitNumber" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_interchange_version.xsd> ;
    schema:domainIncludes netex:ServiceJourneyInterchange, netex:ServiceJourneyPatternInterchange ;
    rdfs:comment "Visit number to distinguish which visit to FROM SCHEDULED STOP POINT this is. Default is one. Only needed for circular routes with connections at the same stop on different visits."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:notation "FromVisitNumber" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#InterchangeEndpointGroup.ToPointRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "ToPointRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_interchange_version.xsd> ;
    schema:domainIncludes netex:ServiceJourneyInterchange, netex:ServiceJourneyPatternInterchange ;
    rdfs:comment "SCHEDULED STOP POINT distributing from INTERCHANGE."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:ScheduledStopPoint ;
    skos:notation "ToPointRef" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#InterchangeEndpointGroup.ToVisitNumber> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "ToVisitNumber" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_interchange_version.xsd> ;
    schema:domainIncludes netex:ServiceJourneyInterchange, netex:ServiceJourneyPatternInterchange ;
    rdfs:comment "Visit number to distinguish which visit to TO SCHEDULED STOP POINT this is. Default is one. Only needed for circular routes with connections at the same stop on different visits."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:notation "ToVisitNumber" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#InterchangeGroup.ConnectionRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "ConnectionRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_interchange_version.xsd> ;
