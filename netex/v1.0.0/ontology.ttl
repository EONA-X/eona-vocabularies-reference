<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#StopAssignmentGroup.ScheduledStopPoint> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "ScheduledStopPoint" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_stopAssignment_version.xsd> ;
    rdfs:comment "A POINT where passengers can board or alight from vehicles. It is open, which hierarchical level such a point has. It can represent a single door (BoardingPosition) or a whole ZONE. The association to the physical model is done with STOP ASSIGNMENTs."@en ;
    rdfs:domain netex:StopAssignment ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:ScheduledStopPoint ;
    skos:notation "ScheduledStopPoint" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#StopAssignmentGroup.ScheduledStopPointRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "ScheduledStopPointRef" ;
