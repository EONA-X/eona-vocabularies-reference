<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneUseEnumeration/cannotAlightInZone> a netex:ZoneUseEnumeration, skos:Concept ;
    skos:definition "May not alight in zone. +v1.2.2"@en ;
    skos:inScheme netex:ZoneUseEnumeration ;
    skos:notation "cannotAlightInZone" ;
    skos:prefLabel "cannotAlightInZone" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneUseEnumeration/cannotBoardAndAlightInSameZone> a netex:ZoneUseEnumeration, skos:Concept ;
    skos:definition "Cannot board and alight within the same zone."@en ;
    skos:inScheme netex:ZoneUseEnumeration ;
    skos:notation "cannotBoardAndAlightInSameZone" ;
    skos:prefLabel "cannotBoardAndAlightInSameZone" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneUseEnumeration/cannotBoardInZone> a netex:ZoneUseEnumeration, skos:Concept ;
    skos:definition "May not board in zone. +v1.2.2"@en ;
    skos:inScheme netex:ZoneUseEnumeration ;
    skos:notation "cannotBoardInZone" ;
    skos:prefLabel "cannotBoardInZone" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneUseEnumeration/forbiddenZone> a netex:ZoneUseEnumeration, skos:Concept ;
    skos:definition "Zone may not be entered. +v1.2.2"@en ;
    skos:inScheme netex:ZoneUseEnumeration ;
    skos:notation "forbiddenZone" ;
    skos:prefLabel "forbiddenZone" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneUseEnumeration/mustAlightInZone> a netex:ZoneUseEnumeration, skos:Concept ;
    skos:definition "Must alight in zone. +v1.2.2"@en ;
    skos:inScheme netex:ZoneUseEnumeration ;
    skos:notation "mustAlightInZone" ;
    skos:prefLabel "mustAlightInZone" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneUseEnumeration/mustBoardInZone> a netex:ZoneUseEnumeration, skos:Concept ;
    skos:definition "Must board in Zone. +v1.2.2"@en ;
    skos:inScheme netex:ZoneUseEnumeration ;
    skos:notation "mustBoardInZone" ;
    skos:prefLabel "mustBoardInZone" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneUseEnumeration/other> a netex:ZoneUseEnumeration, skos:Concept ;
    skos:definition "Other rule."@en ;
    skos:inScheme netex:ZoneUseEnumeration ;
    skos:notation "other" ;
    skos:prefLabel "other" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneUseEnumeration/passThroughUseOnly> a netex:ZoneUseEnumeration, skos:Concept ;
    skos:definition "May only pass through zone. +v1.2.2"@en ;
    skos:inScheme netex:ZoneUseEnumeration ;
    skos:notation "passThroughUseOnly" ;
    skos:prefLabel "passThroughUseOnly" .

