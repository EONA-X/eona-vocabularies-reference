    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:normalizedString ] .

netex:ObservedPassingTimeView a owl:Class ;
    rdfs:label "ObservedPassingTimeView" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_monitoring/netex_monitoredPassingTimes_version.xsd> ;
    rdfs:comment "Simplified OBSERVED PASSING TIME."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:ObservedPassingTime_ViewStructure .

netex:ObservedPassingTime_ViewStructure a owl:Class ;
    rdfs:label "ObservedPassingTime_ViewStructure" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_monitoring/netex_monitoredPassingTimes_version.xsd> ;
    rdfs:comment "Type for Simplified OBSERVED PASSING TIME."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:PassingTime_ViewStructure .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ObservedTimesAtStopGroup.ActualArrivalTime> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "ActualArrivalTime" ;
