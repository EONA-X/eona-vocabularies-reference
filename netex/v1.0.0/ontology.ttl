netex:OccupancyEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "OccupancyEnumeration" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_support.xsd> ;
    rdfs:comment "Passenger load status of a VEHICLE - GTFS-R / TPEG Pts045. +v2.0"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyEnumeration/crushedStandingRoomOnly> a netex:OccupancyEnumeration, skos:Concept ;
    skos:definition "The vehicle can currently accommodate only standing passengers and has limited space for them. Maps to GTFS-R \"CRUSHED_STANDING_ROOM_ONLY\"."@en ;
    skos:inScheme netex:OccupancyEnumeration ;
    skos:notation "crushedStandingRoomOnly" ;
    skos:prefLabel "crushedStandingRoomOnly" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyEnumeration/empty> a netex:OccupancyEnumeration, skos:Concept ;
    skos:definition "The vehicle is considered empty by most measures, and has few or no passengers onboard, but is still accepting passengers. Maps to GTFS-R \"EMPTY\"."@en ;
    skos:inScheme netex:OccupancyEnumeration ;
    skos:notation "empty" ;
    skos:prefLabel "empty" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyEnumeration/fewSeatsAvailable> a netex:OccupancyEnumeration, skos:Concept ;
    skos:definition "The vehicle has a small percentage of seats available. What percentage of free seats out of the total seats available is to be considered small enough to fall into this category is determined at the discretion of the producer. Maps to GTFS-R \"FEW_SEATS_AVAILABLE\" / TPEG Pts45_2, few seats available."@en ;
    skos:inScheme netex:OccupancyEnumeration ;
    skos:notation "fewSeatsAvailable" ;
    skos:prefLabel "fewSeatsAvailable" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyEnumeration/full> a netex:OccupancyEnumeration, skos:Concept ;
    skos:definition "Depends on the MODE and MODE OF OPERATION. In general the vehicle will be at capacity at departure. Maps to GTFS-R \"FULL\" / TPEG Pts45_5, full."@en ;
    skos:inScheme netex:OccupancyEnumeration ;
    skos:notation "full" ;
    skos:prefLabel "full" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyEnumeration/manySeatsAvailable> a netex:OccupancyEnumeration, skos:Concept ;
    skos:definition "The vehicle has a large percentage of seats available. What percentage of free seats out of the total seats available is to be considered large enough to fall into this category is determined at the discretion of the producer. Maps to GTFS-R \"MANY_SEATS_AVAILABLE\" / TPEG Pts45_1, many seats available."@en ;
    skos:inScheme netex:OccupancyEnumeration ;
    skos:notation "manySeatsAvailable" ;
    skos:prefLabel "manySeatsAvailable" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyEnumeration/notAcceptingPassengers> a netex:OccupancyEnumeration, skos:Concept ;
    skos:definition "The vehicle cannot accept passengers. Maps to GTFS-R \"NOT_ACCEPTING_PASSENGERS\""@en ;
    skos:inScheme netex:OccupancyEnumeration ;
    skos:notation "notAcceptingPassengers" ;
    skos:prefLabel "notAcceptingPassengers" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyEnumeration/seatsAvailable> a netex:OccupancyEnumeration, skos:Concept ;
    skos:definition "(SIRI 2.1) deprecated - use a more specific value"@en ;
    skos:inScheme netex:OccupancyEnumeration ;
    skos:notation "seatsAvailable" ;
    skos:prefLabel "seatsAvailable" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyEnumeration/standingAvailable> a netex:OccupancyEnumeration, skos:Concept ;
    skos:definition "(SIRI 2.1) deprecated - use a more specific value"@en ;
    skos:inScheme netex:OccupancyEnumeration ;
    skos:notation "standingAvailable" ;
    skos:prefLabel "standingAvailable" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyEnumeration/standingRoomOnly> a netex:OccupancyEnumeration, skos:Concept ;
    skos:definition "The vehicle can currently accommodate only standing passengers. Standing room only (and TPEG Pts45_3, no seats available). Maps to GTFS-R \"STANDING_ROOM_ONLY\" / TPEG Pts45_4."@en ;
    skos:inScheme netex:OccupancyEnumeration ;
    skos:notation "standingRoomOnly" ;
    skos:prefLabel "standingRoomOnly" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyEnumeration/undefined> a netex:OccupancyEnumeration, skos:Concept ;
    skos:definition "Undefined occupancy- Maps to TPEG Pts45_255."@en ;
    skos:inScheme netex:OccupancyEnumeration ;
    skos:notation "undefined" ;
    skos:prefLabel "undefined" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyEnumeration/unknown> a netex:OccupancyEnumeration, skos:Concept ;
    skos:definition "Unknown. Maps to TPEG Pts45_0."@en ;
    skos:inScheme netex:OccupancyEnumeration ;
    skos:notation "unknown" ;
    skos:prefLabel "unknown" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyGroup.GroupReservation> a owl:ObjectProperty ;
    rdfs:label "GroupReservation" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_version.xsd> ;
    rdfs:comment "Reservations of travel groups, i.e., name of group and number of seats booked."@en ;
    rdfs:domain netex:OccupancyView ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:GroupReservationStructure ;
    skos:notation "GroupReservation" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyGroup.TotalNumberOfReservedSeats> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "TotalNumberOfReservedSeats" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_version.xsd> ;
    rdfs:comment "Total number of booked seats from individual and group reservations."@en ;
    rdfs:domain netex:OccupancyView ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:NumberOfPassengers ;
    skos:notation "TotalNumberOfReservedSeats" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyGroup.dayTypeRefs> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "dayTypeRefs" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_version.xsd> ;
    rdfs:comment "DAY TYPEs for BLOCK."@en ;
    rdfs:domain netex:OccupancyView ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:OccupancyGroupDayTypeRefs ;
    skos:notation "dayTypeRefs" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyGroup.dayTypes> a owl:ObjectProperty ;
    rdfs:label "dayTypes" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_version.xsd> ;
    schema:rangeIncludes netex:DataManagedObject, netex:DayType ;
    rdfs:comment "Reusable DAY TYPE in SERVICE CALENDAR FRAME."@en ;
    rdfs:domain netex:OccupancyView ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    skos:notation "dayTypes" .

netex:OccupancyGroupDayTypeRefs a owl:Class ;
    rdfs:label "OccupancyGroupDayTypeRefs" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_version.xsd> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyScopeFilterGroup.FareClass> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "FareClass" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_version.xsd> ;
    rdfs:comment "Fare class in VEHICLE for which occupancy or capacities are specified."@en ;
    rdfs:domain netex:OccupancyView ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:FareClassEnumeration ;
    skos:notation "FareClass" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyScopeFilterGroup.PassengerCategory> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "PassengerCategory" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_version.xsd> ;
    rdfs:comment "Adult, child, wheelchair etc."@en ;
    rdfs:domain netex:OccupancyView ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range rdf:langString ;
    skos:notation "PassengerCategory" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyValuesGroup.AlightingCount> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "AlightingCount" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_version.xsd> ;
    rdfs:comment "Total number of alighting passengers for this vehicle journey at this STOP POINT."@en ;
    rdfs:domain netex:OccupancyView ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:NumberOfPassengers ;
    skos:notation "AlightingCount" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyValuesGroup.BicycleOnboardCount> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "BicycleOnboardCount" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_version.xsd> ;
    rdfs:comment "Total number of bicycles on-board, i.e., number of bicycle racks that are occupied after departing the STOP POINT."@en ;
    rdfs:domain netex:OccupancyView ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:notation "BicycleOnboardCount" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyValuesGroup.BoardingCount> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "BoardingCount" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_version.xsd> ;
    rdfs:comment "Total number of boarding passengers for this vehicle journey at this STOP POINT."@en ;
    rdfs:domain netex:OccupancyView ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:NumberOfPassengers ;
    skos:notation "BoardingCount" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyValuesGroup.OccupancyLevel> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "OccupancyLevel" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_version.xsd> ;
    rdfs:comment "An approximate figure of how occupied or full a VEHICLE and its parts are, e.g. 'manySeatsAvailable' or 'standingRoomOnly'. More accurate data can be provided by the individual occupancies or capacities below."@en ;
    rdfs:domain netex:OccupancyView ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:OccupancyEnumeration ;
    skos:notation "OccupancyLevel" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyValuesGroup.OccupancyPercentage> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "OccupancyPercentage" ;
