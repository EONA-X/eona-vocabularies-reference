    skos:inScheme netex:TravelBillingPolicyEnumeration ;
    skos:notation "billAsYouGo" ;
    skos:prefLabel "billAsYouGo" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#TravelBillingPolicyEnumeration/billAtFareDayEnd> a netex:TravelBillingPolicyEnumeration, skos:Concept ;
    skos:definition "Bill at end of every fare day."@en ;
    skos:inScheme netex:TravelBillingPolicyEnumeration ;
    skos:notation "billAtFareDayEnd" ;
    skos:prefLabel "billAtFareDayEnd" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#TravelBillingPolicyEnumeration/billAtPeriodEnd> a netex:TravelBillingPolicyEnumeration, skos:Concept ;
    skos:definition "Bill at end of a specified period."@en ;
    skos:inScheme netex:TravelBillingPolicyEnumeration ;
    skos:notation "billAtPeriodEnd" ;
    skos:prefLabel "billAtPeriodEnd" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#TravelBillingPolicyEnumeration/billOnThreshold> a netex:TravelBillingPolicyEnumeration, skos:Concept ;
    skos:definition "Only raise bill when threshold is reached"@en ;
    skos:inScheme netex:TravelBillingPolicyEnumeration ;
    skos:notation "billOnThreshold" ;
    skos:prefLabel "billOnThreshold" .

netex:TravelCreditPolicyEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "TravelCreditPolicyEnumeration" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_fares/netex_usageParameterCharging_support.xsd> ;
    rdfs:comment "Allowed values for Credit Policy."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#TravelCreditPolicyEnumeration/allowTravel> a netex:TravelCreditPolicyEnumeration, skos:Concept ;
    skos:definition "Policy if credit threhsold is exceeded is still to allow further travel."@en ;
    skos:inScheme netex:TravelCreditPolicyEnumeration ;
    skos:notation "allowTravel" ;
    skos:prefLabel "allowTravel" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#TravelCreditPolicyEnumeration/blockAllTravel> a netex:TravelCreditPolicyEnumeration, skos:Concept ;
    skos:definition "Policy if credit threhsold is exceeded is to block all travel by user."@en ;
    skos:inScheme netex:TravelCreditPolicyEnumeration ;
    skos:notation "blockAllTravel" ;
    skos:prefLabel "blockAllTravel" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#TravelCreditPolicyEnumeration/blockPayAsYouGoTravel> a netex:TravelCreditPolicyEnumeration, skos:Concept ;
    skos:definition "Policy if credit threhsold is exceeded is to block on demand travel, but still permit period pass travel."@en ;
    skos:inScheme netex:TravelCreditPolicyEnumeration ;
    skos:notation "blockPayAsYouGoTravel" ;
    skos:prefLabel "blockPayAsYouGoTravel" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#TravelCreditPolicyEnumeration/other> a netex:TravelCreditPolicyEnumeration, skos:Concept ;
    skos:inScheme netex:TravelCreditPolicyEnumeration ;
    skos:notation "other" ;
    skos:prefLabel "other" .

