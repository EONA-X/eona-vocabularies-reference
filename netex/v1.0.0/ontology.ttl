<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#TopicTemporalScopeGroup.ChangedSince> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "ChangedSince" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_service/netex_filter_object.xsd> ;
    rdfs:comment "Return the values that have changed since the specified point in time, including current and superseded values. Values that are no longer current will be flagged with the date they were superseded (using the various cleared / deleted /historic dates on different element types)."@en ;
    rdfs:domain netex:NetworkFrameTopicStructure ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:dateTime ;
    skos:notation "ChangedSince" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#TopicTemporalScopeGroup.Current> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "Current" ;
