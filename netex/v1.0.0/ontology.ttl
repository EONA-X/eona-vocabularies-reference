    schema:domainIncludes netex:ObservedPassingTime, netex:ObservedPassingTime_ViewStructure ;
    rdfs:comment "PASSING TIME Day Offset from start of JOURNEY. +v1.1"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:DayOffsetType ;
    skos:notation "PassingTimeDayOffset" .

netex:ObservedPassingTimeIdType a rdfs:Datatype ;
    rdfs:label "ObservedPassingTimeIdType" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_passingTimes_support.xsd> ;
