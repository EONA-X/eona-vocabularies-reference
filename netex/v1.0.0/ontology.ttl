    rdfs:range xsd:boolean ;
    skos:notation "ForBoarding" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#StopPointInJourneyPatternGroup.OnwardServiceLinkRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "OnwardServiceLinkRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_servicePattern_version.xsd> ;
