    rdfs:label "relationshipStructure" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_responsibility/netex_relationship.xsd> ;
    rdfs:comment "Abstract Type for a serialisation of a NeTEx relationship."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

netex:strictContainmentAggregationStructure a owl:Class ;
    rdfs:label "strictContainmentAggregationStructure" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_responsibility/netex_relationship.xsd> ;
    rdfs:comment "Type for an Implementation of a strict aggregate relationship by value, where the contained element is a child of the parent. A one to many relationship from the source, the containing parent, to the child instance."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:relationshipStructure .
