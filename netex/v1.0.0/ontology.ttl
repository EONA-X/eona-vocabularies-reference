    rdfs:range netex:CustomerPaymentMeans ;
    skos:notation "CustomerPaymentMeansRef" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#CustomerAccountContentsGroup.customerAccountEntries> a owl:ObjectProperty ;
