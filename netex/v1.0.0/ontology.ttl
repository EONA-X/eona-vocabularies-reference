netex:StopPointInJourneyPattern a owl:Class ;
    rdfs:label "StopPointInJourneyPattern" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_servicePattern_version.xsd> ;
    rdfs:comment "The use of a SCHEDULED STOP POINT in a specified order. within a JOURNEY PATTERN or SERVICE PATTERN."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#StopPointInJourneyPatternTimingGroup.ScheduledStopPointRef> ], netex:PointInLinkSequence ;
    skos:hiddenLabel "StopPointInJourneyPattern_VersionedChildStructure" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#StopPointInJourneyPatternGroup.AlightingSideInDirectionOfTravel> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "AlightingSideInDirectionOfTravel" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_servicePattern_version.xsd> ;
    rdfs:comment "On which side the vehicle can be alighted on this stop in the direction of travel. This is often not relevant. And it is difficult to define this from the QUAY when the direction of travel is not known. +v1.3.1"@en ;
    rdfs:domain netex:StopPointInJourneyPattern ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:SideInDirectionOfTravelEnumeration ;
    skos:notation "AlightingSideInDirectionOfTravel" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#StopPointInJourneyPatternGroup.BoardingSideInDirectionOfTravel> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "BoardingSideInDirectionOfTravel" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_servicePattern_version.xsd> ;
    rdfs:comment "On which side the vehicle can be boarded on this stop in the direction of travel. +v1.3.1"@en ;
    rdfs:domain netex:StopPointInJourneyPattern ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:SideInDirectionOfTravelEnumeration ;
    skos:notation "BoardingSideInDirectionOfTravel" .

