    rdfs:comment "Default sense for OVERTAKING POSSIBILITY restrictions in frame. If true, overtaking at all points is restricted unless explicitly permitted, If 'false', meeting at all points is allowed, unless explicitly forbidden by an OVERTAKING POSSIBILITY. Default is 'f'alse'."@en ;
    rdfs:domain netex:InfrastructureFrame ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:boolean ;
    skos:notation "OvertakingPossibilitiesRestricted" .

