netex:AllPublicTransportModesEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "AllPublicTransportModesEnumeration" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_reusableComponents/netex_mode_support.xsd> ;
    rdfs:comment "PUBLIC TRANSPORT MODE: A MODE used for public transport services (e.g., by bus, by tram, by metro, by train, by ferry, by ship, by shared taxi car, by shared car) under either a CONVENTIONAL MODE OF OPERATION or an ALTERNATIVE MODE OF OPERATION (i.e., excluding a PERSONAL MODE OF OPERATION). Note: Prior to TM 6.2 this was named VEHICLE MODE."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/air> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "All air related mode. No special distinction is made."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "air" ;
    skos:prefLabel "air" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/all> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "If all modes are meant."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "all" ;
    skos:prefLabel "all" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/anyMode> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "To be avoided."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "anyMode" ;
    skos:prefLabel "anyMode" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/bus> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "bus" ;
    skos:prefLabel "bus" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/cableway> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "Can be only two cabines or multiple."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "cableway" ;
    skos:prefLabel "cableway" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/coach> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "Bus for longer-distance service. This value specialises from bus through regulation, that the cross multiple metropolitan regions and that all passenger area seating. Also the seating layout is different."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "coach" ;
    skos:prefLabel "coach" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/ferry> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "Ferry can be passenger ferries and/or car ferries. The specialisation from water is the detailed schedule and usually the very rigid pattern with only a few stops on the route."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "ferry" ;
    skos:prefLabel "ferry" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/funicular> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "Cable railway on steep slope using two counterbalanced carriages."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "funicular" ;
    skos:prefLabel "funicular" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/intercityRail> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "DEPRECATED. Use mode rail with RailSubmode longDistance."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "intercityRail" ;
    skos:prefLabel "intercityRail" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/lift> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "General Mode for elevators and for Modes moved by cable. Especially lifts are not only vertical elevators. If a better specialisation applies (like cableway) use that."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "lift" ;
    skos:prefLabel "lift" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/metro> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "Within an urban area. For underground and railway."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "metro" ;
    skos:prefLabel "metro" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/other> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "Use only when no other entry applies."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "other" ;
    skos:prefLabel "other" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/rail> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "rail" ;
    skos:prefLabel "rail" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/selfDrive> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "For all alternative modes where a vehicle is driven by the user. See pti12_x."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "selfDrive" ;
    skos:prefLabel "selfDrive" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/snowAndIce> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "A collection for all modes involving snow and ice."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "snowAndIce" ;
    skos:prefLabel "snowAndIce" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/taxi> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "taxi" ;
    skos:prefLabel "taxi" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/tram> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "tram" ;
    skos:prefLabel "tram" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/trolleyBus> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "Special type of bus with two overhead wires using spring-loaded trolley poles."@en ;
    skos:inScheme netex:AllPublicTransportModesEnumeration ;
    skos:notation "trolleyBus" ;
    skos:prefLabel "trolleyBus" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/unknown> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
    skos:definition "Use only when no other entry applies."@en ;
