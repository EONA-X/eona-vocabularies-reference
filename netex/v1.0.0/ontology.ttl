<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#NetworkFrameRequestPolicyStructure.IncludeDeleted> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "IncludeDeleted" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_service/netex_filter_frame.xsd> ;
    rdfs:comment "Whether to include in response. elements flagged as deleted. By default this will be false."@en ;
    rdfs:domain netex:NetworkFrameRequestPolicyStructure ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:boolean ;
    skos:notation "IncludeDeleted" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#NetworkFrameRequestPolicyStructure.Language> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "Language" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_service/netex_filter_frame.xsd> ;
    rdfs:comment "Preferred language for text elements in response."@en ;
    rdfs:domain netex:NetworkFrameRequestPolicyStructure ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:language ;
    skos:notation "Language" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#NetworkFrameRequestPolicyStructure.MaximumNumberOfElements> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "MaximumNumberOfElements" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_service/netex_filter_frame.xsd> ;
    rdfs:comment "Maximum number of objects to include in response. If absent, include all instances."@en ;
    rdfs:domain netex:NetworkFrameRequestPolicyStructure ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:integer ;
    skos:notation "MaximumNumberOfElements" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#NetworkFrameRequestPolicyStructure.MustHaveBy> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "MustHaveBy" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_service/netex_filter_frame.xsd> ;
    rdfs:comment "Allows requestor to indicate that if data cannot be supplied by a given time it will not be useful. Can be used to prioritize data on systems working at full load."@en ;
    rdfs:domain netex:NetworkFrameRequestPolicyStructure ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:dateTime ;
    skos:notation "MustHaveBy" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#NetworkFrameRequestPolicyStructure.RequestDetail> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "RequestDetail" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_service/netex_filter_frame.xsd> ;
    rdfs:comment "Level of detail to return. Default is all. All = Return all data and geometry, but not Xref NoGeometry = Return all, omitting geometry. XRef - Return Xcross Reference data , e.g. links for zones."@en ;
    rdfs:domain netex:NetworkFrameRequestPolicyStructure ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:OutputDetailListOfEnumerations ;
    skos:notation "RequestDetail" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#NetworkFrameRequestPolicyStructure.Urgency> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "Urgency" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_service/netex_filter_frame.xsd> ;
    rdfs:comment "Allows requestor to indicate a relative urgency of request. A longer period can be specified for non urgent requests, e.g. to get historic data. If not specified assume best possible response desired, preferably immediate."@en ;
    rdfs:domain netex:NetworkFrameRequestPolicyStructure ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:duration ;
    skos:notation "Urgency" .

