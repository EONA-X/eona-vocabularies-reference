    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:normalizedString ] .

netex:ObservedPassingTime a owl:Class ;
    rdfs:label "ObservedPassingTime" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_monitoring/netex_monitoredPassingTimes_version.xsd> ;
    rdfs:comment "OBSERVED PASSING TIME."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:DatedPassingTime ;
    skos:hiddenLabel "ObservedPassingTime_VersionedChildStructure" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ObservedPassingTimeGroup.ActualHeadway> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "ActualHeadway" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_monitoring/netex_monitoredPassingTimes_version.xsd> ;
    schema:domainIncludes netex:ObservedPassingTime, netex:ObservedPassingTime_ViewStructure ;
    rdfs:comment "Actual Frequency of service as a set of intervals."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:HeadwayIntervalStructure ;
    skos:notation "ActualHeadway" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ObservedPassingTimeGroup.ActualNonstopPassingTime> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "ActualNonstopPassingTime" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_monitoring/netex_monitoredPassingTimes_version.xsd> ;
    schema:domainIncludes netex:ObservedPassingTime, netex:ObservedPassingTime_ViewStructure ;
    rdfs:comment "Actual PASSING TIME if doesn't stop at TIMING POINT."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:time ;
    skos:notation "ActualNonstopPassingTime" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ObservedPassingTimeGroup.PassingTimeDayOffset> a owl:DatatypeProperty, owl:FunctionalProperty ;
