    rdfs:comment "Default sense for RESTRICTED MANOEUVRE in frame. If 'true', manoevres at all points are restricted unless explicitly permittted, If 'false', meeting at all points is allowed, unless explicitly forbidden by a RESTRICTED MANOEUVRE. Default is 'f'alse'."@en ;
    rdfs:domain netex:InfrastructureFrame ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:boolean ;
    skos:notation "RestrictedManoeuvres" .

netex:InfrastructureLink a owl:Class ;
    rdfs:label "InfrastructureLink" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_networkDescription/netex_networkInfrastructure_version.xsd> ;
    rdfs:comment "A supertype including all LINKs of the physical network (e.g. RAILWAY ELEMENT). Infrastructure links are directional - there will be separate links for each direction of a network."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:Link ;
    skos:hiddenLabel "InfrastructureLink_VersionStructure" ;
    skos:scopeNote "Abstract in the XSD."@en .

netex:InfrastructureLinkIdType a rdfs:Datatype ;
    rdfs:label "InfrastructureLinkIdType" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_networkDescription/netex_networkInfrastructure_support.xsd> ;
    rdfs:comment "Type for identifier of INFRASTRUCTURE POINT."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:normalizedString ] .

netex:InfrastructureLinkRestriction a owl:Class ;
    rdfs:label "InfrastructureLinkRestriction" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_networkDescription/netex_networkRestriction_version.xsd> ;
    rdfs:comment "A NETWORK RESTRICTION on movement between any two network links."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#InfrastructureLinkRestrictionGroup.FromLinkRef> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#InfrastructureLinkRestrictionGroup.ToLinkRef> ], netex:NetworkRestriction ;
    skos:hiddenLabel "InfrastructureLinkRestriction_VersionStructure" ;
    skos:scopeNote "Abstract in the XSD."@en .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#InfrastructureLinkRestrictionGroup.FromLinkRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "FromLinkRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_networkDescription/netex_networkRestriction_version.xsd> ;
    rdfs:comment "Restriction applies to movements starting from INFRASTRUCTURE LINK identified by this Reference."@en ;
    rdfs:domain netex:InfrastructureLinkRestriction ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:Link ;
    skos:notation "FromLinkRef" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#InfrastructureLinkRestrictionGroup.ToLinkRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "ToLinkRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_networkDescription/netex_networkRestriction_version.xsd> ;
    rdfs:comment "Restriction applies to movements ending on INFRASTRUCTURE LINK identified by this reference."@en ;
    rdfs:domain netex:InfrastructureLinkRestriction ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:Link ;
    skos:notation "ToLinkRef" .

netex:InfrastructureLinkRestrictionIdType a rdfs:Datatype ;
    rdfs:label "InfrastructureLinkRestrictionIdType" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_networkDescription/netex_networkRestriction_support.xsd> ;
    rdfs:comment "Type for Identifier of an INFRASTRUCTURE LINK RESTRICTION."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:normalizedString ] .

netex:InfrastructurePoint a owl:Class ;
    rdfs:label "InfrastructurePoint" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_networkDescription/netex_networkInfrastructure_version.xsd> ;
    rdfs:comment "A supertype including all POINTs of the physical network (e.g. RAILWAY JUNCTION)."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:Point ;
    skos:hiddenLabel "InfrastructurePoint_VersionStructure" ;
    skos:scopeNote "Abstract in the XSD."@en .

netex:InfrastructurePointIdType a rdfs:Datatype ;
    rdfs:label "InfrastructurePointIdType" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_networkDescription/netex_networkInfrastructure_support.xsd> ;
    rdfs:comment "Type for identifier of INFRASTRUCTURE POINT."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:normalizedString ] .

netex:InstalledEquipment a owl:Class ;
    rdfs:label "InstalledEquipment" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_reusableComponents/netex_equipment_version.xsd> ;
    rdfs:comment "INSTALLED EQUIPMENT describes the different types of LOCATED EQUIPMENT that may be associated with the SITE COMPONENTs."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:Equipment ;
    skos:hiddenLabel "InstalledEquipment_VersionStructure" ;
