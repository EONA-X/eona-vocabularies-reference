    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:boolean ;
    skos:notation "BoardingUse" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#StopAssignmentGroup.PrivateCode> a owl:DatatypeProperty, owl:FunctionalProperty ;
