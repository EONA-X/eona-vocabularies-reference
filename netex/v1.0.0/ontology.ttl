    rdfs:comment "Return just the latest current values from the producer at the time the response is created."@en ;
    rdfs:domain netex:NetworkFrameTopicStructure ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:EmptyType ;
    skos:notation "Current" .

