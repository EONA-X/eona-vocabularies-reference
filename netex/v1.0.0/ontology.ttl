    skos:hiddenLabel "VehicleJourney_VersionStructure" .

netex:VehicleJourneyHeadway a owl:Class ;
    rdfs:label "VehicleJourneyHeadway" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_vehicleJourneyFrequency_version.xsd> ;
    rdfs:comment "Headway interval information that is available for a VEHICLE JOURNEY (to be understood as the delay between the previous and the next VEHICLE JOURNEY). This information must be consistent with HEADWAY JOURNEY GROUP if available (HEADWAY JOURNEY GROUP being a more detailed way of describing headway services)."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:JourneyHeadway, netex:JourneyTiming ;
    skos:hiddenLabel "VehicleJourneyHeadway_VersionedChildStructure" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#VehicleJourneyHeadwayGroup.TimingPointInJourneyPatternRef> a owl:FunctionalProperty, owl:ObjectProperty ;
