netex:PassengerAccessibilityNeeds a owl:Class ;
    rdfs:label "PassengerAccessibilityNeeds" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_genericFramework/netex_accessibility/netex_acsb_passengerMobility.xsd> ;
    rdfs:comment "A passenger's requirement for accessibility, comprising one or more USER NEEDs. For example, that he is unable to navigate stairs, or lifts, or has visual or auditory impairments. PASSENGER ACCESSIBILITY NEEDS can be used to derive an accessibility constraint for the passenger, allowing the computation of paths for passengers with specifically constrained mobility. Example: Wheelchair, No Lifts, No Stairs."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:PassengerAccessibilityNeedsStructure .

netex:PassengerAccessibilityNeedsStructure a owl:Class ;
    rdfs:label "PassengerAccessibilityNeedsStructure" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_genericFramework/netex_accessibility/netex_acsb_passengerMobility.xsd> ;
    rdfs:comment "Type for accessibility needs. Records the requirements of a passenger that may affect choice of facilities."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#PassengerAccessibilityNeedsStructure.AccompaniedByCarer> a owl:DatatypeProperty, owl:FunctionalProperty ;
