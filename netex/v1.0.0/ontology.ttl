    rdfs:comment "A link outside of a SITE between any two PLACEs ( PKACES PATH JUNCTIONs) that represents a step in a possible route for pedestrians, cyclists or other out of vehicle passengers within or between a PLACE. +v2.0"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OffSitePathLinkGroup.From> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OffSitePathLinkGroup.To> ], netex:GenericPathLink, netex:Link ;
    skos:hiddenLabel "OffSitePathLink_VersionStructure" .

