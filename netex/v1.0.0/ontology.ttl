    skos:notation "ProjectToPointRef" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneProjection_VersionStructure.ProjectToZoneRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "ProjectToZoneRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_genericFramework/netex_zoneProjection_version.xsd> ;
    rdfs:comment "Reference to ZONE onto to which ZONE projects."@en ;
    rdfs:domain netex:ZoneProjection ;
