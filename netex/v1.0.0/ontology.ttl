    rdfs:label "TimebandRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_call_version.xsd> ;
    schema:domainIncludes netex:ArrivalStructure, netex:DepartureStructure ;
