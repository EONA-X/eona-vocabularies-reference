netex:Call a owl:Class ;
    rdfs:label "Call" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_call_version.xsd> ;
    rdfs:comment "A visit to a SCHEDULED STOP POINT as part of a VEHICLE JOURNEY. A CALL is a view of a POINT IN JOURNEY PATTERN that adds in derived data."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:VersionedChildStructure ;
    skos:hiddenLabel "Call_VersionedChildStructure" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#CallGroup.Note> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "Note" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_call_version.xsd> ;
    rdfs:comment "Text annotation that applies to this CALL. This is for internal use. Customer facing should be added to footnote."@en ;
    rdfs:domain netex:Call ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range rdf:langString ;
    skos:notation "Note" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#CallGroup.PointInJourneyPatternRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "PointInJourneyPatternRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_call_version.xsd> ;
    rdfs:comment "Point in JOURNEY PATTERN upon which this call is based. Can be used to obtain full association sets."@en ;
    rdfs:domain netex:Call ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:PointInJourneyPattern ;
    skos:notation "PointInJourneyPatternRef" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#CallGroup.ServiceJourneyRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "ServiceJourneyRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_call_version.xsd> ;
    rdfs:comment "Reference to a SERVICE JOURNEY."@en ;
    rdfs:domain netex:Call ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:ServiceJourney ;
    skos:notation "ServiceJourneyRef" .

netex:CallIdType a rdfs:Datatype ;
    rdfs:label "CallIdType" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_call_support.xsd> ;
    rdfs:comment "Type for identifier of a CALL."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:normalizedString ] .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#CallPartGroup.AccessibilityAssessment> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "AccessibilityAssessment" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_call_version.xsd> ;
    schema:domainIncludes netex:ArrivalStructure, netex:DepartureStructure ;
    rdfs:comment "The accessibility characteristics of an entity used by passengers such as a STOP PLACE, or a STOP PLACE COMPONENT. Described by ACCESSIBILITY LIMITATIONs, and/or a set of SUITABILITies."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:AccessibilityAssessment ;
    skos:notation "AccessibilityAssessment" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#CallPartGroup.CheckConstraint> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "CheckConstraint" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_call_version.xsd> ;
    schema:domainIncludes netex:ArrivalStructure, netex:DepartureStructure ;
    rdfs:comment "Characteristics of a SITE COMPONENT representing a process, such as check-in, security screening, ticket control or immigration, that may potentially incur a time penalty that should be allowed for when journey planning. Used to mark PATH LINKs to determine transit routes through interchanges."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:CheckConstraint ;
    skos:notation "CheckConstraint" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#CallPartGroup.DutyPartRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "DutyPartRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_journeyTimes/netex_call_version.xsd> ;
    schema:domainIncludes netex:ArrivalStructure, netex:DepartureStructure ;
    rdfs:comment "Reference to a DUTY PART."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:DutyPart ;
    skos:notation "DutyPartRef" .

