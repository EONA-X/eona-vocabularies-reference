<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#SharedUsageEnumeration/concurrentDesignatedUsers> a netex:SharedUsageEnumeration, skos:Concept ;
    skos:definition "Several users (but only of a specified type of companion) may use the same product at a time. E.g. a mobile app carnet of tickets may be shared with children but not others."@en ;
    skos:inScheme netex:SharedUsageEnumeration ;
    skos:notation "concurrentDesignatedUsers" ;
    skos:prefLabel "concurrentDesignatedUsers" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#SharedUsageEnumeration/concurrentUsers> a netex:SharedUsageEnumeration, skos:Concept ;
    skos:definition "Several users may use the same product at a time. E.g. a carnet of tickets may be shared with several users other than the purchaser."@en ;
    skos:inScheme netex:SharedUsageEnumeration ;
    skos:notation "concurrentUsers" ;
    skos:prefLabel "concurrentUsers" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#SharedUsageEnumeration/singleUser> a netex:SharedUsageEnumeration, skos:Concept ;
    skos:definition "Only one user may use the product at a time. E.g. a mobile app carnet of tickets may only restricted to be used by the mobile device holder."@en ;
    skos:inScheme netex:SharedUsageEnumeration ;
    skos:notation "singleUser" ;
    skos:prefLabel "singleUser" .

