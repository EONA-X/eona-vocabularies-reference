    rdfs:label "coursesOfJourneys" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_vehicleService/netex_vehicleService_version.xsd> ;
