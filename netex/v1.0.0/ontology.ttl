<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OccupancyValuesGroup.SpecialPlacesOccupied> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "SpecialPlacesOccupied" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_occupancy/netex_oc_occupancy_version.xsd> ;
