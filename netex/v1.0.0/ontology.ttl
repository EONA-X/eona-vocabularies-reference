netex:ModificationEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "ModificationEnumeration" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_responsibility/netex_version_support.xsd> ;
    rdfs:comment "Classification of modification as addition, deletion or revision. Enumerated value."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ModificationEnumeration/delete> a netex:ModificationEnumeration, skos:Concept ;
    skos:definition "This is a deletion of an existing entity."@en ;
    skos:inScheme netex:ModificationEnumeration ;
    skos:notation "delete" ;
    skos:prefLabel "delete" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ModificationEnumeration/delta> a netex:ModificationEnumeration, skos:Concept ;
    skos:definition "This is just the changes to a previous version of an entity. Optional values are only provided if they have changed."@en ;
    skos:inScheme netex:ModificationEnumeration ;
    skos:notation "delta" ;
    skos:prefLabel "delta" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ModificationEnumeration/new> a netex:ModificationEnumeration, skos:Concept ;
    skos:definition "This is a definition of a new entity."@en ;
    skos:inScheme netex:ModificationEnumeration ;
    skos:notation "new" ;
    skos:prefLabel "new" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ModificationEnumeration/revise> a netex:ModificationEnumeration, skos:Concept ;
    skos:definition "This is a revision to an existing entity. All values are replaced."@en ;
    skos:inScheme netex:ModificationEnumeration ;
    skos:notation "revise" ;
    skos:prefLabel "revise" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ModificationEnumeration/unchanged> a netex:ModificationEnumeration, skos:Concept ;
    skos:definition "This is a repeat of the values to an entity that has not change since the previous version. All values are replaced."@en ;
    skos:inScheme netex:ModificationEnumeration ;
    skos:notation "unchanged" ;
    skos:prefLabel "unchanged" .

netex:ModificationSetEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "ModificationSetEnumeration" ;
