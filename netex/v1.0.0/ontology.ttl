netex:ZoneRuleApplicabilityEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "ZoneRuleApplicabilityEnumeration" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_5/part5_nd/netex_nm_mobilityServiceConstraintZone_support.xsd> ;
    rdfs:comment "Allowed values for ZONE rule applicability. +v1.2.2"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneRuleApplicabilityEnumeration/inside> a netex:ZoneRuleApplicabilityEnumeration, skos:Concept ;
    skos:inScheme netex:ZoneRuleApplicabilityEnumeration ;
    skos:notation "inside" ;
    skos:prefLabel "inside" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneRuleApplicabilityEnumeration/outside> a netex:ZoneRuleApplicabilityEnumeration, skos:Concept ;
    skos:inScheme netex:ZoneRuleApplicabilityEnumeration ;
    skos:notation "outside" ;
    skos:prefLabel "outside" .

netex:ZoneTopologyEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "ZoneTopologyEnumeration" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_fareZone_support.xsd> ;
    rdfs:comment "Allowed values for Fare Zone Topology."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneTopologyEnumeration/annular> a netex:ZoneTopologyEnumeration, skos:Concept ;
    skos:definition "Zones are arranged in tiled hollow rings. The area of any immediately nested zone is excluded from the containing outer zone."@en ;
    skos:inScheme netex:ZoneTopologyEnumeration ;
    skos:notation "annular" ;
    skos:prefLabel "annular" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneTopologyEnumeration/honeycomb> a netex:ZoneTopologyEnumeration, skos:Concept ;
    skos:definition "Zones are arranged as a tiled honeycomb of regular polygons (e.g. Hexagons, squares etc. The zones are contiguous and do not overlap."@en ;
    skos:inScheme netex:ZoneTopologyEnumeration ;
    skos:notation "honeycomb" ;
    skos:prefLabel "honeycomb" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneTopologyEnumeration/nested> a netex:ZoneTopologyEnumeration, skos:Concept ;
    skos:definition "Zones are nested, that is some zones are fully contained within other zones and are automatically included if the outer zone is selected. They may also overlap their neighbours."@en ;
    skos:inScheme netex:ZoneTopologyEnumeration ;
    skos:notation "nested" ;
    skos:prefLabel "nested" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneTopologyEnumeration/other> a netex:ZoneTopologyEnumeration, skos:Concept ;
    skos:inScheme netex:ZoneTopologyEnumeration ;
    skos:notation "other" ;
    skos:prefLabel "other" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneTopologyEnumeration/overlapping> a netex:ZoneTopologyEnumeration, skos:Concept ;
    skos:definition "Zones are of arbitrary shape and may overlap."@en ;
    skos:inScheme netex:ZoneTopologyEnumeration ;
    skos:notation "overlapping" ;
    skos:prefLabel "overlapping" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneTopologyEnumeration/overlappingSequence> a netex:ZoneTopologyEnumeration, skos:Concept ;
    skos:definition "Zones are arranged as adjacent tiles in sequence that touch at either or both ends. They may partially overlap such that some stops are in both zones."@en ;
    skos:inScheme netex:ZoneTopologyEnumeration ;
    skos:notation "overlappingSequence" ;
    skos:prefLabel "overlappingSequence" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneTopologyEnumeration/ring> a netex:ZoneTopologyEnumeration, skos:Concept ;
    skos:definition "Zones are arranged in rings . The nested inner zones are included in any containing outer zones."@en ;
    skos:inScheme netex:ZoneTopologyEnumeration ;
    skos:notation "ring" ;
    skos:prefLabel "ring" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneTopologyEnumeration/sequence> a netex:ZoneTopologyEnumeration, skos:Concept ;
    skos:definition "Zones are arranged as adjacent tiles in sequence that touch at either or both ends. They do not overlap."@en ;
    skos:inScheme netex:ZoneTopologyEnumeration ;
    skos:notation "sequence" ;
    skos:prefLabel "sequence" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneTopologyEnumeration/tiled> a netex:ZoneTopologyEnumeration, skos:Concept ;
    skos:definition "Zones are arranged as adjacent tiles or arbitrary shapes that do not overlap."@en ;
    skos:inScheme netex:ZoneTopologyEnumeration ;
    skos:notation "tiled" ;
    skos:prefLabel "tiled" .

netex:ZoneUseEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "ZoneUseEnumeration" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_routingConstraint_support.xsd> ;
