<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#StopPointInJourneyPatternTimingGroup.OnwardTimingLinkRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "OnwardTimingLinkRef" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_servicePattern_version.xsd> ;
    rdfs:comment "Onward link - used to disambiguate if there are multiple links from the same stop, e.g. as for cloverleaf route topology. If not given explicitly assume there is only one link that connects the two."@en ;
