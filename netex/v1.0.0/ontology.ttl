    schema:domainIncludes netex:TemplateServiceJourney, netex:TemplateVehicleJourney ;
    rdfs:comment "Type of TEMPLATE VEHICLE JOURNEY."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:TemplateVehicleJourneyTypeEnumeration ;
    skos:notation "TemplateVehicleJourneyType" .

