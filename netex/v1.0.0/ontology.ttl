    rdfs:comment "Reference to a STOP PLACE."@en ;
    rdfs:domain netex:PassengerStopAssignment ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:StopPlace ;
    skos:notation "StopPlaceRef" .

