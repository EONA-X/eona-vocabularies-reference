    rdfs:comment "FARE CONTRACT ENTRIES that relate to the CUSTOMER ACCOUNT. Normally these are embedded in a FARE CONTRACT governing the account itself. For convenience they may also be referenced or embedded directly in the CUSTOMER ACCOUNT. +V2.0"@en ;
    rdfs:domain netex:CustomerAccount ;
