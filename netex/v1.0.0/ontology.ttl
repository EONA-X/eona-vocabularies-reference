    skos:notation "urbanRail" ;
    skos:prefLabel "urbanRail" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#AllPublicTransportModesEnumeration/water> a netex:AllPublicTransportModesEnumeration, skos:Concept ;
