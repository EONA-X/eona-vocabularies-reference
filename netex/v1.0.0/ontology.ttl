netex:Block a owl:Class ;
    rdfs:label "Block" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_2/part2_vehicleService/netex_vehicleService_version.xsd> ;
    rdfs:comment "The work of a vehicle from the time it leaves a PARKING POINT after parking until its next return to park at a PARKING POINT. Any subsequent departure from a PARKING POINT after parking marks the start of a new BLOCK. The period of a BLOCK has to be covered by DUTies."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:DataManagedObject, netex:DataManagedObjectStructure ;
    skos:hiddenLabel "Block_VersionStructure" .

