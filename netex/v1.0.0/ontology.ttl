    rdfs:comment "Whether the passenger is accompanied by a carer or assistant."@en ;
    rdfs:domain netex:PassengerAccessibilityNeedsStructure ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:boolean ;
    skos:notation "AccompaniedByCarer" .

