netex:OnBecomingEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "OnBecomingEnumeration" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_fares/netex_usageParameterEligibility_support.xsd> ;
    rdfs:comment "Allowed values for Becoming Eiiigble + v1.1"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OnBecomingEnumeration/automatic> a netex:OnBecomingEnumeration, skos:Concept ;
    skos:definition "If user becomes eligible, automatically apply additional user profile benefits to user, e.g. apply student or senior discounts."@en ;
    skos:inScheme netex:OnBecomingEnumeration ;
    skos:notation "automatic" ;
    skos:prefLabel "automatic" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OnBecomingEnumeration/invite> a netex:OnBecomingEnumeration, skos:Concept ;
    skos:definition "If user becomes eligible, invite user to take up eligible products. e.g. Invite to buy Senior railcard."@en ;
    skos:inScheme netex:OnBecomingEnumeration ;
    skos:notation "invite" ;
    skos:prefLabel "invite" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OnBecomingEnumeration/noAction> a netex:OnBecomingEnumeration, skos:Concept ;
    skos:definition "If user becomes eligible,, no automatic measures are taken."@en ;
    skos:inScheme netex:OnBecomingEnumeration ;
    skos:notation "noAction" ;
    skos:prefLabel "noAction" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OnBecomingEnumeration/other> a netex:OnBecomingEnumeration, skos:Concept ;
    skos:inScheme netex:OnBecomingEnumeration ;
    skos:notation "other" ;
    skos:prefLabel "other" .

netex:OnCeasingEnumeration a owl:Class, skos:ConceptScheme ;
    rdfs:label "OnCeasingEnumeration" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_fares/netex_usageParameterEligibility_support.xsd> ;
    rdfs:comment "Allowed values for Ceasing to be Eligible + v1.1"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OnCeasingEnumeration/automaticallySubstituteProduct> a netex:OnCeasingEnumeration, skos:Concept ;
    skos:inScheme netex:OnCeasingEnumeration ;
    skos:notation "automaticallySubstituteProduct" ;
    skos:prefLabel "automaticallySubstituteProduct" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OnCeasingEnumeration/immediateTermination> a netex:OnCeasingEnumeration, skos:Concept ;
    skos:definition "If user ceases to be eligible, automatically terminate validity of an elibility dependent product."@en ;
    skos:inScheme netex:OnCeasingEnumeration ;
    skos:notation "immediateTermination" ;
    skos:prefLabel "immediateTermination" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OnCeasingEnumeration/noAction> a netex:OnCeasingEnumeration, skos:Concept ;
    skos:definition "If user ceases to be eligible, automatically substitute them with an appropriate replacement product."@en ;
    skos:inScheme netex:OnCeasingEnumeration ;
    skos:notation "noAction" ;
    skos:prefLabel "noAction" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OnCeasingEnumeration/other> a netex:OnCeasingEnumeration, skos:Concept ;
    skos:inScheme netex:OnCeasingEnumeration ;
    skos:notation "other" ;
    skos:prefLabel "other" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OnCeasingEnumeration/terminateAfterGracePeriod> a netex:OnCeasingEnumeration, skos:Concept ;
    skos:definition "If user ceases to be eligible, termination take place after the end of a grace period"@en ;
    skos:inScheme netex:OnCeasingEnumeration ;
    skos:notation "terminateAfterGracePeriod" ;
    skos:prefLabel "terminateAfterGracePeriod" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#OnCeasingEnumeration/useUntilExpiry> a netex:OnCeasingEnumeration, skos:Concept ;
    skos:definition "If user ceases to be eligible, they may go on using the product until it expires.."@en ;
    skos:inScheme netex:OnCeasingEnumeration ;
    skos:notation "useUntilExpiry" ;
    skos:prefLabel "useUntilExpiry" .

