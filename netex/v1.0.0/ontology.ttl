netex:PassengerStopAssignment a owl:Class ;
    rdfs:label "PassengerStopAssignment" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_stopAssignment_version.xsd> ;
    rdfs:comment "The default allocation of a SCHEDULED STOP POINT to a specific STOP PLACE, and also possibly a QUAY and BOARDING POSITION."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:StopAssignment ;
    skos:hiddenLabel "PassengerStopAssignment_VersionStructure" .

