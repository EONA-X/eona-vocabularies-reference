    rdfs:range xsd:positiveInteger ;
    skos:notation "order" .

netex:ZoneProjection a owl:Class ;
    rdfs:label "ZoneProjection" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_genericFramework/netex_zoneProjection_version.xsd> ;
    rdfs:comment "An oriented correspondence from one ZONE in a source layer, onto a target entity : e.g. POINT, COMPLEX FEATURE, within a defined TYPE OF PROJECTION."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#ZoneProjection_VersionStructure.ProjectedZoneRef> ], netex:Projection ;
    skos:hiddenLabel "ZoneProjection_VersionStructure" .

netex:ZoneProjectionIdType a rdfs:Datatype ;
    rdfs:label "ZoneProjectionIdType" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_framework/netex_genericFramework/netex_projection_support.xsd> ;
