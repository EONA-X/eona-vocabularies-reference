    rdfs:label "Name" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_passengerInformationEquipment_version.xsd> ;
    rdfs:comment "Name of LOGICAL DISPLAY."@en ;
    rdfs:domain netex:LogicalDisplay ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range rdf:langString ;
    skos:notation "Name" .

