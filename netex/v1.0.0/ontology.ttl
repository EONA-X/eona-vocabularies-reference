    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#InterchangeEndpointGroup.FromPointRef> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#InterchangeEndpointGroup.ToPointRef> ], netex:DataManagedObject, netex:Interchange ;
    skos:hiddenLabel "ServiceJourneyPatternInterchange_VersionStructure" .

