<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#InfrastructureFramePropertiesGroup.MeetingsRestricted> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "MeetingsRestricted" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_frames/netex_infrastructureFrame_version.xsd> ;
    rdfs:comment "Default sense for MEETING RESTRICTIONs in frame. If 'true', meetings at all points are restricted unless explicitly permittted, If 'false', meetings at all points are allowed, unless explicitly forbidden by a MEETING RESTRICTION. Default is 'f'alse'."@en ;
    rdfs:domain netex:InfrastructureFrame ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:boolean ;
