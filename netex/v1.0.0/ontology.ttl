netex:Customer a owl:Class ;
    rdfs:label "Customer" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_salesTransactions/netex_salesContract_version.xsd> ;
    rdfs:comment "An identified person or organisation involved in a fare process. There may be a FARE CONTRACT between the CUSTOMER and the OPERATOR or the AUTHORITY ruling the consumption of services."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:DataManagedObject, netex:DataManagedObjectStructure ;
    skos:hiddenLabel "Customer_VersionStructure" .

netex:CustomerAccount a owl:Class ;
    rdfs:label "CustomerAccount" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_3/part3_salesTransactions/netex_salesContract_version.xsd> ;
    rdfs:comment "A contract with a particular (but possibly anonymous) customer, ruling the consumption of transport services (and joint services). A CUSTOMER ACCOUNT may be designed for a fixed SALES OFFER PACKAGE (e.g. ticket) or to allow successive purchases of SALES OFFER PACKAGEs."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:subClassOf netex:DataManagedObject, netex:DataManagedObjectStructure ;
    skos:hiddenLabel "CustomerAccount_VersionStructure" .

