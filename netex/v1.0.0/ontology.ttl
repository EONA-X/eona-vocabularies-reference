    rdfs:comment "Whether VEHICLE or TRAIN is expected to depart from the QUAY to the right of a bystander facing the track edge of the platform. Default is true. +v2.0"@en ;
    rdfs:domain netex:StopAssignment ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:boolean ;
    skos:notation "DepartsToRight" .

