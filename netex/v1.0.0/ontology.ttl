    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:RailwayJunction ;
    skos:notation "FromPointRef" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#RailwayElementGroup.ToPointRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "ToPointRef" ;
