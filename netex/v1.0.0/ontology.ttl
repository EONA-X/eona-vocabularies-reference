    rdfs:comment "Reference to POINT to which centre of ZONE projects."@en ;
    rdfs:domain netex:ZoneProjection ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
