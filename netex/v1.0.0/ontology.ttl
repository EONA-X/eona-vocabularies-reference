    rdfs:domain netex:StopAssignment ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:boolean ;
    skos:notation "ArrivesFromLeft" .

<https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#StopAssignmentDirectionGroup.DepartsForwards> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "DepartsForwards" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_stopAssignment_version.xsd> ;
    rdfs:comment "Whether VEHICLE or TRAIN departs from stop travelling in a forwards direction, i.e. operational orientation. Default is true.. Default is true. +v2.0"@en ;
    rdfs:domain netex:StopAssignment ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range xsd:boolean ;
    skos:notation "DepartsForwards" .

