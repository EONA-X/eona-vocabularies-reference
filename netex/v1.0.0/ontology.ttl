    schema:domainIncludes netex:FlexibleServiceProperties, netex:SpecialService ;
    rdfs:comment "Flexible service type is FixedPassingTimes/DynamicPassingTimes/FixedHeadwayFrequency (in the last value, this provides a maximum waiting time, but no passing time is defined, all is done dynamically depending on the demand). A NotFlexible value is probably also required to clearly state that a Stop (i.e. Point in JP) is not flexible when others are."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:FlexibleServiceEnumeration ;
    skos:notation "FlexibleServiceType" .

