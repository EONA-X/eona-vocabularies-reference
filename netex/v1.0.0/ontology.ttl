    rdfs:label "StopPointInJourneyPatternIdType" ;
    dcterms:source <https://github.com/TransmodelEcosystem/NeTEx/blob/11d40b5e94684fa2ddea0222702b220d7d93760b/xsd/netex_part_1/part1_tacticalPlanning/netex_servicePattern_support.xsd> ;
