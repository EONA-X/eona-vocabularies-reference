    schema:domainIncludes netex:StopPlace, netex:StopPlaceComponent, netex:StopPlaceEntrance, netex:StopPlaceVehicleEntrance ;
    rdfs:comment "PUBLIC TRANSPORT MODES which may be accessed through associated place."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/netex/v1.0.0#> ;
    rdfs:range netex:AllPublicTransportModesListOfEnumerations ;
    skos:notation "OtherTransportModes" .

