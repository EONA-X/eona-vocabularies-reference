<> a dcat:Dataset, adms:Asset ;
    dcterms:title "NeTEx/Transmodel — EV Charging & Alternative-Fuel"@en ;
    dcterms:description "Hub-curated OWL/SKOS rendering of the NeTEx (CEN/TS 16614, Transmodel-based) vehicle-charging and alternative-fuel subset: charging/refuelling/battery equipment, recharging stations and points, and vehicle charging profiles."@en ;
    dcat:type assettype:c_89b4bdb7 ;
    adms:status status:CURRENT .

<> dcterms:creator [ a foaf:Agent ; foaf:name "CEN" ] .

<> eona:logo "cen-hero.png" .

[] vann:preferredNamespacePrefix "netex" ;
    vann:preferredNamespaceUri "https://vocab.eona-x.eu/netex/" .
