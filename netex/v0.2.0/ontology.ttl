    skos:editorialNote "NeTEx element TypeOfPlugRef (ref, minOccurs=0), VehicleChargingEquipmentGroup, xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd."@en .

netex:profileTypeOfPlug a skos:Concept ,
