# The Eona-X Metadata Profile
#
# A SHACL shapes graph formally constraining what every vocabulary's
# metadata.ttl is allowed to contain across the Eona Vocabulary Hub — the
# DCAT-AP 3.0.0 + ADMS 2.00 asset self-description each `<slug>/metadata.ttl`
# carries (eona-x/backlog#793), using the two controlled vocabularies chosen
# in the spike (eona-x/backlog#791) for dcat:type and adms:status. EuroVoc
# theming (dcat:theme) is explicitly out of scope for this profile — deferred,
# see #791 — so no shape here touches dcat:theme.
#
# This file is also the "semantic description and explanation" deliverable
# #791 asked for: every constraint below carries an rdfs:comment or
# skos:definition written for a human contributor, not just a validator —
# read them before adding a new vocabulary or picking a dcat:type/adms:status
# value.
#
# Validate a vocabulary's metadata.ttl against this profile, e.g. with pySHACL:
#   pyshacl -s eonax-metadata-profile/ontology.ttl -d <slug>/metadata.ttl

@base <https://w3id.org/eonax/metadata-profile/> .
@prefix eox-meta: <https://w3id.org/eonax/metadata-profile/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix assettype: <http://publications.europa.eu/resource/authority/asset-classification/> .
@prefix status: <http://publications.europa.eu/resource/authority/concept-status/> .

#################################################################
#  Profile (ontology)
#################################################################

eox-meta:
    a owl:Ontology ;
    rdfs:label "Eona-X Metadata Profile"@en ;
    dcterms:title "Eona-X Metadata Profile"@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:conformsTo <http://www.w3.org/ns/dcat#>, <http://www.w3.org/ns/adms#> ;
    dcterms:description """A SHACL shapes graph constraining the DCAT-AP + ADMS metadata.ttl self-description every vocabulary in the Eona Vocabulary Hub carries: it requires a title and description, restricts dcat:type to the Asset Classification concepts the hub actually publishes under, and restricts adms:status to the Concept Status values the hub currently uses (defaulting to CURRENT)."""@en ;
    rdfs:comment """Written to close out eona-x/backlog#791's request for human-readable notes explaining the use of DCAT-AP for vocabulary publication — read each shape's rdfs:comment/skos:definition below for the reasoning, not just the constraint."""@en ;
    rdfs:seeAlso <http://www.w3.org/ns/dcat#>, <http://www.w3.org/ns/adms#> ;
    dcterms:source "https://vocab.eona-x.eu/"^^xsd:anyURI .

#################################################################
#  The metadata shape
#################################################################

eox-meta:MetadataShape
    a sh:NodeShape ;
    rdfs:label "Eona-X hub asset metadata shape"@en ;
    skos:definition "Constrains the metadata.ttl self-description a hub vocabulary directory publishes about itself, modeled as both a dcat:Dataset and an adms:Asset (per the DCAT-AP + ADMS spike, eona-x/backlog#791)."@en ;
    sh:targetClass dcat:Dataset, adms:Asset ;

    sh:property [
        sh:path dcterms:title ;
        sh:name "title" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "en" ) ;
        rdfs:comment """Required: the catalog card and every hub listing page render this as the vocabulary's name. Without it a published asset has nothing to show a browsing user — this was the `title` key metadata.toml always required, carried forward unchanged."""@en ;
    ] ;

    sh:property [
        sh:path dcterms:description ;
        sh:name "description" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "en" ) ;
        rdfs:comment """Required: the one-line summary shown in the catalog list view, so a contributor can tell what a vocabulary is for before opening it. Carried forward unchanged from metadata.toml's required `description` key."""@en ;
    ] ;

    sh:property [
        sh:path dcat:type ;
        sh:name "asset classification" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( assettype:c_89b4bdb7 assettype:c_3948c2ed assettype:c_bba2bb35 ) ;
        skos:definition """Classifies the asset using the EU Publications Office's Asset Classification authority table, restricted to the three concepts the hub actually publishes assets under: c_89b4bdb7 "Formal ontology" for an OWL/RDFS vocabulary (metadata.toml's old, default type="owl"), c_3948c2ed "Markup schema" for a SHACL shapes graph (old type="shacl"), and c_bba2bb35 "Alignment" for a SKOS crosswalk between two vocabularies (old type="crosswalk", confirmed the right concept for this use in eona-x/backlog#800). Restricting to sh:in rather than accepting any Asset Classification concept catches a typo'd or mis-picked classification at authoring time instead of it surfacing later as a wrong facet in the catalog UI."""@en ;
        rdfs:seeAlso <http://publications.europa.eu/resource/authority/asset-classification/c_89b4bdb7>, <http://publications.europa.eu/resource/authority/asset-classification/c_3948c2ed>, <http://publications.europa.eu/resource/authority/asset-classification/c_bba2bb35> ;
    ] ;

    sh:property [
        sh:path adms:status ;
        sh:name "lifecycle status" ;
        sh:maxCount 1 ;
        sh:in ( status:CURRENT ) ;
        sh:defaultValue status:CURRENT ;
        skos:definition """Records the asset's maturity/lifecycle state using the EU Publications Office's Concept Status authority table. Every vocabulary the hub currently publishes is actively maintained, so status:CURRENT is the only value in scope today and is also the default a metadata.ttl may omit this property and rely on. The property is present (not folded away) so the hub has somewhere to record it the day a vocabulary is actually superseded or withdrawn — at that point add e.g. status:DEPRECATED or status:RETIRED to this sh:in list; a value outside the allowed set fails loudly instead of silently rendering as an unrecognised status in the catalog."""@en ;
        rdfs:seeAlso <http://publications.europa.eu/resource/authority/concept-status/CURRENT> ;
    ] .
