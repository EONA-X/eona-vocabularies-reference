    rdfs:label "shortNameUtf8" ;
    rdfs:comment "station name with upper and lower case letters in UTF8"@en ;
    rdfs:domain osdm:StationNamesDef ;
    rdfs:range xsd:string ;
    skos:notation "shortNameUtf8" .

