    skos:prefLabel "INABILITY_TO_TRAVEL" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OverruleCode/JOURNEY_OBSOLETE> a osdm:OverruleCode, skos:Concept ;
    skos:inScheme osdm:OverruleCode ;
