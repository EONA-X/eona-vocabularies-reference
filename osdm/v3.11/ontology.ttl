<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Fulfillment.summary> a owl:DatatypeProperty ;
    rdfs:label "summary" ;
    rdfs:comment "A human-readable description of the fulfillment."@en ;
    rdfs:domain osdm:Fulfillment ;
    rdfs:range xsd:string ;
    skos:notation "summary" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Fulfillment.tripCoverage> a owl:ObjectProperty ;
