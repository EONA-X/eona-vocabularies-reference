osdm:CoachLayout a owl:Class ;
    rdfs:label "CoachLayout" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/place.yml> ;
    rdfs:comment "coach layout providing data to draw a coach layout. The items of a coach\nare located via coordinates with (0,0) in the upper left corner. All\ncoordinates are given without sign."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachLayout.gridSize> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachLayout.id> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachLayout._links> a owl:ObjectProperty ;
    rdfs:label "_links" ;
    rdfs:domain osdm:CoachLayout ;
    rdfs:range osdm:LinksItem ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "_links" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachLayout.compartmentNumbers> a owl:ObjectProperty ;
    rdfs:label "compartmentNumbers" ;
    rdfs:domain osdm:CoachLayout ;
    rdfs:range osdm:CoachLayoutCompartmentNumber ;
    skos:notation "compartmentNumbers" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachLayout.directedInternals> a owl:ObjectProperty ;
    rdfs:label "directedInternals" ;
    rdfs:domain osdm:CoachLayout ;
    rdfs:range osdm:CoachLayoutDirectedInternal ;
    skos:notation "directedInternals" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachLayout.gridSize> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "gridSize" ;
    rdfs:domain osdm:CoachLayout ;
    rdfs:range osdm:CoachLayoutGridSize ;
    skos:notation "gridSize" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachLayout.id> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:comment "id of this coachLayout on this server"@en ;
    rdfs:domain osdm:CoachLayout ;
    rdfs:range xsd:string ;
    skos:notation "id" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachLayout.internals> a owl:ObjectProperty ;
    rdfs:label "internals" ;
    rdfs:domain osdm:CoachLayout ;
    rdfs:range osdm:CoachLayoutInternal ;
    skos:notation "internals" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachLayout.places> a owl:ObjectProperty ;
    rdfs:label "places" ;
    rdfs:comment "list of places included in the layout"@en ;
    rdfs:domain osdm:CoachLayout ;
    rdfs:range osdm:CoachLayoutPlace ;
    skos:notation "places" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachLayout.signs> a owl:ObjectProperty ;
    rdfs:label "signs" ;
    rdfs:domain osdm:CoachLayout ;
    rdfs:range osdm:CoachLayoutSign ;
    skos:notation "signs" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachLayout.summary> a owl:DatatypeProperty ;
    rdfs:label "summary" ;
    rdfs:comment "A human-readable description of the coach layout."@en ;
    rdfs:domain osdm:CoachLayout ;
    rdfs:range xsd:string ;
    skos:example "Coach 3 in train T-122" ;
    skos:notation "summary" .

