osdm:PaymentMethod a owl:Class ;
    rdfs:label "PaymentMethod" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Method of payment used by the customer to the distributor."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PaymentMethod.type> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PaymentMethod.appliedVoucherAmount> a owl:ObjectProperty ;
    rdfs:label "appliedVoucherAmount" ;
    rdfs:comment "Voucher amount applied to the payment."@en ;
    rdfs:domain osdm:PaymentMethod ;
    rdfs:range osdm:Price ;
    skos:notation "appliedVoucherAmount" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PaymentMethod.remainingVoucherAmount> a owl:ObjectProperty ;
    rdfs:label "remainingVoucherAmount" ;
    rdfs:comment "Remaining amount on the voucher after payment."@en ;
    rdfs:domain osdm:PaymentMethod ;
    rdfs:range osdm:Price ;
    skos:notation "remainingVoucherAmount" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PaymentMethod.transactionId> a owl:DatatypeProperty ;
    rdfs:label "transactionId" ;
    rdfs:domain osdm:PaymentMethod ;
    rdfs:range xsd:string ;
    skos:notation "transactionId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PaymentMethod.type> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "type" ;
    rdfs:domain osdm:PaymentMethod ;
    rdfs:range osdm:PaymentType ;
    skos:notation "type" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PaymentMethod.voucherInformation> a owl:ObjectProperty ;
    rdfs:label "voucherInformation" ;
    rdfs:domain osdm:PaymentMethod ;
    rdfs:range osdm:VoucherInformation ;
    skos:notation "voucherInformation" .

