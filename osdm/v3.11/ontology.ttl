    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/trip.yml> ;
    rdfs:comment "Reference to a Stop Place using URNs to define code.\nFor UIC see UIC MERITS/TAP-TSI station codes. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopPlaceRef.stopPlaceRef> ], osdm:PlaceRef .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopPlaceRef.stopPlaceRef> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "stopPlaceRef" ;
    rdfs:domain osdm:StopPlaceRef ;
    rdfs:range xsd:string ;
    skos:example "urn:uic:stn:8503000" ;
    skos:notation "stopPlaceRef" .

osdm:SupportingDocument a owl:Class ;
    rdfs:label "SupportingDocument" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "The supporting document helps to supporting the claim.  Either downloadLink + downloadExpiry or content must be provided."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SupportingDocument.downloadExpiry> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SupportingDocument.format> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SupportingDocument.title> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SupportingDocument.content> a owl:DatatypeProperty ;
    rdfs:label "content" ;
    rdfs:comment "base64 encoded binary of the actual document. The length restriction of 4 MBytes applies to the encoded\nstring, so the raw document cannot exceed 3 MBytes in size."@en ;
    rdfs:domain osdm:SupportingDocument ;
    rdfs:range xsd:base64Binary ;
    skos:notation "content" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SupportingDocument.downloadExpiry> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "downloadExpiry" ;
