    rdfs:range xsd:boolean ;
    skos:notation "isProviderFee" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Fee.price> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "price" ;
    rdfs:domain osdm:Fee ;
    rdfs:range osdm:Price ;
    skos:notation "price" .

