osdm:InitialPlaceInput a owl:Class ;
    rdfs:label "InitialPlaceInput" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/place.yml> ;
    rdfs:comment "Initial input for the place information request. This input defines what is originally looked for.\nProvided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#InitialPlaceInput.geoPosition> a owl:ObjectProperty ;
    rdfs:label "geoPosition" ;
    rdfs:domain osdm:InitialPlaceInput ;
    rdfs:range osdm:GeoPosition ;
    skos:notation "geoPosition" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#InitialPlaceInput.name> a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "Name of the place object which is looked after. This is usually the user's input. If not given,\nthe name of the resulting place objects is not relevant."@en ;
    rdfs:domain osdm:InitialPlaceInput ;
    rdfs:range xsd:string ;
    skos:example "Bern Bärengraben" ;
    skos:notation "name" .

osdm:Intermediate a owl:Class ;
    rdfs:label "Intermediate" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/trip.yml> ;
    rdfs:comment "Describes the situation at a stop or station that lies between the Board and\nAlight stop or station including time-related information. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Intermediate.serviceArrival> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Intermediate.serviceDeparture> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Intermediate.stopPlaceName> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Intermediate.stopPlaceRef> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Intermediate.estimatedStopPointName> a owl:DatatypeProperty ;
    rdfs:label "estimatedStopPointName" ;
    rdfs:comment "Name of the bay/quay/terminal where to board the vehicle. As to the latest realtime status."@en ;
    rdfs:domain osdm:Intermediate ;
    rdfs:range xsd:string ;
    skos:example "8" ;
    skos:notation "estimatedStopPointName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Intermediate.plannedStopPointName> a owl:DatatypeProperty ;
    rdfs:label "plannedStopPointName" ;
    rdfs:comment "Name of the bay/quay/terminal where to board/alight from the vehicle. According to\nplanned timetable."@en ;
    rdfs:domain osdm:Intermediate ;
    rdfs:range xsd:string ;
    skos:example "3" ;
    skos:notation "plannedStopPointName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Intermediate.serviceArrival> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "serviceArrival" ;
    rdfs:domain osdm:Intermediate ;
    rdfs:range osdm:ServiceTime ;
    skos:notation "serviceArrival" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Intermediate.serviceDeparture> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "serviceDeparture" ;
    rdfs:domain osdm:Intermediate ;
    rdfs:range osdm:ServiceTime ;
    skos:notation "serviceDeparture" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Intermediate.status> a owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:domain osdm:Intermediate ;
    rdfs:range osdm:StopCallStatus ;
    skos:notation "status" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Intermediate.stopPlaceName> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "stopPlaceName" ;
    rdfs:domain osdm:Intermediate ;
    rdfs:range xsd:string ;
    skos:example "Luzern" ;
    skos:notation "stopPlaceName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Intermediate.stopPlaceRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "stopPlaceRef" ;
    rdfs:domain osdm:Intermediate ;
    rdfs:range osdm:StopPlaceRef ;
    skos:notation "stopPlaceRef" .

