<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripSearchCriteria.vias> a owl:ObjectProperty ;
    rdfs:label "vias" ;
    rdfs:comment "Ordered series of points where the journey must pass through. If more\nthan one via point is given all of them must be obeyed - in the correct\norder. The server is allowed to replace a via stop by equivalent stops.\n\nTripDataFilters given at a via apply to the section after that via. To apply a TripDataFilter for \nthe first section (between the origin and the first via), use the TripDataFilter within the\nTripParameters structure."@en ;
    rdfs:domain osdm:TripSearchCriteria ;
    rdfs:range osdm:TripVia ;
    skos:notation "vias" .

