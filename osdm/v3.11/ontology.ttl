osdm:VAT a owl:Class ;
    rdfs:label "VAT" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "The VAT structure details a VAT amount (in case of international travel, there may be multiple VAT structures).\nThe netAmount is the amount before adding the VAT; the grossAmount is the amount including VAT, where\nthe amount is the actual VAT being described here. So the equation netAmount + amount = grossAmount holds.\nFurthermore, the equation netAmount * percentage = amount also holds, but is susceptible to possible rounding\nerrors.\nAll the grossAmounts of the VAT structures should add up to the overall amount of the enclosing price structure.\nThe currency is inherited from the currency of the associated price."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.amount> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.countryCode> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.amount> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "amount" ;
    rdfs:comment "VAT amount in cents"@en ;
    rdfs:domain osdm:VAT ;
    rdfs:range xsd:int ;
    skos:example "5" ;
    skos:notation "amount" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.countryCode> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "countryCode" ;
    rdfs:domain osdm:VAT ;
    rdfs:range osdm:CountryCode ;
    skos:notation "countryCode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.grossAmount> a owl:DatatypeProperty ;
    rdfs:label "grossAmount" ;
    rdfs:comment "total amount after adding VAT in cents"@en ;
    rdfs:domain osdm:VAT ;
    rdfs:range xsd:int ;
    skos:example "5" ;
    skos:notation "grossAmount" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.grossAmountScale> a owl:DatatypeProperty ;
    rdfs:label "grossAmountScale" ;
    rdfs:comment "scale of the grossAmount - the number of positions after the comma"@en ;
    rdfs:domain osdm:VAT ;
    rdfs:range xsd:int ;
    skos:notation "grossAmountScale" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.netAmount> a owl:DatatypeProperty ;
    rdfs:label "netAmount" ;
    rdfs:comment "amount before adding VAT"@en ;
    rdfs:domain osdm:VAT ;
    rdfs:range xsd:int ;
    skos:example "5" ;
    skos:notation "netAmount" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.netAmountScale> a owl:DatatypeProperty ;
    rdfs:label "netAmountScale" ;
    rdfs:comment "scale of the netAmount - the number of positions after the comma"@en ;
    rdfs:domain osdm:VAT ;
    rdfs:range xsd:int ;
    skos:notation "netAmountScale" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.percentage> a owl:DatatypeProperty ;
    rdfs:label "percentage" ;
    rdfs:domain osdm:VAT ;
    rdfs:range xsd:float ;
    skos:notation "percentage" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.scale> a owl:DatatypeProperty ;
    rdfs:label "scale" ;
    rdfs:comment "scale of the amount - the number of positions after the comma"@en ;
    rdfs:domain osdm:VAT ;
    rdfs:range xsd:int ;
    skos:notation "scale" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.scope> a owl:ObjectProperty ;
    rdfs:label "scope" ;
    rdfs:domain osdm:VAT ;
    rdfs:range osdm:VatScope ;
    skos:notation "scope" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.taxId> a owl:DatatypeProperty ;
    rdfs:label "taxId" ;
    rdfs:domain osdm:VAT ;
    rdfs:range xsd:string ;
    skos:notation "taxId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.taxIdOnInvoice> a owl:DatatypeProperty ;
    rdfs:label "taxIdOnInvoice" ;
    rdfs:domain osdm:VAT ;
    rdfs:range xsd:boolean ;
    skos:notation "taxIdOnInvoice" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VAT.vatOnInvoice> a owl:DatatypeProperty ;
    rdfs:label "vatOnInvoice" ;
    rdfs:domain osdm:VAT ;
    rdfs:range xsd:boolean ;
    skos:notation "vatOnInvoice" .

