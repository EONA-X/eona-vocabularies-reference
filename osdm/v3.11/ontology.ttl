    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/place.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LayoutCoordinates.x> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LayoutCoordinates.y> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LayoutCoordinates.zOrder> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LayoutCoordinates.x> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "x" ;
    rdfs:comment "horizontal coordinate of the center of the place"@en ;
    rdfs:domain osdm:LayoutCoordinates ;
    rdfs:range xsd:int ;
    skos:notation "x" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LayoutCoordinates.y> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "y" ;
    rdfs:comment "vertical coordinate of the center of the place"@en ;
    rdfs:domain osdm:LayoutCoordinates ;
    rdfs:range xsd:int ;
    skos:notation "y" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LayoutCoordinates.zOrder> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "zOrder" ;
    rdfs:comment "Graphical layer where this item has to be placed.\nCode list according to UIC90918-1\n  - value 0: lowest layer usually used for walls\n  - value 1: middle layer usually used by places\n  - value 2: top layer usually used by icons"@en ;
    rdfs:domain osdm:LayoutCoordinates ;
    rdfs:range xsd:int ;
    skos:notation "zOrder" .

osdm:LegAttribute a owl:Class ;
    rdfs:label "LegAttribute" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Attributes that are not valid on the whole service, but only on section of a trip made on a single mode without interchange between boarding and alighting."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LegAttribute.text> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LegAttribute.code> a owl:DatatypeProperty ;
    rdfs:label "code" ;
    rdfs:comment "Internal code of the attribute. Can be used for detection of double occurrences. Refers to Service Facilities / Leg Attributes from the Catalog of Code Lists"@en ;
    rdfs:domain osdm:LegAttribute ;
    rdfs:range xsd:string ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LegAttribute.fromStopSeqNumber> a owl:DatatypeProperty ;
    rdfs:label "fromStopSeqNumber" ;
    rdfs:comment "The attribute is valid from the stop point with this sequence number within the leg. If missing it is valid from the beginning of the leg."@en ;
    rdfs:domain osdm:LegAttribute ;
    rdfs:range xsd:int ;
    skos:notation "fromStopSeqNumber" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LegAttribute.text> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "text" ;
    rdfs:comment "Text of the attribute to be shown to the user."@en ;
    rdfs:domain osdm:LegAttribute ;
    rdfs:range xsd:string ;
    skos:notation "text" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LegAttribute.toStopSeqNumber> a owl:DatatypeProperty ;
    rdfs:label "toStopSeqNumber" ;
    rdfs:comment "The attribute is valid to the stop point (inclusively) with this sequence number within the leg. If missing it is valid to the end of the leg."@en ;
    rdfs:domain osdm:LegAttribute ;
    rdfs:range xsd:int ;
    skos:notation "toStopSeqNumber" .

osdm:LegacyAccountingIdentifier a owl:Class ;
