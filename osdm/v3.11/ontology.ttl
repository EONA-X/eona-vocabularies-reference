    rdfs:domain osdm:Passenger ;
    rdfs:range osdm:PRMNeedType ;
    skos:notation "prmNeeds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.summary> a owl:DatatypeProperty ;
    rdfs:label "summary" ;
    rdfs:comment "A human-readable description of the passenger."@en ;
    rdfs:domain osdm:Passenger ;
    rdfs:range xsd:string ;
    skos:notation "summary" .

