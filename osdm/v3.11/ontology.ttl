osdm:PlaceRestriction a owl:Class ;
    rdfs:label "PlaceRestriction" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/place.yml> ;
    rdfs:comment "Reservation based place selection criteria. Each requested place selection criterion will only be considered if it is covered by the referenced reservation fare/offerPart/bookingPart. E.g. place selection criterion serviceClass=HIGH will only be considered if reservationRef references a first/high class offer."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceRestriction.reservationRef> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceRestriction.accommodationSubTypes> a owl:ObjectProperty ;
    rdfs:label "accommodationSubTypes" ;
    rdfs:comment "Specifies the accommodation sub types for which place availabilities shall be returned."@en ;
    rdfs:domain osdm:PlaceRestriction ;
    rdfs:range osdm:AccommodationSubType ;
    skos:notation "accommodationSubTypes" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceRestriction.reservationRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "reservationRef" ;
    rdfs:domain osdm:PlaceRestriction ;
    rdfs:range osdm:ReservationReference ;
    skos:notation "reservationRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceRestriction.serviceClass> a owl:ObjectProperty ;
    rdfs:label "serviceClass" ;
    rdfs:domain osdm:PlaceRestriction ;
    rdfs:range osdm:ServiceClassType ;
    skos:notation "serviceClass" .

osdm:PlaceSelection a owl:Class ;
    rdfs:label "PlaceSelection" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/place.yml> ;
    rdfs:comment "Place selection options and selected options in an offer\n- reference place for adjacent reservation\n- selected optional place properties\n- selected places from a graphical place selection\n`tripLegCoverage` is deprecated and can be retrieved by the `reservationId`"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceSelection.reservationId> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceSelection.tripLegCoverage> ] .

