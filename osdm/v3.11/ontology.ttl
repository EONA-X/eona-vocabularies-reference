    rdfs:domain osdm:FareCombinationModel ;
    rdfs:range xsd:boolean ;
    skos:notation "isValidOnlyWhenCombined" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareCombinationModel.model> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "model" ;
