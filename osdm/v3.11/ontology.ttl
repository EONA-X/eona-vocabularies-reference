osdm:Warning a owl:Class ;
    rdfs:label "Warning" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "This element can be used to pass non-blocking information or events,\nsuch as a price difference with the initially offered price at booking time.\nIt is inspired on the JSon problem structure.\n\nThis structure has been deprecated and is replaced by the Problem structure."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Warning.code> ] ;
    owl:deprecated "true"^^xsd:boolean .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Warning.code> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "code" ;
    rdfs:domain osdm:Warning ;
    rdfs:range xsd:string ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Warning.detail> a owl:DatatypeProperty ;
    rdfs:label "detail" ;
    rdfs:comment "A human readable explanation specific to this occurrence of the\nwarning."@en ;
    rdfs:domain osdm:Warning ;
    rdfs:range xsd:string ;
    skos:example "The price of the given offer part has been updated during the booking operation" ;
    skos:notation "detail" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Warning.instance> a owl:DatatypeProperty ;
    rdfs:label "instance" ;
    rdfs:comment "An absolute URI that identifies the specific occurrence of the warning."@en ;
    rdfs:domain osdm:Warning ;
    rdfs:range xsd:anyURI ;
    skos:example "offers/offer1234" ;
    skos:notation "instance" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Warning.type> a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:comment "An absolute URI that identifies the warning type. When dereferenced,\nit SHOULD provide human-readable documentation for the problem type\n(e.g., using HTML)."@en ;
    rdfs:domain osdm:Warning ;
    rdfs:range xsd:anyURI ;
    skos:example "https://example.com/warns/price-updated" ;
    skos:notation "type" .

osdm:WarningCollection a owl:Class ;
