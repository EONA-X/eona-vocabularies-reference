osdm:PlaceGroup a owl:Class ;
    rdfs:label "PlaceGroup" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/place.yml> ;
    rdfs:comment "A place group groups places by service class and optionally by accommodation sub type. A place group not necessarily needs to be visualized (e.g. as a rectangle). Visualization can be done using ServiceIcons and GraphicElements.\n\nNevertheless, a place group can be useful for rendering of coach decks/places for which no place availabilities were returned, as further information (service class, accommodation sub type) can be displayed .\n\nIf availabilities were returned for a certain place, travel class and accommodation sub type values returned in the availability response must be displayed (they replace the static travel class / accommodation sub type defined on the place group). Reason: travel class and accommodation sub type values can dynamically change for each vehicle run.\n\nExample 1: Class upgrade\nA customer with a second class reservation ticket might be placed on a first class seat.\n\nExample 2: New/more specific AccommodationSubType\nAccommodationSubType=BUSINESS defined in static master data might be changed into AccommodationSubType=BUSINESS_COMFORT on certain vehicle runs."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceGroup.places> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceGroup.serviceClass> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceGroup.accommodationSubType> a owl:ObjectProperty ;
    rdfs:label "accommodationSubType" ;
    rdfs:domain osdm:PlaceGroup ;
    rdfs:range osdm:AccommodationSubType ;
    skos:notation "accommodationSubType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceGroup.accommodationType> a owl:ObjectProperty ;
    rdfs:label "accommodationType" ;
    rdfs:domain osdm:PlaceGroup ;
    rdfs:range osdm:AccommodationType ;
    skos:notation "accommodationType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceGroup.places> a owl:ObjectProperty ;
    rdfs:label "places" ;
    rdfs:comment "Seats or bicycle hooks in a coach compartment."@en ;
    rdfs:domain osdm:PlaceGroup ;
    rdfs:range osdm:PlaceLayout ;
    skos:notation "places" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceGroup.serviceClass> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "serviceClass" ;
    rdfs:domain osdm:PlaceGroup ;
    rdfs:range osdm:ServiceClassType ;
    skos:notation "serviceClass" .

osdm:PlaceLayout a owl:Class ;
    rdfs:label "PlaceLayout" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/place.yml> ;
    rdfs:comment "A place (e.g. a seat or bicycle hook)"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceLayout.number> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceLayout.orientation> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceLayout.rectangle> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceLayout.number> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "number" ;
    rdfs:comment "The place number. There might be cases where the place number is not unique \nper coach (e.g. same place number for a seat and associated bicycle hook, same place numbers on upper and lower deck)"@en ;
    rdfs:domain osdm:PlaceLayout ;
    rdfs:range xsd:string ;
    skos:notation "number" .

