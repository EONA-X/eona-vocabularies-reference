    skos:prefLabel "NO" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundType/WITH_CONDITION> a osdm:RefundType, skos:Concept ;
    skos:inScheme osdm:RefundType ;
    skos:notation "WITH_CONDITION" ;
    skos:prefLabel "WITH_CONDITION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundType/YES> a osdm:RefundType, skos:Concept ;
    skos:inScheme osdm:RefundType ;
    skos:notation "YES" ;
