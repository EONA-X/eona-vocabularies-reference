osdm:TrainValidity a owl:Class ;
    rdfs:label "TrainValidity" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/fare.yml> ;
    rdfs:comment "Validity depending on boarding / leaving of a train. The ticket is valid\nfrom departure until the destination station in the train if departure or destination is within the from - until range.\nThe validation can reference the departure or the destination time to decide the validity (e.g. Eurail/Interrail passes\ncurrently use the departure for the validity on night trains)."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TrainValidity.carriers> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TrainValidity.from> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TrainValidity.scope> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TrainValidity.until> ] .

