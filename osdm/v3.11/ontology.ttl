<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContactDetail.address> a owl:DatatypeProperty ;
    rdfs:label "address" ;
    rdfs:domain osdm:ContactDetail ;
    rdfs:range xsd:string ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "address" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContactDetail.email> a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:domain osdm:ContactDetail ;
    rdfs:range xsd:string ;
    skos:notation "email" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContactDetail.phoneNumber> a owl:DatatypeProperty ;
    rdfs:label "phoneNumber" ;
    rdfs:comment "Preferably a mobile phone number, to be contacted in case changes to the booking occur, e.g., in case of delays or interruptions.\nFormat according to E.164 The international public telecommunication numbering plan"@en ;
    rdfs:domain osdm:ContactDetail ;
    rdfs:range xsd:string ;
    skos:notation "phoneNumber" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContactDetail.postalAddress> a owl:ObjectProperty ;
    rdfs:label "postalAddress" ;
    rdfs:domain osdm:ContactDetail ;
    rdfs:range osdm:PostalAddress ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "postalAddress" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContactDetail.preferredLanguage> a owl:DatatypeProperty ;
    rdfs:label "preferredLanguage" ;
    rdfs:comment "ISO-639-1 language code"@en ;
    rdfs:domain osdm:ContactDetail ;
    rdfs:range xsd:string ;
    skos:notation "preferredLanguage" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContactDetail.summary> a owl:DatatypeProperty ;
    rdfs:label "summary" ;
    rdfs:comment "A human-readable description of the contact."@en ;
    rdfs:domain osdm:ContactDetail ;
    rdfs:range xsd:string ;
    skos:notation "summary" .

osdm:ContextType a owl:Class, skos:ConceptScheme ;
