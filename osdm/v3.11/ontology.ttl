<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContinuousServiceProcessIndication/DEEP_INTEGRATION> a osdm:ContinuousServiceProcessIndication, skos:Concept ;
    skos:inScheme osdm:ContinuousServiceProcessIndication ;
    skos:notation "DEEP_INTEGRATION" ;
    skos:prefLabel "DEEP_INTEGRATION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContinuousServiceProcessIndication/PARKING_IMAGE_REQUIRED> a osdm:ContinuousServiceProcessIndication, skos:Concept ;
    skos:definition "parking image required at the end of the usage"@en ;
    skos:inScheme osdm:ContinuousServiceProcessIndication ;
    skos:notation "PARKING_IMAGE_REQUIRED" ;
    skos:prefLabel "PARKING_IMAGE_REQUIRED" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContinuousServiceProcessIndication/POSTPAID> a osdm:ContinuousServiceProcessIndication, skos:Concept ;
    skos:inScheme osdm:ContinuousServiceProcessIndication ;
    skos:notation "POSTPAID" ;
    skos:prefLabel "POSTPAID" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContinuousServiceProcessIndication/PREPAID> a osdm:ContinuousServiceProcessIndication, skos:Concept ;
    skos:inScheme osdm:ContinuousServiceProcessIndication ;
    skos:notation "PREPAID" ;
