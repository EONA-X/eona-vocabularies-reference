osdm:FulfillmentMediaType a owl:Class, skos:ConceptScheme ;
    rdfs:label "FulfillmentMediaType" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/fulfillment.yml> ;
    rdfs:comment "Fulfillment types. RCT2, RCCST and UIC_PDF are official UIC standards.\nNotice:`ALLOCATOR_APP` is deprecated and should not be used anymore. The `ALLOCATOR_APP` type is replaced by the `RETAILER_APP` type. `DISTRIBUTOR_APP` was introduced to distinguish between the different types of apps that can be used to fulfill a booking.\nValues from the [Fulfillment Media Type Code List](https://osdm.io/spec/catalog-of-code-lists/#FulfillmentMediaType)\nListed values here are examples."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentMediaType/ALLOCATOR_APP> a osdm:FulfillmentMediaType, skos:Concept ;
    skos:inScheme osdm:FulfillmentMediaType ;
    skos:notation "ALLOCATOR_APP" ;
    skos:prefLabel "ALLOCATOR_APP" .

