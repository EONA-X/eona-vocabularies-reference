    rdfs:domain osdm:TripCollectionResponse ;
    rdfs:range osdm:Problem ;
    skos:notation "problems" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripCollectionResponse.tripSummaries> a owl:ObjectProperty ;
    rdfs:label "tripSummaries" ;
    rdfs:domain osdm:TripCollectionResponse ;
    rdfs:range osdm:TripSummary ;
    skos:notation "tripSummaries" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripCollectionResponse.trips> a owl:ObjectProperty ;
    rdfs:label "trips" ;
    rdfs:domain osdm:TripCollectionResponse ;
    rdfs:range osdm:Trip ;
    skos:notation "trips" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripCollectionResponse.warning> a owl:ObjectProperty ;
    rdfs:label "warning" ;
