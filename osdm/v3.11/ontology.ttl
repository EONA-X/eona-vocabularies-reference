osdm:Passenger a owl:Class ;
    rdfs:label "Passenger" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/person.yml> ;
    rdfs:comment "Information about a passenger.\n\nEither the date of birth or the age at the time of travel needs to be set. We recommend to use date of birth as it is more stable than age."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.externalRef> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.id> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.type> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger._links> a owl:ObjectProperty ;
    rdfs:label "_links" ;
    rdfs:domain osdm:Passenger ;
    rdfs:range osdm:LinksItem ;
    skos:notation "_links" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.age> a owl:DatatypeProperty ;
    rdfs:label "age" ;
    rdfs:domain osdm:Passenger ;
    rdfs:range xsd:int ;
    skos:notation "age" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.cards> a owl:ObjectProperty ;
    rdfs:label "cards" ;
    rdfs:comment "reduction or loyalty cards owned by the passenger"@en ;
    rdfs:domain osdm:Passenger ;
    rdfs:range osdm:CardReference ;
    skos:notation "cards" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.dateOfBirth> a owl:DatatypeProperty ;
    rdfs:label "dateOfBirth" ;
    rdfs:comment "date of birth of the passenger"@en ;
    rdfs:domain osdm:Passenger ;
    rdfs:range xsd:date ;
    skos:notation "dateOfBirth" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.detail> a owl:ObjectProperty ;
    rdfs:label "detail" ;
    rdfs:domain osdm:Passenger ;
    rdfs:range osdm:PersonDetail ;
    skos:notation "detail" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.externalRef> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "externalRef" ;
    rdfs:comment "A stable reference to a passenger from other elements, or from caller system.\nWhen passed in passenger specification in an offer request, it must be echoed back in the\nresponse."@en ;
    rdfs:domain osdm:Passenger ;
    rdfs:range xsd:string ;
    skos:notation "externalRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.gender> a owl:ObjectProperty ;
    rdfs:label "gender" ;
    rdfs:domain osdm:Passenger ;
    rdfs:range osdm:Gender ;
    skos:notation "gender" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.id> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:domain osdm:Passenger ;
    rdfs:range xsd:string ;
    skos:notation "id" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.identificationCard> a owl:ObjectProperty ;
    rdfs:label "identificationCard" ;
    rdfs:domain osdm:Passenger ;
    rdfs:range osdm:IdentificationCard ;
    skos:notation "identificationCard" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Passenger.prmNeeds> a owl:ObjectProperty ;
    rdfs:label "prmNeeds" ;
