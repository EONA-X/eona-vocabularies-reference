    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContinuousServiceProcessIndication/AUTO_END_USAGE> a osdm:ContinuousServiceProcessIndication, skos:Concept ;
    skos:definition "usage ends automatically (e.g. by locking the service), the end of the usage does not need to be handled via OSDM"@en ;
    skos:inScheme osdm:ContinuousServiceProcessIndication ;
    skos:notation "AUTO_END_USAGE" ;
    skos:prefLabel "AUTO_END_USAGE" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContinuousServiceProcessIndication/AUTO_START_USAGE> a osdm:ContinuousServiceProcessIndication, skos:Concept ;
