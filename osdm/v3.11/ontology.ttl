osdm:DistributionMode a owl:Class, skos:ConceptScheme ;
    rdfs:label "DistributionMode" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "booking parts in product mode are provided as complete products where the tickets and \nconditions are prepared by the OSDM provider. Booking parts in fare mode need to be assembled \ninto tickets on the OSDM client side. In fare mode the conditions are defined on the client \nside the restrictions on conditions and combinability laid down in the booking part (fare). \nBy definition admissions and ancillaries are in PRODUCT_MODE and fares are in _MODE. Reservation \nmight be in PRODUCT_MODE or in FARE_MODE. Offers in FARE_MODE must not be provided unless they are\nrequested in the offer part type list."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DistributionMode/FARE_MODE> a osdm:DistributionMode, skos:Concept ;
    skos:inScheme osdm:DistributionMode ;
    skos:notation "FARE_MODE" ;
    skos:prefLabel "FARE_MODE" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DistributionMode/PRODUCT_MODE> a osdm:DistributionMode, skos:Concept ;
    skos:inScheme osdm:DistributionMode ;
    skos:notation "PRODUCT_MODE" ;
    skos:prefLabel "PRODUCT_MODE" .

