osdm:AccountingId a rdfs:Datatype ;
    rdfs:label "AccountingId" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "id used as reference to OSDM in the settlement data exchange"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:string ] .

osdm:AccountingRef a owl:Class ;
    rdfs:label "AccountingRef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "reference to accounting data in case the accounting is not provided by the API provider"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AccountingRef.accountingCompany> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AccountingRef.accountingCompany> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "accountingCompany" ;
    rdfs:domain osdm:AccountingRef ;
    rdfs:range osdm:CompanyRef ;
    skos:notation "accountingCompany" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AccountingRef.accountingIds> a owl:DatatypeProperty ;
    rdfs:label "accountingIds" ;
    rdfs:comment "ids of accounting data used to link the booking part with accounting data in the billing send by the accounting company"@en ;
    rdfs:domain osdm:AccountingRef ;
    rdfs:range osdm:AccountingId ;
    skos:notation "accountingIds" .

osdm:ActualPassengerType a owl:Class, skos:ConceptScheme ;
    rdfs:label "ActualPassengerType" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/person.yml> ;
    rdfs:comment "Actual Passenger type according to UIC passenger, i.e. passenger type list. \nReturns the passenger type according to the underlying fare system. \nE.g. a passenger of type PERSON is categorized as a ADULT or YOUTH.\nValues from the [Passenger Type Code List](https://osdm.io/spec/catalog-of-code-lists/#PassengerType)\nListed values here are examples."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

