osdm:ContinuousServiceProcessIndication a owl:Class, skos:ConceptScheme ;
    rdfs:label "ContinuousServiceProcessIndication" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/continuous-service.yml> ;
