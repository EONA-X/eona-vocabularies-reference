osdm:ProductCategory a owl:Class ;
    rdfs:label "ProductCategory" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/product.yml> ;
    rdfs:comment "Product category based on NeTEx/SIRI. A product category is a classification for vehicle journeys\nto express some common properties of journeys for marketing and fare products. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductCategory.name> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductCategory.productCategoryRef> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductCategory.shortName> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductCategory.name> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "name" ;
    rdfs:comment "Full name of this product category, e.g. 'TGV Lyria' in Switzerland and France.\nUIC: Long name of Service Brand"@en ;
    rdfs:domain osdm:ProductCategory ;
    rdfs:range xsd:string ;
    skos:example "TGV Lyria" ;
    skos:notation "name" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductCategory.productCategoryRef> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "productCategoryRef" ;
    rdfs:domain osdm:ProductCategory ;
    rdfs:range osdm:ProductCategoryRef ;
    skos:notation "productCategoryRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductCategory.shortName> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "shortName" ;
    rdfs:comment "Short name or acronym of the product category, likely to be published, e.g. 'TGV'\nUIC: Abbreviation of Service Brand"@en ;
    rdfs:domain osdm:ProductCategory ;
    rdfs:range xsd:string ;
    skos:example "TGV" ;
    skos:notation "shortName" .

osdm:ProductCategoryRef a rdfs:Datatype ;
    rdfs:label "ProductCategoryRef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/product.yml> ;
    rdfs:comment "Reference to a product category. Product categories should be defined once and used\nuniformly in all channels (e.g. NeTEx, SIRI, OJP). Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:string ] ;
    skos:example "urn:uic:sbc:76" .

