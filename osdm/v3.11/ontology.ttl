    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#WarningCollection.warnings> ] ;
    owl:deprecated "true"^^xsd:boolean .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#WarningCollection.warnings> a owl:ObjectProperty ;
