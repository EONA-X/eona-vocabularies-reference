    rdfs:label "accommodations" ;
    rdfs:domain osdm:PlaceSelection ;
    rdfs:range osdm:SelectedAccommodation ;
    skos:notation "accommodations" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceSelection.compartments> a owl:ObjectProperty ;
    rdfs:label "compartments" ;
    rdfs:domain osdm:PlaceSelection ;
    rdfs:range osdm:SelectedCompartment ;
    skos:notation "compartments" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceSelection.places> a owl:ObjectProperty ;
    rdfs:label "places" ;
    rdfs:domain osdm:PlaceSelection ;
    rdfs:range osdm:SelectedPlace ;
    skos:notation "places" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceSelection.referencePlace> a owl:ObjectProperty ;
    rdfs:label "referencePlace" ;
    rdfs:domain osdm:PlaceSelection ;
    rdfs:range osdm:SelectedReferencePlace ;
    skos:notation "referencePlace" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceSelection.reservationId> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "reservationId" ;
    rdfs:domain osdm:PlaceSelection ;
    rdfs:range xsd:string ;
    skos:notation "reservationId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceSelection.tripLegCoverage> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "tripLegCoverage" ;
    rdfs:domain osdm:PlaceSelection ;
    rdfs:range osdm:TripLegCoverage ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "tripLegCoverage" .

osdm:PlaceSelectionFlow a owl:Class, skos:ConceptScheme ;
    rdfs:label "PlaceSelectionFlow" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/place.yml> ;
    rdfs:comment "Known Values:\n- MANUAL_PLACE_SELECTION_WITH_FEE: Manual/graphical place selection. A seat selection fee is charged for certain places. /availabilities/vehicle-place-map must be called before the /bookings call.\n- MANUAL_PLACE_SELECTION_WITHOUT_FEE: Manual/graphical place selection. No seat selection fee is charged for certain places. /availabilities/vehicle-place-map must be called before the /bookings call.\n- AUTOMATIC_PLACE_SELECTION: Automatic place selection based on selected accommodation (sub) types and place properties (see BookingRequest.placeSelections[].accommodations[]). It is not necessary to call /availabilities/* before the /bookings call.\n- AUTOMATIC_PLACE_SELECTION_NEARBY: Automatic place selection nearby a given place. /availabilities/nearby must be called before the /bookings call.\n- AUTOMATIC_PLACE_SELECTION_PREFERENCES: Automatic place selection based on available place preferences. /availabilities/preferences must be called before the /bookings call."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceSelectionFlow/AUTOMATIC_PLACE_SELECTION> a osdm:PlaceSelectionFlow, skos:Concept ;
    skos:inScheme osdm:PlaceSelectionFlow ;
    skos:notation "AUTOMATIC_PLACE_SELECTION" ;
    skos:prefLabel "AUTOMATIC_PLACE_SELECTION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceSelectionFlow/AUTOMATIC_PLACE_SELECTION_NEARBY> a osdm:PlaceSelectionFlow, skos:Concept ;
    skos:inScheme osdm:PlaceSelectionFlow ;
    skos:notation "AUTOMATIC_PLACE_SELECTION_NEARBY" ;
    skos:prefLabel "AUTOMATIC_PLACE_SELECTION_NEARBY" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceSelectionFlow/AUTOMATIC_PLACE_SELECTION_PREFERENCES> a osdm:PlaceSelectionFlow, skos:Concept ;
    skos:inScheme osdm:PlaceSelectionFlow ;
    skos:notation "AUTOMATIC_PLACE_SELECTION_PREFERENCES" ;
    skos:prefLabel "AUTOMATIC_PLACE_SELECTION_PREFERENCES" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceSelectionFlow/MANUAL_PLACE_SELECTION_WITHOUT_FEE> a osdm:PlaceSelectionFlow, skos:Concept ;
    skos:inScheme osdm:PlaceSelectionFlow ;
    skos:notation "MANUAL_PLACE_SELECTION_WITHOUT_FEE" ;
    skos:prefLabel "MANUAL_PLACE_SELECTION_WITHOUT_FEE" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceSelectionFlow/MANUAL_PLACE_SELECTION_WITH_FEE> a osdm:PlaceSelectionFlow, skos:Concept ;
    skos:inScheme osdm:PlaceSelectionFlow ;
    skos:notation "MANUAL_PLACE_SELECTION_WITH_FEE" ;
    skos:prefLabel "MANUAL_PLACE_SELECTION_WITH_FEE" .

