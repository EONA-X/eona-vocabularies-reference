    rdfs:comment "In distributor mode placeProperties are mandatory to be returned."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.coachNumber> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.id> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.passengerIds> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.vehicleNumber> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.coachNumber> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "coachNumber" ;
    rdfs:domain osdm:ReservedPlace ;
    rdfs:range xsd:string ;
    skos:notation "coachNumber" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.compartmentNumber> a owl:DatatypeProperty ;
    rdfs:label "compartmentNumber" ;
    rdfs:comment "Compartment number as indicated at the compartment in the coach. A compartment number must be set if the compartment is selectable as a whole only."@en ;
    rdfs:domain osdm:ReservedPlace ;
    rdfs:range xsd:string ;
    skos:example "C1" ;
    skos:notation "compartmentNumber" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.deckLevel> a owl:ObjectProperty ;
    rdfs:label "deckLevel" ;
    rdfs:comment "Deck of the coach on which the reserved place is located. Relevant for multi-deck coaches, where the coach number alone does not identify the deck (a double-deck coach exposes two layouts under a single coach number)."@en ;
    rdfs:domain osdm:ReservedPlace ;
    rdfs:range osdm:CoachDeckLevel ;
    skos:notation "deckLevel" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.id> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:domain osdm:ReservedPlace ;
    rdfs:range xsd:string ;
    skos:notation "id" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.passengerIds> a owl:DatatypeProperty ;
    rdfs:label "passengerIds" ;
    rdfs:comment "Id of the passenger"@en ;
    rdfs:domain osdm:ReservedPlace ;
    rdfs:range xsd:string ;
    skos:notation "passengerIds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.placeDescription> a owl:DatatypeProperty ;
    rdfs:label "placeDescription" ;
    rdfs:comment "description of the places (e.g. 11-35,51)"@en ;
    rdfs:domain osdm:ReservedPlace ;
    rdfs:range xsd:string ;
    skos:notation "placeDescription" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.placeNumbers> a owl:DatatypeProperty ;
    rdfs:label "placeNumbers" ;
    rdfs:comment "list of individual place numbers"@en ;
    rdfs:domain osdm:ReservedPlace ;
    rdfs:range xsd:string ;
    skos:notation "placeNumbers" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.placeProperties> a owl:DatatypeProperty ;
    rdfs:label "placeProperties" ;
    rdfs:comment "place properties to be indicated to the customer"@en ;
    rdfs:domain osdm:ReservedPlace ;
    rdfs:range osdm:PlaceProperty ;
    skos:notation "placeProperties" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.splitSection> a owl:ObjectProperty ;
    rdfs:label "splitSection" ;
    rdfs:comment "Indication of the covered part of a leg in case the reserved \nplace does not cover the whole leg. This element is allowed \non in case the offer was requested using the SPLIT_RESERVATION product tag\nan implementation is not recommended."@en ;
    rdfs:domain osdm:ReservedPlace ;
    rdfs:range osdm:Section ;
    skos:notation "splitSection" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReservedPlace.vehicleNumber> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "vehicleNumber" ;
    rdfs:comment "vehicle number (e.g. train number)"@en ;
    rdfs:domain osdm:ReservedPlace ;
    rdfs:range xsd:string ;
    skos:notation "vehicleNumber" .

