    rdfs:label "issuingDate" ;
    rdfs:domain osdm:IdentificationCard ;
    rdfs:range xsd:dateTime ;
    skos:notation "issuingDate" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#IdentificationCard.name> a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "ICAO transliteration identical as written in the document"@en ;
    rdfs:domain osdm:IdentificationCard ;
    rdfs:range xsd:string ;
