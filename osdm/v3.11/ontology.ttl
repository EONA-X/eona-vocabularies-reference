    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionConstraintDef.maxInterruptions> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionConstraintDef.requiredProcesses> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionConstraintDef.maxDuration> a owl:DatatypeProperty ;
    rdfs:label "maxDuration" ;
    rdfs:comment "maximum duration of one interruption"@en ;
    rdfs:domain osdm:TripInterruptionConstraintDef ;
    rdfs:range xsd:duration ;
    skos:notation "maxDuration" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionConstraintDef.maxInterruptions> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "maxInterruptions" ;
    rdfs:comment "maximum number of interruptions"@en ;
    rdfs:domain osdm:TripInterruptionConstraintDef ;
    rdfs:range xsd:int ;
    skos:notation "maxInterruptions" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionConstraintDef.requiredProcesses> a owl:ObjectProperty ;
    rdfs:label "requiredProcesses" ;
    rdfs:comment "one of the listed processes is required for the interruption of the trip."@en ;
    rdfs:domain osdm:TripInterruptionConstraintDef ;
    rdfs:range osdm:TripInterruptionProcess ;
    skos:notation "requiredProcesses" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionConstraintDef.totalMaxDuration> a owl:DatatypeProperty ;
    rdfs:label "totalMaxDuration" ;
    rdfs:comment "maximum duration of all interruptions on the route"@en ;
    rdfs:domain osdm:TripInterruptionConstraintDef ;
    rdfs:range xsd:duration ;
    skos:notation "totalMaxDuration" .

osdm:TripInterruptionProcess a owl:Class, skos:ConceptScheme ;
    rdfs:label "TripInterruptionProcess" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json>, <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/trip.yml> ;
    rdfs:comment "MANUAL: passenger needs manual confirmation of train or station staff to interrupt the trip. ACTIVATION: Passenger needs to deactivate the ticket during the interruption (via an app)."@en, "Values from the [Trip Interruption Process Code List](https://osdm.io/spec/catalog-of-code-lists/#TripInterruptionProcess)\nKnown Values:\n- NONE\n- MANUAL: passenger needs manual confirmation of train or station staff to interrupt the trip.\n- ACTIVATION: Passenger needs to deactivate the ticket during the interruption (via an app)."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionProcess/ACTIVATION> a osdm:TripInterruptionProcess, skos:Concept ;
    skos:inScheme osdm:TripInterruptionProcess ;
    skos:notation "ACTIVATION" ;
    skos:prefLabel "ACTIVATION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionProcess/MANUAL> a osdm:TripInterruptionProcess, skos:Concept ;
    skos:inScheme osdm:TripInterruptionProcess ;
    skos:notation "MANUAL" ;
    skos:prefLabel "MANUAL" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionProcess/NONE> a osdm:TripInterruptionProcess, skos:Concept ;
    skos:inScheme osdm:TripInterruptionProcess ;
    skos:notation "NONE" ;
    skos:prefLabel "NONE" .

osdm:TripLeg a owl:Class ;
