    rdfs:domain osdm:AbstractOfferPart ;
    rdfs:range xsd:string ;
    skos:notation "summary" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AbstractOfferPart.summaryProductId> a owl:DatatypeProperty ;
    rdfs:label "summaryProductId" ;
    rdfs:comment "Id of the product representing the commercial attributes of this offer part. Although not currently mandatory, this attribute should in all cases be facilitate product based processing at the client"@en ;
    rdfs:domain osdm:AbstractOfferPart ;
    rdfs:range xsd:string ;
    skos:notation "summaryProductId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AbstractOfferPart.tripCoverage> a owl:ObjectProperty ;
    rdfs:label "tripCoverage" ;
    rdfs:domain osdm:AbstractOfferPart ;
    rdfs:range osdm:TripCoverage ;
    skos:notation "tripCoverage" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AbstractOfferPart.tripTags> a owl:DatatypeProperty ;
    rdfs:label "tripTags" ;
    rdfs:comment "List of tags (and their type) that allow identifying sets of compatible offers when trying to combine multiple offers covering one single trip.\nAt least one (not all) tripTags must be in common to allow combination\nIf no tag is provided, there is no trip constraint on this specific offer."@en ;
    rdfs:domain osdm:AbstractOfferPart ;
    rdfs:range xsd:string ;
    skos:notation "tripTags" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AbstractOfferPart.validFrom> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "validFrom" ;
    rdfs:comment "Time from which on the offer can be used, e.g. travel."@en ;
    rdfs:domain osdm:AbstractOfferPart ;
    rdfs:range xsd:dateTime ;
    skos:notation "validFrom" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AbstractOfferPart.validUntil> a owl:DatatypeProperty ;
    rdfs:label "validUntil" ;
    rdfs:comment "Time until the offer can be used, e.g. travel."@en ;
    rdfs:domain osdm:AbstractOfferPart ;
    rdfs:range xsd:dateTime ;
    skos:notation "validUntil" .

