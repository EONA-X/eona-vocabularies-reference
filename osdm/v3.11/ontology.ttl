    rdfs:label "conditions" ;
    rdfs:comment "Structured description of the sales or after-sales conditions."@en ;
    rdfs:domain osdm:Fee ;
    rdfs:range osdm:Condition ;
    skos:notation "conditions" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Fee.distributorBookingRef> a owl:DatatypeProperty ;
    rdfs:label "distributorBookingRef" ;
    rdfs:comment "reference to the booking in the downstream distributor system"@en ;
    rdfs:domain osdm:Fee ;
    rdfs:range xsd:string ;
    skos:notation "distributorBookingRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Fee.id> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:domain osdm:Fee ;
    rdfs:range xsd:string ;
    skos:notation "id" .

