    rdfs:label "nonTripSearchCriteria" ;
    rdfs:domain osdm:ExchangeOfferCollectionRequest ;
    rdfs:range osdm:NonTripSearchCriteria ;
    skos:notation "nonTripSearchCriteria" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ExchangeOfferCollectionRequest.offerSearchCriteria> a owl:ObjectProperty ;
    rdfs:label "offerSearchCriteria" ;
    rdfs:domain osdm:ExchangeOfferCollectionRequest ;
    rdfs:range osdm:OfferSearchCriteria ;
    skos:notation "offerSearchCriteria" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ExchangeOfferCollectionRequest.overruleCode> a owl:ObjectProperty ;
    rdfs:label "overruleCode" ;
    rdfs:domain osdm:ExchangeOfferCollectionRequest ;
    rdfs:range osdm:OverruleCode ;
    skos:notation "overruleCode" .

