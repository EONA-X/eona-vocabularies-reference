    rdfs:label "code" ;
    rdfs:comment "code"@en ;
    rdfs:domain osdm:StationNamesDef ;
    rdfs:range xsd:string ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StationNamesDef.country> a owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:comment "uic country code"@en ;
    rdfs:domain osdm:StationNamesDef ;
    rdfs:range xsd:integer ;
    skos:notation "country" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StationNamesDef.legacyBorderPointCode> a owl:DatatypeProperty ;
    rdfs:label "legacyBorderPointCode" ;
    rdfs:domain osdm:StationNamesDef ;
    rdfs:range xsd:integer ;
