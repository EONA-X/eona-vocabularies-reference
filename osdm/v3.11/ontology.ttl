<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Fulfillment.issuer> a owl:DatatypeProperty ;
    rdfs:label "issuer" ;
    rdfs:domain osdm:Fulfillment ;
    rdfs:range osdm:CompanyRef ;
    skos:notation "issuer" .

