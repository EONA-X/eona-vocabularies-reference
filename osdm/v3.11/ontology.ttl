    rdfs:domain osdm:ContinuousServicePickUpPlace ;
    rdfs:range xsd:dateTime ;
    skos:notation "estimatedVehicleArrivalAtPickUp" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContinuousServicePickUpPlace.geoPosition> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "geoPosition" ;
    rdfs:domain osdm:ContinuousServicePickUpPlace ;
