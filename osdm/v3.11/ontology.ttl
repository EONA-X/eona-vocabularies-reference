    rdfs:label "serialId" ;
    rdfs:comment "sequential number of regional validities"@en ;
    rdfs:domain osdm:LegacyAccountingIdentifierDef ;
    rdfs:range xsd:int ;
    skos:notation "serialId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LegacyAccountingIdentifierDef.tariffId> a owl:DatatypeProperty ;
    rdfs:label "tariffId" ;
    rdfs:comment "sequential number of the fares for one regional validity"@en ;
    rdfs:domain osdm:LegacyAccountingIdentifierDef ;
    rdfs:range xsd:int ;
    skos:notation "tariffId" .

