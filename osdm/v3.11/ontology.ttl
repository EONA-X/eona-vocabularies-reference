    rdfs:label "refundable" ;
    rdfs:domain osdm:Fee ;
    rdfs:range osdm:RefundType ;
    skos:notation "refundable" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Fee.status> a owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:domain osdm:Fee ;
    rdfs:range osdm:FeeStatus ;
    skos:notation "status" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Fee.summary> a owl:DatatypeProperty ;
