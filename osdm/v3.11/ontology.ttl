    rdfs:domain osdm:ContinuousServiceOfferPart ;
    rdfs:range osdm:ContinuousServicePickUpPlace ;
    skos:notation "pickUpPlaces" .

osdm:ContinuousServicePickUpPlace a owl:Class ;
