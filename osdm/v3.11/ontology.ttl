osdm:DayTravelAccountUnit a owl:Class ;
    rdfs:label "DayTravelAccountUnit" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/travel-account.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf osdm:AbstractTravelAccountUnit .

osdm:DecisionType a owl:Class, skos:ConceptScheme ;
    rdfs:label "DecisionType" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/complaint.yml> ;
    rdfs:comment "Summary result of decision on a complaint\n\n- `ACCEPTED`: the complaint is accepted and refund or compensation will be paid\n- `REJECTED`: the complaint is rejected and no refund or compensation will be paid\n- `GOOD_WILL`: a good will compensation is offered, no legal obligation\n  to pay refund or compensation exists\n- `PARTIALLY_ACCEPTED`: the complaint is partially accepted, e.g. for\n  part of the journey or part of the passengers"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DecisionType/ACCEPTED> a osdm:DecisionType, skos:Concept ;
    skos:inScheme osdm:DecisionType ;
    skos:notation "ACCEPTED" ;
    skos:prefLabel "ACCEPTED" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DecisionType/GOOD_WILL> a osdm:DecisionType, skos:Concept ;
    skos:inScheme osdm:DecisionType ;
    skos:notation "GOOD_WILL" ;
    skos:prefLabel "GOOD_WILL" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DecisionType/PARTIALLY_ACCEPTED> a osdm:DecisionType, skos:Concept ;
    skos:inScheme osdm:DecisionType ;
    skos:notation "PARTIALLY_ACCEPTED" ;
    skos:prefLabel "PARTIALLY_ACCEPTED" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DecisionType/REJECTED> a osdm:DecisionType, skos:Concept ;
    skos:inScheme osdm:DecisionType ;
    skos:notation "REJECTED" ;
    skos:prefLabel "REJECTED" .

osdm:DeckAvailability a owl:Class ;
    rdfs:label "DeckAvailability" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/place.yml> ;
    rdfs:comment "A coach deck"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DeckAvailability.compartments> a owl:ObjectProperty ;
    rdfs:label "compartments" ;
    rdfs:comment "Only compartments that match a requested place restriction must be returned (e.g. only return bike hook compartments if availabilities for a bicycle reservation offer were requested). Empty if the whole deck contains no compartments (e.g. traction unit) or no places that matches a requested place restriction."@en ;
    rdfs:domain osdm:DeckAvailability ;
    rdfs:range osdm:CompartmentAvailability ;
    skos:notation "compartments" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DeckAvailability.layoutId> a owl:DatatypeProperty ;
    rdfs:label "layoutId" ;
    rdfs:comment "Identifies the coach deck layout. It is recommended to import coach deck layout master data periodically by calling GET /coach-deck-layouts"@en ;
    rdfs:domain osdm:DeckAvailability ;
    rdfs:range xsd:string ;
    skos:notation "layoutId" .

osdm:DirectionChange a owl:Class ;
    rdfs:label "DirectionChange" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/transportable.yml> ;
    rdfs:comment "A StopPlace where the direction of a train changes"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DirectionChange.stopPlaceName> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DirectionChange.stopPlaceRef> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DirectionChange.stopPlaceName> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "stopPlaceName" ;
    rdfs:comment "Name of the station where the direction changes"@en ;
    rdfs:domain osdm:DirectionChange ;
    rdfs:range xsd:string ;
    skos:notation "stopPlaceName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DirectionChange.stopPlaceRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "stopPlaceRef" ;
    rdfs:comment "Reference to the station where the direction changes"@en ;
    rdfs:domain osdm:DirectionChange ;
    rdfs:range osdm:StopPlaceRef ;
    skos:notation "stopPlaceRef" .

osdm:DirectionType a owl:Class, skos:ConceptScheme ;
    rdfs:label "DirectionType" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/transportable.yml> ;
    rdfs:comment "Direction of a place, defined optional as it might be omitted in\ncase of berths in future. \nCode list according to UIC90918-1\nValid Values:\n- RIGHT: to right, RIGHT is the default. In case of walls it indicates a wall parallel with the x axis.\n- LEFT: to left\n- UP: up (from right side of a coach pointing to the middle of the aisle)\n- DOWN: down (from right side of the coach pointing to the middle of the aisle)"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DirectionType/DOWN> a osdm:DirectionType, skos:Concept ;
    skos:inScheme osdm:DirectionType ;
    skos:notation "DOWN" ;
    skos:prefLabel "DOWN" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#DirectionType/LEFT> a osdm:DirectionType, skos:Concept ;
    skos:inScheme osdm:DirectionType ;
    skos:notation "LEFT" ;
    skos:prefLabel "LEFT" .

