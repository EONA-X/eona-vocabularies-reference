osdm:OfferMode a owl:Class, skos:ConceptScheme ;
    rdfs:label "OfferMode" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/offer.yml> ;
    rdfs:comment "Offer mode applied to provide offers for given criteria. \n\nIndividual offer mode means that each passenger is given individual admissions and reservations  to allow to refund individual passengers booked in a single booking.\n\nIf collective mode is not supported,  reverts back to the other mode and provides warning.\n\nIf individual mode is not supported,  reverts back to the other mode and provides warning."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferMode/COLLECTIVE> a osdm:OfferMode, skos:Concept ;
    skos:inScheme osdm:OfferMode ;
    skos:notation "COLLECTIVE" ;
    skos:prefLabel "COLLECTIVE" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferMode/INDIVIDUAL> a osdm:OfferMode, skos:Concept ;
    skos:inScheme osdm:OfferMode ;
    skos:notation "INDIVIDUAL" ;
    skos:prefLabel "INDIVIDUAL" .

