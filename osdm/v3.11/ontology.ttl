osdm:ExchangeOfferCollectionRequest a owl:Class ;
    rdfs:label "ExchangeOfferCollectionRequest" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/aftersales.yml> ;
    rdfs:comment "Defines the parameters needed to request an exchange offer, either based on either an\nexisting trip (that is then passed in) plus a set of offer search\ncriteria, or based on trip-search and offer search criteria. At least one\nof the trip or tripSearchCriteria must be set."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ExchangeOfferCollectionRequest.anonymousPassengerSpecifications> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ExchangeOfferCollectionRequest.fulfillmentIds> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ExchangeOfferCollectionRequest.anonymousPassengerSpecifications> a owl:ObjectProperty ;
    rdfs:label "anonymousPassengerSpecifications" ;
    rdfs:domain osdm:ExchangeOfferCollectionRequest ;
    rdfs:range osdm:AnonymousPassengerSpecification ;
    skos:notation "anonymousPassengerSpecifications" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ExchangeOfferCollectionRequest.corporateCodes> a owl:ObjectProperty ;
    rdfs:label "corporateCodes" ;
    rdfs:domain osdm:ExchangeOfferCollectionRequest ;
    rdfs:range osdm:CorporateCode ;
    skos:notation "corporateCodes" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ExchangeOfferCollectionRequest.embed> a owl:ObjectProperty ;
    rdfs:label "embed" ;
    rdfs:domain osdm:ExchangeOfferCollectionRequest ;
    rdfs:range osdm:OfferCollectionResponseContent ;
    skos:notation "embed" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ExchangeOfferCollectionRequest.exchangeFee> a owl:ObjectProperty ;
    rdfs:label "exchangeFee" ;
    rdfs:comment "In some business models the distributor has the right to define the exchange fee amount for a fare provided by the fare provider. This need to be indicated in the fare after sales rules to be applied. In this case the distributor submits the amount to the fare provider in exchange fee amount and the fare provider uses this amount to create the fees including the VAT split."@en ;
    rdfs:domain osdm:ExchangeOfferCollectionRequest ;
    rdfs:range osdm:CurrencyAmount ;
    skos:notation "exchangeFee" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ExchangeOfferCollectionRequest.fulfillmentIds> a owl:DatatypeProperty ;
    rdfs:label "fulfillmentIds" ;
    rdfs:domain osdm:ExchangeOfferCollectionRequest ;
    rdfs:range xsd:string ;
    skos:notation "fulfillmentIds" .

