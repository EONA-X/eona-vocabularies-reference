<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductRequestOfferSelection.productTag> a owl:DatatypeProperty ;
    rdfs:label "productTag" ;
    rdfs:domain osdm:ProductRequestOfferSelection ;
    rdfs:range xsd:string ;
    skos:notation "productTag" .

