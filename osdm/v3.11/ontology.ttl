osdm:Place a owl:Class ;
    rdfs:label "Place" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/place.yml> ;
    rdfs:comment "A geographic place of any type which may be specified as the origin or destination of a trip. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Place.id> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Place.objectType> ] ;
    skos:scopeNote "Discriminator property: objectType."@en .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Place._links> a owl:ObjectProperty ;
    rdfs:label "_links" ;
    rdfs:domain osdm:Place ;
    rdfs:range osdm:LinksItem ;
    skos:notation "_links" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Place.alternativeIds> a owl:DatatypeProperty ;
    rdfs:label "alternativeIds" ;
    rdfs:comment "For a place with ids in different reference systems, the alternative ids can be returned. \nThe reference system is encoded in the string. E.g.: 'urn:uic:std:80000', 'x_swe:stn:10000', 'ch:1:sloid:343434'"@en ;
    rdfs:domain osdm:Place ;
    rdfs:range xsd:string ;
    skos:notation "alternativeIds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Place.geoPosition> a owl:ObjectProperty ;
    rdfs:label "geoPosition" ;
    rdfs:domain osdm:Place ;
    rdfs:range osdm:GeoPosition ;
    skos:notation "geoPosition" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Place.id> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:comment "id  defining the place. The code is provided as URN, relative URNs are allowed with base path urn:uic:stn '0850000'"@en ;
    rdfs:domain osdm:Place ;
    rdfs:range xsd:string ;
    skos:example "urn:uic:stn:8500000" ;
    skos:notation "id" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Place.modes> a owl:ObjectProperty ;
    rdfs:label "modes" ;
    rdfs:comment "List of Transport modes calling the place.\n\nThis field is added in later OJP 2.0, used here as property for forward compatibility."@en ;
    rdfs:domain osdm:Place ;
    rdfs:range osdm:Mode ;
    skos:notation "modes" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Place.objectType> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "objectType" ;
    rdfs:comment "Attribute is used as discriminator for inheritance between data types."@en ;
    rdfs:domain osdm:Place ;
    rdfs:range xsd:string ;
    skos:notation "objectType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Place.ref> a owl:ObjectProperty ;
    rdfs:label "ref" ;
    rdfs:comment "Reference to another a place, e.g. to link address information. Provided by OJP."@en ;
    rdfs:domain osdm:Place ;
    rdfs:range osdm:PlaceRef ;
    skos:notation "ref" .

osdm:PlaceAllocation a owl:Class ;
