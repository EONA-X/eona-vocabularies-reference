osdm:GeoCoordinate a owl:Class ;
    rdfs:label "GeoCoordinate" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:comment "Used to provide any geo-encoded location, regardless of environment, using longitude and latitude coordinates."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#GeoCoordinate.latitude> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#GeoCoordinate.longitude> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#GeoCoordinate.accuracy> a owl:DatatypeProperty ;
    rdfs:label "accuracy" ;
    rdfs:comment "to be provided in degree."@en ;
    rdfs:domain osdm:GeoCoordinate ;
    rdfs:range xsd:float ;
    skos:notation "accuracy" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#GeoCoordinate.latitude> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "latitude" ;
    rdfs:comment "Geographic coordinate that specifies the north-south position of a point on the earths surface"@en ;
    rdfs:domain osdm:GeoCoordinate ;
    rdfs:range xsd:float ;
    skos:example "46.948825" ;
    skos:notation "latitude" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#GeoCoordinate.longitude> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "longitude" ;
    rdfs:comment "Geographic coordinate that specifies the east-west position of a point on the earths surface."@en ;
    rdfs:domain osdm:GeoCoordinate ;
    rdfs:range xsd:float ;
    skos:example "7.439122" ;
    skos:notation "longitude" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#GeoCoordinate.system> a owl:ObjectProperty ;
    rdfs:label "system" ;
    rdfs:comment "geo coordinate system indication: \n - WGS84 = WGS 84 standard system,\n - GRS80 = (outdated) GRS 80 coordinate system"@en ;
    rdfs:domain osdm:GeoCoordinate ;
    rdfs:range osdm:GeoCoordinateSystem ;
    skos:notation "system" .

osdm:GeoCoordinateSystem a owl:Class, skos:ConceptScheme ;
    rdfs:label "GeoCoordinateSystem" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:comment "geo coordinate system indication: \n - WGS84 = WGS 84 standard system,\n - GRS80 = (outdated) GRS 80 coordinate system"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

