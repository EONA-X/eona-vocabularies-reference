osdm:TripInterruptionConstraint a owl:Class ;
    rdfs:label "TripInterruptionConstraint" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/trip.yml> ;
    rdfs:comment "rules on allowed trip interruptions. Interruptions due to a train change\nindicated by a trip search must not be included here."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionConstraint.maxInterruptions> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionConstraint.requiredProcesses> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionConstraint.maxDuration> a owl:DatatypeProperty ;
    rdfs:label "maxDuration" ;
    rdfs:comment "maximum duration of one interruption"@en ;
    rdfs:domain osdm:TripInterruptionConstraint ;
    rdfs:range xsd:duration ;
    skos:example "PT30M" ;
    skos:notation "maxDuration" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionConstraint.maxInterruptions> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "maxInterruptions" ;
    rdfs:comment "maximum number of allowed interruptions"@en ;
    rdfs:domain osdm:TripInterruptionConstraint ;
    rdfs:range xsd:int ;
    skos:notation "maxInterruptions" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionConstraint.requiredProcesses> a owl:ObjectProperty ;
    rdfs:label "requiredProcesses" ;
    rdfs:comment "one of the listed processes is required for the interruption of the trip"@en ;
    rdfs:domain osdm:TripInterruptionConstraint ;
    rdfs:range osdm:TripInterruptionProcess ;
    skos:notation "requiredProcesses" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripInterruptionConstraint.totalMaxDuration> a owl:DatatypeProperty ;
    rdfs:label "totalMaxDuration" ;
    rdfs:comment "maximum duration of all interruptions on the route"@en ;
    rdfs:domain osdm:TripInterruptionConstraint ;
    rdfs:range xsd:duration ;
    skos:example "PT30M" ;
    skos:notation "totalMaxDuration" .

osdm:TripInterruptionConstraintDef a owl:Class ;
    rdfs:label "TripInterruptionConstraintDef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:comment "rules on allowed trip interruptions. Interruptions due to a train change  indicated by a trip search must not be included here."@en ;
