<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AvailablePlace.accommodationSubType> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "accommodationSubType" ;
    rdfs:domain osdm:AvailablePlace ;
    rdfs:range osdm:AccommodationSubType ;
    skos:notation "accommodationSubType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AvailablePlace.accommodationType> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "accommodationType" ;
    rdfs:domain osdm:AvailablePlace ;
    rdfs:range osdm:AccommodationType ;
    skos:notation "accommodationType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AvailablePlace.numericAvailability> a owl:DatatypeProperty ;
    rdfs:label "numericAvailability" ;
