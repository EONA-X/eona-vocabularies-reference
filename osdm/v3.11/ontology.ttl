osdm:Coach a owl:Class ;
    rdfs:label "Coach" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/place.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Coach.layoutId> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Coach.number> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Coach.compartments> a owl:ObjectProperty ;
    rdfs:label "compartments" ;
    rdfs:domain osdm:Coach ;
    rdfs:range osdm:Compartment ;
    skos:notation "compartments" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Coach.direction> a owl:ObjectProperty ;
    rdfs:label "direction" ;
    rdfs:domain osdm:Coach ;
    rdfs:range osdm:TravelDirectionType ;
    skos:notation "direction" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Coach.layoutId> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "layoutId" ;
    rdfs:comment "Id to identify the coach layout. In case of two deck vehicles, \nboth upper and lower deck layouts are provided next to each other."@en ;
    rdfs:domain osdm:Coach ;
    rdfs:range xsd:string ;
    skos:notation "layoutId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Coach.layoutIdLowerDeck> a owl:DatatypeProperty ;
    rdfs:label "layoutIdLowerDeck" ;
    rdfs:comment "id to identify a layout for the lower deck in a double deck coach"@en ;
    rdfs:domain osdm:Coach ;
    rdfs:range xsd:string ;
    skos:notation "layoutIdLowerDeck" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Coach.layoutIdUpperDeck> a owl:DatatypeProperty ;
    rdfs:label "layoutIdUpperDeck" ;
    rdfs:comment "id to identify a layout for the upper deck in a double deck coach"@en ;
    rdfs:domain osdm:Coach ;
    rdfs:range xsd:string ;
    skos:notation "layoutIdUpperDeck" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Coach.number> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "number" ;
    rdfs:comment "coach number"@en ;
    rdfs:domain osdm:Coach ;
    rdfs:range xsd:string ;
    skos:notation "number" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Coach.owner> a owl:DatatypeProperty ;
    rdfs:label "owner" ;
    rdfs:domain osdm:Coach ;
    rdfs:range osdm:CompanyRef ;
    skos:notation "owner" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Coach.reservationRefs> a owl:DatatypeProperty ;
    rdfs:label "reservationRefs" ;
    rdfs:comment "references to the reservations/fares for which all places in the coach can be selected. The reservation ids must be part of the list of reservation ids for which the consumer has requested the available places and the consumer must accept a list by setting singleSelectionMapsRequired to false"@en ;
    rdfs:domain osdm:Coach ;
    rdfs:range xsd:string ;
    skos:notation "reservationRefs" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Coach.specialCoach> a owl:ObjectProperty ;
    rdfs:label "specialCoach" ;
    rdfs:domain osdm:Coach ;
    rdfs:range osdm:SpecialCoachType ;
    skos:notation "specialCoach" .

osdm:CoachAvailability a owl:Class ;
    rdfs:label "CoachAvailability" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/place.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachAvailability.number> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachAvailability.travelDirection> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachAvailability.decks> a owl:ObjectProperty ;
    rdfs:label "decks" ;
    rdfs:comment "The decks of a coach ordered in ascending order from the lowest to the highest deck. Optional as for some coaches (especially special/not reservable coach types) no coach layout might exist."@en ;
    rdfs:domain osdm:CoachAvailability ;
    rdfs:range osdm:DeckAvailability ;
    skos:notation "decks" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachAvailability.noPassageToNextCoach> a owl:DatatypeProperty ;
    rdfs:label "noPassageToNextCoach" ;
    rdfs:comment "Indicates that there is no passage to the next coach."@en ;
    rdfs:domain osdm:CoachAvailability ;
    rdfs:range xsd:boolean ;
    skos:notation "noPassageToNextCoach" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachAvailability.number> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "number" ;
    rdfs:comment "Coach number"@en ;
    rdfs:domain osdm:CoachAvailability ;
    rdfs:range xsd:string ;
    skos:notation "number" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachAvailability.travelDirection> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "travelDirection" ;
    rdfs:domain osdm:CoachAvailability ;
    rdfs:range osdm:TravelDirectionType ;
    skos:notation "travelDirection" .

