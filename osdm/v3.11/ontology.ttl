    rdfs:range osdm:ContinuousService ;
    skos:notation "service" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContinuousLeg.situationFullRefs> a owl:DatatypeProperty ;
    rdfs:label "situationFullRefs" ;
    rdfs:domain osdm:ContinuousLeg ;
