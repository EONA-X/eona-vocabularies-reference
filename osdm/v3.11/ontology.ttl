    rdfs:label "notVias" ;
    rdfs:domain osdm:TripSearchCriteria ;
    rdfs:range osdm:NotVia ;
    skos:notation "notVias" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripSearchCriteria.origin> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "origin" ;
    rdfs:domain osdm:TripSearchCriteria ;
    rdfs:range osdm:PlaceRef ;
    skos:notation "origin" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripSearchCriteria.parameters> a owl:ObjectProperty ;
    rdfs:label "parameters" ;
    rdfs:domain osdm:TripSearchCriteria ;
    rdfs:range osdm:TripParameters ;
