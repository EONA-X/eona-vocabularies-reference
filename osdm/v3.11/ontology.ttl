    rdfs:label "availableVehicles" ;
    rdfs:domain osdm:ContinuousServicePickUpPlace ;
    rdfs:range osdm:ContinuousServiceVehicleAvailability ;
    skos:notation "availableVehicles" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContinuousServicePickUpPlace.description> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "description" ;
    rdfs:comment "description of the pick-up place"@en ;
    rdfs:domain osdm:ContinuousServicePickUpPlace ;
    rdfs:range xsd:string ;
