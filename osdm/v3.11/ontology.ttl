osdm:FulfillmentActivationPatchRequest a owl:Class ;
    rdfs:label "FulfillmentActivationPatchRequest" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/fulfillment.yml> ;
    rdfs:comment "Changes the fulfillment to status AVAILABLE. In the case of multi-journey  product, one of the fulfillment is\nnow 'activated' and can be used to travel. Selects on-demand vehicles. Selects pick-up place and vehicle type for continuous services."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentActivationPatchRequest.startOfUsage> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentActivationPatchRequest.continuousServiceVehicleSelection> a owl:ObjectProperty ;
    rdfs:label "continuousServiceVehicleSelection" ;
    rdfs:comment "selection of a pick-up place and vehicle type for continuous services."@en ;
    rdfs:domain osdm:FulfillmentActivationPatchRequest ;
    rdfs:range osdm:ContinuousServiceVehicleSelection ;
    skos:notation "continuousServiceVehicleSelection" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentActivationPatchRequest.fromPlace> a owl:ObjectProperty ;
    rdfs:label "fromPlace" ;
    rdfs:domain osdm:FulfillmentActivationPatchRequest ;
    rdfs:range osdm:PlaceRef ;
    skos:notation "fromPlace" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentActivationPatchRequest.selectedZoneIds> a owl:DatatypeProperty ;
    rdfs:label "selectedZoneIds" ;
    rdfs:domain osdm:FulfillmentActivationPatchRequest ;
    rdfs:range xsd:string ;
    skos:notation "selectedZoneIds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentActivationPatchRequest.startOfUsage> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "startOfUsage" ;
    rdfs:domain osdm:FulfillmentActivationPatchRequest ;
    rdfs:range xsd:dateTime ;
    skos:notation "startOfUsage" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentActivationPatchRequest.stockControlNumbers> a owl:DatatypeProperty ;
    rdfs:label "stockControlNumbers" ;
    rdfs:comment "The ids of the secure paper stock that identifies the blank secure paper stock used for printing.\n\nThe stock control number is only used for secure paper stock and triggers a printing of the stock control number in the ticket layout. This establishes a link between paper stock and ticket that is used to control the usage of blank secure paper stock at offices as secure paper has otherwise no intrinsic protection against internal fraud."@en ;
    rdfs:domain osdm:FulfillmentActivationPatchRequest ;
    rdfs:range xsd:string ;
    skos:notation "stockControlNumbers" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentActivationPatchRequest.travelDates> a owl:DatatypeProperty ;
    rdfs:label "travelDates" ;
    rdfs:domain osdm:FulfillmentActivationPatchRequest ;
    rdfs:range xsd:date ;
    skos:notation "travelDates" .

