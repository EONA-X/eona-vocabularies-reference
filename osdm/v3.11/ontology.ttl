<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOffer.validFrom> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "validFrom" ;
    rdfs:domain osdm:RefundOffer ;
    rdfs:range xsd:dateTime ;
    skos:notation "validFrom" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOffer.validUntil> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "validUntil" ;
    rdfs:comment "time until the offer can be used"@en ;
    rdfs:domain osdm:RefundOffer ;
    rdfs:range xsd:dateTime ;
    skos:notation "validUntil" .

osdm:RefundOfferBreakdownItem a owl:Class ;
    rdfs:label "RefundOfferBreakdownItem" ;
