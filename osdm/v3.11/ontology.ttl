osdm:RemarkType a owl:Class, skos:ConceptScheme ;
    rdfs:label "RemarkType" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Remark concerning the place (e.g. to be used in a tool tip).\nCode list according to UIC90918-1\nKnown Values:\n- MIGHT_HAVE_TABLE: place might have a table\n- MIGHT_NOT_HAVE_TABLE: table at the place might be missing\n- MIGHT_HAVE_DIFFERENT_DIRECTION: place might have a different direction\n- MIGHT_HAVE_TABLE_AND_DIFFERENT_DIRECTION: place might have a table and a different direction\n- MIGHT_NOT_HAVE_TABLE_AND_MIGHT_HAVE_DIFFERENT_DIRECTION: table at the place might be missing and place might have a different direction\n- MIGHT_BE_IN_COMPARTMENT: place might be in compartment\n- MIGHT_BE_IN_OPEN_SPACE: place might be in open space"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RemarkType/MIGHT_BE_IN_COMPARTMENT> a osdm:RemarkType, skos:Concept ;
    skos:inScheme osdm:RemarkType ;
    skos:notation "MIGHT_BE_IN_COMPARTMENT" ;
    skos:prefLabel "MIGHT_BE_IN_COMPARTMENT" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RemarkType/MIGHT_BE_IN_OPEN_SPACE> a osdm:RemarkType, skos:Concept ;
    skos:inScheme osdm:RemarkType ;
    skos:notation "MIGHT_BE_IN_OPEN_SPACE" ;
    skos:prefLabel "MIGHT_BE_IN_OPEN_SPACE" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RemarkType/MIGHT_HAVE_DIFFERENT_DIRECTION> a osdm:RemarkType, skos:Concept ;
    skos:inScheme osdm:RemarkType ;
    skos:notation "MIGHT_HAVE_DIFFERENT_DIRECTION" ;
    skos:prefLabel "MIGHT_HAVE_DIFFERENT_DIRECTION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RemarkType/MIGHT_HAVE_TABLE> a osdm:RemarkType, skos:Concept ;
    skos:inScheme osdm:RemarkType ;
    skos:notation "MIGHT_HAVE_TABLE" ;
    skos:prefLabel "MIGHT_HAVE_TABLE" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RemarkType/MIGHT_HAVE_TABLE_AND_DIFFERENT_DIRECTION> a osdm:RemarkType, skos:Concept ;
    skos:inScheme osdm:RemarkType ;
    skos:notation "MIGHT_HAVE_TABLE_AND_DIFFERENT_DIRECTION" ;
    skos:prefLabel "MIGHT_HAVE_TABLE_AND_DIFFERENT_DIRECTION" .

