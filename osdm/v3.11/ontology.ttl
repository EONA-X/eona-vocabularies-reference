    rdfs:range xsd:dateTime ;
    skos:notation "endTime" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripSummary.externalRef> a owl:DatatypeProperty ;
    rdfs:label "externalRef" ;
