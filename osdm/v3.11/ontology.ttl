<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareCombinationModelDef.referenceCluster> a owl:DatatypeProperty ;
    rdfs:label "referenceCluster" ;
    rdfs:comment "In case of CLUSTERING model: the cluster to which the fare belongs"@en ;
    rdfs:domain osdm:FareCombinationModelDef ;
    rdfs:range xsd:string ;
    skos:notation "referenceCluster" .

osdm:FareConnectionPoint a owl:Class ;
    rdfs:label "FareConnectionPoint" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/fare.yml> ;
    rdfs:comment "Connection point connecting two fare regimes. The connection is possible between stations of the two provided station sets.\nA legacy border point code (id) might be provided as an additional code within the stations (code list BORDER_POINT provided in URN).\nIn case the connection point is a real station this station is indicated.\nIn case the connection point is between stations for each side of the border real stations must be provided.\nMultiple sets of station can be provided in the rare case that the connection point connects more than two station (A-B and A-C).\nMultiple stations within a set at one side of the border might be provided in case of changes (new stations build near the border).\n\nProviding the UIC code for the station is mandatory."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareConnectionPoint.stationSets> ], osdm:Place .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareConnectionPoint.name> a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain osdm:FareConnectionPoint ;
    rdfs:range xsd:string ;
    skos:notation "name" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareConnectionPoint.nameTranslations> a owl:ObjectProperty ;
    rdfs:label "nameTranslations" ;
    rdfs:comment "Translations for the name"@en ;
    rdfs:domain osdm:FareConnectionPoint ;
    rdfs:range osdm:Translation ;
    skos:notation "nameTranslations" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareConnectionPoint.stationSets> a owl:ObjectProperty ;
    rdfs:label "stationSets" ;
    rdfs:domain osdm:FareConnectionPoint ;
    rdfs:range osdm:StationSet ;
    skos:notation "stationSets" .

osdm:FareConnectionPointRef a owl:Class ;
    rdfs:label "FareConnectionPointRef" ;
