osdm:FulfillmentOption a owl:Class ;
    rdfs:label "FulfillmentOption" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/fulfillment.yml> ;
    rdfs:comment "CIT paper implies printing on value paper which is stock controlled."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentOption.media> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentOption.type> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentOption.applications> a owl:DatatypeProperty ;
    rdfs:label "applications" ;
    rdfs:comment "list of applications that can handle the fulfillment. This is required in case of media `APPLICATION`. minItems >= 1 is applicable on business logic level exclusively for this media type.\n\nThe applications might be modules on a vending machine to handle chop cards or smartphone apps handling NFC communication."@en ;
    rdfs:domain osdm:FulfillmentOption ;
    rdfs:range xsd:string ;
    skos:notation "applications" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentOption.media> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "media" ;
    rdfs:domain osdm:FulfillmentOption ;
    rdfs:range osdm:FulfillmentMediaType ;
    skos:notation "media" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentOption.specification> a owl:DatatypeProperty ;
    rdfs:label "specification" ;
    rdfs:comment "accepted fulfillment specifications in case the fulfillment via `APPLICATION` or `CHIP_CARD` is not not limited to a specific application."@en ;
    rdfs:domain osdm:FulfillmentOption ;
    rdfs:range xsd:string ;
    skos:notation "specification" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentOption.type> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "type" ;
    rdfs:domain osdm:FulfillmentOption ;
    rdfs:range osdm:FulfillmentType ;
    skos:notation "type" .

osdm:FulfillmentPart a owl:Class ;
    rdfs:label "FulfillmentPart" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/fulfillment.yml> ;
    rdfs:comment "Fulfillment items to be integrated in to tickets,\ne.g. visual security elements, additional bar codes, control keys."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPart.controlId> a owl:DatatypeProperty ;
    rdfs:label "controlId" ;
    rdfs:domain osdm:FulfillmentPart ;
    rdfs:range xsd:string ;
    skos:notation "controlId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPart.fulfillmentInformationTexts> a owl:ObjectProperty ;
    rdfs:label "fulfillmentInformationTexts" ;
    rdfs:domain osdm:FulfillmentPart ;
    rdfs:range osdm:TextElement ;
    skos:notation "fulfillmentInformationTexts" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPart.fulfillmentMedia> a owl:ObjectProperty ;
    rdfs:label "fulfillmentMedia" ;
    rdfs:comment "list of fulfillment media where this item applies"@en ;
    rdfs:domain osdm:FulfillmentPart ;
    rdfs:range osdm:FulfillmentMediaType ;
    skos:notation "fulfillmentMedia" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPart.isMandatory> a owl:DatatypeProperty ;
    rdfs:label "isMandatory" ;
    rdfs:comment "The use of the provided features is mandatory."@en ;
    rdfs:domain osdm:FulfillmentPart ;
    rdfs:range xsd:boolean ;
    skos:notation "isMandatory" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPart.passengerRef> a owl:DatatypeProperty ;
    rdfs:label "passengerRef" ;
    rdfs:comment "reference to a passenger"@en ;
    rdfs:domain osdm:FulfillmentPart ;
    rdfs:range xsd:string ;
    skos:notation "passengerRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPart.securePaperOnly> a owl:DatatypeProperty ;
    rdfs:label "securePaperOnly" ;
    rdfs:comment "The security feature must be used on secure paper."@en ;
    rdfs:domain osdm:FulfillmentPart ;
    rdfs:range xsd:boolean ;
    skos:notation "securePaperOnly" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPart.securityFeatureLinks> a owl:ObjectProperty ;
    rdfs:label "securityFeatureLinks" ;
    rdfs:domain osdm:FulfillmentPart ;
    rdfs:range osdm:FulfillmentItemSecurityFeatureLinks ;
    skos:notation "securityFeatureLinks" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPart.securityFeatures> a owl:ObjectProperty ;
    rdfs:label "securityFeatures" ;
    rdfs:comment "'visual elements, bar codes'"@en ;
    rdfs:domain osdm:FulfillmentPart ;
    rdfs:range osdm:FulfillmentItemSecurityFeature ;
    skos:notation "securityFeatures" .

osdm:FulfillmentPatchRequest a owl:Class ;
    rdfs:label "FulfillmentPatchRequest" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/fulfillment.yml> ;
    rdfs:comment "Changes the fulfillment to status FULFILLED."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPatchRequest.fulfillmentUpdates> a owl:DatatypeProperty ;
    rdfs:label "fulfillmentUpdates" ;
    rdfs:domain osdm:FulfillmentPatchRequest ;
    rdfs:range osdm:FulfillmentId ;
    skos:notation "fulfillmentUpdates" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPatchRequest.issuingLanguage> a owl:DatatypeProperty ;
    rdfs:label "issuingLanguage" ;
    rdfs:comment "The desired issuing language (ISO-639-1 language code) for the document(s) produced by this call.\nSame semantics as FulfillmentPostRequest.issuingLanguage, for providers that produce the document\nat finalization time."@en ;
    rdfs:domain osdm:FulfillmentPatchRequest ;
    rdfs:range xsd:string ;
    skos:notation "issuingLanguage" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPatchRequest.preferredFulfillmentMedia> a owl:ObjectProperty ;
    rdfs:label "preferredFulfillmentMedia" ;
    rdfs:comment "Preferred media type for the document(s) produced by this call. It applies to this call only and\ndoes not persist any booking state."@en ;
    rdfs:domain osdm:FulfillmentPatchRequest ;
    rdfs:range osdm:FulfillmentMediaType ;
    skos:notation "preferredFulfillmentMedia" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPatchRequest.requestedFulfillmentType> a owl:ObjectProperty ;
    rdfs:label "requestedFulfillmentType" ;
    rdfs:comment "The requested fulfillment type (e.g. paper or e-ticket) for the document(s) produced by this call.\nIt applies to this call only and does not persist any booking state."@en ;
    rdfs:domain osdm:FulfillmentPatchRequest ;
    rdfs:range osdm:FulfillmentType ;
    skos:notation "requestedFulfillmentType" .

osdm:FulfillmentPostRequest a owl:Class ;
    rdfs:label "FulfillmentPostRequest" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/fulfillment.yml> ;
    rdfs:comment "Creates the fulfillment in the requested language"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPostRequest.issuingLanguage> a owl:DatatypeProperty ;
    rdfs:label "issuingLanguage" ;
    rdfs:comment "the desired issuing language (ISO-639-1 language code). If not provided or not available, will default to (one of) the language(s) of the issuing country"@en ;
    rdfs:domain osdm:FulfillmentPostRequest ;
    rdfs:range xsd:string ;
    skos:notation "issuingLanguage" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPostRequest.preferredFulfillmentMedia> a owl:ObjectProperty ;
    rdfs:label "preferredFulfillmentMedia" ;
    rdfs:comment "Preferred media type for the document(s) produced by this call. It applies to this call only and\ndoes not persist any booking state."@en ;
    rdfs:domain osdm:FulfillmentPostRequest ;
    rdfs:range osdm:FulfillmentMediaType ;
    skos:notation "preferredFulfillmentMedia" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentPostRequest.requestedFulfillmentType> a owl:ObjectProperty ;
    rdfs:label "requestedFulfillmentType" ;
    rdfs:comment "The requested fulfillment type (e.g. paper or e-ticket) for the document(s) produced by this call.\nIt applies to this call only and does not persist any booking state."@en ;
    rdfs:domain osdm:FulfillmentPostRequest ;
    rdfs:range osdm:FulfillmentType ;
    skos:notation "requestedFulfillmentType" .

osdm:FulfillmentResponse a owl:Class ;
