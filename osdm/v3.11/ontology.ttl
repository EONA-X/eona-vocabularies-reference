    rdfs:comment "Describes the the situation at a stop or station at which the passenger boards a Leg\nof a trip including time-related information. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Board.serviceDeparture> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Board.stopPlaceName> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Board.stopPlaceRef> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Board.estimatedStopPointName> a owl:DatatypeProperty ;
    rdfs:label "estimatedStopPointName" ;
    rdfs:comment "Name of the bay/quay/terminal where to board the vehicle. As to the latest realtime status."@en ;
    rdfs:domain osdm:Board ;
    rdfs:range xsd:string ;
    skos:example "8" ;
    skos:notation "estimatedStopPointName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Board.plannedStopPointName> a owl:DatatypeProperty ;
    rdfs:label "plannedStopPointName" ;
    rdfs:comment "Name of the bay/quay/terminal where to board/alight from the vehicle. According to\nplanned timetable."@en ;
    rdfs:domain osdm:Board ;
    rdfs:range xsd:string ;
    skos:example "3" ;
    skos:notation "plannedStopPointName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Board.serviceDeparture> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "serviceDeparture" ;
    rdfs:domain osdm:Board ;
    rdfs:range osdm:ServiceTime ;
    skos:notation "serviceDeparture" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Board.status> a owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:domain osdm:Board ;
    rdfs:range osdm:StopCallStatus ;
    skos:notation "status" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Board.stopPlaceName> a owl:DatatypeProperty, owl:FunctionalProperty ;
