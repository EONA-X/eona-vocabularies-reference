<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Fulfillment.continuousServiceUsage> a owl:ObjectProperty ;
    rdfs:label "continuousServiceUsage" ;
    rdfs:domain osdm:Fulfillment ;
    rdfs:range osdm:ContinuousServiceUsage ;
    skos:notation "continuousServiceUsage" .

