    skos:notation "VOUCHER" ;
    skos:prefLabel "VOUCHER" .

osdm:PersonDetail a owl:Class ;
    rdfs:label "PersonDetail" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/person.yml> ;
    rdfs:comment "Personal information potentially needed at booking step. To support privacy by design,\nit is not permitted to send personal information not required to create a valid booking.\nNote that address is deprecated in favor of `postalAddress`, and email and phoneNumber \nare deprecated in favor of the attributes in `ContactDetail`"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.firstName> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.lastName> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.address> a owl:ObjectProperty ;
    rdfs:label "address" ;
    rdfs:comment "Deprecated in favor of `postalAddress`"@en ;
    rdfs:domain osdm:PersonDetail ;
    rdfs:range osdm:Address ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "address" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.contact> a owl:ObjectProperty ;
    rdfs:label "contact" ;
    rdfs:domain osdm:PersonDetail ;
    rdfs:range osdm:ContactDetail ;
    skos:notation "contact" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.email> a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:domain osdm:PersonDetail ;
    rdfs:range xsd:string ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "email" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.firstFamilyName> a owl:DatatypeProperty ;
    rdfs:label "firstFamilyName" ;
    rdfs:comment "first family name in case of multiple family names. The element lastName includes all family names."@en ;
    rdfs:domain osdm:PersonDetail ;
    rdfs:range xsd:string ;
    skos:example "Diaz" ;
    skos:notation "firstFamilyName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.firstName> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "firstName" ;
    rdfs:domain osdm:PersonDetail ;
    rdfs:range xsd:string ;
    skos:notation "firstName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.lastName> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "lastName" ;
    rdfs:comment "full last names of the person"@en ;
    rdfs:domain osdm:PersonDetail ;
    rdfs:range xsd:string ;
    skos:example "Diaz Lopez" ;
    skos:notation "lastName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.phoneNumber> a owl:DatatypeProperty ;
    rdfs:label "phoneNumber" ;
    rdfs:comment "Preferably a mobile phone number, to be contacted in case changes to the booking occur, e.g.,\nin case of interruptions.\nFormat according to E.164 The international public telecommunication numbering plan"@en ;
    rdfs:domain osdm:PersonDetail ;
    rdfs:range xsd:string ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "phoneNumber" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.postalAddress> a owl:ObjectProperty ;
    rdfs:label "postalAddress" ;
    rdfs:comment "Address of the physical person for issuing an invoice or receipt"@en ;
    rdfs:domain osdm:PersonDetail ;
    rdfs:range osdm:PostalAddress ;
    skos:notation "postalAddress" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.preferredLanguage> a owl:DatatypeProperty ;
    rdfs:label "preferredLanguage" ;
    rdfs:comment "ISO-639-1 language code"@en ;
    rdfs:domain osdm:PersonDetail ;
    rdfs:range xsd:string ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "preferredLanguage" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.secondFamilyName> a owl:DatatypeProperty ;
    rdfs:label "secondFamilyName" ;
    rdfs:comment "second family name in case of multiple family names. The element lastName includes all family names."@en ;
    rdfs:domain osdm:PersonDetail ;
    rdfs:range xsd:string ;
    skos:example "Lopez" ;
    skos:notation "secondFamilyName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.summary> a owl:DatatypeProperty ;
    rdfs:label "summary" ;
    rdfs:comment "A human-readable description of the person."@en ;
    rdfs:domain osdm:PersonDetail ;
    rdfs:range xsd:string ;
    skos:notation "summary" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonDetail.taxId> a owl:DatatypeProperty ;
    rdfs:label "taxId" ;
    rdfs:comment "Tax identification of the physical person for issuing an invoice or receipt"@en ;
    rdfs:domain osdm:PersonDetail ;
    rdfs:range xsd:string ;
    skos:example "CZ1234567890" ;
    skos:notation "taxId" .

osdm:PersonalDataConstraintDef a owl:Class ;
    rdfs:label "PersonalDataConstraintDef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PersonalDataConstraintDef.allowedChanges> a owl:ObjectProperty ;
    rdfs:label "allowedChanges" ;
