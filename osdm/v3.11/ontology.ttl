    rdfs:label "number" ;
    rdfs:comment "Number identifying the travel account, need issuer to be unique."@en ;
    rdfs:domain osdm:CardReference ;
    rdfs:range xsd:string ;
    skos:notation "number" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CardReference.type> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "type" ;
    rdfs:domain osdm:CardReference ;
