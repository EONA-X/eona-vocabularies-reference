osdm:PassengerCategory a owl:Class ;
    rdfs:label "PassengerCategory" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/person.yml> ;
    rdfs:comment "Passenger Category predefines a set of passenger specification properties that result to offer of a specific passenger type. \n`title` is the localized name of the passenger category and `specification` describes exact passenger specification that may results into offer for selected passenger category. Passenger category specification doesn't guarantee availability of expected passenger type on offered trip. `appliedPassengerType` must always be checked in the offer response."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerCategory.specification> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerCategory.title> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerCategory.additional> a owl:DatatypeProperty ;
    rdfs:label "additional" ;
    rdfs:comment "Indicate whether this passenger category should be always visible in UI or folded into \"additional\" section."@en ;
    rdfs:domain osdm:PassengerCategory ;
    rdfs:range xsd:boolean ;
    skos:notation "additional" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerCategory.base> a owl:DatatypeProperty ;
    rdfs:label "base" ;
    rdfs:comment "Indicate whether this passenger category should be preselected \nas a default option in the passenger selection. Usually results \nto a \"full fare\" or \"adult fare\" offers."@en ;
    rdfs:domain osdm:PassengerCategory ;
    rdfs:range xsd:boolean ;
    skos:notation "base" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerCategory.specification> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "specification" ;
    rdfs:comment "Exact passenger specification to be used in order to request an offer for given passenger category."@en ;
    rdfs:domain osdm:PassengerCategory ;
    rdfs:range osdm:AnonymousPassengerSpecification ;
    skos:notation "specification" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerCategory.title> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "title" ;
    rdfs:comment "Default and localized name of the passenger category."@en ;
    rdfs:domain osdm:PassengerCategory ;
    rdfs:range osdm:Text ;
    skos:notation "title" .

