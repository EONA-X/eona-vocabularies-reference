osdm:Line a owl:Class ;
    rdfs:label "Line" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "terminalStation - in case the product requires a destination within the zone (e.g. local ticket\nto go to the main rail station).\nentryStation - Station to enter the zone in case the product requires to enter the zone via a\nspecific station (e.g. local zone ticket to start from the main rail station)."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Line.carrier> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Line.binaryLineId> a owl:DatatypeProperty ;
    rdfs:label "binaryLineId" ;
    rdfs:comment "Id to support local traffic standards (e.g. VDV,...)."@en ;
    rdfs:domain osdm:Line ;
    rdfs:range xsd:base64Binary ;
    skos:notation "binaryLineId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Line.carrier> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "carrier" ;
    rdfs:domain osdm:Line ;
    rdfs:range osdm:CompanyRef ;
    skos:notation "carrier" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Line.city> a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:domain osdm:Line ;
    rdfs:range xsd:int ;
    skos:notation "city" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Line.entryStation> a owl:ObjectProperty ;
    rdfs:label "entryStation" ;
    rdfs:domain osdm:Line ;
    rdfs:range osdm:StopPlace ;
    skos:notation "entryStation" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Line.lineIds> a owl:DatatypeProperty ;
    rdfs:label "lineIds" ;
    rdfs:domain osdm:Line ;
    rdfs:range xsd:string ;
    skos:notation "lineIds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Line.nutsCode> a owl:DatatypeProperty ;
    rdfs:label "nutsCode" ;
    rdfs:comment "Nomenclature des units territoriales statistiques\n COMMISSION REGULATION (EU) No 31/2011"@en ;
    rdfs:domain osdm:Line ;
    rdfs:range xsd:string ;
    skos:notation "nutsCode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Line.terminalStation> a owl:ObjectProperty ;
    rdfs:label "terminalStation" ;
    rdfs:domain osdm:Line ;
    rdfs:range osdm:StopPlace ;
    skos:notation "terminalStation" .

