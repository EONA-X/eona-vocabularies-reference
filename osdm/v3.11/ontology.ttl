osdm:Address a owl:Class ;
    rdfs:label "Address" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/_common.yml> ;
    rdfs:comment "A descriptive data associated with a place that can be used to describe the unique geographical context of a\nplace for the purposes of identifying it. may be refined as either a road address, a postal address or both.\nProvided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf osdm:Place .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Address.city> a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:comment "City name"@en ;
    rdfs:domain osdm:Address ;
    rdfs:range xsd:string ;
    skos:example "Leidschendam" ;
    skos:notation "city" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Address.code> a owl:DatatypeProperty ;
    rdfs:label "code" ;
    rdfs:comment "id of the address"@en ;
    rdfs:domain osdm:Address ;
    rdfs:range xsd:string ;
    skos:example "NL:1916200000022621" ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Address.countryCode> a owl:DatatypeProperty ;
    rdfs:label "countryCode" ;
    rdfs:domain osdm:Address ;
    rdfs:range osdm:CountryCode ;
    skos:notation "countryCode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Address.countryName> a owl:DatatypeProperty ;
    rdfs:label "countryName" ;
    rdfs:comment "Country of the address."@en ;
    rdfs:domain osdm:Address ;
    rdfs:range xsd:string ;
    skos:example "The Netherlands" ;
    skos:notation "countryName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Address.houseNumber> a owl:DatatypeProperty ;
    rdfs:label "houseNumber" ;
    rdfs:comment "House number of the address. House number can either be in this separate field, or can be\ncontained in the street field."@en ;
    rdfs:domain osdm:Address ;
    rdfs:range xsd:string ;
    skos:example "7" ;
    skos:notation "houseNumber" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Address.name> a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "Name or description of address for use in passenger information."@en ;
    rdfs:domain osdm:Address ;
    rdfs:range xsd:string ;
    skos:example "Oude Trambaan 7, 2265CA Leidschendam, Nederland" ;
    skos:notation "name" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Address.nameTranslations> a owl:ObjectProperty ;
    rdfs:label "nameTranslations" ;
    rdfs:comment "Translations for the name"@en ;
    rdfs:domain osdm:Address ;
    rdfs:range osdm:Translation ;
    skos:notation "nameTranslations" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Address.postCode> a owl:DatatypeProperty ;
    rdfs:label "postCode" ;
    rdfs:comment "Postal code of the address."@en ;
    rdfs:domain osdm:Address ;
    rdfs:range xsd:string ;
    skos:example "2265CA" ;
    skos:notation "postCode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Address.street> a owl:DatatypeProperty ;
    rdfs:label "street" ;
    rdfs:comment "Street name of the address. Can also contain the house number."@en ;
    rdfs:domain osdm:Address ;
    rdfs:range xsd:string ;
    skos:example "Oude Trambaan" ;
    skos:notation "street" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Address.topographicPlaceName> a owl:DatatypeProperty ;
    rdfs:label "topographicPlaceName" ;
    rdfs:comment "TopographicPlace name of the address. If set it should at least contain the city name."@en ;
    rdfs:domain osdm:Address ;
    rdfs:range xsd:string ;
    skos:example "Leidschendam" ;
    skos:notation "topographicPlaceName" .

osdm:AddressRef a owl:Class ;
    rdfs:label "AddressRef" ;
