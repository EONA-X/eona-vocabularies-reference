<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareCombinationModelDef.combinableCarrier> a owl:DatatypeProperty ;
    rdfs:label "combinableCarrier" ;
    rdfs:comment "List of all carriers where the model can be applied, in case the list is empty all combinations are allowed."@en ;
    rdfs:domain osdm:FareCombinationModelDef ;
    rdfs:range osdm:CompanyDef ;
    skos:notation "combinableCarrier" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareCombinationModelDef.model> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "model" ;
    rdfs:comment "Possible models are SEPARATE_CONTRACT, CLUSTERING, COMBINING.  The models need to be supported by the allocator."@en ;
