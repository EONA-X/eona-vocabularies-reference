osdm:LineNumber a rdfs:Datatype ;
    rdfs:label "LineNumber" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Especially on regional traffic, a vehicle is defined by a line number.\nE.g. the line numbers of 'S 52' or 'B 19'."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:string ] ;
    skos:example "52, 19" .

osdm:LinksItem a owl:Class ;
    rdfs:label "LinksItem" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "The underlying system may provide links for pagination of links pointing on\nfurther information (such as HTML download links, web sites or extended APIs).\nMechanism to add flexible extensions specific to an underlying system. Implemented\nthe JSON-HAL specification."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LinksItem.href> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LinksItem.rel> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LinksItem.href> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "href" ;
    rdfs:comment "Allows to provide a value to the link, for example id of the targeted \nresource or displayable representation for the link."@en ;
    rdfs:domain osdm:LinksItem ;
    rdfs:range xsd:anyURI ;
    skos:notation "href" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LinksItem.rel> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "rel" ;
    rdfs:comment "the 'rel' field in HATEOAS navigation."@en ;
    rdfs:domain osdm:LinksItem ;
    rdfs:range xsd:string ;
    skos:example "self" ;
    skos:notation "rel" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LinksItem.type> a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:comment "Hint to indicate the media type expected when dereferencing the target resource."@en ;
