osdm:RefundOfferPatchRequest a owl:Class ;
    rdfs:label "RefundOfferPatchRequest" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/aftersales.yml> ;
    rdfs:comment "Changes the refund offer to status CONFIRMED. De-confirmation by setting PROPOSED status is not supported by API."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOfferPatchRequest.status> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOfferPatchRequest.status> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:domain osdm:RefundOfferPatchRequest ;
    rdfs:range osdm:RefundStatus ;
    skos:notation "status" .

osdm:RefundOfferRequest a owl:Class ;
    rdfs:label "RefundOfferRequest" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/aftersales.yml> ;
    rdfs:comment "Request for a refund offer.\nFulfillments can be provided in case the booking contains multiple individual fulfillments."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOfferRequest.fulfillmentIds> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOfferRequest.fulfillmentIds> a owl:DatatypeProperty ;
    rdfs:label "fulfillmentIds" ;
    rdfs:comment "ids of the fulfillments to refund"@en ;
    rdfs:domain osdm:RefundOfferRequest ;
    rdfs:range xsd:string ;
    skos:notation "fulfillmentIds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOfferRequest.overruleCode> a owl:ObjectProperty ;
    rdfs:label "overruleCode" ;
    rdfs:domain osdm:RefundOfferRequest ;
    rdfs:range osdm:OverruleCode ;
    skos:notation "overruleCode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOfferRequest.refundDate> a owl:DatatypeProperty ;
    rdfs:label "refundDate" ;
    rdfs:comment "Indicates for passes the date taken as reference to compute possible partial refund. It is also the date taken\nas reference to invalidate the pass partially refunded."@en ;
    rdfs:domain osdm:RefundOfferRequest ;
    rdfs:range xsd:dateTime ;
    skos:notation "refundDate" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOfferRequest.refundSpecifications> a owl:ObjectProperty ;
    rdfs:label "refundSpecifications" ;
    rdfs:comment "To do a partial refund repeat the fulfillmentIds affected and point out what to refund"@en ;
    rdfs:domain osdm:RefundOfferRequest ;
    rdfs:range osdm:RefundSpecification ;
    skos:notation "refundSpecifications" .

osdm:RefundOfferResponse a owl:Class ;
    rdfs:label "RefundOfferResponse" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/aftersales.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOfferResponse.problems> a owl:ObjectProperty ;
    rdfs:label "problems" ;
    rdfs:domain osdm:RefundOfferResponse ;
    rdfs:range osdm:Problem ;
    skos:notation "problems" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOfferResponse.refundOffer> a owl:ObjectProperty ;
    rdfs:label "refundOffer" ;
    rdfs:domain osdm:RefundOfferResponse ;
    rdfs:range osdm:RefundOffer ;
    skos:notation "refundOffer" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOfferResponse.warnings> a owl:ObjectProperty ;
    rdfs:label "warnings" ;
    rdfs:domain osdm:RefundOfferResponse ;
    rdfs:range osdm:WarningCollection ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "warnings" .

osdm:RefundPaymentBreakdownItem a owl:Class ;
    rdfs:label "RefundPaymentBreakdownItem" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/aftersales.yml> ;
    rdfs:comment "One channel through which (part of) the refundable amount is returned to\nthe purchaser. A list of these expresses split reimbursements (e.g. part to\na voucher, part to the original payment mean), which the singular\nreimbursementMethod cannot represent."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundPaymentBreakdownItem.type> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundPaymentBreakdownItem.refundableAmount> a owl:ObjectProperty ;
    rdfs:label "refundableAmount" ;
    rdfs:comment "Amount returned to the purchaser through this channel. Authoritative for\nthe VOUCHER channel, where the system knows the credited amount (mirroring\nappliedVoucherAmount on PaymentMethod). For other channels such as\nORIGINAL_ACCOUNT the amount is declarative and may be omitted when the\nsystem cannot state it."@en ;
    rdfs:domain osdm:RefundPaymentBreakdownItem ;
    rdfs:range osdm:Price ;
    skos:notation "refundableAmount" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundPaymentBreakdownItem.type> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "type" ;
    rdfs:domain osdm:RefundPaymentBreakdownItem ;
    rdfs:range osdm:PaymentType ;
    skos:notation "type" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundPaymentBreakdownItem.voucherInformation> a owl:ObjectProperty ;
    rdfs:label "voucherInformation" ;
    rdfs:comment "Identifies the voucher this amount is credited to when type is VOUCHER.\nThis is the per-voucher key that lets a specific amount be attached to a\nspecific voucher (which issuedVouchers cannot express). A voucher that\nalso appears in issuedVouchers is newly issued; one that appears here but\nnot in issuedVouchers is a re-credit of an existing voucher."@en ;
    rdfs:domain osdm:RefundPaymentBreakdownItem ;
    rdfs:range osdm:VoucherInformation ;
    skos:notation "voucherInformation" .

osdm:RefundSpecification a owl:Class ;
    rdfs:label "RefundSpecification" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/aftersales.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundSpecification.fulfillmentId> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundSpecification.bookingPartIds> a owl:DatatypeProperty ;
    rdfs:label "bookingPartIds" ;
    rdfs:comment "ids of booking parts to be removed from the fulfillment"@en ;
    rdfs:domain osdm:RefundSpecification ;
    rdfs:range xsd:string ;
    skos:notation "bookingPartIds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundSpecification.fulfillmentId> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "fulfillmentId" ;
    rdfs:comment "id of the fulfillment where some part(s) should be removed"@en ;
    rdfs:domain osdm:RefundSpecification ;
    rdfs:range xsd:string ;
    skos:notation "fulfillmentId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundSpecification.passengerIds> a owl:DatatypeProperty ;
    rdfs:label "passengerIds" ;
    rdfs:comment "ids of passengers to be removed from the fulfillment"@en ;
    rdfs:domain osdm:RefundSpecification ;
    rdfs:range xsd:string ;
    skos:notation "passengerIds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundSpecification.refundFee> a owl:ObjectProperty ;
    rdfs:label "refundFee" ;
    rdfs:comment "In some business models the distributor has the right to define the refund fee amount for a fare provided by the fare provider. This need to be indicated in the fare after sales rules to be applied. In this case the distributor submits the amount to the fare provider in refund fee amount and the fare provider uses this amount to create the fees including the VAT split."@en ;
    rdfs:domain osdm:RefundSpecification ;
    rdfs:range osdm:CurrencyAmount ;
    skos:notation "refundFee" .

