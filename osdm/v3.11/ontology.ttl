    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDefFareReferenceStationSet.carrier> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDefFareReferenceStationSet.code> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDefFareReferenceStationSet.carrier> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "carrier" ;
    rdfs:domain osdm:ViaStationsDefFareReferenceStationSet ;
    rdfs:range osdm:CompanyDef ;
    skos:notation "carrier" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDefFareReferenceStationSet.code> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "code" ;
    rdfs:domain osdm:ViaStationsDefFareReferenceStationSet ;
    rdfs:range xsd:string ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDefFareReferenceStationSet.name> a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain osdm:ViaStationsDefFareReferenceStationSet ;
    rdfs:range xsd:string ;
    skos:notation "name" .

osdm:ViaStationsDefRouteValidityType a owl:Class, skos:ConceptScheme ;
    rdfs:label "ViaStationsDefRouteValidityType" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:comment "Indiction of the type of validity for a route. In case of LINE validity (Default) the described lines are allowed for travel. In case of BUBBLE it is additionally allowed to travel on all routes inbetween the defined lines."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDefRouteValidityType/BUBBLE> a osdm:ViaStationsDefRouteValidityType, skos:Concept ;
    skos:inScheme osdm:ViaStationsDefRouteValidityType ;
    skos:notation "BUBBLE" ;
    skos:prefLabel "BUBBLE" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDefRouteValidityType/LINE> a osdm:ViaStationsDefRouteValidityType, skos:Concept ;
    skos:inScheme osdm:ViaStationsDefRouteValidityType ;
    skos:notation "LINE" ;
    skos:prefLabel "LINE" .

osdm:VoucherInformation a owl:Class ;
    rdfs:label "VoucherInformation" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VoucherInformation.code> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VoucherInformation.issuer> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VoucherInformation.code> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "code" ;
    rdfs:comment "voucher code provided by the issuer"@en ;
    rdfs:domain osdm:VoucherInformation ;
    rdfs:range xsd:string ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VoucherInformation.issuer> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "issuer" ;
    rdfs:domain osdm:VoucherInformation ;
    rdfs:range osdm:CompanyRef ;
