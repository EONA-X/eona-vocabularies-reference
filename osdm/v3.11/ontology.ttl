    rdfs:label "nameTranslation" ;
    rdfs:comment "Translations for the name"@en ;
    rdfs:domain osdm:CoachDeckLayout ;
    rdfs:range osdm:Translation ;
    skos:notation "nameTranslation" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachDeckLayout.placeGroups> a owl:ObjectProperty ;
    rdfs:label "placeGroups" ;
    rdfs:comment "Groups places. No place groups might exist for special coach types (e.g. traction units without seats)."@en ;
