osdm:OnlineResourceDef a owl:Class ;
    rdfs:label "OnlineResourceDef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OnlineResourceDef.interfaceType> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OnlineResourceDef.interfaceType> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "interfaceType" ;
    rdfs:comment "see code list for interface type"@en ;
    rdfs:domain osdm:OnlineResourceDef ;
    rdfs:range xsd:string ;
    skos:notation "interfaceType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OnlineResourceDef.offerType> a owl:DatatypeProperty ;
    rdfs:label "offerType" ;
    rdfs:comment "The resource provides offers bases on trains or based on areas. Train based offers must start and end at a real station and are not split between a train run. Values TRAIN, AREA"@en ;
    rdfs:domain osdm:OnlineResourceDef ;
    rdfs:range xsd:string ;
    skos:notation "offerType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OnlineResourceDef.system> a owl:DatatypeProperty ;
    rdfs:label "system" ;
    rdfs:comment "system where the offer can be found (e.r. for TAP-TSI-B5 the reservation system code)"@en ;
    rdfs:domain osdm:OnlineResourceDef ;
    rdfs:range xsd:string ;
    skos:notation "system" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OnlineResourceDef.version> a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:domain osdm:OnlineResourceDef ;
    rdfs:range xsd:string ;
    skos:notation "version" .

osdm:OperatingDays a owl:Class ;
    rdfs:label "OperatingDays" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/trip.yml> ;
    rdfs:comment "Day of public transport operation of which the characteristics are defined in a specific\nservice calendar and which may last more than 24 hours. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OperatingDays.from> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OperatingDays.pattern> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OperatingDays.until> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OperatingDays.from> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "from" ;
    rdfs:comment "Start date of period"@en ;
    rdfs:domain osdm:OperatingDays ;
    rdfs:range xsd:dateTime ;
    skos:notation "from" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OperatingDays.pattern> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "pattern" ;
    rdfs:comment "Bit pattern for operating days between start date and end date.\nThe length of the pattern is equal to the number of days from\nstart date to end date. A bit value of '1' indicates that an event\nactually happens on the day that is represented by the bit position."@en ;
    rdfs:domain osdm:OperatingDays ;
    rdfs:range xsd:string ;
    skos:notation "pattern" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OperatingDays.until> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "until" ;
    rdfs:comment "End date of period"@en ;
    rdfs:domain osdm:OperatingDays ;
    rdfs:range xsd:dateTime ;
    skos:notation "until" .

osdm:OperationDayRef a rdfs:Datatype ;
    rdfs:label "OperationDayRef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/trip.yml> ;
    rdfs:comment "Reference to an operating day. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:string ] ;
    skos:example "OperatingDay:12345" .

osdm:Orientation a rdfs:Datatype ;
    rdfs:label "Orientation" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/place.yml> ;
    rdfs:comment "Orientation angle in degrees"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:int ] ;
    skos:example "90" .

osdm:OsmTag a owl:Class ;
    rdfs:label "OsmTag" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/_common.yml> ;
    rdfs:comment "Structure of an Open Street Map tag. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OsmTag.tag> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OsmTag.value> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OsmTag.tag> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "tag" ;
    rdfs:comment "Name of Open Street Map tag (amenity, leisure, tourism, bike, ...)"@en ;
    rdfs:domain osdm:OsmTag ;
    rdfs:range xsd:string ;
    skos:example "name" ;
    skos:notation "tag" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OsmTag.value> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "value" ;
    rdfs:comment "Value for Open Street Map tag (charging_station, hostel, yes, ...)"@en ;
    rdfs:domain osdm:OsmTag ;
    rdfs:range xsd:string ;
    skos:example "Rozenrust" ;
    skos:notation "value" .

osdm:OverruleCode a owl:Class, skos:ConceptScheme ;
    rdfs:label "OverruleCode" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Reason for and type of an after sale, code list in IRS 90918-10.\nThe PRM_SUPPORT_UNAVAILABLE overrule code shall only be used by the UIC PRM ABT tool.\nValues from the [Overrule Codes Code List](https://osdm.io/spec/catalog-of-code-lists/#OverruleCode)\nListed values here are examples.   \n- 'CONNECTION_BROKEN'\n- 'DEATH'\n- 'EQUIPMENT_FAILURE'\n- 'PAYMENT_FAILURE'\n- 'PRM_SUPPORT_UNAVAILABLE'\n- 'SALES_STAFF_ERROR'\n- 'STOP_NOT_SERVED'\n- 'STRIKE'\n- 'TECHNICAL_FAILURE'\n- 'TICKET_NOT_USED'\n- 'INABILITY_TO_TRAVEL': Inability to travel due to accident or sickness.\n- 'EXTERNAL_COMPENSATION': Offer has been compensated outside of the provider system in another way.\n- 'DISRUPTION': Inability to operate due to disruption.\n- 'JOURNEY_OBSOLETE': Due to external factors it's senseless to start the trip, thus the travel is obsolete.\n- 'CERTIFIED_MEDICAL_CONDITION': A medical certificate certifies that the passenger is unable to travel.\n- 'DELAY_COMPENSATION': Allows to override conditions in context of passenger rights regulation (PRR)."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OverruleCode/CERTIFIED_MEDICAL_CONDITION> a osdm:OverruleCode, skos:Concept ;
    skos:inScheme osdm:OverruleCode ;
    skos:notation "CERTIFIED_MEDICAL_CONDITION" ;
    skos:prefLabel "CERTIFIED_MEDICAL_CONDITION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OverruleCode/CONNECTION_BROKEN> a osdm:OverruleCode, skos:Concept ;
    skos:inScheme osdm:OverruleCode ;
    skos:notation "CONNECTION_BROKEN" ;
