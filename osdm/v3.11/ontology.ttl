<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Admission.regionalValidities> a owl:ObjectProperty ;
    rdfs:label "regionalValidities" ;
    rdfs:comment "This contains multiple regional validities for this item and replaces the `regionalValidity` (deprecated) attribute."@en ;
