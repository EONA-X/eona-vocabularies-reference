osdm:TextElement a owl:Class ;
    rdfs:label "TextElement" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Additional texts which should be displayed to the customer to further describe the product being offered."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TextElement.description> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TextElement.shortDescription> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TextElement.textElementType> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TextElement.description> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "description" ;
    rdfs:comment "Full version of the text for display when sufficient space is available."@en ;
    rdfs:domain osdm:TextElement ;
    rdfs:range xsd:string ;
    skos:notation "description" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TextElement.descriptionTranslations> a owl:ObjectProperty ;
    rdfs:label "descriptionTranslations" ;
    rdfs:comment "Translations of description and shortDescription attributes"@en ;
    rdfs:domain osdm:TextElement ;
    rdfs:range osdm:Translation ;
    skos:notation "descriptionTranslations" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TextElement.shortDescription> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "shortDescription" ;
    rdfs:comment "Brief version of the text for display in space restricted environments, e.g. mobile phone. No longer than 64 characters."@en ;
    rdfs:domain osdm:TextElement ;
    rdfs:range xsd:string ;
    skos:notation "shortDescription" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TextElement.textElementType> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "textElementType" ;
    rdfs:domain osdm:TextElement ;
    rdfs:range osdm:TextElementType ;
    skos:notation "textElementType" .

osdm:TextElementType a owl:Class, skos:ConceptScheme ;
    rdfs:label "TextElementType" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Type of descriptive text.\nValid Values:\n- INFORMATION: pure informational text (product/fulfillment).\n- MANDATORY: must be displayed to the customer prior to purchase (product).\n- MANDATORY_WITH_CONFIRMATION: must be confirmed, e.g. by checking a checkbox, prior to purchase (product).\n- TICKET_VALIDITY: any text on the ticket regarding it's validity (other than information which can be retrieved from the booking)"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TextElementType/INFORMATION> a osdm:TextElementType, skos:Concept ;
    skos:inScheme osdm:TextElementType ;
    skos:notation "INFORMATION" ;
    skos:prefLabel "INFORMATION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TextElementType/MANDATORY> a osdm:TextElementType, skos:Concept ;
    skos:inScheme osdm:TextElementType ;
    skos:notation "MANDATORY" ;
    skos:prefLabel "MANDATORY" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TextElementType/MANDATORY_WITH_CONFIRMATION> a osdm:TextElementType, skos:Concept ;
    skos:inScheme osdm:TextElementType ;
    skos:notation "MANDATORY_WITH_CONFIRMATION" ;
    skos:prefLabel "MANDATORY_WITH_CONFIRMATION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TextElementType/TICKET_VALIDITY> a osdm:TextElementType, skos:Concept ;
    skos:inScheme osdm:TextElementType ;
    skos:notation "TICKET_VALIDITY" ;
    skos:prefLabel "TICKET_VALIDITY" .

