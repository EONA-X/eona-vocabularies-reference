<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOfferBreakdownItem.bookingParts> a owl:ObjectProperty ;
    rdfs:label "bookingParts" ;
    rdfs:domain osdm:RefundOfferBreakdownItem ;
    rdfs:range osdm:BookingPartReference ;
    skos:notation "bookingParts" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#RefundOfferBreakdownItem.refundFee> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "refundFee" ;
