    rdfs:label "id" ;
    rdfs:domain osdm:CoachDeckLayout ;
    rdfs:range xsd:string ;
    skos:notation "id" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachDeckLayout.lowFloorEntry> a owl:DatatypeProperty ;
    rdfs:label "lowFloorEntry" ;
    rdfs:comment "Typically set on the lowest deck. Empty if unknown."@en ;
    rdfs:domain osdm:CoachDeckLayout ;
    rdfs:range xsd:boolean ;
    skos:notation "lowFloorEntry" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CoachDeckLayout.name> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "name" ;
    rdfs:domain osdm:CoachDeckLayout ;
    rdfs:range xsd:string ;
