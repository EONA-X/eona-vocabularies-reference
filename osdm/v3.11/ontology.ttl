osdm:TravelDirectionType a owl:Class, skos:ConceptScheme ;
    rdfs:label "TravelDirectionType" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Indicated travel direction of a coach. Standard direction is left to right with ascending coordinates in the layout values. To get the direction of travel for a place the direction information of the coach needs to be combined with the direction of the seat in the coach layout.\nValues from the [Travel Direction Code List](https://osdm.io/spec/catalog-of-code-lists/#TravelDirection)\nListed values here are examples.\n<br><br>\nKnown Values:\n- UNSPECIFIED\n- IN_DIRECTION\n- OPPOSITE_DIRECTION\n- CHANGING\n- @Deprecated STARING_IN_DIRECTION: \n    <br><br>\n    Deprecated: Substituted by STARTING_IN_DIRECTION (since: 3.5.0, removed with: 4.0.0)\n- STARTING_IN_DIRECTION\n- STARTING_OPPOSITE_TO_DIRECTION"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TravelDirectionType/CHANGING> a osdm:TravelDirectionType, skos:Concept ;
    skos:inScheme osdm:TravelDirectionType ;
    skos:notation "CHANGING" ;
    skos:prefLabel "CHANGING" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TravelDirectionType/IN_DIRECTION> a osdm:TravelDirectionType, skos:Concept ;
    skos:inScheme osdm:TravelDirectionType ;
    skos:notation "IN_DIRECTION" ;
    skos:prefLabel "IN_DIRECTION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TravelDirectionType/OPPOSITE_DIRECTION> a osdm:TravelDirectionType, skos:Concept ;
    skos:inScheme osdm:TravelDirectionType ;
    skos:notation "OPPOSITE_DIRECTION" ;
    skos:prefLabel "OPPOSITE_DIRECTION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TravelDirectionType/STARTING_IN_DIRECTION> a osdm:TravelDirectionType, skos:Concept ;
    skos:inScheme osdm:TravelDirectionType ;
    skos:notation "STARTING_IN_DIRECTION" ;
    skos:prefLabel "STARTING_IN_DIRECTION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TravelDirectionType/STARTING_OPPOSITE_TO_DIRECTION> a osdm:TravelDirectionType, skos:Concept ;
    skos:inScheme osdm:TravelDirectionType ;
    skos:notation "STARTING_OPPOSITE_TO_DIRECTION" ;
