    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ResourceType/FARE> a osdm:ResourceType, skos:Concept ;
    skos:inScheme osdm:ResourceType ;
    skos:notation "FARE" ;
    skos:prefLabel "FARE" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ResourceType/RESERVATION> a osdm:ResourceType, skos:Concept ;
    skos:inScheme osdm:ResourceType ;
    skos:notation "RESERVATION" ;
    skos:prefLabel "RESERVATION" .

osdm:ReturnConstraint a owl:Class ;
    rdfs:label "ReturnConstraint" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "a return trip with the same carrier must be sold in combination"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnConstraint.earliestReturn> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnConstraint.latestReturn> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnConstraint.earliestReturn> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "earliestReturn" ;
    rdfs:comment "number of days after departure or start of validity of the earliest return"@en ;
    rdfs:domain osdm:ReturnConstraint ;
    rdfs:range xsd:int ;
    skos:notation "earliestReturn" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnConstraint.excludedWeekdays> a owl:DatatypeProperty ;
    rdfs:label "excludedWeekdays" ;
    rdfs:comment "weekdays (ISO day of the week, 1 = Monday) between travel and return where travel is not allowed"@en ;
    rdfs:domain osdm:ReturnConstraint ;
    rdfs:range xsd:int ;
    skos:notation "excludedWeekdays" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnConstraint.latestReturn> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "latestReturn" ;
    rdfs:comment "number of days after departure or start of validity of the last return"@en ;
    rdfs:domain osdm:ReturnConstraint ;
    rdfs:range xsd:int ;
    skos:notation "latestReturn" .

osdm:ReturnSearchParameters a owl:Class ;
    rdfs:label "ReturnSearchParameters" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/trip.yml> ;
    rdfs:comment "This property can be used in case a return trip is being requested.\nThis will allow to benefit from return-specific fares or product.\n\nOnly one of `outboundTripIds` or `outwardOfferIds` should be provided.\n\n`inwardReturnDate` and `outwardOfferTag` should not be used as they are deprecated in 3.7.0 and will be removed in 4.0.0."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnSearchParameters.arrivalTime> a owl:DatatypeProperty ;
    rdfs:label "arrivalTime" ;
    rdfs:comment "Needs to in be local date time format of the stop. Exactly one of `departureTime` or `arrivalTime` must be provided."@en ;
    rdfs:domain osdm:ReturnSearchParameters ;
    rdfs:range xsd:dateTime ;
    skos:notation "arrivalTime" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnSearchParameters.departureTime> a owl:DatatypeProperty ;
    rdfs:label "departureTime" ;
    rdfs:comment "Needs to be in local date time format of the stop. Exactly one of `departureTime` or `arrivalTime` must be provided."@en ;
    rdfs:domain osdm:ReturnSearchParameters ;
    rdfs:range xsd:dateTime ;
    skos:notation "departureTime" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnSearchParameters.inwardReturnDate> a owl:DatatypeProperty ;
    rdfs:label "inwardReturnDate" ;
    rdfs:comment "Needs to be provided when creating the collection of outbound travels so that the\nprovider knows when a inbound travel can be expected and propose appropriate\nproduct and fares.\n\nSuperseded by `OfferSearchCriteria.inboundDate`."@en ;
    rdfs:domain osdm:ReturnSearchParameters ;
    rdfs:range xsd:dateTime ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "inwardReturnDate" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnSearchParameters.outboundTripIds> a owl:DatatypeProperty ;
    rdfs:label "outboundTripIds" ;
    rdfs:comment "Needs to be provided when creating collection of offers covering both\noutbound and inbound (return) journey."@en ;
    rdfs:domain osdm:ReturnSearchParameters ;
    rdfs:range xsd:string ;
    skos:notation "outboundTripIds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnSearchParameters.outwardOfferIds> a owl:DatatypeProperty ;
    rdfs:label "outwardOfferIds" ;
    rdfs:comment "Needs to be provided when creating the collection of inbound travels so that the provider\ncan relate the inbound travels to the outbound travels context."@en ;
    rdfs:domain osdm:ReturnSearchParameters ;
    rdfs:range xsd:string ;
    skos:notation "outwardOfferIds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnSearchParameters.outwardOfferTag> a owl:DatatypeProperty ;
    rdfs:label "outwardOfferTag" ;
    rdfs:comment "Needs to be provided when creating the collection of inbound travels so that the provider\nknows what the outbound offer is and and propose compatible offers only if desired or mandatory."@en ;
    rdfs:domain osdm:ReturnSearchParameters ;
    rdfs:range xsd:string ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "outwardOfferTag" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnSearchParameters.parameters> a owl:ObjectProperty ;
    rdfs:label "parameters" ;
    rdfs:domain osdm:ReturnSearchParameters ;
    rdfs:range osdm:TripParameters ;
    skos:notation "parameters" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ReturnSearchParameters.vias> a owl:ObjectProperty ;
    rdfs:label "vias" ;
    rdfs:comment "Ordered series of points where the journey must pass through. If more\nthan one via point is given all of them must be obeyed - in the correct\norder. The server is allowed to replace a via stop by equivalent stops.\n\nTripDataFilters given at a via apply to the section after that via. To apply a TripDataFilter for \nthe first section (between the origin and the first via), use the TripDataFilter within the\nTripParameters structure."@en ;
    rdfs:domain osdm:ReturnSearchParameters ;
    rdfs:range osdm:TripVia ;
    skos:notation "vias" .

