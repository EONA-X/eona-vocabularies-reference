    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#NamedTravelAccountUnit.name> ], osdm:AbstractTravelAccountUnit .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#NamedTravelAccountUnit.name> a owl:DatatypeProperty, owl:FunctionalProperty ;
