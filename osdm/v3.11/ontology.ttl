osdm:NonTripSearchCriteria a owl:Class ;
    rdfs:label "NonTripSearchCriteria" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/trip.yml> ;
    rdfs:comment "Defines the requested validity when searching specifically for a non-trip Offer. \n\nThe geographical validity can either be specified by a list of nutsCodes, by a list of places (e.g. stations) with the semantics that trips between either of any of the listed stations are covered (e.g. Frankfurt (Main) Hbf, Friedberg(Hess) and Hanau Hbf, which would imply that any travel between these stations is to be covered), or a list of zones (e.g. with carrier urn:vdv:rmv, the zones with the ids 50, 2501 and 3001 would cover the same area as the list of stations above)."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#NonTripSearchCriteria.nutsCodes> a owl:DatatypeProperty ;
    rdfs:label "nutsCodes" ;
    rdfs:comment "Nomenclature des units territoriales statistiques COMMISSION REGULATION (EU) No 31/2011"@en ;
    rdfs:domain osdm:NonTripSearchCriteria ;
    rdfs:range xsd:string ;
    skos:notation "nutsCodes" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#NonTripSearchCriteria.places> a owl:ObjectProperty ;
    rdfs:label "places" ;
