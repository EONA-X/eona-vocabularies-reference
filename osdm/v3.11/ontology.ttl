osdm:AncillarySubType a owl:Class, skos:ConceptScheme ;
    rdfs:label "AncillarySubType" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/offer.yml> ;
    rdfs:comment "Values from the [Ancillary SubType Code List](https://osdm.io/spec/catalog-of-code-lists/#ancillary-sub-types-)\nListed values here are examples."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AncillarySubType/ASSISTANCE_ANIMAL> a osdm:AncillarySubType, skos:Concept ;
