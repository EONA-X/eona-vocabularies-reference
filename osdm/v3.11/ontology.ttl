<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceAllocation.accommodationType> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "accommodationType" ;
    rdfs:domain osdm:PlaceAllocation ;
    rdfs:range osdm:AccommodationType ;
    skos:notation "accommodationType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceAllocation.reservedPlaces> a owl:ObjectProperty ;
    rdfs:label "reservedPlaces" ;
    rdfs:comment "Reserved places in a confirmed reservation.\nMultiple place packs are needed to combined person and bicycle reservations"@en ;
    rdfs:domain osdm:PlaceAllocation ;
    rdfs:range osdm:ReservedPlace ;
    skos:notation "reservedPlaces" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceAllocation.tripLegCoverage> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "tripLegCoverage" ;
    rdfs:domain osdm:PlaceAllocation ;
    rdfs:range osdm:TripLegCoverage ;
    skos:notation "tripLegCoverage" .

