    rdfs:range osdm:RegionalValidity ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "regionalValidity" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Admission.regulatoryConditions> a owl:ObjectProperty ;
    rdfs:label "regulatoryConditions" ;
    rdfs:domain osdm:Admission ;
    rdfs:range osdm:RegulatoryCondition ;
    skos:notation "regulatoryConditions" .

