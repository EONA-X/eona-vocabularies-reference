    rdfs:label "allowedClusters" ;
    rdfs:comment "In case of CLUSTERING model: the other clusters that allow a combination"@en ;
    rdfs:domain osdm:FareCombinationModelDef ;
    rdfs:range xsd:string ;
    skos:notation "allowedClusters" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareCombinationModelDef.allowedCommonContracts> a owl:DatatypeProperty ;
    rdfs:label "allowedCommonContracts" ;
    rdfs:comment "List of carriers where a common contract with separate fulfillments are allowed."@en ;
