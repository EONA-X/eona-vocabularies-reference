    rdfs:range xsd:dateTime ;
    skos:notation "downloadExpiry" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SupportingDocument.downloadLink> a owl:DatatypeProperty ;
    rdfs:label "downloadLink" ;
    rdfs:domain osdm:SupportingDocument ;
    rdfs:range xsd:string ;
    skos:notation "downloadLink" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SupportingDocument.format> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "format" ;
    rdfs:domain osdm:SupportingDocument ;
    rdfs:range osdm:DocumentFormat ;
    skos:notation "format" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SupportingDocument.title> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "title" ;
    rdfs:comment "title of the document"@en ;
    rdfs:domain osdm:SupportingDocument ;
    rdfs:range xsd:string ;
    skos:example "delay confirmation written by staff on board" ;
    skos:notation "title" .

