osdm:CorporateCode a owl:Class ;
    rdfs:label "CorporateCode" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "The corporate code is a token that reduces the price of an offer or enables  offers that are not available without it. Needs with a commercial agreement between parties."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CorporateCode.code> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CorporateCode.issuer> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CorporateCode.beneficiary> a owl:DatatypeProperty ;
    rdfs:label "beneficiary" ;
    rdfs:comment "The name of the party that benefits from the corporate code, intended to be presented to the end user."@en ;
    rdfs:domain osdm:CorporateCode ;
    rdfs:range xsd:string ;
    skos:example "Siemens" ;
    skos:notation "beneficiary" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CorporateCode.code> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "code" ;
    rdfs:comment "The corporate code issued by the referenced company."@en ;
    rdfs:domain osdm:CorporateCode ;
    rdfs:range xsd:string ;
    skos:example "123-232" ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#CorporateCode.issuer> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "issuer" ;
    rdfs:domain osdm:CorporateCode ;
    rdfs:range osdm:CompanyRef ;
    skos:notation "issuer" .

osdm:CountryCode a rdfs:Datatype ;
    rdfs:label "CountryCode" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "ISO 3166-1 alpha-2 2 character country code"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:string ] ;
    skos:example "DE" .

