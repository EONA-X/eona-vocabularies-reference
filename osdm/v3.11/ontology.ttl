osdm:OfferSearchCriteria a owl:Class ;
    rdfs:label "OfferSearchCriteria" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/offer.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSearchCriteria.currency> a owl:DatatypeProperty ;
    rdfs:label "currency" ;
    rdfs:domain osdm:OfferSearchCriteria ;
    rdfs:range osdm:Currency ;
    skos:notation "currency" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSearchCriteria.flexibilities> a owl:ObjectProperty ;
    rdfs:label "flexibilities" ;
    rdfs:comment "Defines the flexibility levels desired of the fares returned.\nThis refers to the after sales flexibility levels as defined in IRS-90918-10"@en ;
    rdfs:domain osdm:OfferSearchCriteria ;
    rdfs:range osdm:Flexibility ;
    skos:notation "flexibilities" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSearchCriteria.inboundDate> a owl:DatatypeProperty ;
    rdfs:label "inboundDate" ;
    rdfs:comment "Needs to be provided when creating the collection of outbound travels so that the\nprovider knows when a inbound travel can be expected and propose appropriate\nproduct and fares."@en ;
    rdfs:domain osdm:OfferSearchCriteria ;
    rdfs:range xsd:dateTime ;
    skos:notation "inboundDate" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSearchCriteria.offerMode> a owl:ObjectProperty ;
    rdfs:label "offerMode" ;
    rdfs:domain osdm:OfferSearchCriteria ;
    rdfs:range osdm:OfferMode ;
    skos:notation "offerMode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSearchCriteria.productSelections> a owl:ObjectProperty ;
    rdfs:label "productSelections" ;
    rdfs:comment "preselection of products where offers are requested"@en ;
    rdfs:domain osdm:OfferSearchCriteria ;
    rdfs:range osdm:ProductRequestOfferSelection ;
    skos:notation "productSelections" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSearchCriteria.productTags> a owl:ObjectProperty ;
    rdfs:label "productTags" ;
    rdfs:domain osdm:OfferSearchCriteria ;
    rdfs:range osdm:ProductTag ;
    skos:notation "productTags" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSearchCriteria.requestedOfferParts> a owl:ObjectProperty ;
    rdfs:label "requestedOfferParts" ;
    rdfs:domain osdm:OfferSearchCriteria ;
    rdfs:range osdm:OfferPartType ;
    skos:notation "requestedOfferParts" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSearchCriteria.serviceClassTypes> a owl:ObjectProperty ;
    rdfs:label "serviceClassTypes" ;
    rdfs:comment "The classes returned might be different from the requested classes."@en ;
    rdfs:domain osdm:OfferSearchCriteria ;
    rdfs:range osdm:ServiceClassType ;
    skos:notation "serviceClassTypes" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSearchCriteria.travelClasses> a owl:ObjectProperty ;
    rdfs:label "travelClasses" ;
    rdfs:comment "The classes returned might be different from the requested classes."@en ;
    rdfs:domain osdm:OfferSearchCriteria ;
    rdfs:range osdm:TravelClass ;
    skos:notation "travelClasses" .

osdm:OfferSelection a owl:Class ;
    rdfs:label "OfferSelection" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/offer.yml> ;
    rdfs:comment "The Ids of the offers to be booked need to be passed in."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSelection.offerId> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSelection.passengerRefs> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSelection.afterSaleByRetailerOnly> a owl:DatatypeProperty ;
    rdfs:label "afterSaleByRetailerOnly" ;
    rdfs:comment "in case the distributor has proposed this offer in conjunction with an offer of another provider constrained\nby a combinationTag, this flag must be set to true to indicate to the provider that after-sale must be done\non the totality of the distributor's booking. Only after-sale requests triggered by the distributor can be\nsafely processed on this offer. When the flag is not set, standard provider logic applies."@en ;
    rdfs:domain osdm:OfferSelection ;
    rdfs:range xsd:boolean ;
    skos:notation "afterSaleByRetailerOnly" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSelection.appliedRegulatoryCondition> a owl:ObjectProperty ;
    rdfs:label "appliedRegulatoryCondition" ;
    rdfs:domain osdm:OfferSelection ;
    rdfs:range osdm:RegulatoryCondition ;
    skos:notation "appliedRegulatoryCondition" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSelection.externalRef> a owl:DatatypeProperty ;
    rdfs:label "externalRef" ;
    rdfs:comment "A stable reference to the id of the offer in the caller's system. When received in input of a request, it must be persisted and echoed back in the response."@en ;
    rdfs:domain osdm:OfferSelection ;
    rdfs:range xsd:string ;
    skos:notation "externalRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSelection.offerId> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "offerId" ;
    rdfs:comment "id of the selected offer or exchangeOffer"@en ;
    rdfs:domain osdm:OfferSelection ;
    rdfs:range xsd:string ;
    skos:notation "offerId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSelection.optionalAncillarySelections> a owl:ObjectProperty ;
    rdfs:label "optionalAncillarySelections" ;
    rdfs:domain osdm:OfferSelection ;
    rdfs:range osdm:AncillarySelection ;
    skos:notation "optionalAncillarySelections" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSelection.optionalReservationSelections> a owl:ObjectProperty ;
    rdfs:label "optionalReservationSelections" ;
    rdfs:comment "Mandatory reservations are booked when the booking is being booked."@en ;
    rdfs:domain osdm:OfferSelection ;
    rdfs:range osdm:ReservationSelection ;
    skos:notation "optionalReservationSelections" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSelection.passengerRefs> a owl:DatatypeProperty ;
    rdfs:label "passengerRefs" ;
    rdfs:domain osdm:OfferSelection ;
    rdfs:range xsd:string ;
    skos:notation "passengerRefs" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSelection.placeSelections> a owl:ObjectProperty ;
    rdfs:label "placeSelections" ;
    rdfs:domain osdm:OfferSelection ;
    rdfs:range osdm:PlaceSelection ;
    skos:notation "placeSelections" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSelection.throughTicketTags> a owl:ObjectProperty ;
    rdfs:label "throughTicketTags" ;
    rdfs:domain osdm:OfferSelection ;
    rdfs:range osdm:ThroughTicketTag ;
    skos:notation "throughTicketTags" .

osdm:OfferSummary a owl:Class ;
    rdfs:label "OfferSummary" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/offer.yml> ;
    rdfs:comment "The offer summary indicates the most relevant service class, level, flexibility or accommodation\nthat describe this offer, but this does not imply that these values exactly apply to all parts of\nthe offer.\nLet's consider, as a simplified example, a trip composed of two legs, one with both 1st and\n2nd class, and one with only 2nd.\nOn this trip, the railway is expected to propose one offer with overallServiceClass FIRST composed\nof one admission in 1st class on the first legs and one admission in 2nd class on the second one,\nplus a second offer with overallServiceClass SECOND composed of two second class admissions.\nLikewise for all 'overall' attributes. The purpose of these attributes is to convey to the client\nsystem the service class, level, flexibility and accommodation that best represent this offer so to\nfacilitate presentation to the final user.\nThe offerSummary must be provided for product based offers. It is not needed for fares."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSummary.minimalPrice> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSummary.overallFlexibility> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSummary.overallServiceClass> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSummary.minimalIndicatedConsumption> a owl:ObjectProperty ;
    rdfs:label "minimalIndicatedConsumption" ;
    rdfs:domain osdm:OfferSummary ;
    rdfs:range osdm:IndicatedConsumption ;
    skos:notation "minimalIndicatedConsumption" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSummary.minimalPrice> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "minimalPrice" ;
    rdfs:domain osdm:OfferSummary ;
    rdfs:range osdm:Price ;
    skos:notation "minimalPrice" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSummary.overallAccommodationSubType> a owl:ObjectProperty ;
    rdfs:label "overallAccommodationSubType" ;
    rdfs:domain osdm:OfferSummary ;
    rdfs:range osdm:AccommodationSubType ;
    skos:notation "overallAccommodationSubType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSummary.overallAccommodationType> a owl:ObjectProperty ;
    rdfs:label "overallAccommodationType" ;
    rdfs:domain osdm:OfferSummary ;
    rdfs:range osdm:AccommodationType ;
    skos:notation "overallAccommodationType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSummary.overallFlexibility> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "overallFlexibility" ;
    rdfs:domain osdm:OfferSummary ;
    rdfs:range osdm:Flexibility ;
    skos:notation "overallFlexibility" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSummary.overallServiceClass> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "overallServiceClass" ;
    rdfs:domain osdm:OfferSummary ;
    rdfs:range osdm:ServiceClass ;
    skos:notation "overallServiceClass" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OfferSummary.overallTravelClass> a owl:ObjectProperty ;
