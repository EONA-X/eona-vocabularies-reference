<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StationNamesDef.localCode> a owl:DatatypeProperty ;
    rdfs:label "localCode" ;
    rdfs:comment "local code deprecated with version 1.4"@en ;
    rdfs:domain osdm:StationNamesDef ;
    rdfs:range xsd:integer ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "localCode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StationNamesDef.name> a owl:DatatypeProperty ;
    rdfs:label "name" ;
