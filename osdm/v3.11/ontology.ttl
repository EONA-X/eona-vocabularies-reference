osdm:FulfillmentDocument a owl:Class ;
    rdfs:label "FulfillmentDocument" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/fulfillment.yml> ;
    rdfs:comment "Document created for fulfillment. Either downloadLink + downloadExpiry or content must\nbe provided."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentDocument.format> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentDocument.medium> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentDocument.type> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentDocument.applicationProvider> a owl:DatatypeProperty ;
    rdfs:label "applicationProvider" ;
    rdfs:domain osdm:FulfillmentDocument ;
    rdfs:range osdm:CompanyRef ;
    skos:notation "applicationProvider" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentDocument.content> a owl:DatatypeProperty ;
    rdfs:label "content" ;
    rdfs:comment "base64 encoded binary of the actual fulfillment document. The length restriction of 4 MBytes applies to the encoded\nstring, so the raw document cannot exceed 3 MBytes in size.\nPreferred encoding is UTF-8."@en ;
    rdfs:domain osdm:FulfillmentDocument ;
    rdfs:range xsd:base64Binary ;
    skos:notation "content" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentDocument.controlNumber> a owl:DatatypeProperty ;
    rdfs:label "controlNumber" ;
    rdfs:comment "Ticket Control Number. Used for secure paper stock of referencing tickets in fulfillment applications."@en ;
    rdfs:domain osdm:FulfillmentDocument ;
    rdfs:range xsd:string ;
    skos:notation "controlNumber" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentDocument.downloadExpiry> a owl:DatatypeProperty ;
    rdfs:label "downloadExpiry" ;
    rdfs:comment "Expiration time of the download link, the document will not be available at the given URI\nafter this time."@en ;
    rdfs:domain osdm:FulfillmentDocument ;
    rdfs:range xsd:dateTime ;
    skos:notation "downloadExpiry" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentDocument.downloadLink> a owl:DatatypeProperty ;
    rdfs:label "downloadLink" ;
    rdfs:domain osdm:FulfillmentDocument ;
    rdfs:range xsd:anyURI ;
    skos:notation "downloadLink" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentDocument.format> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "format" ;
    rdfs:domain osdm:FulfillmentDocument ;
    rdfs:range osdm:DocumentFormat ;
    skos:notation "format" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentDocument.id> a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:comment "Technical reference. Required if referencing from fulfilment.fulfillmentDocumentRefs"@en ;
    rdfs:domain osdm:FulfillmentDocument ;
    rdfs:range xsd:string ;
    skos:notation "id" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentDocument.medium> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "medium" ;
    rdfs:domain osdm:FulfillmentDocument ;
    rdfs:range osdm:FulfillmentMediaType ;
    skos:notation "medium" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FulfillmentDocument.type> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "type" ;
    rdfs:domain osdm:FulfillmentDocument ;
    rdfs:range osdm:FulfillmentDocumentType ;
    skos:notation "type" .

