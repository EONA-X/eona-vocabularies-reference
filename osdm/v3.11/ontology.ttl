    skos:inScheme osdm:OverruleCode ;
    skos:notation "DEATH" ;
    skos:prefLabel "DEATH" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OverruleCode/DELAY_COMPENSATION> a osdm:OverruleCode, skos:Concept ;
    skos:inScheme osdm:OverruleCode ;
    skos:notation "DELAY_COMPENSATION" ;
    skos:prefLabel "DELAY_COMPENSATION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OverruleCode/DISRUPTION> a osdm:OverruleCode, skos:Concept ;
    skos:inScheme osdm:OverruleCode ;
    skos:notation "DISRUPTION" ;
    skos:prefLabel "DISRUPTION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OverruleCode/EQUIPMENT_FAILURE> a osdm:OverruleCode, skos:Concept ;
    skos:inScheme osdm:OverruleCode ;
