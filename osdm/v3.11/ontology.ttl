    rdfs:label "legIds" ;
    rdfs:comment "indices of the legs in the trip given by the provider of the offer"@en ;
    rdfs:domain osdm:ProductLegAssociation ;
    rdfs:range xsd:string ;
    skos:notation "legIds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductLegAssociation.productId> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "productId" ;
    rdfs:domain osdm:ProductLegAssociation ;
    rdfs:range xsd:string ;
    skos:notation "productId" .

osdm:ProductRequestOfferSelection a owl:Class ;
