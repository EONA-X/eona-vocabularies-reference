    rdfs:range osdm:StopPlaceRef ;
    skos:notation "stations" .

osdm:FareReferenceStationSetDef a owl:Class ;
    rdfs:label "FareReferenceStationSetDef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:comment "set of stations used in the fare equivalently. E.g. Brussels-Region). The set is identified by the fare provider and a code unique within the fare provider."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareReferenceStationSetDef.code> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareReferenceStationSetDef.fareProvider> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareReferenceStationSetDef.legacyCode> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareReferenceStationSetDef.stations> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareReferenceStationSetDef.code> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "code" ;
    rdfs:comment "code of the fare reference station set used in regional validity. Unique within the fare provider."@en ;
    rdfs:domain osdm:FareReferenceStationSetDef ;
    rdfs:range xsd:string ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareReferenceStationSetDef.fareProvider> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "fareProvider" ;
    rdfs:comment "ERA company code. In case proprietary codes are used on a bilateral base the  codes must have at least 5 positions and start with x"@en ;
    rdfs:domain osdm:FareReferenceStationSetDef ;
    rdfs:range osdm:CompanyDef ;
    skos:notation "fareProvider" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareReferenceStationSetDef.legacyCode> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "legacyCode" ;
    rdfs:comment "id used in B.1 as local station code"@en ;
    rdfs:domain osdm:FareReferenceStationSetDef ;
    rdfs:range xsd:integer ;
    skos:notation "legacyCode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareReferenceStationSetDef.name> a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "name to be used in route descriptions"@en ;
    rdfs:domain osdm:FareReferenceStationSetDef ;
    rdfs:range xsd:string ;
    skos:notation "name" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareReferenceStationSetDef.nameUtf8> a owl:DatatypeProperty ;
    rdfs:label "nameUtf8" ;
    rdfs:domain osdm:FareReferenceStationSetDef ;
    rdfs:range xsd:string ;
    skos:notation "nameUtf8" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareReferenceStationSetDef.stations> a owl:ObjectProperty ;
    rdfs:label "stations" ;
    rdfs:domain osdm:FareReferenceStationSetDef ;
    rdfs:range osdm:StationDef ;
    skos:notation "stations" .

osdm:FareResourceLocationDef a owl:Class ;
