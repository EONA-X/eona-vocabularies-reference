osdm:StopBehavior a owl:Class, skos:ConceptScheme ;
    rdfs:label "StopBehavior" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/trip.yml> ;
    rdfs:comment "Influences what stops are to be returned in response (ORIGIN_DESTINATION_ONLY returns no intermediate stops; REAL_BOARDING_ALIGHTING returns all stops except virtual stops). Default value: ORIGIN_DESTINATION_ONLY"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopBehavior/ORIGIN_DESTINATION_ONLY> a osdm:StopBehavior, skos:Concept ;
    skos:inScheme osdm:StopBehavior ;
    skos:notation "ORIGIN_DESTINATION_ONLY" ;
    skos:prefLabel "ORIGIN_DESTINATION_ONLY" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopBehavior/REAL_BOARDING_ALIGHTING> a osdm:StopBehavior, skos:Concept ;
    skos:inScheme osdm:StopBehavior ;
    skos:notation "REAL_BOARDING_ALIGHTING" ;
    skos:prefLabel "REAL_BOARDING_ALIGHTING" .

osdm:StopCallStatus a owl:Class ;
    rdfs:label "StopCallStatus" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/trip.yml> ;
    rdfs:comment "Status properties for the vehicle call at this stop. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopCallStatus.isBorderPoint> a owl:DatatypeProperty ;
    rdfs:label "isBorderPoint" ;
    rdfs:comment "Indicates whether the stop is recognized by the system as a border point between two or more countries."@en ;
    rdfs:domain osdm:StopCallStatus ;
    rdfs:range xsd:boolean ;
    skos:notation "isBorderPoint" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopCallStatus.noAlightingAtStop> a owl:DatatypeProperty ;
    rdfs:label "noAlightingAtStop" ;
    rdfs:comment "Alighting will not be allowed at this stop of this journey."@en ;
    rdfs:domain osdm:StopCallStatus ;
    rdfs:range xsd:boolean ;
    skos:notation "noAlightingAtStop" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopCallStatus.noBoardingAtStop> a owl:DatatypeProperty ;
    rdfs:label "noBoardingAtStop" ;
    rdfs:comment "Boarding will not be allowed at this stop of this journey."@en ;
    rdfs:domain osdm:StopCallStatus ;
    rdfs:range xsd:boolean ;
    skos:notation "noBoardingAtStop" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopCallStatus.notServicedStop> a owl:DatatypeProperty ;
    rdfs:label "notServicedStop" ;
    rdfs:comment "The vehicle will not call at this stop despite earlier planning."@en ;
    rdfs:domain osdm:StopCallStatus ;
    rdfs:range xsd:boolean ;
    skos:notation "notServicedStop" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopCallStatus.order> a owl:DatatypeProperty ;
    rdfs:label "order" ;
    rdfs:comment "Sequence number of this stop in the service pattern of the journey."@en ;
    rdfs:domain osdm:StopCallStatus ;
    rdfs:range xsd:int ;
    skos:notation "order" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopCallStatus.requestStop> a owl:DatatypeProperty ;
    rdfs:label "requestStop" ;
    rdfs:comment "The vehicle journey calls at this stop only on demand."@en ;
    rdfs:domain osdm:StopCallStatus ;
    rdfs:range xsd:boolean ;
    skos:notation "requestStop" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopCallStatus.unplannedStop> a owl:DatatypeProperty ;
    rdfs:label "unplannedStop" ;
    rdfs:comment "This stop has not been planned by the planning department."@en ;
    rdfs:domain osdm:StopCallStatus ;
    rdfs:range xsd:boolean ;
    skos:notation "unplannedStop" .

osdm:StopPlace a owl:Class ;
    rdfs:label "StopPlace" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/trip.yml> ;
    rdfs:comment "A place extended by accessibility limitation properties and some attributes of the associated equipment,\ncomprising one or more places where vehicles may stop and where passengers may board or leave vehicles\nor prepare their trip, and which will usually have one or more wellknown names. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopPlace.name> ], osdm:Place .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopPlace.name> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "name" ;
    rdfs:comment "Name of this stop place for use in passenger information."@en ;
    rdfs:domain osdm:StopPlace ;
    rdfs:range xsd:string ;
    skos:example "Zürich HB" ;
    skos:notation "name" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StopPlace.nameTranslations> a owl:ObjectProperty ;
    rdfs:label "nameTranslations" ;
    rdfs:comment "Translations for the name"@en ;
    rdfs:domain osdm:StopPlace ;
    rdfs:range osdm:Translation ;
    skos:notation "nameTranslations" .

osdm:StopPlaceRef a owl:Class ;
