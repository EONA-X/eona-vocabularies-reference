osdm:OnHoldOfferPatchRequest a owl:Class ;
    rdfs:label "OnHoldOfferPatchRequest" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/offer.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

osdm:OnHoldOfferRequest a owl:Class ;
    rdfs:label "OnHoldOfferRequest" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/offer.yml> ;
    rdfs:comment "Confirming the offer puts into the 'On-hold' state."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OnHoldOfferRequest.increaseTTL> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OnHoldOfferRequest.increaseTTL> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "increaseTTL" ;
