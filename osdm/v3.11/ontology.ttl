    skos:notation "TRAIN_HEAD" ;
    skos:prefLabel "TRAIN_HEAD" .

osdm:SpecificPlaceAvailability a owl:Class ;
    rdfs:label "SpecificPlaceAvailability" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/place.yml> ;
    rdfs:comment "Availability status of a specific place."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SpecificPlaceAvailability.number> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SpecificPlaceAvailability.reservationRefs> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SpecificPlaceAvailability.status> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SpecificPlaceAvailability.number> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "number" ;
    rdfs:comment "Place number as indicated at the place in the coach."@en ;
    rdfs:domain osdm:SpecificPlaceAvailability ;
    rdfs:range xsd:string ;
    skos:notation "number" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SpecificPlaceAvailability.reservationRefs> a owl:ObjectProperty ;
    rdfs:label "reservationRefs" ;
    rdfs:comment "References requested reservation fares/offerParts/bookingParts that allow the selection of the place.\nThis allows clients to link place availabilities with the corresponding reservation fare/offerPart/bookingPart. E.g. link a bicycle hook with a bicycle reservationOfferPart."@en ;
    rdfs:domain osdm:SpecificPlaceAvailability ;
    rdfs:range osdm:ReservationReference ;
    skos:notation "reservationRefs" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SpecificPlaceAvailability.selectionFee> a owl:ObjectProperty ;
    rdfs:label "selectionFee" ;
    rdfs:domain osdm:SpecificPlaceAvailability ;
    rdfs:range osdm:SelectionFee ;
    skos:notation "selectionFee" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SpecificPlaceAvailability.status> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:domain osdm:SpecificPlaceAvailability ;
    rdfs:range osdm:AvailabilityStatus ;
    skos:notation "status" .

osdm:StationCodeListDef a rdfs:Datatype ;
    rdfs:label "StationCodeListDef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:comment "Code list used for the station codes: UIC = UIC codes as used by merits (UIC country code + local code) = Default/ UIC-R = UIC codes for reservation (UIC country code + local code reservation) / ERA = future ERA station code"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:string ] .

osdm:StationDef a owl:Class ;
    rdfs:label "StationDef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:comment "Used to represent a station location. This is a location that can be used as origin and destination for a train journey"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StationDef.code> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StationDef.country> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StationDef.code> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "code" ;
    rdfs:comment "the code representing the station in the specified code-list"@en ;
    rdfs:domain osdm:StationDef ;
    rdfs:range xsd:string ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StationDef.codeList> a owl:DatatypeProperty ;
    rdfs:label "codeList" ;
    rdfs:domain osdm:StationDef ;
    rdfs:range osdm:StationCodeListDef ;
    skos:notation "codeList" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StationDef.country> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "country" ;
    rdfs:domain osdm:StationDef ;
    rdfs:range osdm:CountryDef ;
    skos:notation "country" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StationDef.geoCoordinate> a owl:ObjectProperty ;
    rdfs:label "geoCoordinate" ;
    rdfs:domain osdm:StationDef ;
    rdfs:range osdm:GeoCoordinate ;
    skos:notation "geoCoordinate" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#StationDef.name> a owl:ObjectProperty ;
    rdfs:label "name" ;
    rdfs:domain osdm:StationDef ;
    rdfs:range osdm:TextDef ;
    skos:notation "name" .

