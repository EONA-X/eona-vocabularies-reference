    rdfs:domain osdm:LineDef ;
    rdfs:range xsd:string ;
    skos:notation "binaryLineId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LineDef.carrier> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "carrier" ;
    rdfs:domain osdm:LineDef ;
    rdfs:range osdm:CompanyDef ;
    skos:notation "carrier" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LineDef.city> a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:domain osdm:LineDef ;
    rdfs:range xsd:int ;
    skos:notation "city" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LineDef.entryStation> a owl:ObjectProperty ;
    rdfs:label "entryStation" ;
    rdfs:domain osdm:LineDef ;
    rdfs:range osdm:StationDef ;
    skos:notation "entryStation" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LineDef.lineId> a owl:DatatypeProperty ;
    rdfs:label "lineId" ;
    rdfs:domain osdm:LineDef ;
    rdfs:range xsd:string ;
    skos:notation "lineId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LineDef.nutsCode> a owl:DatatypeProperty ;
    rdfs:label "nutsCode" ;
    rdfs:comment "Nomenclature des units territoriales statistiques  \n COMMISSION REGULATION (EU) No 31/2011"@en ;
    rdfs:domain osdm:LineDef ;
    rdfs:range xsd:string ;
    skos:notation "nutsCode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#LineDef.terminalStation> a owl:ObjectProperty ;
    rdfs:label "terminalStation" ;
    rdfs:domain osdm:LineDef ;
    rdfs:range osdm:StationDef ;
