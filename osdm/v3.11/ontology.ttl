    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "warning" .

osdm:TripCoverage a owl:Class ;
    rdfs:label "TripCoverage" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/trip.yml> ;
    rdfs:comment "The trip coverage defines which part of the trip is covered by the offer, offer part, booking or booking part, respectively.\n\nIf neither coveredLegIds nor coveredSections are defined, the complete trip is covered.\ncoveredLegIds and coveredSections are mutually exclusive, i.e. only one of the structures can be present.\n\nIf either coveredLegIds or coveredSections is defined, the sectionIndex field must be filled to indicate which part of the trip is covered\nby the respective OfferPart or BookingPart"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripCoverage.coveredTripId> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripCoverage.coveredLegIds> a owl:DatatypeProperty ;
    rdfs:label "coveredLegIds" ;
    rdfs:comment "Indicate which legs are covered by the specific offer. Not used for fares."@en ;
    rdfs:domain osdm:TripCoverage ;
    rdfs:range xsd:string ;
    skos:notation "coveredLegIds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripCoverage.coveredSections> a owl:ObjectProperty ;
    rdfs:label "coveredSections" ;
    rdfs:domain osdm:TripCoverage ;
    rdfs:range osdm:Section ;
    skos:notation "coveredSections" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripCoverage.coveredTripId> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "coveredTripId" ;
    rdfs:domain osdm:TripCoverage ;
    rdfs:range xsd:string ;
    skos:notation "coveredTripId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripCoverage.sectionIndex> a owl:DatatypeProperty ;
    rdfs:label "sectionIndex" ;
    rdfs:comment "Describes which part of the trip (in order) is covered by the OfferPart/BookingPart which contains this TripCoverage structure.\n\nThis needs to be filled if either coveredLegIds or coveredSections is present."@en ;
    rdfs:domain osdm:TripCoverage ;
    rdfs:range xsd:int ;
    skos:notation "sectionIndex" .

