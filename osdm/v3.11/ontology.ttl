    rdfs:range xsd:string ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#FareReferenceStation.name> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "name" ;
