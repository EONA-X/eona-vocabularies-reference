    rdfs:label "refundableAmount" ;
    rdfs:comment "Amount to be returned to the purchaser"@en ;
    rdfs:domain osdm:RefundOfferBreakdownItem ;
    rdfs:range osdm:Price ;
    skos:notation "refundableAmount" .

