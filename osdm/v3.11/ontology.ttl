osdm:ProductLegAssociation a owl:Class ;
    rdfs:label "ProductLegAssociation" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/offer.yml> ;
    rdfs:comment "In offer mode, in almost all cases exactly one product is referenced. Only on some French\ntrips consisting of a TGV and a TER two products need to be used.\nIn fare mode, no product exists as first needs to created from the different fares."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductLegAssociation.productId> ] .

