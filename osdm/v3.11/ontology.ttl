    rdfs:comment "id of the text describing the service level"@en ;
    rdfs:domain osdm:ServiceLevelDef ;
    rdfs:range xsd:string ;
    skos:notation "textRef" .

osdm:ServiceLevelIdDef a rdfs:Datatype ;
    rdfs:label "ServiceLevelIdDef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:comment "Code of the service level, code-list in IRS 90918-1."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:string ] .

osdm:ServiceStatus a owl:Class ;
    rdfs:label "ServiceStatus" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/_common.yml> ;
    rdfs:comment "Parameters which describe the current status of a dated vehicle journey.\nProvided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ServiceStatus.cancelled> a owl:DatatypeProperty ;
    rdfs:label "cancelled" ;
    rdfs:comment "Whether this trip is cancelled and will not be run."@en ;
    rdfs:domain osdm:ServiceStatus ;
    rdfs:range xsd:boolean ;
    skos:notation "cancelled" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ServiceStatus.deviation> a owl:DatatypeProperty ;
    rdfs:label "deviation" ;
    rdfs:comment "Whether this trip deviates from the planned service pattern."@en ;
    rdfs:domain osdm:ServiceStatus ;
    rdfs:range xsd:boolean ;
    skos:notation "deviation" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ServiceStatus.occupancy> a owl:DatatypeProperty ;
    rdfs:label "occupancy" ;
    rdfs:comment "Passenger load status on vehicle. If omitted, not known.\nEquivalent to siri:OccupancyEnumeration which describes three values:\n'full', 'seatingAvailable' and 'standingAvailable'."@en ;
    rdfs:domain osdm:ServiceStatus ;
    rdfs:range xsd:string ;
    skos:notation "occupancy" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ServiceStatus.unplanned> a owl:DatatypeProperty ;
    rdfs:label "unplanned" ;
    rdfs:comment "Whether this trip is an additional one that has not been planned."@en ;
    rdfs:domain osdm:ServiceStatus ;
    rdfs:range xsd:boolean ;
    skos:notation "unplanned" .

osdm:ServiceTime a owl:Class ;
    rdfs:label "ServiceTime" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "The time needs to be in Offset Time Format, i.e.  2023-12-03T10:15:30+01:00 as it is important the time zones are important  to show in the timetable.\n\nDo not use the Coordinated Universal Time (UTC) format, i.e. 2023-12-03T10:15:30Z."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ServiceTime.timetabledTime> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ServiceTime.estimatedTime> a owl:DatatypeProperty ;
    rdfs:label "estimatedTime" ;
    rdfs:domain osdm:ServiceTime ;
    rdfs:range xsd:dateTime ;
    skos:notation "estimatedTime" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ServiceTime.observedTime> a owl:DatatypeProperty ;
    rdfs:label "observedTime" ;
    rdfs:domain osdm:ServiceTime ;
    rdfs:range xsd:dateTime ;
    skos:notation "observedTime" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ServiceTime.timetabledTime> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "timetabledTime" ;
    rdfs:domain osdm:ServiceTime ;
    rdfs:range xsd:dateTime ;
    skos:notation "timetabledTime" .

