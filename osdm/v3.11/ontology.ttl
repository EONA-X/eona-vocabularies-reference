    skos:notation "ORIGIN" ;
    skos:prefLabel "ORIGIN" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlaceUsage/VIA> a osdm:PlaceUsage, skos:Concept ;
    skos:inScheme osdm:PlaceUsage ;
    skos:notation "VIA" ;
    skos:prefLabel "VIA" .

osdm:PointOfInterest a owl:Class ;
    rdfs:label "PointOfInterest" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/place.yml> ;
    rdfs:comment "A type of place to or through which passengers may wish to navigate as part of\ntheir journey and which is modelled in detail by journey planners. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PointOfInterest.code> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PointOfInterest.name> ], osdm:Place .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PointOfInterest.code> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "code" ;
    rdfs:comment "id of the Point of Interest."@en ;
    rdfs:domain osdm:PointOfInterest ;
    rdfs:range xsd:string ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PointOfInterest.name> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "name" ;
    rdfs:comment "Name or description of point of interest for use in passenger information."@en ;
    rdfs:domain osdm:PointOfInterest ;
    rdfs:range xsd:string ;
    skos:example "Park Rozenrust" ;
    skos:notation "name" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PointOfInterest.nameTranslations> a owl:ObjectProperty ;
    rdfs:label "nameTranslations" ;
    rdfs:comment "Translations for the name"@en ;
    rdfs:domain osdm:PointOfInterest ;
    rdfs:range osdm:Translation ;
    skos:notation "nameTranslations" .

osdm:PointOfInterestCategory a owl:Class ;
    rdfs:label "PointOfInterestCategory" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/place.yml> ;
    rdfs:comment "A categorization of points of interest in respect of the activities undertaken at them (defined by key-value-pairs). Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PointOfInterestCategory.osmTags> a owl:ObjectProperty ;
    rdfs:label "osmTags" ;
    rdfs:comment "Open Street Map tag structure (key-value)"@en ;
    rdfs:domain osdm:PointOfInterestCategory ;
    rdfs:range osdm:OsmTag ;
    skos:notation "osmTags" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PointOfInterestCategory.pointOfInterestClassifications> a owl:DatatypeProperty ;
    rdfs:label "pointOfInterestClassifications" ;
    rdfs:comment "Classification of the POI (when it is not from OSM). The codification of the\nclassification Id may include de codification source (for example\n'IGN:[classificationCode]')"@en ;
    rdfs:domain osdm:PointOfInterestCategory ;
    rdfs:range xsd:string ;
    skos:notation "pointOfInterestClassifications" .

osdm:PointOfInterestFilter a owl:Class ;
    rdfs:label "PointOfInterestFilter" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/place.yml> ;
    rdfs:comment "Filter POIs by category. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PointOfInterestFilter.exclude> a owl:DatatypeProperty ;
    rdfs:label "exclude" ;
    rdfs:comment "Whether carriers are to be included or excluded from the filtering."@en ;
    rdfs:domain osdm:PointOfInterestFilter ;
    rdfs:range xsd:boolean ;
    skos:notation "exclude" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PointOfInterestFilter.pointOfInterestCategory> a owl:ObjectProperty ;
    rdfs:label "pointOfInterestCategory" ;
    rdfs:comment "These POI categories can be used to filter POIs. If more than one is given the filtering\nis by logical 'OR' (when Exclude=FALSE) and logical 'AND' (when Exclude=TRUE)."@en ;
    rdfs:domain osdm:PointOfInterestFilter ;
    rdfs:range osdm:PointOfInterestCategory ;
    skos:notation "pointOfInterestCategory" .

osdm:PointOfInterestRef a owl:Class ;
    rdfs:label "PointOfInterestRef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/place.yml> ;
    rdfs:comment "Reference to a Point of Interest. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PointOfInterestRef.pointOfInterestRef> ], osdm:PlaceRef .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PointOfInterestRef.pointOfInterestRef> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "pointOfInterestRef" ;
    rdfs:domain osdm:PointOfInterestRef ;
    rdfs:range xsd:string ;
    skos:notation "pointOfInterestRef" .

osdm:Polygon a owl:Class ;
    rdfs:label "Polygon" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Polygon.edges> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Polygon.edges> a owl:ObjectProperty ;
    rdfs:label "edges" ;
    rdfs:domain osdm:Polygon ;
    rdfs:range osdm:GeoPosition ;
    skos:notation "edges" .

osdm:PolygonDef a owl:Class ;
    rdfs:label "PolygonDef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PolygonDef.edge> a owl:ObjectProperty ;
    rdfs:label "edge" ;
    rdfs:domain osdm:PolygonDef ;
    rdfs:range osdm:GeoCoordinate ;
    skos:notation "edge" .

osdm:PostalAddress a owl:Class ;
    rdfs:label "PostalAddress" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PostalAddress.city> a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:comment "City name"@en ;
    rdfs:domain osdm:PostalAddress ;
    rdfs:range xsd:string ;
    skos:example "Leidschendam" ;
    skos:notation "city" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PostalAddress.countryCode> a owl:DatatypeProperty ;
    rdfs:label "countryCode" ;
    rdfs:domain osdm:PostalAddress ;
    rdfs:range osdm:CountryCode ;
    skos:notation "countryCode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PostalAddress.countryName> a owl:DatatypeProperty ;
    rdfs:label "countryName" ;
    rdfs:comment "Country of the address."@en ;
    rdfs:domain osdm:PostalAddress ;
    rdfs:range xsd:string ;
    skos:example "The Netherlands" ;
    skos:notation "countryName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PostalAddress.houseNumber> a owl:DatatypeProperty ;
    rdfs:label "houseNumber" ;
    rdfs:comment "House number of the address. House number can either be in this separate field, or can be\ncontained in the street field."@en ;
    rdfs:domain osdm:PostalAddress ;
    rdfs:range xsd:string ;
    skos:example "7" ;
    skos:notation "houseNumber" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PostalAddress.postCode> a owl:DatatypeProperty ;
    rdfs:label "postCode" ;
    rdfs:comment "Postal code of the address."@en ;
    rdfs:domain osdm:PostalAddress ;
    rdfs:range xsd:string ;
    skos:example "2265CA" ;
    skos:notation "postCode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PostalAddress.street> a owl:DatatypeProperty ;
    rdfs:label "street" ;
    rdfs:comment "Street name of the address. Can also contain the house number."@en ;
    rdfs:domain osdm:PostalAddress ;
    rdfs:range xsd:string ;
    skos:example "Oude Trambaan" ;
    skos:notation "street" .

osdm:Price a owl:Class ;
    rdfs:label "Price" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Price.amount> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Price.currency> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Price.amount> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "amount" ;
    rdfs:comment "amount in cents"@en ;
    rdfs:domain osdm:Price ;
    rdfs:range xsd:int ;
    skos:notation "amount" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Price.appliedCurrencyConversion> a owl:ObjectProperty ;
    rdfs:label "appliedCurrencyConversion" ;
    rdfs:domain osdm:Price ;
    rdfs:range osdm:CurrencyConversion ;
    skos:notation "appliedCurrencyConversion" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Price.currency> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "currency" ;
    rdfs:domain osdm:Price ;
    rdfs:range osdm:Currency ;
    skos:notation "currency" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Price.scale> a owl:DatatypeProperty ;
    rdfs:label "scale" ;
    rdfs:comment "scale of the amount - the number of positions after the comma"@en ;
    rdfs:domain osdm:Price ;
    rdfs:range xsd:int ;
    skos:notation "scale" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Price.vats> a owl:ObjectProperty ;
    rdfs:label "vats" ;
    rdfs:domain osdm:Price ;
    rdfs:range osdm:VAT ;
    skos:notation "vats" .

osdm:PriceDef a owl:Class ;
    rdfs:label "PriceDef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PriceDef.price> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PriceDef.id> a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:comment "required for bulk data transfer"@en ;
    rdfs:domain osdm:PriceDef ;
    rdfs:range xsd:string ;
    skos:notation "id" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PriceDef.price> a owl:ObjectProperty ;
    rdfs:label "price" ;
    rdfs:domain osdm:PriceDef ;
    rdfs:range osdm:CurrencyPriceDef ;
    skos:notation "price" .

osdm:Problem a owl:Class ;
    rdfs:label "Problem" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Problem Details for HTTP APIs (RFC 9457) defines a 'problem detail' as a way\nto carry machine-readable details of errors in a HTTP response to avoid\nthe need to define new error response formats for HTTP APIs.\nSee: https://tools.ietf.org/html/rfc9457"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Problem.alternativeSystemProposals> a owl:ObjectProperty ;
    rdfs:label "alternativeSystemProposals" ;
    rdfs:domain osdm:Problem ;
    rdfs:range osdm:AlternativeSystemProposal ;
    skos:notation "alternativeSystemProposals" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Problem.code> a owl:DatatypeProperty ;
    rdfs:label "code" ;
    rdfs:comment "optional in version 3.1, will be made mandatory in upcoming releases"@en ;
    rdfs:domain osdm:Problem ;
    rdfs:range xsd:string ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Problem.detail> a owl:DatatypeProperty ;
    rdfs:label "detail" ;
    rdfs:comment "A human readable explanation specific to this occurrence\nof the problem."@en ;
    rdfs:domain osdm:Problem ;
    rdfs:range xsd:string ;
    skos:example "Connection to database timed out" ;
    skos:notation "detail" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Problem.instance> a owl:DatatypeProperty ;
    rdfs:label "instance" ;
    rdfs:comment "An absolute URI that identifies the specific occurrence of the problem."@en ;
    rdfs:domain osdm:Problem ;
    rdfs:range xsd:anyURI ;
    skos:notation "instance" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Problem.pointers> a owl:ObjectProperty ;
    rdfs:label "pointers" ;
    rdfs:domain osdm:Problem ;
    rdfs:range osdm:ProblemPointer ;
    skos:notation "pointers" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Problem.status> a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:comment "The HTTP status code generated by the origin server for this occurrence\nof the problem."@en ;
    rdfs:domain osdm:Problem ;
    rdfs:range xsd:int ;
    skos:example "503" ;
    skos:notation "status" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Problem.title> a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:comment "A short, summary of the problem type. Written in English and readable\nfor engineers (usually not suited for non technical stakeholders and\nnot localized);"@en ;
    rdfs:domain osdm:Problem ;
    rdfs:range xsd:string ;
    skos:example "Service Unavailable" ;
    skos:notation "title" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Problem.type> a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:comment "An absolute URI that identifies the problem type. When dereferenced,\nit SHOULD provide human-readable documentation for the problem type\n(e.g., using HTML)."@en ;
    rdfs:domain osdm:Problem ;
    rdfs:range xsd:anyURI ;
    skos:example "https://example.com/probs/passenger-too-young" ;
    skos:notation "type" .

osdm:ProblemPointer a owl:Class ;
    rdfs:label "ProblemPointer" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Problem Details for HTTP APIs (RFC 9457) defines a 'problem detail' as a way\nto carry machine-readable details of errors in a HTTP response to avoid\nthe need to define new error response formats for HTTP APIs.\nSee: https://tools.ietf.org/html/rfc9457"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProblemPointer.code> a owl:DatatypeProperty ;
    rdfs:label "code" ;
    rdfs:comment "optional in version 3.1, will be made mandatory in upcoming releases"@en ;
    rdfs:domain osdm:ProblemPointer ;
    rdfs:range xsd:string ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProblemPointer.detail> a owl:DatatypeProperty ;
    rdfs:label "detail" ;
    rdfs:comment "A human readable explanation specific to this occurrence\nof the problem."@en ;
    rdfs:domain osdm:ProblemPointer ;
    rdfs:range xsd:string ;
    skos:example "Connection to database timed out" ;
    skos:notation "detail" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProblemPointer.instance> a owl:DatatypeProperty ;
    rdfs:label "instance" ;
    rdfs:comment "An absolute URI that identifies the specific occurrence of the problem."@en ;
    rdfs:domain osdm:ProblemPointer ;
    rdfs:range xsd:anyURI ;
    skos:notation "instance" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProblemPointer.originator> a owl:DatatypeProperty ;
    rdfs:label "originator" ;
    rdfs:comment "Identifier to the origin server for this occurrence of the problem."@en ;
    rdfs:domain osdm:ProblemPointer ;
    rdfs:range xsd:string ;
    skos:example "IMS1" ;
    skos:notation "originator" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProblemPointer.requestPointer> a owl:DatatypeProperty ;
    rdfs:label "requestPointer" ;
    rdfs:comment "A pointer to the attribute in the request for the problem."@en ;
    rdfs:domain osdm:ProblemPointer ;
    rdfs:range xsd:string ;
    skos:example "#/offers[1]/placeSelections[1]/reservationId" ;
    skos:notation "requestPointer" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProblemPointer.responsePointer> a owl:DatatypeProperty ;
    rdfs:label "responsePointer" ;
    rdfs:comment "A pointer to the attribute in the response for the problem."@en ;
    rdfs:domain osdm:ProblemPointer ;
    rdfs:range xsd:string ;
    skos:example "#/booking/bookedOffers[4]/reservations[1]/id" ;
    skos:notation "responsePointer" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProblemPointer.status> a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:comment "The HTTP status code generated by the origin server for this occurrence\nof the problem."@en ;
    rdfs:domain osdm:ProblemPointer ;
    rdfs:range xsd:int ;
    skos:example "503" ;
    skos:notation "status" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProblemPointer.title> a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:comment "A short, summary of the problem type. Written in English and readable\nfor engineers (usually not suited for non technical stakeholders and\nnot localized);"@en ;
    rdfs:domain osdm:ProblemPointer ;
    rdfs:range xsd:string ;
    skos:example "Service Unavailable" ;
    skos:notation "title" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProblemPointer.type> a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:comment "An absolute URI that identifies the problem type. When dereferenced,\nit SHOULD provide human-readable documentation for the problem type\n(e.g., using HTML)."@en ;
    rdfs:domain osdm:ProblemPointer ;
    rdfs:range xsd:anyURI ;
    skos:example "https://example.com/probs/passenger-too-young" ;
    skos:notation "type" .

osdm:Product a owl:Class ;
    rdfs:label "Product" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/product.yml> ;
    rdfs:comment "Structured description of the product, its name, comfort and sales / after-sales conditions"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Product.code> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Product.flexibility> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Product.id> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Product.owner> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Product._links> a owl:ObjectProperty ;
    rdfs:label "_links" ;
    rdfs:domain osdm:Product ;
    rdfs:range osdm:LinksItem ;
    skos:notation "_links" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Product.carrierConstraintText> a owl:DatatypeProperty ;
    rdfs:label "carrierConstraintText" ;
    rdfs:domain osdm:Product ;
    rdfs:range xsd:string ;
    skos:notation "carrierConstraintText" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Product.carrierConstraintTextTranslations> a owl:ObjectProperty ;
    rdfs:label "carrierConstraintTextTranslations" ;
    rdfs:comment "Translations of the carrier constraint text attribute"@en ;
    rdfs:domain osdm:Product ;
    rdfs:range osdm:Translation ;
    skos:notation "carrierConstraintTextTranslations" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Product.code> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "code" ;
    rdfs:comment "The product code expressed in the provider system (could be a\nmapping from an even lower-level provider)."@en ;
    rdfs:domain osdm:Product ;
    rdfs:range xsd:string ;
    skos:example "PT00AD" ;
    skos:notation "code" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Product.combinationTags> a owl:ObjectProperty ;
    rdfs:label "combinationTags" ;
    rdfs:domain osdm:Product ;
    rdfs:range osdm:CombinationTag ;
    skos:notation "combinationTags" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Product.conditions> a owl:ObjectProperty ;
    rdfs:label "conditions" ;
    rdfs:comment "Structured description of the sales or after-sales conditions."@en ;
    rdfs:domain osdm:Product ;
    rdfs:range osdm:Condition ;
    skos:notation "conditions" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Product.description> a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:comment "Textual description of the product."@en ;
    rdfs:domain osdm:Product ;
    rdfs:range xsd:string ;
