    skos:notation "validFrom" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AfterSalesOverrideDetails.validUntil> a owl:DatatypeProperty ;
    rdfs:label "validUntil" ;
    rdfs:domain osdm:AfterSalesOverrideDetails ;
    rdfs:range xsd:dateTime ;
    skos:notation "validUntil" .

osdm:AfterSalesRuleDef a owl:Class ;
    rdfs:label "AfterSalesRuleDef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AfterSalesRuleDef.transactionType> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AfterSalesRuleDef.applicationTime> a owl:ObjectProperty ;
    rdfs:label "applicationTime" ;
    rdfs:domain osdm:AfterSalesRuleDef ;
    rdfs:range osdm:RelativeTimeDef ;
    skos:notation "applicationTime" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AfterSalesRuleDef.feeRef> a owl:DatatypeProperty ;
    rdfs:label "feeRef" ;
    rdfs:comment "Reference to a price data item defining the fee; optional in case there is no fee but the  after sales transaction is allowed. Online services include fee directly in the fee tag."@en ;
    rdfs:domain osdm:AfterSalesRuleDef ;
    rdfs:range xsd:string ;
    skos:notation "feeRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AfterSalesRuleDef.individualContracts> a owl:DatatypeProperty ;
    rdfs:label "individualContracts" ;
    rdfs:comment "indicates that the after sales of this fare can be treated independently per person."@en ;
    rdfs:domain osdm:AfterSalesRuleDef ;
    rdfs:range xsd:boolean ;
    skos:notation "individualContracts" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AfterSalesRuleDef.isCarrierFee> a owl:DatatypeProperty ;
    rdfs:label "isCarrierFee" ;
    rdfs:comment "indicates that the fee belongs to the allocator"@en ;
    rdfs:domain osdm:AfterSalesRuleDef ;
    rdfs:range xsd:boolean ;
    skos:notation "isCarrierFee" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AfterSalesRuleDef.transactionType> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "transactionType" ;
    rdfs:comment "code list Reason for after sale"@en ;
    rdfs:domain osdm:AfterSalesRuleDef ;
    rdfs:range xsd:string ;
    skos:notation "transactionType" .

osdm:Alight a owl:Class ;
    rdfs:label "Alight" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/ojp/trip.yml> ;
    rdfs:comment "Describes the situation at a stop or station at which the passenger alights from a Leg\nof a trip including time-related information. Provided by OJP."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Alight.serviceArrival> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Alight.stopPlaceName> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Alight.stopPlaceRef> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Alight.estimatedStopPointName> a owl:DatatypeProperty ;
    rdfs:label "estimatedStopPointName" ;
    rdfs:comment "Name of the bay/quay/terminal where to board the vehicle. As to the latest realtime status."@en ;
    rdfs:domain osdm:Alight ;
    rdfs:range xsd:string ;
    skos:example "8" ;
    skos:notation "estimatedStopPointName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Alight.plannedStopPointName> a owl:DatatypeProperty ;
    rdfs:label "plannedStopPointName" ;
    rdfs:comment "Name of the bay/quay/terminal where to board/alight from the vehicle. According to\nplanned timetable."@en ;
    rdfs:domain osdm:Alight ;
    rdfs:range xsd:string ;
    skos:example "3" ;
    skos:notation "plannedStopPointName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Alight.serviceArrival> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "serviceArrival" ;
    rdfs:domain osdm:Alight ;
    rdfs:range osdm:ServiceTime ;
    skos:notation "serviceArrival" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Alight.status> a owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:domain osdm:Alight ;
    rdfs:range osdm:StopCallStatus ;
    skos:notation "status" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Alight.stopPlaceName> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "stopPlaceName" ;
    rdfs:domain osdm:Alight ;
    rdfs:range xsd:string ;
    skos:example "Luzern" ;
    skos:notation "stopPlaceName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Alight.stopPlaceRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "stopPlaceRef" ;
    rdfs:domain osdm:Alight ;
    rdfs:range osdm:StopPlaceRef ;
    skos:notation "stopPlaceRef" .

osdm:AlightSpecification a owl:Class ;
    rdfs:label "AlightSpecification" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/trip.yml> ;
    rdfs:comment "Minimal alight specification"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlightSpecification.serviceArrival> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlightSpecification.stopPlaceRef> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlightSpecification.replacedPlaceRef> a owl:ObjectProperty ;
    rdfs:label "replacedPlaceRef" ;
    rdfs:comment "reference to the original place in case of a replacement (e.g. bus stop of a replacement bus for a train)"@en ;
    rdfs:domain osdm:AlightSpecification ;
    rdfs:range osdm:StopPlaceRef ;
    skos:notation "replacedPlaceRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlightSpecification.serviceArrival> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "serviceArrival" ;
    rdfs:domain osdm:AlightSpecification ;
    rdfs:range osdm:ServiceTime ;
    skos:notation "serviceArrival" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlightSpecification.status> a owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:domain osdm:AlightSpecification ;
    rdfs:range osdm:StopCallStatus ;
    skos:notation "status" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlightSpecification.stopPlaceRef> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "stopPlaceRef" ;
    rdfs:domain osdm:AlightSpecification ;
    rdfs:range osdm:StopPlaceRef ;
    skos:notation "stopPlaceRef" .

osdm:AlternativeSystemProposal a owl:Class ;
    rdfs:label "AlternativeSystemProposal" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "This type can only be used in offer responses inside OfferCollectionResponse when the problem has the following values:\n* Type is https://osdm.io/errors/alternative_system_proposal\n* Code is urn:uic:problem:ALTERNATIVE_SYSTEM_PROPOSAL\n* Status (HTTP) is 200\nThe OSDM Offer API returns an alternative system proposal when the current system cannot provide an\noffer for the requested trip, but identifies one or more other OSDM/90918.1-capable systems that might be able\nto fulfill the request.\nThe proposal should be returned as part of the problems section in the OfferCollectionResponse.\nIf only some of the legs or products are affected, for example in a multi-leg trip:\n* The available offers should be returned to the caller\n* One or more AlternativeSystemProposals should be returned as part of\n  OfferCollectionResponse's problems structure\n* The problem pointer structure should be filled to identify the affected Leg(s) or OfferPart(s).\n  * It must contain a problem pointer for the affected trip legs, which should be priced or booked\n    in other systems. The problem pointer's responsePointer field should contain a link to the\n    affected leg inside the given trip (e.g. #/trips[1]/legs[1]/id).\n  * The scope structure may be filled with the leg's vehicle (train) number.\n  * If a partial offer is returned for a leg, then it might contain a response problem pointer pointing\n    to the affected offer parts. For example, if the system can provide an admission offer for the whole trip,\n    but the reservation offer part is missing for one leg, then the following responsePointer could be returned:\n    #/offers[1]/reservationOfferParts"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlternativeSystemProposal.systemOperatorCode> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlternativeSystemProposal.priority> a owl:DatatypeProperty ;
    rdfs:label "priority" ;
    rdfs:comment "If multiple alternative system proposals are returned, the provider might define a\npriority order between them. The requestor should first use the proposal with the\nlowest priority that matches the requestor's case based on the proposal's scope\nand problem pointer."@en ;
    rdfs:domain osdm:AlternativeSystemProposal ;
    rdfs:range xsd:integer ;
    skos:example "1" ;
    skos:notation "priority" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlternativeSystemProposal.reservationSystemId> a owl:DatatypeProperty ;
    rdfs:label "reservationSystemId" ;
    rdfs:comment "The 90918.1 code of the alternative reservation system."@en ;
    rdfs:domain osdm:AlternativeSystemProposal ;
    rdfs:range xsd:integer ;
    skos:example "80" ;
    skos:notation "reservationSystemId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlternativeSystemProposal.scope> a owl:ObjectProperty ;
    rdfs:label "scope" ;
    rdfs:domain osdm:AlternativeSystemProposal ;
    rdfs:range osdm:AlternativeSystemProposalScope ;
    skos:notation "scope" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlternativeSystemProposal.systemOperatorCode> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "systemOperatorCode" ;
    rdfs:comment "The company code (e.g. RICS code) of the alternative reservation system's operator."@en ;
    rdfs:domain osdm:AlternativeSystemProposal ;
    rdfs:range osdm:CompanyRef ;
    skos:example "urn:uic:rics:1185" ;
    skos:notation "systemOperatorCode" .

osdm:AlternativeSystemProposalScope a owl:Class ;
    rdfs:label "AlternativeSystemProposalScope" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Defines a scope for an alternative system proposal. This object specifies the routing\nlogic for:\n * Trips or trains hosted across multiple OSDM/UIC 918.1 reservation systems, identifying which\n   system to connect to for specific travel classes or accommodation (sub)types.\n   For example, the problem returned for a RailJet might contain two proposals: one for business class\n   pointing to ÖBB, and another pointing to MAV for first and second class (using two scopes).\n   In a more complex case, it might contain three AlternativeSystemProposals:\n      * One with business class scope pointing to ÖBB\n      * Another with first and second class scope and priority \"1\", also pointing to ÖBB\n      * A third with first and second class scope and priority \"2\", pointing to MAV, indicating\n        that the requestor should first ask ÖBB, but if an ÖBB offer is not available, for example\n        because it has run out of spaces, MAV may also be used.\n * Offers for trips containing multiple legs. In this case, the vehicleNumber also helps the\n   requestor identify which system to connect to for each leg or journey."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlternativeSystemProposalScope.vehicleNumber> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlternativeSystemProposalScope.accommodationSubType> a owl:ObjectProperty ;
    rdfs:label "accommodationSubType" ;
    rdfs:domain osdm:AlternativeSystemProposalScope ;
    rdfs:range osdm:AccommodationSubType ;
    skos:notation "accommodationSubType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlternativeSystemProposalScope.accommodationType> a owl:ObjectProperty ;
    rdfs:label "accommodationType" ;
    rdfs:domain osdm:AlternativeSystemProposalScope ;
    rdfs:range osdm:AccommodationType ;
    skos:notation "accommodationType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlternativeSystemProposalScope.travelClass> a owl:ObjectProperty ;
    rdfs:label "travelClass" ;
    rdfs:domain osdm:AlternativeSystemProposalScope ;
    rdfs:range osdm:TravelClass ;
    skos:notation "travelClass" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AlternativeSystemProposalScope.vehicleNumber> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "vehicleNumber" ;
    rdfs:comment "Vehicle number, such as the train number, for which the alternative system proposal is valid."@en ;
    rdfs:domain osdm:AlternativeSystemProposalScope ;
    rdfs:range xsd:string ;
    skos:example "462" ;
    skos:notation "vehicleNumber" .

