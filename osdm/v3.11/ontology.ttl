    rdfs:range osdm:SelectionFee ;
    skos:notation "selectionFee" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlacePosition.status> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:domain osdm:PlacePosition ;
    rdfs:range osdm:AvailabilityStatus ;
    skos:notation "status" .

osdm:PlacePreSelection a owl:Class ;
