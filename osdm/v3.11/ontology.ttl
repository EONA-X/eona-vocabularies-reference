<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlacePosition.placeProperties> a owl:DatatypeProperty ;
    rdfs:label "placeProperties" ;
    rdfs:domain osdm:PlacePosition ;
    rdfs:range osdm:PlaceProperty ;
    skos:notation "placeProperties" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlacePosition.reservationRefs> a owl:DatatypeProperty ;
    rdfs:label "reservationRefs" ;
    rdfs:comment "references to the reservations for which this place can be selected. The reservation ids must be part of the list of reservation ids for which the consumer has requested the available places and the consumer must accept a list by setting singleSelectionMapsRequired to false"@en ;
    rdfs:domain osdm:PlacePosition ;
    rdfs:range xsd:string ;
    skos:notation "reservationRefs" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PlacePosition.selectionFee> a owl:ObjectProperty ;
    rdfs:label "selectionFee" ;
