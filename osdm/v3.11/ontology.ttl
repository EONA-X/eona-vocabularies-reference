    skos:notation "AUTO_START_USAGE" ;
    skos:prefLabel "AUTO_START_USAGE" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ContinuousServiceProcessIndication/BLOCKING_TRACKING> a osdm:ContinuousServiceProcessIndication, skos:Concept ;
    skos:definition "updates provided before pick-up (e.g. current location of a taxi)"@en ;
