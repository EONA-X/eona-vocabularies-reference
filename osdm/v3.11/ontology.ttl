    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#IdentificationCard.id> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#IdentificationCard.type> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#IdentificationCard.birthCity> a owl:DatatypeProperty ;
