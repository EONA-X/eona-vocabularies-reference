osdm:ZoneDefinition a owl:Class ;
    rdfs:label "ZoneDefinition" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/fare.yml> ;
    rdfs:comment "Definition of a zone used to define regional validity. The area of the zone can be defined via a\ngeo-polygon, a complete list of all contained stations or area codes from the NUTS code list.\nThe carrier is either the carrier or transport authority responsible for the definition."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ZoneDefinition.carrier> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ZoneDefinition.id> ] .

