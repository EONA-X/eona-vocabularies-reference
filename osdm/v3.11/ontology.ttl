<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SpecialCoachType/BICYCLE_COACH> a osdm:SpecialCoachType, skos:Concept ;
    skos:inScheme osdm:SpecialCoachType ;
    skos:notation "BICYCLE_COACH" ;
    skos:prefLabel "BICYCLE_COACH" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#SpecialCoachType/LUGGAGE_COACH> a osdm:SpecialCoachType, skos:Concept ;
