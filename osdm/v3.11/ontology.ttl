    rdfs:range xsd:base64Binary ;
    skos:notation "binaryZoneId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Zone.carrier> a owl:DatatypeProperty ;
    rdfs:label "carrier" ;
