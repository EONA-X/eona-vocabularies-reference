osdm:TripAllocationConstraint a owl:Class ;
    rdfs:label "TripAllocationConstraint" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/trip.yml> ;
    rdfs:comment "constraint on the use of a multiple trip ticket"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationConstraint.allocationUnit> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationConstraint.requiredProcesses> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationConstraint.allocationUnit> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "allocationUnit" ;
    rdfs:domain osdm:TripAllocationConstraint ;
    rdfs:range osdm:TripAllocationUnit ;
    skos:notation "allocationUnit" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationConstraint.durationUnit> a owl:DatatypeProperty ;
    rdfs:label "durationUnit" ;
    rdfs:comment "multiples of this duration can be allocated"@en ;
    rdfs:domain osdm:TripAllocationConstraint ;
    rdfs:range xsd:duration ;
    skos:example "PT30M" ;
    skos:notation "durationUnit" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationConstraint.maxUnits> a owl:DatatypeProperty ;
    rdfs:label "maxUnits" ;
    rdfs:comment "maximum number of allowed units to be allocated"@en ;
    rdfs:domain osdm:TripAllocationConstraint ;
    rdfs:range xsd:int ;
    skos:notation "maxUnits" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationConstraint.requiredProcesses> a owl:ObjectProperty ;
    rdfs:label "requiredProcesses" ;
    rdfs:comment "one of the listed processes is required for the allocation of a single trip"@en ;
    rdfs:domain osdm:TripAllocationConstraint ;
    rdfs:range osdm:TripAllocationProcess ;
    skos:notation "requiredProcesses" .

osdm:TripAllocationConstraintDef a owl:Class ;
    rdfs:label "TripAllocationConstraintDef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:comment "constraint on the use of a multiple trip ticket"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationConstraintDef.allocationUnit> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationConstraintDef.requiredProcesses> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationConstraintDef.allocationUnit> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "allocationUnit" ;
    rdfs:domain osdm:TripAllocationConstraintDef ;
    rdfs:range osdm:TripAllocationUnit ;
    skos:notation "allocationUnit" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationConstraintDef.durationUnit> a owl:DatatypeProperty ;
    rdfs:label "durationUnit" ;
    rdfs:comment "multiples of this duration can be allocated"@en ;
    rdfs:domain osdm:TripAllocationConstraintDef ;
    rdfs:range xsd:duration ;
    skos:notation "durationUnit" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationConstraintDef.maxUnits> a owl:DatatypeProperty ;
    rdfs:label "maxUnits" ;
    rdfs:comment "maximum number of allowed units to be allocated"@en ;
    rdfs:domain osdm:TripAllocationConstraintDef ;
    rdfs:range xsd:int ;
    skos:notation "maxUnits" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationConstraintDef.requiredProcesses> a owl:ObjectProperty ;
    rdfs:label "requiredProcesses" ;
    rdfs:comment "one of the listed processes is required for the allocation of a single trip."@en ;
    rdfs:domain osdm:TripAllocationConstraintDef ;
    rdfs:range osdm:TripAllocationProcess ;
    skos:notation "requiredProcesses" .

osdm:TripAllocationProcess a owl:Class, skos:ConceptScheme ;
    rdfs:label "TripAllocationProcess" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json>, <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/trip.yml> ;
    rdfs:comment "NONE: Individual trips don't need to be allocated. MANUAL: The passenger has to allocate a trip manually (This should not be used as it is by desiugn non-interoperable). ACTIVATION: Individual trips can be allocatted by activation of the ticket. FULFILLMENT A new fulfillment needs to be created to allocate a trip"@en, "Values from the [Trip Allocation Process Code List](https://osdm.io/spec/catalog-of-code-lists/#TripAllocationProcess)\nKnown Values:\n- NONE: Individual trips don't need to be allocated.\n- MANUAL: The passenger has to allocate a trip manually (This should not be used as it is by design non-interoperable).\n- ACTIVATION: Individual trips can be allocated by activation of the ticket.\n- FULFILLMENT: A new fulfillment needs to be created to allocate a trip."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationProcess/ACTIVATION> a osdm:TripAllocationProcess, skos:Concept ;
    skos:inScheme osdm:TripAllocationProcess ;
    skos:notation "ACTIVATION" ;
    skos:prefLabel "ACTIVATION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationProcess/FULFILLMENT> a osdm:TripAllocationProcess, skos:Concept ;
    skos:inScheme osdm:TripAllocationProcess ;
    skos:notation "FULFILLMENT" ;
    skos:prefLabel "FULFILLMENT" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationProcess/MANUAL> a osdm:TripAllocationProcess, skos:Concept ;
    skos:inScheme osdm:TripAllocationProcess ;
    skos:notation "MANUAL" ;
    skos:prefLabel "MANUAL" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationProcess/NONE> a osdm:TripAllocationProcess, skos:Concept ;
    skos:inScheme osdm:TripAllocationProcess ;
    skos:notation "NONE" ;
    skos:prefLabel "NONE" .

osdm:TripAllocationUnit a owl:Class, skos:ConceptScheme ;
    rdfs:label "TripAllocationUnit" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json>, <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/trip.yml> ;
    rdfs:comment "NONE: Individual trips don't need to be allocated. TRIP: allocation per individual trip. DAY: The allocation is per travel day DURATION: the allocation is per duration"@en, "Values from the [Trip Allocation Unit Code List](https://osdm.io/spec/catalog-of-code-lists/#TripAllocationUnit)\nUnit to allocate trips in a multi-trip fare. Trips can be allocated per day (e.g. Eurail) or per\nduration (e.g. multiples of a duration unit to cover the trip) or as single trips (e.g. carnet))\nKnown Values:\n- NONE: Individual trips don't need to be allocated. \n- TRIP: allocation per individual trip.\n- DAY: The allocation is per travel day.\n- DURATION: the allocation is per duration."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationUnit/DAY> a osdm:TripAllocationUnit, skos:Concept ;
    skos:inScheme osdm:TripAllocationUnit ;
    skos:notation "DAY" ;
    skos:prefLabel "DAY" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationUnit/DURATION> a osdm:TripAllocationUnit, skos:Concept ;
    skos:inScheme osdm:TripAllocationUnit ;
    skos:notation "DURATION" ;
    skos:prefLabel "DURATION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationUnit/NONE> a osdm:TripAllocationUnit, skos:Concept ;
    skos:inScheme osdm:TripAllocationUnit ;
    skos:notation "NONE" ;
    skos:prefLabel "NONE" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#TripAllocationUnit/TRIP> a osdm:TripAllocationUnit, skos:Concept ;
    skos:inScheme osdm:TripAllocationUnit ;
    skos:notation "TRIP" ;
    skos:prefLabel "TRIP" .

