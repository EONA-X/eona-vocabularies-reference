osdm:Booking a owl:Class ;
    rdfs:label "Booking" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/booking.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.createdOn> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.id> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.passengers> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking._links> a owl:ObjectProperty ;
    rdfs:label "_links" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:LinksItem ;
    skos:notation "_links" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.bookedOffers> a owl:ObjectProperty ;
    rdfs:label "bookedOffers" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:BookedOffer ;
    skos:notation "bookedOffers" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.bookingCode> a owl:DatatypeProperty ;
    rdfs:label "bookingCode" ;
    rdfs:comment "The unique booking code in the provider system. Usually refers to an order number or PNR."@en ;
    rdfs:domain osdm:Booking ;
    rdfs:range xsd:string ;
    skos:notation "bookingCode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.cancelFulfillmentsOffers> a owl:ObjectProperty ;
    rdfs:label "cancelFulfillmentsOffers" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:CancelFulfillmentsOffer ;
    skos:notation "cancelFulfillmentsOffers" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.confirmationTimeLimit> a owl:DatatypeProperty ;
    rdfs:label "confirmationTimeLimit" ;
    rdfs:comment "Time until the booking needs to be confirmed or put on hold. After that, the booking is no longer valid."@en ;
    rdfs:domain osdm:Booking ;
    rdfs:range xsd:dateTime ;
    skos:notation "confirmationTimeLimit" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.confirmedPrice> a owl:ObjectProperty ;
    rdfs:label "confirmedPrice" ;
    rdfs:comment "Sum of all prices of confirmed parts in the booking minus the sum of all confirmed refund amounts. The confirmed price must be provided if the booking includes confirmed parts."@en ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:Price ;
    skos:notation "confirmedPrice" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.createdOn> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "createdOn" ;
    rdfs:domain osdm:Booking ;
    rdfs:range xsd:dateTime ;
    skos:notation "createdOn" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.documents> a owl:ObjectProperty ;
    rdfs:label "documents" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:Document ;
    skos:notation "documents" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.exchangeOperations> a owl:ObjectProperty ;
    rdfs:label "exchangeOperations" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:ExchangeOperation ;
    skos:notation "exchangeOperations" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.externalRef> a owl:DatatypeProperty ;
    rdfs:label "externalRef" ;
    rdfs:comment "The unique booking reference in the provider system. Usually refers to an order number or PNR."@en ;
    rdfs:domain osdm:Booking ;
    rdfs:range xsd:string ;
    skos:notation "externalRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.fulfillmentDocuments> a owl:ObjectProperty ;
    rdfs:label "fulfillmentDocuments" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:FulfillmentDocument ;
    skos:notation "fulfillmentDocuments" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.fulfillmentStatus> a owl:ObjectProperty ;
    rdfs:label "fulfillmentStatus" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:FulfillmentSummaryStatus ;
    skos:notation "fulfillmentStatus" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.fulfillmentType> a owl:ObjectProperty ;
    rdfs:label "fulfillmentType" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:FulfillmentType ;
    skos:notation "fulfillmentType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.fulfillments> a owl:ObjectProperty ;
    rdfs:label "fulfillments" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:Fulfillment ;
    skos:notation "fulfillments" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.id> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:domain osdm:Booking ;
    rdfs:range xsd:string ;
    skos:notation "id" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.issuedVouchers> a owl:ObjectProperty ;
    rdfs:label "issuedVouchers" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:VoucherInformation ;
    skos:notation "issuedVouchers" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.onHoldOffer> a owl:ObjectProperty ;
    rdfs:label "onHoldOffer" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:OnHoldOffer ;
    skos:notation "onHoldOffer" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.passengers> a owl:ObjectProperty ;
    rdfs:label "passengers" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:Passenger ;
    skos:notation "passengers" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.paymentMethods> a owl:ObjectProperty ;
    rdfs:label "paymentMethods" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:PaymentMethod ;
    skos:notation "paymentMethods" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.provisionalPrice> a owl:ObjectProperty ;
    rdfs:label "provisionalPrice" ;
    rdfs:comment "Price of all unconfirmed pre-booked parts in the booking. The provisional price must be provided if the booking includes unconfirmed pre-booked parts."@en ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:Price ;
    skos:notation "provisionalPrice" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.provisionalRefundAmount> a owl:ObjectProperty ;
    rdfs:label "provisionalRefundAmount" ;
    rdfs:comment "Sum of the refund amounts of all unconfirmed pre-booked refunds and exchanges. The provisional refund amount must be provided if the booking includes unconfirmed pre-booked refunds or exchange operations."@en ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:Price ;
    skos:notation "provisionalRefundAmount" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.purchaser> a owl:ObjectProperty ;
    rdfs:label "purchaser" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:Purchaser ;
    skos:notation "purchaser" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.refundOffers> a owl:ObjectProperty ;
    rdfs:label "refundOffers" ;
    rdfs:comment "Refund offers are created with the details of the to-be-confirmed refund operation.\nOne refund offer can then be confirmed, which turns it into a refund.\nRefund offers in state PROPOSED might not be available in the Booking but only via the get endpoint. Confirmed refund offers must be listed here."@en ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:RefundOffer ;
    skos:notation "refundOffers" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.relatedBookingIds> a owl:DatatypeProperty ;
    rdfs:label "relatedBookingIds" ;
    rdfs:comment "If this booking has been split, this attribute references the newly created bookingIds."@en ;
    rdfs:domain osdm:Booking ;
    rdfs:range xsd:string ;
    skos:notation "relatedBookingIds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.releaseOffers> a owl:ObjectProperty ;
    rdfs:label "releaseOffers" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:ReleaseOffer ;
    skos:notation "releaseOffers" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.requestedInformation> a owl:DatatypeProperty ;
    rdfs:label "requestedInformation" ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:RequestedInformation ;
    skos:notation "requestedInformation" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.summary> a owl:DatatypeProperty ;
    rdfs:label "summary" ;
    rdfs:comment "A human-readable description of the booking."@en ;
    rdfs:domain osdm:Booking ;
    rdfs:range xsd:string ;
    skos:example "Booking 2345 for Clemens Gantert" ;
    skos:notation "summary" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Booking.trips> a owl:ObjectProperty ;
    rdfs:label "trips" ;
    rdfs:comment "This trip will be included in the offer if the offer is part of the booking."@en ;
    rdfs:domain osdm:Booking ;
    rdfs:range osdm:Trip ;
    skos:notation "trips" .

osdm:BookingCleanupRequest a owl:Class ;
    rdfs:label "BookingCleanupRequest" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/booking.yml> ;
    rdfs:comment "Request to cleanup a complete booking.\nUnconfirmed items will be deleted, any confirmed items will be refunded. There is no confirmation required.\nAttention point: refundDate and overruleCode are deprecated request attributes and will be ignored"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#BookingCleanupRequest.overruleCode> a owl:ObjectProperty ;
    rdfs:label "overruleCode" ;
    rdfs:comment "--Deprecated --"@en ;
    rdfs:domain osdm:BookingCleanupRequest ;
    rdfs:range osdm:OverruleCode ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "overruleCode" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#BookingCleanupRequest.refundDate> a owl:DatatypeProperty ;
    rdfs:label "refundDate" ;
    rdfs:comment "--Deprecated -- Indicates for passes the date taken as reference to compute possible partial refund. It is also the date taken\nas reference to invalidate the pass partially refunded."@en ;
    rdfs:domain osdm:BookingCleanupRequest ;
    rdfs:range xsd:dateTime ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "refundDate" .

