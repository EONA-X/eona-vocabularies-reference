osdm:ProductTag a owl:Class, skos:ConceptScheme ;
    rdfs:label "ProductTag" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/product.yml> ;
    rdfs:comment "Values from the [Product Tags Code List](https://osdm.io/spec/catalog-of-code-lists/#ProductTags)\nKnown values:\n- SPLIT_RESERVATION\n  Indicate for the provider that the distributor is prepared to get reservations including a split inside the reservation\n  Without this indication the provider is not allowed to use the SplitSection Object inside a reservation. \n  The implementation of SPLIT_RESERVATION is not recommended. To provide reservations that do not cover a full leg \n  multiple reservations as offerParts should be created.\n- CARD_LOST\n  Tag used to request a non-trip offer to replace a lost card. This applies to physical cards only.\n- TICKET_LOST\n  Tag used to request a non-trip offer to replace a lost ticket. This applies to physical tickets only.\n- Product Types\n  All product types can be used as Product Tags in the search"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductTag/ADMISSION_MULTI_RIDE> a osdm:ProductTag, skos:Concept ;
    skos:inScheme osdm:ProductTag ;
    skos:notation "ADMISSION_MULTI_RIDE" ;
    skos:prefLabel "ADMISSION_MULTI_RIDE" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductTag/ADMISSION_PASS> a osdm:ProductTag, skos:Concept ;
    skos:inScheme osdm:ProductTag ;
    skos:notation "ADMISSION_PASS" ;
    skos:prefLabel "ADMISSION_PASS" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductTag/ADMISSION_POINT2POINT> a osdm:ProductTag, skos:Concept ;
    skos:inScheme osdm:ProductTag ;
    skos:notation "ADMISSION_POINT2POINT" ;
    skos:prefLabel "ADMISSION_POINT2POINT" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductTag/ANCILLARY_ITEM> a osdm:ProductTag, skos:Concept ;
    skos:inScheme osdm:ProductTag ;
    skos:notation "ANCILLARY_ITEM" ;
    skos:prefLabel "ANCILLARY_ITEM" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductTag/ANCILLARY_SERVICE> a osdm:ProductTag, skos:Concept ;
    skos:inScheme osdm:ProductTag ;
    skos:notation "ANCILLARY_SERVICE" ;
    skos:prefLabel "ANCILLARY_SERVICE" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductTag/CARD_LOST> a osdm:ProductTag, skos:Concept ;
    skos:inScheme osdm:ProductTag ;
    skos:notation "CARD_LOST" ;
    skos:prefLabel "CARD_LOST" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductTag/REDUCTION_CARD> a osdm:ProductTag, skos:Concept ;
    skos:inScheme osdm:ProductTag ;
    skos:notation "REDUCTION_CARD" ;
    skos:prefLabel "REDUCTION_CARD" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductTag/RESERVATION> a osdm:ProductTag, skos:Concept ;
    skos:inScheme osdm:ProductTag ;
    skos:notation "RESERVATION" ;
    skos:prefLabel "RESERVATION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductTag/SPLIT_RESERVATION> a osdm:ProductTag, skos:Concept ;
    skos:inScheme osdm:ProductTag ;
    skos:notation "SPLIT_RESERVATION" ;
    skos:prefLabel "SPLIT_RESERVATION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ProductTag/TICKET_LOST> a osdm:ProductTag, skos:Concept ;
    skos:inScheme osdm:ProductTag ;
