osdm:Vehicle a owl:Class ;
    rdfs:label "Vehicle" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/transportable.yml> ;
    rdfs:comment "List of the coaches in a vehicle run ordered according to the physical\nordering of the vehicle."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Vehicle.coaches> a owl:ObjectProperty ;
    rdfs:label "coaches" ;
    rdfs:domain osdm:Vehicle ;
    rdfs:range osdm:Coach ;
    skos:notation "coaches" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Vehicle.reservationRefs> a owl:DatatypeProperty ;
    rdfs:label "reservationRefs" ;
    rdfs:comment "References to the reservations/fares for which all places in the vehicle can be selected. \nThe reservation ids must be part of the list of reservation ids for which the consumer has\nrequested the available places and the consumer must accept a list by setting \nsingleSelectionMapsRequired to false"@en ;
    rdfs:domain osdm:Vehicle ;
    rdfs:range xsd:string ;
    skos:notation "reservationRefs" .

osdm:VehicleAvailability a owl:Class ;
    rdfs:label "VehicleAvailability" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/transportable.yml> ;
    rdfs:comment "A vehicle run for which place availabilities were requested."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VehicleAvailability.coaches> a owl:ObjectProperty ;
    rdfs:label "coaches" ;
    rdfs:comment "List of the coaches in a vehicle run ordered according to the physical ordering of the vehicle. Empty if train composition data is missing or specific place selection is not supported."@en ;
    rdfs:domain osdm:VehicleAvailability ;
    rdfs:range osdm:CoachAvailability ;
    skos:notation "coaches" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VehicleAvailability.directionChanges> a owl:ObjectProperty ;
    rdfs:label "directionChanges" ;
    rdfs:comment "List of direction changes (in direction of travel)."@en ;
    rdfs:domain osdm:VehicleAvailability ;
    rdfs:range osdm:DirectionChange ;
    skos:notation "directionChanges" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VehicleAvailability.preSelectedCompartments> a owl:ObjectProperty ;
    rdfs:label "preSelectedCompartments" ;
    rdfs:domain osdm:VehicleAvailability ;
    rdfs:range osdm:CompartmentPreSelection ;
    skos:notation "preSelectedCompartments" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VehicleAvailability.preSelectedPlaces> a owl:ObjectProperty ;
    rdfs:label "preSelectedPlaces" ;
    rdfs:domain osdm:VehicleAvailability ;
    rdfs:range osdm:PlacePreSelection ;
    skos:notation "preSelectedPlaces" .

osdm:VehicleFilter a owl:Class ;
    rdfs:label "VehicleFilter" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/transportable.yml> ;
    rdfs:comment "Filter for in/exclusion of vehicle based on vehicle number or line number."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VehicleFilter.exclude> a owl:DatatypeProperty ;
    rdfs:label "exclude" ;
    rdfs:comment "Whether vehicle in list is to include or exclude from search."@en ;
    rdfs:domain osdm:VehicleFilter ;
    rdfs:range xsd:boolean ;
    skos:notation "exclude" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VehicleFilter.lineNumbers> a owl:DatatypeProperty ;
    rdfs:label "lineNumbers" ;
    rdfs:domain osdm:VehicleFilter ;
    rdfs:range osdm:LineNumber ;
    skos:notation "lineNumbers" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VehicleFilter.vehicleNumbers> a owl:DatatypeProperty ;
    rdfs:label "vehicleNumbers" ;
    rdfs:domain osdm:VehicleFilter ;
    rdfs:range osdm:VehicleNumber ;
    skos:notation "vehicleNumbers" .

osdm:VehicleNumber a rdfs:Datatype ;
    rdfs:label "VehicleNumber" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/transportable.yml> ;
    rdfs:comment "The vehicle number(s) of the vehicle that runs this timed leg. On some legs a vehicle can\nhave multiple vehicle numbers, e.g. if it is split into two trains at a intermediate stop.\nE.g. the vehicle numbers of 'TGV 9218', 'TH 9340' or 'ICE 15'.\nFor backwards compatibility with Hermes/Hosa the length of the string must be restricted\nto 5 characters. If's longer, it is not possible to use the H2O converter."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:string ] ;
    skos:example "9218, 9340, 15" .

osdm:ViaStationsDef a owl:Class ;
    rdfs:label "ViaStationsDef" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.alternativeRoute> a owl:ObjectProperty ;
    rdfs:label "alternativeRoute" ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range osdm:ViaStationsDef ;
    skos:notation "alternativeRoute" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.carrier> a owl:DatatypeProperty ;
    rdfs:label "carrier" ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range osdm:CompanyDef ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "carrier" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.carrierConstraintRef> a owl:DatatypeProperty ;
    rdfs:label "carrierConstraintRef" ;
    rdfs:comment "restriction to a specific carriers"@en ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range xsd:string ;
    skos:notation "carrierConstraintRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.fareReferenceStationSet> a owl:ObjectProperty ;
    rdfs:label "fareReferenceStationSet" ;
    rdfs:comment "reference to a list of stations included in the fare"@en ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range osdm:ViaStationsDefFareReferenceStationSet ;
    skos:notation "fareReferenceStationSet" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.isBorder> a owl:DatatypeProperty ;
    rdfs:label "isBorder" ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range xsd:boolean ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "isBorder" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.route> a owl:ObjectProperty ;
    rdfs:label "route" ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range osdm:ViaStationsDef ;
    skos:notation "route" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.routeId> a owl:DatatypeProperty ;
    rdfs:label "routeId" ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range xsd:int ;
    skos:notation "routeId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.routeValidityType> a owl:ObjectProperty ;
    rdfs:label "routeValidityType" ;
    rdfs:comment "Indiction of the type of validity for a route. In case of LINE validity (Default) the described lines are allowed for travel. In case of BUBBLE it is additionally allowed to travel on all routes inbetween the defined lines."@en ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range osdm:ViaStationsDefRouteValidityType ;
    skos:notation "routeValidityType" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.seriesId> a owl:DatatypeProperty ;
    rdfs:label "seriesId" ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range xsd:int ;
    skos:notation "seriesId" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.serviceBrand> a owl:DatatypeProperty ;
    rdfs:label "serviceBrand" ;
    rdfs:comment "restriction to a specific service brand"@en ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range xsd:string ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "serviceBrand" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.serviceConstraintRef> a owl:DatatypeProperty ;
    rdfs:label "serviceConstraintRef" ;
    rdfs:comment "restriction to a specific service brands"@en ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range xsd:string ;
    skos:notation "serviceConstraintRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.station> a owl:ObjectProperty ;
    rdfs:label "station" ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range osdm:StationDef ;
    skos:notation "station" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.stop> a owl:DatatypeProperty ;
    rdfs:label "stop" ;
    rdfs:comment "indicates that the station must be a real stop. In case a service passes the station but does not stop there the fare is not valid. Default is false."@en ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range xsd:boolean ;
    skos:notation "stop" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ViaStationsDef.technicalViaOnly> a owl:DatatypeProperty ;
    rdfs:label "technicalViaOnly" ;
    rdfs:comment "this via station is used to support the alignment with time tables but is not part of the contractual route provided to the passenger."@en ;
    rdfs:domain osdm:ViaStationsDef ;
    rdfs:range xsd:boolean ;
    skos:notation "technicalViaOnly" .

osdm:ViaStationsDefFareReferenceStationSet a owl:Class ;
    rdfs:label "ViaStationsDefFareReferenceStationSet" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/OSDM-offline-model.json> ;
    rdfs:comment "reference to a list of stations included in the fare"@en ;
