    rdfs:comment "scale of the amount - the number of positions after the comma"@en ;
    rdfs:domain osdm:VatDetailDef ;
    rdfs:range xsd:int ;
    skos:notation "scale" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VatDetailDef.scope> a owl:ObjectProperty ;
    rdfs:label "scope" ;
    rdfs:domain osdm:VatDetailDef ;
    rdfs:range osdm:VatScopeDef ;
    skos:notation "scope" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#VatDetailDef.taxId> a owl:DatatypeProperty ;
    rdfs:label "taxId" ;
    rdfs:domain osdm:VatDetailDef ;
