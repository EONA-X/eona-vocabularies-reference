osdm:PassengerSearchRequest a owl:Class ;
    rdfs:label "PassengerSearchRequest" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/person.yml> ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSearchRequest.dateOfBirth> a owl:DatatypeProperty ;
    rdfs:label "dateOfBirth" ;
    rdfs:domain osdm:PassengerSearchRequest ;
    rdfs:range xsd:date ;
    skos:notation "dateOfBirth" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSearchRequest.email> a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:domain osdm:PassengerSearchRequest ;
    rdfs:range xsd:string ;
    skos:notation "email" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSearchRequest.externalRef> a owl:DatatypeProperty ;
    rdfs:label "externalRef" ;
    rdfs:comment "A stable reference to a person from other elements, or from caller system.\nWhen received in input of a request, it must be echoed back in the response."@en ;
    rdfs:domain osdm:PassengerSearchRequest ;
    rdfs:range xsd:string ;
    skos:notation "externalRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSearchRequest.firstName> a owl:DatatypeProperty ;
    rdfs:label "firstName" ;
    rdfs:domain osdm:PassengerSearchRequest ;
    rdfs:range xsd:string ;
    skos:notation "firstName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSearchRequest.lastName> a owl:DatatypeProperty ;
    rdfs:label "lastName" ;
    rdfs:domain osdm:PassengerSearchRequest ;
    rdfs:range xsd:string ;
    skos:notation "lastName" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSearchRequest.phoneNumber> a owl:DatatypeProperty ;
    rdfs:label "phoneNumber" ;
    rdfs:comment "format according to E.164 The international public telecommunication numbering plan"@en ;
    rdfs:domain osdm:PassengerSearchRequest ;
    rdfs:range xsd:string ;
    skos:notation "phoneNumber" .

osdm:PassengerSpecification a owl:Class ;
    rdfs:label "PassengerSpecification" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/person.yml> ;
    rdfs:comment "Minimal specification of a passenger to request offers.\nEither the date of birth or the age at the time of travel needs to be set. We recommend to use date of birth as it is more stable than age."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSpecification.externalRef> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSpecification.type> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSpecification.age> a owl:DatatypeProperty ;
    rdfs:label "age" ;
    rdfs:domain osdm:PassengerSpecification ;
    rdfs:range xsd:int ;
    skos:notation "age" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSpecification.cards> a owl:ObjectProperty ;
    rdfs:label "cards" ;
    rdfs:comment "reduction or loyalty cards owned by the passenger"@en ;
    rdfs:domain osdm:PassengerSpecification ;
    rdfs:range osdm:CardReference ;
    skos:notation "cards" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSpecification.dateOfBirth> a owl:DatatypeProperty ;
    rdfs:label "dateOfBirth" ;
    rdfs:comment "Date of birth of the passenger. Only needed for passengers of type persons, family child, PRM\nand wheelchair."@en ;
    rdfs:domain osdm:PassengerSpecification ;
    rdfs:range xsd:date ;
    skos:notation "dateOfBirth" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSpecification.detail> a owl:ObjectProperty ;
    rdfs:label "detail" ;
    rdfs:domain osdm:PassengerSpecification ;
    rdfs:range osdm:PersonDetail ;
    skos:notation "detail" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSpecification.externalRef> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "externalRef" ;
    rdfs:comment "A stable reference to a passenger from other elements, or from caller system. When received in input of a request, it must be echoed back in the response."@en ;
    rdfs:domain osdm:PassengerSpecification ;
    rdfs:range xsd:string ;
    skos:example "TK-id-12345" ;
    skos:notation "externalRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSpecification.gender> a owl:ObjectProperty ;
    rdfs:label "gender" ;
    rdfs:domain osdm:PassengerSpecification ;
    rdfs:range osdm:Gender ;
    skos:notation "gender" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSpecification.prmNeeds> a owl:ObjectProperty ;
    rdfs:label "prmNeeds" ;
    rdfs:comment "For the persons with reduced mobility (PRMs) its specific needs for support are expressed."@en ;
    rdfs:domain osdm:PassengerSpecification ;
    rdfs:range osdm:PRMNeedType ;
    skos:notation "prmNeeds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSpecification.transportableDetails> a owl:ObjectProperty ;
    rdfs:label "transportableDetails" ;
    rdfs:domain osdm:PassengerSpecification ;
    rdfs:range osdm:Transportable ;
    skos:notation "transportableDetails" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#PassengerSpecification.type> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "type" ;
    rdfs:domain osdm:PassengerSpecification ;
    rdfs:range osdm:PassengerType ;
    skos:notation "type" .

osdm:PassengerType a owl:Class, skos:ConceptScheme ;
    rdfs:label "PassengerType" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/person.yml> ;
    rdfs:comment "Passenger type according to UIC passenger, i.e. passenger type list.\nValues from the [Passenger Type Code List](https://osdm.io/spec/catalog-of-code-lists/#PassengerType)\nListed values here are examples.   \nProposed default PERSON"@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    skos:scopeNote "Extensible list: other values may occur."@en .

