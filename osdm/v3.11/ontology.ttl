osdm:AnonymousPassengerSpecification a owl:Class ;
    rdfs:label "AnonymousPassengerSpecification" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/person.yml> ;
    rdfs:comment "Minimal specification of a passenger to request offers without any GDPR relevant attributes such as name or address.\n\nEither the date of birth or the age at the time of travel needs to be set. We recommend to use date of birth as it is more stable than age."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AnonymousPassengerSpecification.externalRef> ], [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AnonymousPassengerSpecification.type> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AnonymousPassengerSpecification.age> a owl:DatatypeProperty ;
    rdfs:label "age" ;
    rdfs:domain osdm:AnonymousPassengerSpecification ;
    rdfs:range xsd:int ;
    skos:notation "age" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AnonymousPassengerSpecification.cards> a owl:ObjectProperty ;
    rdfs:label "cards" ;
    rdfs:domain osdm:AnonymousPassengerSpecification ;
    rdfs:range osdm:CardReference ;
    skos:notation "cards" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AnonymousPassengerSpecification.dateOfBirth> a owl:DatatypeProperty ;
    rdfs:label "dateOfBirth" ;
    rdfs:comment "Date of birth of the passenger. Only needed for passengers of type persons, family child, PRM\nand wheelchair."@en ;
    rdfs:domain osdm:AnonymousPassengerSpecification ;
    rdfs:range xsd:date ;
    skos:notation "dateOfBirth" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AnonymousPassengerSpecification.externalRef> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "externalRef" ;
    rdfs:comment "A stable reference to a passenger from other elements, or from caller system. When received in input of a request, it must be echoed back in the response."@en ;
    rdfs:domain osdm:AnonymousPassengerSpecification ;
    rdfs:range xsd:string ;
    skos:notation "externalRef" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AnonymousPassengerSpecification.gender> a owl:ObjectProperty ;
    rdfs:label "gender" ;
    rdfs:domain osdm:AnonymousPassengerSpecification ;
    rdfs:range osdm:Gender ;
    skos:notation "gender" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AnonymousPassengerSpecification.prmNeeds> a owl:ObjectProperty ;
    rdfs:label "prmNeeds" ;
    rdfs:domain osdm:AnonymousPassengerSpecification ;
    rdfs:range osdm:PRMNeedType ;
    skos:notation "prmNeeds" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AnonymousPassengerSpecification.residency> a owl:DatatypeProperty ;
    rdfs:label "residency" ;
    rdfs:domain osdm:AnonymousPassengerSpecification ;
    rdfs:range osdm:CountryCode ;
    skos:notation "residency" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AnonymousPassengerSpecification.transportable> a owl:ObjectProperty ;
    rdfs:label "transportable" ;
    rdfs:domain osdm:AnonymousPassengerSpecification ;
    rdfs:range osdm:TransportableSpecification ;
    skos:notation "transportable" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#AnonymousPassengerSpecification.type> a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "type" ;
    rdfs:domain osdm:AnonymousPassengerSpecification ;
    rdfs:range osdm:PassengerType ;
    skos:notation "type" .

osdm:ApiNextVersion a owl:Class ;
    rdfs:label "ApiNextVersion" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Next version of the API.\nThe next version is used to indicate the next version of the API that is being used.\nThe version is in semantic versioning format, e.g. \"4.0.0\" and it is a version released at osdm.io."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ApiNextVersion.availableAt> a owl:DatatypeProperty ;
    rdfs:label "availableAt" ;
    rdfs:domain osdm:ApiNextVersion ;
    rdfs:range xsd:anyURI ;
    skos:example "https://api.next.example.com" ;
    skos:notation "availableAt" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ApiNextVersion.availableFrom> a owl:DatatypeProperty ;
    rdfs:label "availableFrom" ;
    rdfs:comment "Date from which the next version is available."@en ;
    rdfs:domain osdm:ApiNextVersion ;
    rdfs:range xsd:dateTime ;
    skos:example "2025-01-01T00:00:00+01:00" ;
    skos:notation "availableFrom" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ApiNextVersion.version> a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:comment "Version of the next API."@en ;
    rdfs:domain osdm:ApiNextVersion ;
    rdfs:range xsd:string ;
    skos:example "4.0.0" ;
    skos:notation "version" .

osdm:ApiVersion a owl:Class ;
    rdfs:label "ApiVersion" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Version of the API.\nThe version is used to indicate the version of the API that is being used.\nThe version is in semantic versioning format, e.g. \"3.0.0\" and it is a version released at osdm.io."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf [ a owl:Restriction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ; owl:onProperty <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ApiVersion.version> ] .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ApiVersion.nextVersion> a owl:ObjectProperty ;
    rdfs:label "nextVersion" ;
    rdfs:domain osdm:ApiVersion ;
    rdfs:range osdm:ApiNextVersion ;
    skos:notation "nextVersion" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ApiVersion.sunset> a owl:DatatypeProperty ;
    rdfs:label "sunset" ;
    rdfs:comment "Date after which the API version will no longer be available."@en ;
    rdfs:domain osdm:ApiVersion ;
    rdfs:range xsd:dateTime ;
    skos:example "2024-12-31T23:59:59+01:00" ;
    skos:notation "sunset" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#ApiVersion.version> a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "version" ;
    rdfs:comment "Version of the API"@en ;
    rdfs:domain osdm:ApiVersion ;
    rdfs:range xsd:string ;
    skos:example "3.0.0" ;
    skos:notation "version" .

