osdm:RequestedInformation a rdfs:Datatype ;
    rdfs:label "RequestedInformation" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/_common.yml> ;
    rdfs:comment "Boolean-expression indicating the data that must be set in the data model in order to proceed to next step of the process. \n\nThe syntax and semantics of the expression is described in detail in the OSDM documentation."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:onDatatype xsd:string ] .

osdm:Reservation a owl:Class ;
    rdfs:label "Reservation" ;
    dcterms:source <https://github.com/UnionInternationalCheminsdeFer/OSDM/blob/d198a80259b9399754cec68cd60278892fe04cfe/specification/schemas/offer.yml> ;
    rdfs:comment "Reservation includes the reference to the in the initial offer.\nThe offer needs to be updated with the selected places before the confirmation\nwhich creates the reservation details including the reserved places."@en ;
    rdfs:isDefinedBy <https://vocabulary.eona-x.eu/ontology/osdm/v3.11#> ;
    rdfs:subClassOf osdm:AbstractBookingPart .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Reservation.ancillaryRefs> a owl:ObjectProperty ;
    rdfs:label "ancillaryRefs" ;
    rdfs:comment "*DEPRECATED* Formerly OSDM allowed to link ancillaries to reservation. Since 3.7.0, it is recommended to only link reservations to admissions, ancillaries, and not the other way round. Reference will be removed in 4.0.0"@en ;
    rdfs:domain osdm:Reservation ;
    rdfs:range osdm:BookingPartReference ;
    owl:deprecated "true"^^xsd:boolean ;
    skos:notation "ancillaryRefs" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Reservation.availablePlacePreferences> a owl:ObjectProperty ;
    rdfs:label "availablePlacePreferences" ;
    rdfs:comment "options for place selection in case the place selection is made after the pre-booking."@en ;
    rdfs:domain osdm:Reservation ;
    rdfs:range osdm:AvailablePlacePreferences ;
    skos:notation "availablePlacePreferences" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#Reservation.distributionMode> a owl:ObjectProperty ;
    rdfs:label "distributionMode" ;
    rdfs:comment "indication of a reservation to be used as a fare or as a product"@en ;
    rdfs:domain osdm:Reservation ;
    rdfs:range osdm:DistributionMode ;
