    skos:inScheme osdm:OverruleCode ;
    skos:notation "EXTERNAL_COMPENSATION" ;
    skos:prefLabel "EXTERNAL_COMPENSATION" .

<https://vocabulary.eona-x.eu/ontology/osdm/v3.11#OverruleCode/INABILITY_TO_TRAVEL> a osdm:OverruleCode, skos:Concept ;
    skos:inScheme osdm:OverruleCode ;
