<> a dcat:Dataset, adms:Asset ;
    dcat:version "3.11" ;
    dcterms:title "OSDM 3.11 (Open Sales and Distribution Model)"@en ;
    dcterms:description "RDF/OWL rendering of the UIC Open Sales and Distribution Model v3.11: the offline fare-delivery model and the online API schemas, generated by tools/generators from the pinned upstream JSON Schema and OpenAPI files (Apache-2.0)."@en ;
