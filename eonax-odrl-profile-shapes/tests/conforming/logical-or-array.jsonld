{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "eox-policy": "https://eona-x.eu/vocabulary/odrl-profile#"
  },
  "@id": "https://provider.example/policy/or-array",
  "@type": "odrl:Set",
  "odrl:permission": [
    {
      "odrl:action": {
        "@id": "odrl:use"
      },
      "odrl:constraint": [
        {
          "@type": "odrl:LogicalConstraint",
          "odrl:or": [
            {
              "odrl:leftOperand": {
                "@id": "eox-policy:Membership"
              },
              "odrl:operator": {
                "@id": "odrl:eq"
              },
              "odrl:rightOperand": "active"
            },
            {
              "odrl:leftOperand": {
                "@id": "eox-policy:GenericClaim.$.MembershipCredential.membership.membershipType"
              },
              "odrl:operator": {
                "@id": "odrl:eq"
              },
              "odrl:rightOperand": "FullMember"
            }
          ]
        }
      ]
    }
  ]
}
