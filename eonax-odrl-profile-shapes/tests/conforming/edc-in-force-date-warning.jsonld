{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "eox-policy": "https://eona-x.eu/vocabulary/odrl-profile#"
  },
  "@id": "https://provider.example/policy/in-force",
  "@type": "odrl:Set",
  "odrl:permission": [
    {
      "odrl:action": {
        "@id": "odrl:use"
      },
      "odrl:constraint": [
        {
          "odrl:leftOperand": {
            "@id": "eox-policy:Membership"
          },
          "odrl:operator": {
            "@id": "odrl:eq"
          },
          "odrl:rightOperand": "active"
        },
        {
          "odrl:leftOperand": {
            "@id": "https://w3id.org/edc/v0.0.1/ns/inForceDate"
          },
          "odrl:operator": {
            "@id": "odrl:lteq"
          },
          "odrl:rightOperand": "contractAgreement+30d"
        }
      ]
    }
  ]
}
