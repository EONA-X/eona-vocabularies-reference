{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "eox-policy": "https://eona-x.eu/vocabulary/odrl-profile#"
  },
  "@id": "https://provider.example/policy/api-data",
  "@type": "odrl:Set",
  "odrl:permission": [
    {
      "odrl:action": {
        "@id": "odrl:use"
      },
      "odrl:constraint": [
        {
          "odrl:leftOperand": {
            "@id": "eox-policy:Membership"
          },
          "odrl:operator": {
            "@id": "odrl:eq"
          },
          "odrl:rightOperand": "active"
        }
      ]
    },
    {
      "odrl:action": {
        "@id": "odrl:read"
      },
      "odrl:duty": [
        {
          "odrl:action": {
            "@id": "odrl:delete"
          },
          "odrl:constraint": [
            {
              "odrl:leftOperand": {
                "@id": "odrl:elapsedTime"
              },
              "odrl:operator": {
                "@id": "odrl:lteq"
              },
              "odrl:rightOperand": {
                "@value": "PT24H",
                "@type": "xsd:duration"
              }
            }
          ]
        }
      ]
    },
    {
      "odrl:action": {
        "@id": "odrl:aggregate"
      }
    },
    {
      "odrl:action": {
        "@id": "odrl:derive"
      }
    },
    {
      "odrl:action": {
        "@id": "odrl:use"
      },
      "odrl:constraint": [
        {
          "odrl:leftOperand": {
            "@id": "eox-policy:GenericClaim.$.DomainCredential.domain"
          },
          "odrl:operator": {
            "@id": "odrl:isPartOf"
          },
          "odrl:rightOperand": "['route','travel']"
        }
      ]
    }
  ],
  "odrl:obligation": [
    {
      "odrl:action": {
        "@id": "odrl:reviewPolicy"
      },
      "odrl:constraint": [
        {
          "odrl:leftOperand": {
            "@id": "eox-policy:acceptedTerms"
          },
          "odrl:operator": {
            "@id": "odrl:eq"
          },
          "odrl:rightOperand": {
            "@id": "https://provider.example/terms/api-1.1"
          }
        }
      ]
    },
    {
      "odrl:action": {
        "@id": "odrl:attribute"
      },
      "odrl:constraint": [
        {
          "odrl:leftOperand": {
            "@id": "eox-policy:acceptedTerms"
          },
          "odrl:operator": {
            "@id": "odrl:eq"
          },
          "odrl:rightOperand": "https://provider.example/terms/api-1.1"
        }
      ]
    }
  ],
  "odrl:prohibition": [
    {
      "odrl:action": {
        "@id": "odrl:display"
      },
      "odrl:remedy": [
        {
          "odrl:action": {
            "@id": "odrl:delete"
          }
        }
      ]
    },
    {
      "odrl:action": {
        "@id": "odrl:sell"
      },
      "odrl:remedy": [
        {
          "odrl:action": {
            "@id": "odrl:delete"
          }
        }
      ]
    }
  ]
}
