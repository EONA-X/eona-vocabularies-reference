{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "eox-policy": "https://eona-x.eu/vocabulary/odrl-profile#",
    "eox-policy-travel": "https://eona-x.eu/vocabulary/odrl-profile-travel#"
  },
  "@type": "odrl:Set",
  "odrl:permission": [
    {
      "odrl:action": {
        "@id": "odrl:use"
      },
      "odrl:constraint": [
        {
          "odrl:leftOperand": {
            "@id": "eox-policy:Membership"
          },
          "odrl:operator": {
            "@id": "odrl:eq"
          },
          "odrl:rightOperand": "active"
        }
      ]
    }
  ],
  "odrl:obligation": [
    {
      "odrl:action": {
        "@id": "odrl:delete"
      },
      "odrl:constraint": [
        {
          "odrl:leftOperand": {
            "@id": "eox-policy-travel:consentStatus"
          },
          "odrl:operator": {
            "@id": "odrl:eq"
          },
          "odrl:rightOperand": "https://w3id.org/dpv#ConsentWithdrawn"
        },
        {
          "odrl:leftOperand": {
            "@id": "odrl:elapsedTime"
          },
          "odrl:operator": {
            "@id": "odrl:lteq"
          },
          "odrl:rightOperand": "PT24H"
        }
      ]
    }
  ]
}
