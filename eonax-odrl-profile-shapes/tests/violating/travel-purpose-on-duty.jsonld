{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "eox-policy": "https://eona-x.eu/vocabulary/odrl-profile#",
    "eox-policy-travel": "https://eona-x.eu/vocabulary/odrl-profile-travel#"
  },
  "@type": "odrl:Set",
  "odrl:permission": [
    {
      "odrl:action": {
        "@id": "odrl:use"
      },
      "odrl:constraint": [
        {
          "odrl:leftOperand": {
            "@id": "eox-policy:Membership"
          },
          "odrl:operator": {
            "@id": "odrl:eq"
          },
          "odrl:rightOperand": "active"
        }
      ],
      "odrl:duty": [
        {
          "odrl:action": {
            "@id": "odrl:delete"
          },
          "odrl:constraint": [
            {
              "odrl:leftOperand": {
                "@id": "odrl:purpose"
              },
              "odrl:operator": {
                "@id": "odrl:eq"
              },
              "odrl:rightOperand": "https://w3id.org/dpv#ServiceProvision"
            }
          ]
        }
      ]
    }
  ]
}
