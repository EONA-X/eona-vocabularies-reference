{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "eox-policy": "https://eona-x.eu/vocabulary/odrl-profile#"
  },
  "@id": "https://provider.example/policy/or-on-duty",
  "@type": "odrl:Set",
  "odrl:permission": [
    {
      "odrl:action": {
        "@id": "odrl:use"
      },
      "odrl:constraint": [
        {
          "odrl:leftOperand": {
            "@id": "eox-policy:Membership"
          },
          "odrl:operator": {
            "@id": "odrl:eq"
          },
          "odrl:rightOperand": "active"
        }
      ]
    }
  ],
  "odrl:obligation": [
    {
      "odrl:action": {
        "@id": "odrl:attribute"
      },
      "odrl:constraint": [
        {
          "@type": "odrl:LogicalConstraint",
          "odrl:or": [
            {
              "odrl:leftOperand": {
                "@id": "eox-policy:GenericClaim.$.MembershipCredential.name"
              },
              "odrl:operator": {
                "@id": "odrl:eq"
              },
              "odrl:rightOperand": "Org A"
            },
            {
              "odrl:leftOperand": {
                "@id": "odrl:elapsedTime"
              },
              "odrl:operator": {
                "@id": "odrl:lteq"
              },
              "odrl:rightOperand": {
                "@value": "PT24H",
                "@type": "xsd:duration"
              }
            }
          ]
        }
      ]
    }
  ]
}
