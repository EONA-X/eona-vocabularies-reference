{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "eox-policy": "https://eona-x.eu/vocabulary/odrl-profile#"
  },
  "@type": "odrl:Set",
  "odrl:permission": [
    {
      "odrl:action": {
        "@id": "odrl:use"
      },
      "odrl:constraint": [
        {
          "odrl:leftOperand": {
            "@id": "eox-policy:Membership"
          },
          "odrl:operator": {
            "@id": "odrl:eq"
          },
          "odrl:rightOperand": "active"
        }
      ]
    },
    {
      "odrl:action": {
        "@id": "odrl:read"
      },
      "odrl:constraint": [
        {
          "@type": "odrl:LogicalConstraint",
          "odrl:or": {
            "@list": [
              {
                "odrl:leftOperand": {
                  "@id": "odrl:elapsedTime"
                },
                "odrl:operator": {
                  "@id": "odrl:lteq"
                },
                "odrl:rightOperand": "PT24H"
              },
              {
                "odrl:leftOperand": {
                  "@id": "odrl:elapsedTime"
                },
                "odrl:operator": {
                  "@id": "odrl:lt"
                },
                "odrl:rightOperand": "P1D"
              }
            ]
          }
        }
      ]
    }
  ]
}