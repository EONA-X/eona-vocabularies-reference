{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "eox-policy": "https://eona-x.eu/vocabulary/odrl-profile#"
  },
  "@id": "https://provider.example/policy/or-is-any-of",
  "@type": "odrl:Set",
  "odrl:permission": [
    {
      "odrl:action": {
        "@id": "odrl:use"
      },
      "odrl:constraint": [
        {
          "@type": "odrl:LogicalConstraint",
          "odrl:or": {
            "@list": [
              {
                "odrl:leftOperand": {
                  "@id": "eox-policy:Membership"
                },
                "odrl:operator": {
                  "@id": "odrl:eq"
                },
                "odrl:rightOperand": "active"
              },
              {
                "odrl:leftOperand": {
                  "@id": "eox-policy:GenericClaim.$.MembershipCredential.groups"
                },
                "odrl:operator": {
                  "@id": "odrl:isAnyOf"
                },
                "odrl:rightOperand": "['EMDS']"
              }
            ]
          }
        }
      ]
    }
  ]
}
