# SHACL shapes for the Eona-X ODRL Profile v0.0.5
#
# Validates an ODRL policy (Set, Offer or Agreement, as RDF from its JSON-LD)
# against the authoring rules of the Eona-X ODRL profile v0.0.5
# (eonax-odrl-profile/v0.0.5): the terms it lists, the operator and right-operand
# datatype each left operand takes, and the rewrite rules that keep a policy intact
# through the connector's JSON-LD ingestion.
#
# These shapes check that a policy is well formed for the profile. They do not
# say whether the connector will store it: that depends on what the connector binds
# and declares (see eox-policy:connectorSupport in the profile). Run them before a
# policy reaches the connector: in the policy editor, and against example policies
# in this repository's CI.
#
# The shapes also check the Declared terms of the profile (eox-policy:Declared,
# dataspace-ecosystem MR !145 and MR !150): eox-policy:acceptedTerms,
# odrl:reviewPolicy, odrl:delete and odrl:elapsedTime.
#
# Severity:
#   Violation - breaks a profile rule, or would be changed or lost on ingestion.
#   Warning   - outside the profile but possibly legitimate (an EDC built-in operand
#               such as edc:inForceDate).
#
# Credential-claim left operands are strings, eox-policy:<Term>.$.<Credential>.<path>.
# They are matched by pattern, in the profile's stable term namespace
# https://eona-x.eu/vocabulary/odrl-profile# (eona-x/backlog#994) only. A policy
# written in the connector's legacy namespace https://w3id.org/eonax/policy/ does
# not conform: its credential-claim operands are not profile terms, so it keeps no
# enforced permission. The shapes themselves keep a versioned namespace: they are
# validation shapes, not terms a runtime matches by IRI.

@prefix eoxs: <https://eona-x.eu/shape/odrl-profile-shapes/v0.0.5#> .
@prefix eox-policy: <https://eona-x.eu/vocabulary/odrl-profile#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

eoxs:
    a owl:Ontology ;
    rdfs:label "Eona-X ODRL Profile SHACL shapes"@en ;
    dct:title "Eona-X ODRL Profile SHACL shapes"@en ;
    owl:versionInfo "0.0.5" ;
    owl:priorVersion <https://eona-x.eu/shape/odrl-profile-shapes/v0.0.4#> ;
    skos:changeNote """0.0.5: for eonax-odrl-profile v0.0.5 (odrl:delete and odrl:elapsedTime are Declared, dataspace-ecosystem MR !150, eona-x/backlog#1087): odrl:elapsedTime takes odrl:lt or odrl:lteq (odrl:eq is refused; odrl:lt joins the global operator list), only as a direct constraint of an odrl:delete duty or policy-level obligation, and a right operand that is a plain string or an xsd:duration typed literal, in both cases a non-negative xsd:duration lexical form of at most 64 characters, a zero duration being refused with odrl:lt (odrl:lteq "PT0S" conforms); the datatype IRI, a free-form value, a negative duration and { "@id" } are refused; new shapes eoxs:DeleteNotAPermissionAction, eoxs:DeleteNotAProhibitionAction and eoxs:DeleteNotARemedyOrConsequenceAction (odrl:delete is the action of a permission duty or a policy-level obligation only, eona-x/backlog#1065), eoxs:ElapsedTimeOnDeleteDutyOnly (odrl:elapsedTime is a direct constraint of such a delete duty or obligation only; refused on a permission, prohibition, remedy, consequence, in odrl:or and in an action refinement; the connector answers HTTP 400, an enforced permission constraint is eona-x/backlog#1091)."""@en ;
    skos:changeNote """0.0.4: new shapes eoxs:NoAcceptedTermsOnProhibition and eoxs:ReviewPolicyNotAPermissionAction; eox-policy:acceptedTerms requires odrl:eq and one IRI, an http(s) IRI with an authority or a urn: IRI, made of characters java.net.URI accepts (stricter than dataspace-ecosystem MR !145, which accepts any scheme that has an authority); the declared actions of eox-policy:declaredActions are part of the profile actions."""@en ;
    rdfs:seeAlso <https://eona-x.eu/vocabulary/odrl-profile#> ;
    dct:description "SHACL shapes checking an ODRL policy against the authoring rules of the Eona-X ODRL Profile v0.0.5."@en .

#################################################################
#  Rules: permissions, prohibitions, obligations, duties, remedies
#################################################################

eoxs:RuleShape
    a sh:NodeShape ;
    rdfs:label "Rule"@en ;
    sh:targetObjectsOf odrl:permission, odrl:prohibition, odrl:obligation, odrl:duty, odrl:remedy, odrl:consequence ;
    sh:property eoxs:RuleOneAction, eoxs:RuleActionInProfile, eoxs:RuleNoTarget, eoxs:RuleNoOutput,
                eoxs:RuleAttributedParty, eoxs:RuleTrackingParty .

eoxs:RuleOneAction
    a sh:PropertyShape ;
    sh:path odrl:action ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "OneActionPerRule: a rule has exactly one action. The connector keeps only the first action of a list and drops the others."@en .

eoxs:RuleActionInProfile
    a sh:PropertyShape ;
    sh:path odrl:action ;
    sh:in ( odrl:use odrl:transfer odrl:share odrl:distribute
            odrl:read odrl:display odrl:present odrl:print odrl:archive odrl:index
            odrl:aggregate odrl:derive odrl:extract odrl:reproduce
            odrl:sell odrl:give odrl:grantUse
            odrl:delete odrl:reviewPolicy odrl:attribute odrl:acceptTracking ) ;
    sh:message "The action is not in the Eona-X ODRL profile (eox-policy:supportedActions, eox-policy:declaredActions, eox-policy:authoringActions)."@en .

eoxs:RuleNoTarget
    a sh:PropertyShape ;
    sh:path odrl:target ;
    sh:maxCount 0 ;
    sh:message "OneTargetPerPolicy: put the target on the policy. The connector drops a rule's own target, so the rule would apply to the policy target."@en .

eoxs:RuleNoOutput
    a sh:PropertyShape ;
    sh:path odrl:output ;
    sh:maxCount 0 ;
    sh:message "OneTargetPerPolicy: odrl:output is dropped by the connector. Publish the derived asset with its own policy."@en .

eoxs:RuleAttributedParty
    a sh:PropertyShape ;
    sh:path odrl:attributedParty ;
    sh:maxCount 0 ;
    sh:severity sh:Warning ;
    sh:message "PartiesInTerms: odrl:attributedParty is dropped by the connector. Name the party in the human-readable terms as well."@en .

eoxs:RuleTrackingParty
    a sh:PropertyShape ;
    sh:path odrl:trackingParty ;
    sh:maxCount 0 ;
    sh:severity sh:Warning ;
    sh:message "PartiesInTerms: odrl:trackingParty is dropped by the connector. Name the party in the human-readable terms as well."@en .

#################################################################
#  Constraints
#################################################################

# A constraint is atomic (left operand, operator, right operand) or an
# odrl:LogicalConstraint whose odrl:or lists atomic constraints, written as a JSON-LD
# @list or as a plain array (eox-policy:supportedConstraintTerms). The atomic shapes
# below target every node that has a left operand, an operator or a right operand,
# so they check the members of odrl:or as well as top-level constraints, and never
# the logical constraint itself.
eoxs:ConstraintEntry
    a sh:NodeShape ;
    rdfs:label "Constraint entry"@en ;
    sh:targetObjectsOf odrl:constraint ;
    sh:xone (
        [ sh:path odrl:leftOperand ; sh:minCount 1 ]
        [ sh:path odrl:or ; sh:minCount 1 ]
    ) ;
    sh:message "A constraint is either atomic (left operand, operator, right operand) or an odrl:LogicalConstraint with odrl:or; the profile supports only odrl:or (not odrl:and, odrl:xone or odrl:andSequence), and a constraint cannot be both."@en .

eoxs:LogicalConstraintShape
    a sh:NodeShape ;
    rdfs:label "Logical constraint"@en ;
    sh:targetSubjectsOf odrl:or ;
    sh:property [
        sh:path odrl:or ;
        sh:minCount 1 ;
        sh:or ( [ sh:path rdf:first ; sh:minCount 1 ]
                [ sh:path odrl:leftOperand ; sh:minCount 1 ] ) ;
        sh:message "Each member of odrl:or is an atomic constraint (left operand, operator, right operand), as a JSON-LD @list or a plain array; odrl:or is not empty and does not nest."@en
    ] , [
        sh:path ( odrl:or [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:property [ sh:path odrl:leftOperand ; sh:minCount 1 ] ;
        sh:message "Each member of odrl:or is an atomic constraint (left operand, operator, right operand), as a JSON-LD @list or a plain array; odrl:or is not empty and does not nest."@en
    ] .

eoxs:ConstraintShape
    a sh:NodeShape ;
    rdfs:label "Constraint"@en ;
    sh:targetSubjectsOf odrl:leftOperand, odrl:operator, odrl:rightOperand ;
    sh:property [
        sh:path odrl:leftOperand ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A constraint has exactly one left operand, an IRI."@en
    ] , [
        sh:path odrl:operator ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( odrl:eq odrl:neq odrl:isPartOf odrl:hasPart odrl:lt odrl:lteq odrl:isNoneOf ) ;
        sh:message "The operator is not in the Eona-X ODRL profile (supported or declared operators). For set membership use odrl:isPartOf, not odrl:isAnyOf."@en
    ] , [
        sh:path odrl:rightOperand ;
        sh:minCount 1 ;
        sh:message "A constraint has a right operand."@en
    ] .

eoxs:LeftOperandInProfile
    a sh:NodeShape ;
    sh:targetSubjectsOf odrl:leftOperand, odrl:operator, odrl:rightOperand ;
    sh:severity sh:Warning ;
    sh:or (
        [ sh:path odrl:leftOperand ; sh:hasValue odrl:elapsedTime ]
        [ sh:path odrl:leftOperand ; sh:pattern "^https://eona-x\\.eu/vocabulary/odrl-profile#(acceptedTerms$|Membership$|GenericClaim\\.\\$\\.|RestrictedDiscoveryClaim\\.\\$\\.)" ]
    ) ;
    sh:message "The left operand is not in the Eona-X ODRL profile. An EDC built-in (for example edc:inForceDate) may still be accepted by the connector."@en .

# odrl:elapsedTime (Declared, dataspace-ecosystem MR !150): odrl:lt or odrl:lteq (not odrl:eq)
# and one non-negative xsd:duration lexical form of at most 64 characters (odrl:lt: not zero,
# that is with a digit 1-9; odrl:lteq "PT0S" is allowed), written as a plain string
# (recommended) or as an xsd:duration typed literal (MR !150 reduces it to its value).
# The pattern is an XPath regular expression without lookaheads: P, then at least one
# of years, months, days, or a T part with at least one of hours, minutes, seconds
# (fractional seconds allowed), and no sign. The datatype IRI
# "http://www.w3.org/2001/XMLSchema#duration" (what the dataspace-ui editor produces),
# a free-form value such as "24h", a negative duration and {"@id"} are refused.
eoxs:ElapsedTimeConstraint
    a sh:NodeShape ;
    sh:targetSubjectsOf odrl:leftOperand, odrl:operator, odrl:rightOperand ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:elapsedTime ] ]
        [ sh:property [ sh:path odrl:operator ; sh:in ( odrl:lt odrl:lteq ) ] ;
          sh:property [ sh:path odrl:rightOperand ; sh:minCount 1 ; sh:maxCount 1 ; sh:maxLength 64 ;
                        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype xsd:duration ] ) ;
                        sh:pattern "^P(([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))?|(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S)))$" ] ;
          sh:or ( [ sh:path odrl:operator ; sh:hasValue odrl:lteq ]
                  [ sh:path odrl:rightOperand ; sh:pattern "[1-9]" ] ) ]
    ) ;
    sh:message "odrl:elapsedTime takes odrl:lt or odrl:lteq and one non-negative xsd:duration of at most 64 characters, written as a plain string such as \"PT24H\" (or an xsd:duration typed literal); odrl:lt takes a non-zero duration (odrl:lteq \"PT0S\" is the zero bound). The datatype IRI, a free-form value such as \"24h\", a negative duration such as \"-P1D\", a zero duration with odrl:lt and { \"@id\" } are refused."@en .

# eox-policy:acceptedTerms (Declared, dataspace-ecosystem MR !145): odrl:eq and the IRI
# of one version of the terms, written as a plain string (or an xsd:anyURI literal):
# an http(s) IRI with an authority, or a urn:, the same rule as MR !145. A compact IRI
# and a did: IRI are refused. An {"@id"} right operand is refused too: upstream EDC
# rejects it with HTTP 400 since eclipse-edc/Connector#6164 (a right operand is a
# literal), and dataspace-ecosystem MR !134 only keeps it working as a deprecated
# compatibility transform ({"@id": X} -> "X") whose support will be dropped.
eoxs:AcceptedTermsConstraint
    a sh:NodeShape ;
    sh:targetSubjectsOf odrl:leftOperand, odrl:operator, odrl:rightOperand ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:pattern "^https://eona-x\\.eu/vocabulary/odrl-profile#acceptedTerms$" ] ]
        [ sh:property [ sh:path odrl:operator ; sh:in ( odrl:eq ) ] ;
          sh:property [ sh:path odrl:rightOperand ; sh:minCount 1 ; sh:maxCount 1 ;
                        sh:or ( [ sh:datatype xsd:anyURI ] [ sh:datatype xsd:string ] ) ;
                        sh:pattern "^(https?://[^/?#\\s]+([A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=%]*)?|urn:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=%]+)$" ; sh:flags "i" ] ]
    ) ;
    sh:message "eox-policy:acceptedTerms takes odrl:eq and one IRI naming a single version of the terms: an http(s) IRI with an authority or a urn: IRI. Write it as a plain string, not {\"@id\"} (deprecated, refused by EDC since eclipse-edc/Connector#6164). dataspace-ecosystem MR !145 refuses a compact IRI such as eox-policy:terms and a did: IRI."@en .

# A prohibition's remedies and consequences are Duty in EDC and are accepted, so only
# the prohibition's own constraints are targeted.
eoxs:NoAcceptedTermsOnProhibition
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:prohibition ;
    sh:property [
        sh:path [ sh:alternativePath (
            ( odrl:constraint odrl:leftOperand )
            ( odrl:constraint odrl:or odrl:leftOperand )
            ( odrl:constraint odrl:or [ sh:zeroOrMorePath rdf:rest ] rdf:first odrl:leftOperand )
        ) ] ;
        sh:not [ sh:hasValue eox-policy:acceptedTerms ] ;
        sh:message "eox-policy:acceptedTerms is declared on duties, obligations and permissions only: dataspace-ecosystem MR !145 has no function for it on a prohibition and rejects the policy (HTTP 400)."@en
    ] .

# odrl:elapsedTime bounds an odrl:delete duty (dataspace-ecosystem MR !150): it is a
# direct odrl:constraint of a rule that is an odrl:duty of a permission or a
# policy-level odrl:obligation, and whose action is odrl:delete. A permission, a
# prohibition, a remedy, a consequence, a duty with another action, an odrl:or member
# and an action refinement all lack that shape and are refused.
eoxs:ElapsedTimeOnDeleteDutyOnly
    a sh:NodeShape ;
    sh:targetSubjectsOf odrl:leftOperand ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:hasValue odrl:elapsedTime ] ]
        [ sh:property [ sh:path [ sh:inversePath odrl:constraint ] ; sh:minCount 1 ; sh:node eoxs:DeleteDuty ] ]
    ) ;
    sh:message "odrl:elapsedTime is a direct constraint of an odrl:delete duty or obligation only (dataspace-ecosystem MR !150): not on a permission, a prohibition, a remedy, a consequence, a duty with another action, inside odrl:or or in an action refinement. An enforced permission constraint is eona-x/backlog#1091."@en .

eoxs:DeleteDuty
    a sh:NodeShape ;
    sh:property [ sh:path odrl:action ; sh:hasValue odrl:delete ] ;
    sh:or ( [ sh:property [ sh:path [ sh:inversePath odrl:duty ] ; sh:minCount 1 ] ]
            [ sh:property [ sh:path [ sh:inversePath odrl:obligation ] ; sh:minCount 1 ] ] ) .

eoxs:ReviewPolicyNotAPermissionAction
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:permission ;
    sh:property [
        sh:path odrl:action ;
        sh:not [ sh:hasValue odrl:reviewPolicy ] ;
        sh:message "odrl:reviewPolicy is not a permission action: write it as a duty or an obligation. The connector drops a permission whose action is declared, with every constraint on it (eona-x/backlog#1065)."@en
    ] .

eoxs:DeleteNotAPermissionAction
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:permission ;
    sh:property [
        sh:path odrl:action ;
        sh:not [ sh:hasValue odrl:delete ] ;
        sh:message "odrl:delete is not a permission action: write it as the action of a duty of a permission or of a policy-level obligation. The connector drops a permission whose action is declared, with every constraint on it (eona-x/backlog#1065)."@en
    ] .

eoxs:DeleteNotARemedyOrConsequenceAction
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:remedy, odrl:consequence ;
    sh:property [
        sh:path odrl:action ;
        sh:not [ sh:hasValue odrl:delete ] ;
        sh:message "odrl:delete is not a remedy or consequence action: write it as the action of a duty of a permission or of a policy-level obligation."@en
    ] .

eoxs:DeleteNotAProhibitionAction
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:prohibition ;
    sh:property [
        sh:path odrl:action ;
        sh:not [ sh:hasValue odrl:delete ] ;
        sh:message "odrl:delete is not a prohibition action: write it as the action of a duty of a permission or of a policy-level obligation."@en
    ] .

# Credential-claim operands: the operators the connector's constraint functions accept.
eoxs:CredentialClaimConstraint
    a sh:NodeShape ;
    sh:targetSubjectsOf odrl:leftOperand, odrl:operator, odrl:rightOperand ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:pattern "^https://eona-x\\.eu/vocabulary/odrl-profile#(GenericClaim|RestrictedDiscoveryClaim)\\.\\$\\." ] ]
        [ sh:property [ sh:path odrl:operator ; sh:in ( odrl:eq odrl:neq odrl:isPartOf odrl:hasPart odrl:isNoneOf ) ] ]
    ) ;
    sh:message "GenericClaim and RestrictedDiscoveryClaim take odrl:eq, odrl:neq, odrl:isPartOf, odrl:hasPart and odrl:isNoneOf (deny-list, evaluated by connectors that include dataspace-ecosystem MR !133)."@en .

# The list operators on credential-claim operands take several values, a JSON-LD list
# or an array string such as "['a', 'b']", never a bare scalar. In dataspace-ecosystem
# MR !133 (dataspace-ecosystem commit fa55491) GenericClaim refuses a bare scalar
# ("Array string must be enclosed in square brackets": the policy denies everyone) and
# RestrictedDiscoveryClaim misparses it (parseToList strips its first and last
# characters, "SANCTIONED" becomes ["ANCTIONE"], so an isNoneOf deny-list fails open).
# A one-element JSON array arrives as a scalar too: write "['SANCTIONED']".
eoxs:CredentialClaimListOperand
    a sh:NodeShape ;
    sh:targetSubjectsOf odrl:leftOperand, odrl:operator, odrl:rightOperand ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:pattern "^https://eona-x\\.eu/vocabulary/odrl-profile#(GenericClaim|RestrictedDiscoveryClaim)\\.\\$\\." ] ]
        [ sh:not [ sh:path odrl:operator ; sh:in ( odrl:isNoneOf odrl:isPartOf ) ] ]
        [ sh:path odrl:rightOperand ; sh:minCount 2 ]
        [ sh:path odrl:rightOperand ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:or ( [ sh:datatype xsd:string ; sh:pattern "^\\s*\\[.*\\]\\s*$" ]
                  [ sh:nodeKind sh:BlankNode ; sh:property [ sh:path rdf:first ; sh:minCount 1 ] ] ) ]
    ) ;
    sh:message "odrl:isNoneOf and odrl:isPartOf on GenericClaim and RestrictedDiscoveryClaim: the right operand takes a list or an array string such as \"['a', 'b']\", never a bare scalar. dataspace-ecosystem MR !133 refuses a bare scalar on GenericClaim and misparses it on RestrictedDiscoveryClaim (it strips the first and last characters, so a deny-list fails open)."@en .

eoxs:MembershipConstraint
    a sh:NodeShape ;
    sh:targetSubjectsOf odrl:leftOperand, odrl:operator, odrl:rightOperand ;
    sh:or (
        [ sh:not [ sh:path odrl:leftOperand ; sh:pattern "^https://eona-x\\.eu/vocabulary/odrl-profile#Membership$" ] ]
        [ sh:property [ sh:path odrl:operator ; sh:in ( odrl:eq ) ] ;
          sh:property [ sh:path odrl:rightOperand ; sh:hasValue "active" ] ]
    ) ;
    sh:message "eox-policy:Membership takes odrl:eq and the literal \"active\"."@en .

# ConstraintsOnDuties: credential-claim operands only on permissions.
# The path reaches the left operands of atomic constraints and of the members of odrl:or.
eoxs:NoCredentialClaimOutsidePermission
    a sh:NodeShape ;
    sh:targetObjectsOf odrl:prohibition, odrl:obligation, odrl:duty, odrl:remedy, odrl:consequence ;
    sh:property [
        sh:path [ sh:alternativePath (
            ( odrl:constraint odrl:leftOperand )
            ( odrl:constraint odrl:or odrl:leftOperand )
            ( odrl:constraint odrl:or [ sh:zeroOrMorePath rdf:rest ] rdf:first odrl:leftOperand )
        ) ] ;
        sh:not [ sh:pattern "^https://eona-x\\.eu/vocabulary/odrl-profile#(Membership$|GenericClaim\\.\\$\\.|RestrictedDiscoveryClaim\\.\\$\\.)" ] ;
        sh:message "ConstraintsOnDuties: credential-claim operands are evaluated on permissions only. On a duty, obligation or prohibition the connector has no function for them and rejects the policy."@en
    ] .

#################################################################
#  Policy
#################################################################

# KeepAnEnforcedPermission: at least one permission with an enforced action and a
# constraint on a credential-claim operand.
# A credential-claim operand inside odrl:or counts.
eoxs:PolicyShape
    a sh:NodeShape ;
    rdfs:label "Policy"@en ;
    sh:targetClass odrl:Set, odrl:Offer, odrl:Agreement, odrl:Policy ;
    sh:property [
        sh:path odrl:permission ;
        sh:qualifiedValueShape eoxs:EnforcedPermission ;
        sh:qualifiedMinCount 1 ;
        sh:message "KeepAnEnforcedPermission: keep at least one permission the connector enforces (odrl:use, transfer, share or distribute, constrained by eox-policy:Membership, GenericClaim or RestrictedDiscoveryClaim). Rules it does not evaluate leave an empty policy that grants anyone."@en
    ] .

eoxs:EnforcedPermission
    a sh:NodeShape ;
    sh:property [ sh:path odrl:action ; sh:in ( odrl:use odrl:transfer odrl:share odrl:distribute ) ] ;
    sh:property [
        sh:path [ sh:alternativePath (
            ( odrl:constraint odrl:leftOperand )
            ( odrl:constraint odrl:or odrl:leftOperand )
            ( odrl:constraint odrl:or [ sh:zeroOrMorePath rdf:rest ] rdf:first odrl:leftOperand )
        ) ] ;
        sh:qualifiedValueShape [ sh:pattern "^https://eona-x\\.eu/vocabulary/odrl-profile#(Membership$|GenericClaim\\.\\$\\.|RestrictedDiscoveryClaim\\.\\$\\.)" ] ;
        sh:qualifiedMinCount 1
    ] .
