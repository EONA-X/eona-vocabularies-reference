@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix assettype: <http://publications.europa.eu/resource/authority/asset-classification/> .
@prefix status: <http://publications.europa.eu/resource/authority/concept-status/> .

<> a dcat:Dataset, adms:Asset ;
    dcterms:title "Verifiable Credentials Vocabulary v2.0"@en ;
    dcterms:description "RDF vocabulary underlying the W3C Verifiable Credentials Data Model — issuers, holders, verifiable credentials and presentations. Used by the Gaia-X ICAM semantic model and by Eona-X's own credential types (see eonax-credentials)."@en ;
    dcat:type assettype:c_89b4bdb7 ;
    adms:status status:CURRENT .

<> dcterms:creator [ a foaf:Agent ; foaf:name "W3C" ] .

<> schema:logo "w3c-hero.png" .
