<> a dcat:Dataset, adms:Asset ;
    dcterms:title "Eona-X Credentials Vocabulary"@en ;
    dcterms:description "Verifiable Credential types the Eona-X dataspace issues to participants: DomainCredential (current), FederationCredential (target — not yet emitted by the current runtime), and MembershipCredential (current attestation, plus target set-valued claims)."@en ;
