# Catalog fragment for the Eona-X policy & credentials vocabularies.
#
# Like the ODRL fragment, this does NOT redefine the shared catalog (the mobility
# pipeline's catalog.ttl owns eona:catalog). It MERGES additional triples into that
# single catalog via the default-graph union:
#   - dcterms:hasPart edges to two browsable ConceptSchemes,
#   - each scheme's title/label/description, and
#   - skos:inScheme + skos:topConceptOf links so the terms list & render in Prez
#     (asserted here directly because this pipeline has no bespoke loader step,
#      unlike load-odrl which injects them via SPARQL).
# The eox-policy: / eox-cred: vann prefix bindings for Prez curie routing now live
# in metadata.ttl (same target named graph, so the union sees them exactly as
# before).
#
# Two schemes are exposed:
#   eona:eonax-odrl-profile  -> the supported ODRL profile terms
#   eona:eonax-credentials   -> the target credential structures

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix eona: <https://vocab.eona-x.eu/> .
@prefix eox-policy: <https://w3id.org/eonax/policy/> .
@prefix eox-cred: <https://w3id.org/eonax/credentials/> .

# Merge the two schemes into the shared catalog as additional members.
eona:catalog dcterms:hasPart eona:eonax-odrl-profile , eona:eonax-credentials .

#################################################################
#  Scheme 1 — the supported ODRL profile
#################################################################

eona:eonax-odrl-profile a skos:ConceptScheme ;
    dcterms:identifier "eonax-odrl-profile" ;
    dcterms:title "Eona-X ODRL Profile" ;
    rdfs:label "Eona-X ODRL Profile" ;
    dcterms:description "The supported subset of W3C ODRL 2.2 used to author and enforce access & usage policies in the Eona-X dataspace, plus three custom credential-claim leftOperands (Membership, GenericClaim, RestrictedDiscoveryClaim)." ;
    rdfs:seeAlso <https://w3id.org/eonax/policy/> .

# The profile's own terms as items of the scheme.
eox-policy:Membership               skos:inScheme eona:eonax-odrl-profile ; skos:topConceptOf eona:eonax-odrl-profile .
eox-policy:GenericClaim             skos:inScheme eona:eonax-odrl-profile ; skos:topConceptOf eona:eonax-odrl-profile .
eox-policy:RestrictedDiscoveryClaim skos:inScheme eona:eonax-odrl-profile ; skos:topConceptOf eona:eonax-odrl-profile .
eona:eonax-odrl-profile skos:hasTopConcept
    eox-policy:Membership , eox-policy:GenericClaim , eox-policy:RestrictedDiscoveryClaim .

#################################################################
#  Scheme 2 — the target credential structures
#################################################################

eona:eonax-credentials a skos:ConceptScheme ;
    dcterms:identifier "eonax-credentials" ;
    dcterms:title "Eona-X Credential Structures (target)" ;
    rdfs:label "Eona-X Credential Structures (target)" ;
    dcterms:description "Target structures of the Verifiable Credentials used in the Eona-X dataspace: MembershipCredential, DomainCredential and FederationCredential. Describes the intended credentialSubject shapes (SHACL), not runtime instances." ;
    rdfs:seeAlso <https://w3id.org/eonax/credentials/> .

eox-cred:MembershipCredential skos:inScheme eona:eonax-credentials ; skos:topConceptOf eona:eonax-credentials .
eox-cred:DomainCredential     skos:inScheme eona:eonax-credentials ; skos:topConceptOf eona:eonax-credentials .
eox-cred:FederationCredential skos:inScheme eona:eonax-credentials ; skos:topConceptOf eona:eonax-credentials .
eona:eonax-credentials skos:hasTopConcept
    eox-cred:MembershipCredential , eox-cred:DomainCredential , eox-cred:FederationCredential .
